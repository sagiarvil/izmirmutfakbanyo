---
import SEO, { type Props as SEOProps } from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloating from "../components/WhatsAppFloating.astro";
import ScrollToTop from "../components/ScrollToTop.astro";

export interface Props {
  seo: SEOProps;
  activeService?: string;
}

const { seo, activeService } = Astro.props;
---

<!doctype html>
<html lang="tr" class="scroll-smooth overflow-x-hidden bg-[#FAF9F6] text-[#1D1D1F]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, minimum-scale=1, maximum-scale=5" />

    <SEO {...seo} />
    
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,600;1,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/assets/tailwind-build.css" />

    <!-- Favicon & Touch Icons (Logo İle Senkron - v=20261028c Cache-Buster) -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=20261028c" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=20261028c" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=20261028c" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png?v=20261028c" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png?v=20261028c" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=20261028c" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=20261028c" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20261028c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261028c" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Mobil & PWA Standartları -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Yeşilay Mutfak" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="theme-color" content="#FAF9F6" />

    <!-- Speculation Rules API (0 ms Anında Geçiş & bfcache Uyumu) -->
    <script type="speculationrules" is:inline>
      {
        "prerender": [
          {
            "where": { "href_matches": "/*" },
            "eagerness": "moderate"
          }
        ]
      }
    </script>

    <!-- Alpine.js 3.x with Collapse Plugin (Declarative Reactive UI Engine) -->
    <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.14.8/dist/cdn.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
  </head>
  <body class="min-h-screen flex flex-col font-sans architect-grid-bg text-[#1D1D1F] overflow-x-hidden antialiased selection:bg-[#006039] selection:text-white">
    <Header activeService={activeService} />
    <main id="main-content" class="flex-1 w-full overflow-hidden">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloating service={activeService} />
    <ScrollToTop />
  
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const targetSelectors = [
          "section > div > div.grid > div",
          ".apple-card",
          "details",
          "table",
          "section h2"
        ];
        const vh = window.innerHeight || 900;
        const elements = document.querySelectorAll(targetSelectors.join(", "));
        const pending = [];
        elements.forEach((el, index) => {
          if (el.closest("#siteHeader") || el.closest("footer")) return;
          const rect = el.getBoundingClientRect();
          if (rect.top < vh + 120) return;
          if (!el.classList.contains("reveal-on-scroll")) {
            el.classList.add("reveal-on-scroll");
            const stagger = (index % 4) * 80;
            if (stagger > 0) el.style.transitionDelay = stagger + "ms";
            pending.push(el);
          }
        });
        if (!pending.length) return;
        const revealEl = (el) => {
          el.classList.add("is-revealed");
        };
        if ("IntersectionObserver" in window) {
          const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting || entry.boundingClientRect.top < window.innerHeight + 160) {
                revealEl(entry.target);
                revealObserver.unobserve(entry.target);
              }
            });
          }, { threshold: 0.01, rootMargin: "160px 0px 160px 0px" });
          pending.forEach(el => revealObserver.observe(el));
          const revealAboveFold = () => {
            const limit = (window.innerHeight || 900) + 160;
            pending.forEach(el => {
              if (!el.classList.contains("is-revealed") && el.getBoundingClientRect().top <= limit) {
                revealEl(el);
                revealObserver.unobserve(el);
              }
            });
          };
          window.addEventListener("scroll", revealAboveFold, { passive: true });
          window.addEventListener("hashchange", () => setTimeout(revealAboveFold, 50), { passive: true });
        } else {
          pending.forEach(revealEl);
        }
      });
    </script>
    <!-- Conversion Event Listener (G077) -->
    <script is:inline>
      document.addEventListener('click', function(e) {
        var t = e.target && e.target.closest ? e.target.closest('[data-conversion-event]') : null;
        if (!t) return;
        var evName = t.getAttribute('data-conversion-event');
        if (window.dataLayer) { window.dataLayer.push({ event: evName, page: location.pathname }); }
      }, { passive: true });
    </script>
    <!-- Google tag (gtag.js) Deferred Until After Initial Paint -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.addEventListener('load', function() {
        setTimeout(function() {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-4BK4ZYZ9ET';
          document.head.appendChild(s);
          gtag('js', new Date());
          gtag('config', 'G-4BK4ZYZ9ET');
        }, 2500);
      });
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  html, body {
    max-width: 100vw;
    overflow-x: hidden !important;
    background-color: #FAF9F6;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "SF Pro", "Helvetica Neue", Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  :focus-visible {
    outline: 2px solid #006039;
    outline-offset: 2px;
  }

  /* Apple Glass & Card Elevation */
  .apple-glass {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(210, 210, 215, 0.7);
  }

  .apple-card {
    background: #FFFFFF;
    border: 1px solid #E5DFD5;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .apple-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px -6px rgba(0, 96, 57, 0.10);
    border-color: #006039;
  }

  /* ===================================================================== */
  /* CINEMATIC SCROLL & INTERACTION MOTION ENGINE (Apple & GSAP Standard) */
  /* ===================================================================== */
  
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .reveal-on-scroll.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* Micro Stagger Delays */
  .delay-100 { transition-delay: 100ms; }
  .delay-200 { transition-delay: 200ms; }
  .delay-300 { transition-delay: 300ms; }
  .delay-400 { transition-delay: 400ms; }

  /* Premium Card Hover Lift */
  .hover-lift {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease;
  }
  .hover-lift:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px -10px rgba(0, 96, 57, 0.12);
  }

  /* Mimari Teknik Cizim Milimetrik Grid Deseni (Sayfa ve Bolum Duz Arka Planlarinda) */
  .architect-grid-bg {
    background-color: #FAF9F6;
    background-image: 
      linear-gradient(to right, rgba(29, 29, 31, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(29, 29, 31, 0.04) 1px, transparent 1px),
      linear-gradient(to right, rgba(197, 168, 128, 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(197, 168, 128, 0.08) 1px, transparent 1px);
    background-size: 24px 24px, 24px 24px, 120px 120px, 120px 120px;
    background-position: 0 0, 0 0, 0 0, 0 0;
  }

  /* Missing Tailwind utility parity rules */
  .aspect-4\/3 { aspect-ratio: 4 / 3; }
  .rounded-xs { border-radius: 0.125rem; }
  .shadow-2xs { box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.03); }
  .shadow-xs, .hover\:shadow-xs:hover { box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05); }
  .backdrop-blur-xs { -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px); }
  .bg-\[\#006039\]\/8 { background-color: rgba(0, 96, 57, 0.08); }
  .bg-\[\#006039\]\/92 { background-color: rgba(0, 96, 57, 0.92); }
  .bottom-20 { bottom: 5rem; }
  .bottom-22 { bottom: 5.5rem; }
  .bottom-36 { bottom: 9rem; }
  @media (min-width: 1280px) {
    .xl\:bottom-6 { bottom: 1.5rem; }
    .xl\:bottom-24 { bottom: 6rem; }
  }
  .duration-7000 { transition-duration: 7000ms; }
  .group:hover .group-hover\:scale-103 { transform: scale(1.03); }
  .group:hover .group-hover\:scale-106 { transform: scale(1.06); }
  .w-3\/8 { width: 37.5%; }
  .py-0\.2 { padding-top: 0.0625rem; padding-bottom: 0.0625rem; }
  .h-\[54svh\] { height: 54svh; }
  .min-h-\[380px\] { min-height: 380px; }
  .h-\[calc\(100svh-72px\)\] { height: calc(100svh - 72px); }
  .min-h-\[500px\] { min-height: 500px; }
  @media (min-width: 640px) {
    .sm\:h-\[62svh\] { height: 62svh; }
    .sm\:min-h-\[440px\] { min-height: 440px; }
    .sm\:h-\[calc\(100svh-80px\)\] { height: calc(100svh - 80px); }
  }
  @media (min-width: 1024px) {
    .lg\:h-\[68svh\] { height: 68svh; }
    .lg\:h-\[calc\(100svh-88px\)\] { height: calc(100svh - 88px); }
  }

  @media (prefers-reduced-motion: reduce), print {
    .reveal-on-scroll {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

</style>
