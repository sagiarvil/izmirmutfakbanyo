---
import Layout from "../../../layouts/Layout.astro";
import { siteConfig } from "../../../data/siteConfig";

const seo = {
  title: "Güzelbahçe Villa Mutfak Tadilatı & Yelki Mutfak Dolabı | Yeşilay Mutfak",
  description: "Güzelbahçe ve Yelki villalarına özel ada mutfak tasarımları, porselen tezgah ve komple villa renovasyonu. Kendi atölyemizde E1 neme dayanıklı MDF ve Blum mekanizmayla imalat.",
  canonical: "https://yesilaymutfak.com/hizmet-bolgeleri/guzelbahce/",
  serviceName: "Güzelbahçe Villa Mutfak Tadilatı",
  breadcrumbs: [
    { name: "Hizmet Bölgeleri", url: "/hizmet-bolgeleri/buca/" },
    { name: "Güzelbahçe", url: "/hizmet-bolgeleri/guzelbahce/" }
  ],
  faqList: [
    {
      question: "Güzelbahçe ve Yelki villalarında açık salon ada mutfak projeleri yapıyor musunuz?",
      answer: "Evet. Geniş salon ve bahçeye açılan verandalarla bütünleşen ada tezgahlar, bar taburesi oturma alanlı tasarımlar ve gizli kiler odaları projelendiriyoruz."
    },
    {
      question: "Güzelbahçe'de komple villa içi tadilat ve seramik yenilemesi yapıyor musunuz?",
      answer: "Evet. Salon zemin seramikleri, ıslak hacim su yalıtımı, banyo dolapları, iç kapılar ve mutfak dahil tek muhatap anahtar teslim mimari taahhüt veriyoruz."
    },
    {
      question: "Güzelbahçe keşif ve mimari 3D çizim süresi ne kadardır?",
      answer: "Talebinizin ardından 24-48 saat içerisinde yerinde lazer rölöve alınır ve 3 iş günü içinde fotogerçekçi 3D mimari çizimleriniz hazırlanarak sunulur."
    }
  ]
};
---

<Layout seo={seo} activeService="Güzelbahçe Mutfak Tadilatı">
  <!-- HERO BÖLÜMÜ -->
  <section class="relative bg-[#0E2017] text-white py-20 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-85" style="background-image: url('/media/real/yesilay-showroom-ic-mekan.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A1A12]/85 via-[#0A1A12]/40 to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <nav class="flex items-center gap-2 text-xs font-semibold text-stone-400 uppercase tracking-widest" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Ana Sayfa</a>
        <span>/</span>
        <a href="/hizmet-bolgeleri/guzelbahce/" class="text-emerald-400">Güzelbahçe & Yelki</a>
      </nav>

      <span class="inline-block px-3.5 py-1.5 bg-emerald-950/80 border border-emerald-400/40 text-emerald-300 text-[11px] font-black tracking-[0.2em] uppercase shadow-lg">
        YELKİ, KAHRAMANDERE & ÇAMLI ÖZEL VİLLA MİMARİSİ
      </span>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight leading-[1.15]" style="font-family: 'Playfair Display', Georgia, serif;">
        Güzelbahçe Villa Mutfak Tadilatı & <br /><span class="font-normal">Özel İmalat Ada Tezgah Tasarımları</span>
      </h1>

      <p class="text-sm sm:text-base text-stone-300 font-light leading-relaxed max-w-2xl">
        Yelki ve Kahramandere'deki müstakil villalar için bahçe manzaralı açık mutfaklar, geniş porselen ada üniteleri, gizli kiler odaları ve tek yüklenici güvencesiyle komple villa taahhüdü.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="https://wa.me/905324261788?text=Merhaba,%20Güzelbahçe'deki%20villam%20için%20mutfak%20tadilatı%20keşfi%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg inline-flex items-center gap-2">
          <span>💬</span> <span>WhatsApp ile Güzelbahçe Keşif İste</span>
        </a>
        <a href="tel:02324411060" class="px-8 py-3.5 bg-transparent border border-stone-400 text-white text-xs font-bold uppercase tracking-widest hover:bg-white hover:text-stone-950 transition">
          0232 441 10 60
        </a>
      </div>
    </div>
  </section>

  <!-- TEKNİK KANIT VE BÖLGESEL ÇÖZÜMLER -->
  <section class="py-16 sm:py-24 bg-white border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      <div class="max-w-3xl space-y-3">
        <div class="text-[11px] font-black uppercase tracking-[0.2em] text-[#006039]">Müstakil Yaşam Alanı Mühendisliği</div>
        <h2 class="text-2xl sm:text-4xl font-light text-[#1D1D1F] tracking-tight" style="font-family: 'Playfair Display', Georgia, serif;">
          Güzelbahçe Villalarına Özel <span class="font-bold">Bütünleşik Tasarım Yaklaşımı</span>
        </h2>
        <p class="text-sm text-[#6E675F] leading-relaxed">
          Bahçe ve havuz terasına açılan geniş hacimli Güzelbahçe evlerinde, mutfak sadece yemek pişirme alanı değil, ailenin ve misafirlerin toplandığı sosyal merkezdir. Çizilmez porselen tezgahlar ve akıllı gömme kiler sistemleri ile estetik ve fonksiyonu birleştiriyoruz.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] space-y-3">
          <div class="text-2xl">🏡</div>
          <h3 class="text-base font-bold text-[#1D1D1F]">Veranda Entegre Ada Mutfak</h3>
          <p class="text-xs text-[#6E675F] leading-relaxed">
            Dış mekânla iç mekânı akıcı bir şekilde bağlayan oturma barlı ada tezgahlar ve geniş depolama üniteleri.
          </p>
        </div>
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] space-y-3">
          <div class="text-2xl">💎</div>
          <h3 class="text-base font-bold text-[#1D1D1F]">Çizilmez Porselen Plakalar</h3>
          <p class="text-xs text-[#6E675F] leading-relaxed">
            Sıcak tencere temasından ve limon/asit lekelerinden etkilenmeyen 12mm kompakt porselen tezgah uygulamaları.
          </p>
        </div>
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] space-y-3">
          <div class="text-2xl">📋</div>
          <h3 class="text-base font-bold text-[#1D1D1F]">Gecikme Tazminatlı Sözleşme</h3>
          <p class="text-xs text-[#6E675F] leading-relaxed">
            Villa tadilatınızın taahhüt edilen teslim günü resmi sözleşmeyle imza altına alınır; gecikilen her gün nakit tazminat ödenir.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS -->
  <section class="py-16 bg-[#FAF9F6]">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-3xl font-light text-[#1D1D1F]" style="font-family: 'Playfair Display', Georgia, serif;">
          Güzelbahçe Villa Tadilatı <span class="font-bold">Sıkça Sorulan Sorular</span>
        </h2>
        <p class="text-xs text-[#6E675F]">Yelki ve Güzelbahçe villa sahiplerinin en çok merak ettiği konular.</p>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="p-5 bg-white border border-[#E5DFD5] space-y-2">
            <h3 class="text-sm font-bold text-[#1D1D1F]">{faq.question}</h3>
            <p class="text-xs text-[#6E675F] leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
