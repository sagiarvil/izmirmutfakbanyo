---
import Layout from "../../../layouts/Layout.astro";
import { siteConfig } from "../../../data/siteConfig";

const seo = {
  title: "Çeşme & Alaçatı Villa Mutfak Tadilatı | Yeşilay Mutfak",
  description: "Çeşme ve Alaçatı lüks villalarına özel marin gövde mutfak dolapları, porselen tezgah ve komple yazlık tadilatı. Sezon öncesi gün garantili teslimat.",
  canonical: "https://yesilaymutfak.com/hizmet-bolgeleri/cesme/",
  serviceName: "Çeşme Villa Mutfak Tadilatı",
  breadcrumbs: [
    { name: "Ana Sayfa", url: "/" },
    { name: "Çeşme Villa Mutfak Tadilatı", url: "/hizmet-bolgeleri/cesme/" }
  ],
  faqList: [
    {
      question: "Çeşme ve Alaçatı'da yaz sezonu öncesi kesin teslimat garantisi veriyor musunuz?",
      answer: "Evet. Noter onaylı resmi sözleşmemizde teslim günü net olarak belirlenir ve gecikilen her takvim günü için müşterimize cezai nakit tazminat ödenir. Sezonu kaçırma riski sıfırdır."
    },
    {
      question: "Çeşme'deki yüksek deniz tuzu ve neme karşı hangi malzemeler kullanılır?",
      answer: "Gövdede %100 çift yüz neme dayanımlı yeşil marin MDF, menteşelerde korozyona dayanıklı Avusturya Blum donanım ve sararmayan UV filtreli fırın lake kapaklar kullanılır."
    },
    {
      question: "Çeşme'deki villamız için kırım, havuz başı banyo ve komple tadilat yapıyor musunuz?",
      answer: "Evet. Kırım, moloz tahliyesi, su yalıtımı, 60x120 ve 120x240 porselen seramik kaplama, banyo dolabı ve mutfak montajı tek elden iç mimar kontrolünde yürütülür."
    }
  ]
};
---

<Layout seo={seo} activeService="Çeşme Mutfak Tadilatı">
  <!-- HERO BÖLÜMÜ -->
  <section class="relative bg-[#0E2017] text-white py-20 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-85" style="background-image: url('/media/real/yesilay-showroom-ic-mekan.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A1A12]/85 via-[#0A1A12]/40 to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <nav class="flex items-center gap-2 text-xs font-semibold text-stone-400 uppercase tracking-widest" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Ana Sayfa</a>
        <span>/</span>
        <span class="text-emerald-400">Çeşme & Alaçatı Villa Mutfak</span>
      </nav>

      <span class="inline-block px-3.5 py-1.5 bg-emerald-950/80 border border-emerald-400/40 text-emerald-300 text-[11px] font-black tracking-[0.2em] uppercase shadow-lg">
        ALAÇATI, ILICA, DALYAN & OVACIK VİLLA YENİLEME VE İMALAT
      </span>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight leading-[1.15]" style="font-family: 'Playfair Display', Georgia, serif;">
        Çeşme & Alaçatı Villa Mutfak Tadilatı: <br /><span class="font-normal">Sezon Öncesi Gün Garantili Lüks Renovasyon</span>
      </h1>
          <p data-answer-capsule="true" class="answer-capsule mt-4 text-stone-300 sm:text-stone-600 text-sm sm:text-base font-normal leading-relaxed max-w-2xl">Çeşme, Alaçatı, Ilıca ve Dalyan villaları için mutfak yenileme ve tadilat; deniz tuzu, yüksek nem ve korozyona dayanıklı marin kontrplak gövdeler, paslanmaz menteşeler ve porselen tezgahlarla gerçekleştirilir. Yeşilay Mutfak, yaz sezonu öncesi gecikme cezalı sözleşmeyle gününde anahtar teslim eder.</p>

      <p class="text-sm sm:text-base text-stone-300 font-light leading-relaxed max-w-2xl">
        Alaçatı taş evleri ve Çeşme müstakil villaları için tuzlu sahil havasına dayanıklı yeşil marin MDF gövdeler, sararmayan fırın lake dolaplar ve gecikme tazminatlı sözleşmeyle anahtar teslim tadilat.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="https://wa.me/905324261788?text=Merhaba,%20Çeşme'deki%20villam%20için%20mutfak%20tadilatı%20keşfi%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg inline-flex items-center gap-2">
          <span>💬</span> <span>WhatsApp ile Çeşme Keşif İste</span>
        </a>
        <a href="tel:02324411060" class="px-8 py-3.5 bg-transparent border border-stone-400 text-white text-xs font-bold uppercase tracking-widest hover:bg-white hover:text-stone-950 transition">
          📞 0232 441 10 60
        </a>
      </div>
    </div>
  </section>

  <!-- ÇEŞME VİLLA MİMARİ MÜHENDİSLİK CETVELİ TABLOSU -->
  <section class="py-16 sm:py-20 bg-white border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="border-l-4 border-emerald-600 pl-4 space-y-1">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-800">ÇEŞME YARIMADASI VİLLA MÜHENDİSLİK KRİTERLERİ</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900">
          Çeşme ve Alaçatı Konut Tiplerine Özel Malzeme ve Tadilat Matrisi
        </h2>
        <p class="text-xs sm:text-sm text-stone-600 max-w-3xl leading-relaxed">
          Kışın kapalı kalan yazlıklarda yaşanan küflenme, ahşap kabarması ve menteşe paslanması gibi kronik sorunları kalıcı olarak çözen marin spesifikasyonlarımız:
        </p>
      </div>

      <div class="overflow-x-auto border border-stone-200 rounded-xl shadow-xs">
        <table class="w-full text-left border-collapse text-xs sm:text-sm">
          <thead>
            <tr class="bg-stone-900 text-white">
              <th class="p-3 sm:p-4 font-bold border-b border-stone-800">Bölge / Konut Segmenti</th>
              <th class="p-3 sm:p-4 font-bold border-b border-stone-800">Sahil & İklim Kaynaklı Riskler</th>
              <th class="p-3 sm:p-4 font-bold border-b border-stone-800">Yeşilay Marin Kalite Çözümü</th>
              <th class="p-3 sm:p-4 font-bold border-b border-stone-800">Önerilen Tezgah & Donanım</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-200 text-stone-700 bg-white">
            <tr class="hover:bg-stone-50 transition">
              <td class="p-3 sm:p-4 font-semibold text-stone-900">Alaçatı Taş Evleri & Butik Oteller</td>
              <td class="p-3 sm:p-4">Doğal taş duvar eğrilikleri, yüksek kış rutubeti, dar mutfak nişleri.</td>
              <td class="p-3 sm:p-4">Taş duvara göre özel şablonlanan masif meşe ve fırın lake gövde, nefes alan arkalık paneli.</td>
              <td class="p-3 sm:p-4 font-medium text-emerald-800">Porselen Tezgah / Rustik Seramik Evye</td>
            </tr>
            <tr class="hover:bg-stone-50 transition">
              <td class="p-3 sm:p-4 font-semibold text-stone-900">Ilıca & Boyalık Sahil Villaları</td>
              <td class="p-3 sm:p-4">Tuzlu deniz spreyi, yoğun UV güneş ışığı, menteşe ve ray korozyonu.</td>
              <td class="p-3 sm:p-4">%100 yeşil marin MDF gövde, nikel kaplamalı Avusturya Blum Clip-Top menteşeler.</td>
              <td class="p-3 sm:p-4 font-medium text-emerald-800">Lamar 12mm Porselen Ada Tezgah</td>
            </tr>
            <tr class="hover:bg-stone-50 transition">
              <td class="p-3 sm:p-4 font-semibold text-stone-900">Ovacık & Çiftlikköy Müstakil Villalar</td>
              <td class="p-3 sm:p-4">Geniş açık plan salonlar, bahçeye açılan verandalar, rüzgar tozu.</td>
              <td class="p-3 sm:p-4">Geniş ada mutfak barı, entegre gizli kiler odası, çift taraflı servis dolapları.</td>
              <td class="p-3 sm:p-4 font-medium text-emerald-800">Belenco Kuvars Tezgah / Blum Legrabox</td>
            </tr>
            <tr class="hover:bg-stone-50 transition">
              <td class="p-3 sm:p-4 font-semibold text-stone-900">Dalyan & Ayayorgi Marina Evleri</td>
              <td class="p-3 sm:p-4">Sürekli deniz havası, kış boyu kapalı kalma sonucu oluşan havasızlık.</td>
              <td class="p-3 sm:p-4">Havalandırma kanallı süpürgelik mimarisi, antibakteriyel fırın lake yüzeyler.</td>
              <td class="p-3 sm:p-4 font-medium text-emerald-800">Çimstone Tezgah / Entegre LED Aydınlatma</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- GÖRSEL VE BÖLGESEL KANIT -->
  <section class="py-16 sm:py-20 bg-stone-50 border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      <div class="max-w-3xl space-y-3">
        <div class="text-[11px] font-black uppercase tracking-[0.2em] text-[#006039]">Lüks Villa Renovasyon Referansları</div>
        <h2 class="text-2xl sm:text-4xl font-light text-[#1D1D1F] tracking-tight" style="font-family: 'Playfair Display', Georgia, serif;">
          Çeşme Yarımadasında Tamamlanan <span class="font-bold">Özel Projeler</span>
        </h2>
        <p class="text-sm text-[#6E675F] leading-relaxed">
          Alaçatı ve Çeşme genelinde teslim ettiğimiz villa mutfaklarında sezon başlamadan önce anahtar teslimi sağlıyoruz. Dilerseniz <a href="/izmir-mutfak-dolabi-imalati/" class="text-emerald-700 font-semibold underline underline-offset-4">özel ölçü dolap modellerimizi</a>, komple konut projeleri için <a href="/izmir-anahtar-teslim-tadilat/" class="text-emerald-700 font-semibold underline underline-offset-4">anahtar teslim tadilat sayfamızı</a> veya <a href="/yapilan-isler/" class="text-emerald-700 font-semibold underline underline-offset-4">tamamlanan projeler vitrinimizi</a> inceleyebilirsiniz.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="group bg-white rounded-2xl overflow-hidden border border-stone-200 shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="aspect-[16/10] overflow-hidden bg-stone-900 relative">
            <img 
              src="/media/projeler/proje-01.webp" 
              alt="Çeşme Villa Özel İmalat Lüks Ada Mutfak Projesi" 
              width="1200"
              height="676"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-3 left-3 px-3 py-1 bg-emerald-600 text-white text-[10px] font-bold uppercase tracking-wider rounded">ALAÇATI VİLLA MUTFAK</span>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="text-base font-bold text-stone-900">Alaçatı Müstakil Taş Ev Mutfak Renovasyonu</h3>
            <p class="text-xs text-stone-600 leading-relaxed">Taş dokuya tam oturan masif meşe detaylı ada mutfak, porselen tezgah ve entegre kiler dolabı.</p>
          </div>
        </div>

        <div class="group bg-white rounded-2xl overflow-hidden border border-stone-200 shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="aspect-[16/10] overflow-hidden bg-stone-900 relative">
            <img 
              src="/media/real/yesilay-showroom-ic-mekan.webp" 
              alt="Yeşilay Mutfak Showroom Çeşme Müşteri Teşhir Alanı" 
              width="1920"
              height="1080"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-3 left-3 px-3 py-1 bg-stone-900 text-emerald-400 border border-emerald-500/30 text-[10px] font-bold uppercase tracking-wider rounded">CANLI VİLLA TEŞHİRİ</span>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="text-base font-bold text-stone-900">Marin Gövde & UV Dayanımlı Lake Testi</h3>
            <p class="text-xs text-stone-600 leading-relaxed">Buca amiral mağazamızda Çeşme iklimine özel üretilmiş numuneleri ve menteşe sistemlerini bizzat görün.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TEKNİK KANIT VE BÖLGESEL ÇÖZÜMLER -->
  <section class="py-16 sm:py-24 bg-white border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      <div class="max-w-3xl space-y-3">
        <div class="text-[11px] font-black uppercase tracking-[0.2em] text-[#006039]">Çeşme Yarımadası Mühendislik Kriterleri</div>
        <h2 class="text-2xl sm:text-4xl font-light text-[#1D1D1F] tracking-tight" style="font-family: 'Playfair Display', Georgia, serif;">
          Yüksek Nem ve Tuzlu Rüzgara <span class="font-bold">Mukavim Donanım</span>
        </h2>
        <p class="text-sm text-[#6E675F] leading-relaxed">
          Çeşme ikliminde kış aylarında kapalı kalan yazlıkların en büyük sorunu rutubet ve ahşap şişmesidir. Yeşilay Mutfak olarak gövdede çift yüzlü yeşil neme dayanımlı MDF ve fırın poliüretan lake kullanarak mutfaklarınızı 10 yıl boyunca ilk günkü formunda tutuyoruz.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] space-y-3">
          <div class="text-2xl">⏳</div>
          <h3 class="text-base font-bold text-[#1D1D1F]">Sezon Öncesi Kesin Teslim</h3>
          <p class="text-xs text-[#6E675F] leading-relaxed">
            Yaz tatilinizi riske atmayan, resmi sözleşmede gün bazlı gecikme cezası içeren garantili şantiye takvimi.
          </p>
        </div>
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] space-y-3">
          <div class="text-2xl">🌊</div>
          <h3 class="text-base font-bold text-[#1D1D1F]">Korozyonsuz Blum Donanım</h3>
          <p class="text-xs text-[#6E675F] leading-relaxed">
            Tuzlu deniz havasında paslanma yapmayan özel kaplamalı Avusturya Blum menteşe ve ray sistemleri.
          </p>
        </div>
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] space-y-3">
          <div class="text-2xl">☀️</div>
          <h3 class="text-base font-bold text-[#1D1D1F]">Sararmayan UV Lake</h3>
          <p class="text-xs text-[#6E675F] leading-relaxed">
            Çeşme'nin yoğun güneş ışığına karşı renk değiştirmeyen, sararmayan ve solmayan fırın lake teknolojisi.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS -->
  <section class="py-16 bg-[#FAF9F6]">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-3xl font-light text-[#1D1D1F]" style="font-family: 'Playfair Display', Georgia, serif;">
          Çeşme Villa Mutfak Tadilatı <span class="font-bold">Sıkça Sorulan Sorular</span>
        </h2>
        <p class="text-xs text-[#6E675F]">Alaçatı ve Çeşme villa sahiplerinin en çok merak ettiği operasyonel detaylar.</p>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="p-5 bg-white border border-[#E5DFD5] space-y-2">
            <h3 class="text-sm font-bold text-[#1D1D1F]">{faq.question}</h3>
            <p class="text-xs text-[#6E675F] leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
