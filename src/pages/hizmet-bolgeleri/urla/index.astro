---
import Layout from "../../../layouts/Layout.astro";
import { siteConfig } from "../../../data/siteConfig";

const seo = {
  title: "Urla Mutfak Tadilatı & Taş Ev Villa Mutfak Dolabı | Yeşilay Mutfak",
  description: "Urla, Kekliktepe ve İskele taş evlerine özel ahşap ve lake mutfak dolapları ile komple tadilat. 28 yıllık atölye zanaatıyla ücretsiz mimari keşif alın.",
  canonical: "https://yesilaymutfak.com/hizmet-bolgeleri/urla/",
  serviceName: "Urla Mutfak Tadilatı ve Dolap İmalatı",
  breadcrumbs: [
    { name: "Ana Sayfa", url: "/" },
    { name: "Urla Mutfak Tadilatı", url: "/hizmet-bolgeleri/urla/" }
  ],
  faqList: [
    {
      question: "Urla taş ev ve bağ villalarında hangi tarz mutfaklar önerilir?",
      answer: "Doğal meşe/ceviz kaplamalı masif detaylar, rustik country lake kapaklar ve porselen tezgahların harmanlandığı sıcak Ege mimarisine uygun mutfak tasarımları uyguluyoruz."
    },
    {
      question: "Urla'da kışın kapalı kalan evlerde rutubet ve neme karşı hangi gövde kullanılır?",
      answer: "Kışın havalandırılmayan veya denize yakın Urla konutlarında neme ve rutubete dayanıklı çift yüzlü yeşil marin MDF gövde ve paslanmaz menteşe donanımları kullanıyoruz."
    },
    {
      question: "Urla'da komple anahtar teslim taş ev renovasyonu yapıyor musunuz?",
      answer: "Evet. Taş duvar derz temizliği, sıhhi ve elektrik altyapısı, şömine çevresi ahşap giydirme, banyo ve mutfak dahil komple mimari renovasyon taahhüt ediyoruz."
    }
  ]
};
---

<Layout seo={seo} activeService="Urla Mutfak Tadilatı">
  <!-- HERO BÖLÜMÜ -->
  <section class="relative bg-[#0E2017] text-white py-20 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-85" style="background-image: url('/media/real/yesilay-showroom-ic-mekan.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A1A12]/85 via-[#0A1A12]/40 to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <nav class="flex items-center gap-2 text-xs font-semibold text-stone-400 uppercase tracking-widest" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Ana Sayfa</a>
        <span>/</span>
        <span class="text-emerald-400">Urla & Kekliktepe</span>
      </nav>

      <span class="inline-block px-3.5 py-1.5 bg-emerald-950/80 border border-emerald-400/40 text-emerald-300 text-[11px] font-black tracking-[0.2em] uppercase shadow-lg">
        KEKLİKTEPE, İSKELE & ÇAMLIÇAY VİLLA VE TAŞ EV MİMARİSİ
      </span>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight leading-[1.15]" style="font-family: 'Playfair Display', Georgia, serif;">
        Urla Mutfak Tadilatı & <br /><span class="font-normal">Taş Ev ve Bağ Villası Özel İmalatı</span>
      </h1>
          <p data-answer-capsule="true" class="answer-capsule mt-4 text-stone-300 sm:text-stone-600 text-sm sm:text-base font-normal leading-relaxed max-w-2xl">Urla, Kekliktepe ve İskele bölgelerindeki taş ev ve bağ villaları için mutfak tadilatı; taş duvar dokusuyla uyumlu masif meşe, mat lake ve doğal taş tezgahlarla tasarlanır. Yeşilay Mutfak, Buca atölyesinde özel ölçüyle ürettiği mobilyaları taahhüt edilen sürede kusursuz teslim eder.</p>

      <p class="text-sm sm:text-base text-stone-300 font-light leading-relaxed max-w-2xl">
        Urla'nın doğal dokusuna saygılı doğal ahşap kaplama, neoklasik lake ve geniş ada tezgah tasarımları. Kendi atölyemizde üretilen E1 marin MDF gövde ve Avusturya Blum donanımlarla Ege'nin havasına dayanıklı mutfaklar.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="https://wa.me/905324261788?text=Merhaba,%20Urla'daki%20evim%20için%20mutfak%20tadilatı%20keşfi%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg inline-flex items-center gap-2">
          <span>💬</span> <span>WhatsApp ile Urla Keşif İste</span>
        </a>
        <a href="tel:02324411060" class="px-8 py-3.5 bg-transparent border border-stone-400 text-white text-xs font-bold uppercase tracking-widest hover:bg-white hover:text-stone-950 transition">
          📞 0232 441 10 60
        </a>
      </div>
    </div>
  </section>

  <!-- URLA VİLLA MİMARİ CETVELİ TABLOSU -->
  <section class="py-16 sm:py-20 bg-white border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="border-l-4 border-emerald-600 pl-4 space-y-1">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-800">EGE VE URLA MİMARİSİ ZANAAT STANDARTLARI</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900">
          Urla ve Kekliktepe Konut Tiplerine Özel Donanım ve Tasarım Matrisi
        </h2>
        <p class="text-xs sm:text-sm text-stone-600 max-w-3xl leading-relaxed">
          Taş duvar eğrilikleri, yüksek ahşap tavanlar ve geniş bağ arazisi konutlarında uyguladığımız yerel mimari spesifikasyonlar:
        </p>
      </div>

      <div class="overflow-x-auto border border-stone-200 rounded-xl shadow-xs">
        <table class="w-full text-left border-collapse text-xs sm:text-sm">
          <thead>
            <tr class="bg-stone-900 text-white">
              <th class="p-3 sm:p-4 font-bold border-b border-stone-800">Urla Bölgesi / Konut Tipi</th>
              <th class="p-3 sm:p-4 font-bold border-b border-stone-800">Mimari Doku & Kısıtlar</th>
              <th class="p-3 sm:p-4 font-bold border-b border-stone-800">Yeşilay Özel İmalat Çözümü</th>
              <th class="p-3 sm:p-4 font-bold border-b border-stone-800">Tavsiye Edilen Kapak & Tezgah</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-200 text-stone-700 bg-white">
            <tr class="hover:bg-stone-50 transition">
              <td class="p-3 sm:p-4 font-semibold text-stone-900">Kekliktepe & Yelaltı Lüks Villaları</td>
              <td class="p-3 sm:p-4">Geniş ada mutfaklar, bahçeye açılan cam cepheler, şaraplık ve kiler talebi.</td>
              <td class="p-3 sm:p-4">Çift sıralı şelale porselen ada tezgah, ahşap akustik paneller ve gizli kiler kapısı.</td>
              <td class="p-3 sm:p-4 font-medium text-emerald-800">Lamar Porselen / İpek Mat Fırın Lake</td>
            </tr>
            <tr class="hover:bg-stone-50 transition">
              <td class="p-3 sm:p-4 font-semibold text-stone-900">İskele & Çamlıçay Sahil Konutları</td>
              <td class="p-3 sm:p-4">Deniz tuzu spreyi, kış rutubeti, paslanma riski.</td>
              <td class="p-3 sm:p-4">Çift yüzlü yeşil marin MDF gövde, paslanmaz Avusturya Blum raylar ve UV korumalı lake.</td>
              <td class="p-3 sm:p-4 font-medium text-emerald-800">Belenco Kuvars / Paslanmaz Donanım</td>
            </tr>
            <tr class="hover:bg-stone-50 transition">
              <td class="p-3 sm:p-4 font-semibold text-stone-900">Bademler & Yağcılar Taş Ev ve Bağ Evleri</td>
              <td class="p-3 sm:p-4">Doğal taş duvarlar, düzensiz nişler, rustik ve sıcak Ege atmosferi ihtiyacı.</td>
              <td class="p-3 sm:p-4">Lazer rölöveyle taş duvara sıfır oturan masif meşe kapaklar ve seramik rustik evye.</td>
              <td class="p-3 sm:p-4 font-medium text-emerald-800">Country Doğal Ahşap / Porselen Tezgah</td>
            </tr>
            <tr class="hover:bg-stone-50 transition">
              <td class="p-3 sm:p-4 font-semibold text-stone-900">Urla Merkez & Yenikent Müstakil Daireler</td>
              <td class="p-3 sm:p-4">Kompakt alanlar, eskiyen su-elektrik tesisatı, banyo-mutfak ortak renovasyon.</td>
              <td class="p-3 sm:p-4">Komple kırım, Siemens sigortalı tesisat, tavana kadar boy dolap ve hilton banyo montajı.</td>
              <td class="p-3 sm:p-4 font-medium text-emerald-800">Akrilik Parlak / Çimstone Tezgah</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- GÖRSEL VE BÖLGESEL KANIT -->
  <section class="py-16 sm:py-20 bg-stone-50 border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      <div class="max-w-3xl space-y-3">
        <div class="text-[11px] font-black uppercase tracking-[0.2em] text-[#006039]">Urla Referans Projelerimiz</div>
        <h2 class="text-2xl sm:text-4xl font-light text-[#1D1D1F] tracking-tight" style="font-family: 'Playfair Display', Georgia, serif;">
          Urla'nın Doğasına Uyumlu <span class="font-bold">Özel Tasarımlar</span>
        </h2>
        <p class="text-sm text-[#6E675F] leading-relaxed">
          Urla taş evleri ve villaları için Buca atölyemizde ürettiğimiz doğal meşe ve lake dolapları inceleyin. Klasik ve country çizgiler için <a href="/klasik-country-mutfak-modelleri/" class="text-emerald-700 font-semibold underline underline-offset-4">country mutfak modellerimizi</a>, fiyat bilgileri için <a href="/2026-mutfak-dolabi-fiyatlari/" class="text-emerald-700 font-semibold underline underline-offset-4">2026 fiyat listemizi</a> veya <a href="/yapilan-isler/" class="text-emerald-700 font-semibold underline underline-offset-4">tamamlanan projelerimizi</a> inceleyin.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="group bg-white rounded-2xl overflow-hidden border border-stone-200 shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="aspect-[16/10] overflow-hidden bg-stone-900 relative">
            <img 
              src="/media/projeler/proje-20.webp" 
              alt="Urla Kekliktepe Taş Ev Özel Country Ahşap Mutfak Montajı" 
              width="1200"
              height="695"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-3 left-3 px-3 py-1 bg-emerald-600 text-white text-[10px] font-bold uppercase tracking-wider rounded">KEKLİKTEPE VİLLA PROJESİ</span>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="text-base font-bold text-stone-900">Kekliktepe Taş Ev Country Mutfak</h3>
            <p class="text-xs text-stone-600 leading-relaxed">Doğal meşe çıtalı country kapaklar, porselen evye ve taş duvara özel lazer gönye montajı.</p>
          </div>
        </div>

        <div class="group bg-white rounded-2xl overflow-hidden border border-stone-200 shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="aspect-[16/10] overflow-hidden bg-stone-900 relative">
            <img 
              src="/media/real/yesilay-mimari-danismanlik-toplanti-wide.webp" 
              alt="Urla Villa Müşterimizle Mimari Danışmanlık ve Malzeme Seçimi" 
              width="1200"
              height="675"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-3 left-3 px-3 py-1 bg-stone-900 text-emerald-400 border border-emerald-500/30 text-[10px] font-bold uppercase tracking-wider rounded">BİREBİR REHBERLİK</span>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="text-base font-bold text-stone-900">Urla Villalarına Özel 3D Tasarım</h3>
            <p class="text-xs text-stone-600 leading-relaxed">Mimarımızla birebir toplantıda renk kartelaları ve taş-ahşap uyumunu birlikte planlayın.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TEKNİK KANIT VE BÖLGESEL ÇÖZÜMLER -->
  <section class="py-16 sm:py-24 bg-white border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      <div class="max-w-3xl space-y-3">
        <div class="text-[11px] font-black uppercase tracking-[0.2em] text-[#006039]">Urla Bölgesi Zanaat Standartları</div>
        <h2 class="text-2xl sm:text-4xl font-light text-[#1D1D1F] tracking-tight" style="font-family: 'Playfair Display', Georgia, serif;">
          Doğal Taş ve Ahşabın <span class="font-bold">Kusursuz Uyumu</span>
        </h2>
        <p class="text-sm text-[#6E675F] leading-relaxed">
          Kekliktepe, Kalabak ve İskele bölgelerindeki müstakil yapılarda, yüksek tavanlar ve taş duvar boşluklarına özel milimetrik gömme kütüphane dolapları, ada mutfak üniteleri ve seramik döşemeler üretiyoruz. Komple tadilat projelerinde sıhhi tesisat ve elektrik altyapısı yenilenerek 15-20 iş gününde teslim edilir.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] space-y-3">
          <div class="text-2xl">🌿</div>
          <h3 class="text-base font-bold text-[#1D1D1F]">Doğal Ahşap & Meşe Kaplama</h3>
          <p class="text-xs text-[#6E675F] leading-relaxed">
            Urla'nın rustik ve sakin atmosferine uygun doğal meşe hareleri, fırın mat koruyucu vernik ve parmak izi bırakmayan yüzeyler.
          </p>
        </div>
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] space-y-3">
          <div class="text-2xl">💧</div>
          <h3 class="text-base font-bold text-[#1D1D1F]">Neme Dayanımlı Marin Gövde</h3>
          <p class="text-xs text-[#6E675F] leading-relaxed">
            Kış mevsiminde kapalı kalan yazlıklarda rutubet kaynaklı şişme yapmayan çift kat E1 yeşil MDF gövde garantisi.
          </p>
        </div>
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] space-y-3">
          <div class="text-2xl">🔨</div>
          <h3 class="text-base font-bold text-[#1D1D1F]">Tek Elden Mimari Taahhüt</h3>
          <p class="text-xs text-[#6E675F] leading-relaxed">
            Elektrik-su tesisatı, zemin seramiği, mutfak ve banyo montajının tek muhatap iç mimar kontrolünde yürütülmesi.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS -->
  <section class="py-16 bg-[#FAF9F6]">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-3xl font-light text-[#1D1D1F]" style="font-family: 'Playfair Display', Georgia, serif;">
          Urla Mutfak Tadilatı <span class="font-bold">Sıkça Sorulan Sorular</span>
        </h2>
        <p class="text-xs text-[#6E675F]">Urla ve Kekliktepe konut sahiplerinin en çok sorduğu sorular.</p>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="p-5 bg-white border border-[#E5DFD5] space-y-2">
            <h3 class="text-sm font-bold text-[#1D1D1F]">{faq.question}</h3>
            <p class="text-xs text-[#6E675F] leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
