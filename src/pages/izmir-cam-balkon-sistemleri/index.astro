---
import Layout from '../../layouts/Layout.astro';

const seoData = {
  title: 'İzmir Cam Balkon Sistemleri & Isıcamlı İmalat | Yeşilay Mutfak',
  description: 'İzmir genelinde katlanır, sürgülü ve motorlu giyotin ısıcamlı cam balkon sistemleri. Buca imalat güvencesi, su tahliye kanallı elektrostatik alüminyum profil ve temperli cam.',
  canonical: 'https://yesilaymutfak.com/izmir-cam-balkon-sistemleri/',
  openGraph: {
    title: 'İzmir Cam Balkon Sistemleri & Isıcamlı İmalat | Yeşilay Mutfak',
    description: 'Balkonunuzu 4 mevsim oturma alanına çevirin. Şişecam patentli ısıcamlı katlanır ve sürme cam balkon sistemleri Buca atölye fiyatıyla.',
    type: 'website',
    image: 'https://yesilaymutfak.com/media/cam-balkon/izmir-cambalkon.webp'
  }
};

const systems = [
  {
    title: 'Isıcamlı Katlanır Cam Balkon',
    tag: 'Maksimum Isı ve Ses Yalıtımı',
    desc: '4+16+4 mm veya 4+12+4 mm Şişecam Konfor ısıcam üniteleriyle balkonunuzu evin bir odası gibi kışın sıcak, yazın serin tutar. Rüzgar ve fırtınaya karşı tam sızdırmazlık.',
    features: ['Isıcam Konfor Patentli Cam', 'Çift Sıra İzolasyon Fitili', 'Paslanmaz Çelik Rulmanlar', '%85 Enerji Tasarrufu'],
    img: '/media/cam-balkon/katlanir-cambalkon.webp'
  },
  {
    title: 'Sürgülü (Sürme) Eşiksiz Sistemler',
    tag: 'Geniş Geçiş & Dar Alan Çözümü',
    desc: 'Zeminde ayak takılmasını önleyen alçak profilli eşikli veya tamamen eşiksiz alt ray mimarisi. Kafe, kış bahçesi veya dar balkonlarda alandan sıfır kayıp.',
    features: ['Eşiksiz Zemin Tasarımı', '8mm / 10mm Temperli Cam', 'Teleskopik Sürme Raylar', 'Kilitlenebilir Güvenlik Mandalları'],
    img: '/media/cam-balkon/surgulu-cambalkon.webp'
  },
  {
    title: 'Motorlu Giyotin Cam Balkon',
    tag: 'Uzaktan Kumandalı & Korkuluk Fonksiyonlu',
    desc: 'Tek tuşla yukarı veya aşağı hareket eden dikey kayar sistem. Açıldığında cam korkuluk (küpeşte) vazifesi görür, rüzgar korumalı otomatik konfor sunar.',
    features: ['Somfy / Becker Motor Seçenekleri', 'Uzaktan Kumandalı Kontrol', 'Ses İzolasyonlu Ağır Gövde', 'Güvenli Çift Çelik Halat Sistemi'],
    img: '/media/cam-balkon/giyotin-cambalkon.webp'
  },
  {
    title: 'Mimari Kış Bahçesi & Veranda',
    tag: 'Geniş Yaşam Alanları & Villalar',
    desc: 'Teras ve bahçeli evler için çatı karkasından cam cephesine kadar komple kış bahçesi projelendirmesi ve üretimi.',
    features: ['Statik Mukavemetli Çelik Karkas', 'Sandviç Panel veya Cam Tavan', 'Entegre LED Aydınlatma Kanalı', 'Yağmur Oluk ve Drenaj Sistemi'],
    img: '/media/cam-balkon/izmir-kis-bahcesi.webp'
  },
  {
    title: 'Biyoklimatik & Otomatik Pergola',
    tag: 'Gölgeleme & Yağmur Koruması',
    desc: 'Cam balkon sistemleriyle tam entegre çalışan, uzaktan kumandalı açılır-kapanır tavan tente ve lamel pergola sistemleri.',
    features: ['Alüminyum Döner Lameller', 'Otomatik Yağmur Sensörü', 'RGB Lineer Aydınlatma', '4 Mevsim Dış Mekan Konforu'],
    img: '/media/cam-balkon/izmir-pergola.webp'
  },
  {
    title: 'Özel Cam Balkon Plise Perde',
    tag: 'Güneş Kırıcı & Gizlilik Çözümü',
    desc: 'Her bir cam kanadına bağımsız monte edilen, yukarı ve aşağı çift yönlü hareket edebilen leke tutmaz plise perde çeşitleri.',
    features: ['İthal Kumaş & UV Filtreli', 'Kanatla Beraber Katlanan Mekanizma', 'Geniş Renk Kartelası', 'Yıkanabilir ve Toz Tutmaz'],
    img: '/media/cam-balkon/izmir-plise-perde.webp'
  }
];

const faqItems = [
  {
    q: 'İzmir rüzgarında cam balkon içeri su veya ses alır mı?',
    a: 'Yeşilay Mimarlık olarak kullandığımız ekstrüzyon alüminyum kasa profillerinde patentli eğimli su tahliye kanalları bulunur. Doğru montaj, EPDM kauçuk conta ve kıl fitil kombinasyonu sayesinde İzmirin şiddetli lodos ve sağanak yağışlarında kesinlikle içeri su almaz.'
  },
  {
    q: 'Katlanır cam balkon mu yoksa sürgülü cam balkon mu tercih edilmeli?',
    a: 'Balkonun tamamını açıp açık hava keyfi yaşamak isteyenler için katlanır sistem; zemininde eşik istemeyen, çocuklu veya dar balkona sahip olanlar için sürme (sürgülü) sistem tavsiye edilir. Keşif sırasında mimarımız balkonunuza en uygun sistemi belirler.'
  },
  {
    q: 'Isıcamlı cam balkon sistemi odayı sıcak tutar mı?',
    a: 'Evet, çift camlı (ısıcamlı) modeller tek cama kıyasla %80 e varan ısı yalıtımı sağlar. Balkonunu mutfakla birleştiren veya çalışma odası olarak kullanan müşterilerimizin tamamında Isıcam Konfor serisi uygulamaktayız.'
  },
  {
    q: 'Keşif, ölçü alımı ve montaj süresi kaç gündür?',
    a: 'İzmir içi lazerli keşif ve ölçü alımı 24 saat içinde yapılır. İmalat atölyemizde hazırlanan sistemler ortalama 7-10 iş günü içinde kendi bünyemizdeki uzman ekiplerce 1 günde monte edilir.'
  }
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': 'https://yesilaymutfak.com/izmir-cam-balkon-sistemleri/#service',
      name: 'İzmir Isıcamlı & Katlanır Cam Balkon Sistemleri İmalatı',
      serviceType: 'Cam Balkon Montaj ve İmalat Hizmeti',
      provider: {
        '@type': 'HomeAndConstructionBusiness',
        name: 'Yeşilay Mutfak & Mimarlık',
        telephone: '+902324411060',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Gaziler Mah. 1084/2 Sok. No: 1/A',
          addressLocality: 'Buca',
          addressRegion: 'İzmir',
          addressCountry: 'TR'
        }
      },
      areaServed: {
        '@type': 'City',
        name: 'İzmir'
      }
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://yesilaymutfak.com/izmir-cam-balkon-sistemleri/#faq',
      mainEntity: faqItems.map(item => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a
        }
      }))
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://yesilaymutfak.com/izmir-cam-balkon-sistemleri/#breadcrumb',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Ana Sayfa',
          item: 'https://yesilaymutfak.com/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Anahtar Teslim Tadilat',
          item: 'https://yesilaymutfak.com/izmir-anahtar-teslim-tadilat/'
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Cam Balkon Sistemleri',
          item: 'https://yesilaymutfak.com/izmir-cam-balkon-sistemleri/'
        }
      ]
    }
  ]
};
---

<Layout seo={seoData} activeService="cam-balkon">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- HERO SECTION -->
  <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 bg-[#15231C] text-white overflow-hidden">
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-emerald-600/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-cyan-600/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Breadcrumb -->
      <nav class="flex items-center space-x-2 text-xs text-stone-300/80 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Ana Sayfa</a>
        <span>/</span>
        <a href="/izmir-anahtar-teslim-tadilat/" class="hover:text-white transition">Anahtar Teslim Tadilat</a>
        <span>/</span>
        <span class="text-cyan-400 font-medium">Cam Balkon Sistemleri</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 text-cyan-300 text-xs font-semibold tracking-wider uppercase mb-5 backdrop-blur-sm border border-white/10">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
            İzmir Buca İmalatı • Şişecam Patentli Isıcamlı Sistemler
          </div>

          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight mb-6">
            İzmir <span class="text-cyan-400">Cam Balkon</span> & Isıcamlı Katlanır Sistemler
          </h1>

          <p id="hero-answer-engine" class="text-stone-300 text-base sm:text-lg leading-relaxed mb-8 speakable-content">
            Balkonunuzu İzmirin sert rüzgarına ve tozuna karşı kapatarak evinizin en keyifli 4 mevsim yaşam odasına dönüştürün. Paslanmaz çelik rulmanlar, çift fitilli sızdırmazlık mimarisi ve Buca atölyemizden doğrudan üretici fiyatı güvencesiyle.
          </p>

          <div class="flex flex-wrap items-center gap-4">
            <a
              href="https://wa.me/905324261788?text=Merhaba%20Ye%C5%9Filay%20Mutfak%2C%20%C4%B0zmir%20cam%20balkon%20sistemleri%20fiyat%C4%B1%20ve%20%C3%BCcretsiz%20ke%C5%9Fif%20hakk%C4%B1nda%20bilgi%20almak%20istiyorum."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-6 py-3.5 bg-[#006039] hover:bg-[#004e2e] text-white font-bold rounded-xl text-sm transition shadow-lg shadow-emerald-900/40 gap-2"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
              Lazerli Keşif & Teklif İste
            </a>
            <a
              href="tel:+902324411060"
              class="inline-flex items-center justify-center px-6 py-3.5 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-xl text-sm transition backdrop-blur-sm border border-white/15 gap-2"
            >
              <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              0232 441 10 60
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="bg-white/10 backdrop-blur-md p-6 sm:p-8 rounded-2xl border border-white/15 shadow-2xl">
            <h3 class="text-lg font-bold text-white mb-2">Cam Balkon Hızlı Fiyat & Keşif Formu</h3>
            <p class="text-xs text-stone-300 mb-6">Ölçülerinizi girin, mimarımız 15 dakikada geri dönüş sağlasın.</p>
            <form id="cbFormDirect" class="space-y-4" onsubmit="event.preventDefault(); const n = document.getElementById('cbName').value; const p = document.getElementById('cbPhone').value; const t = document.getElementById('cbType').value; const w = window.open('https://wa.me/905324261788?text=' + encodeURIComponent('İzmir Cam Balkon Keşif Talebi: ' + n + ' - ' + p + ' - Tercih: ' + t), '_blank');">
              <div>
                <label class="block text-xs font-semibold text-stone-200 mb-1">Adınız Soyadınız</label>
                <input id="cbName" type="text" required placeholder="Örn: Kemal Yılmaz" class="w-full px-3.5 py-2.5 rounded-xl bg-white/20 border border-white/20 text-white placeholder-stone-400 text-sm focus:outline-none focus:border-cyan-400" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-stone-200 mb-1">Telefon Numaranız</label>
                <input id="cbPhone" type="tel" required placeholder="05XX XXX XX XX" class="w-full px-3.5 py-2.5 rounded-xl bg-white/20 border border-white/20 text-white placeholder-stone-400 text-sm focus:outline-none focus:border-cyan-400" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-stone-200 mb-1">İstediğiniz Sistem</label>
                <select id="cbType" class="w-full px-3.5 py-2.5 rounded-xl bg-stone-900 border border-white/20 text-white text-sm focus:outline-none focus:border-cyan-400">
                  <option value="Isıcamlı Katlanır Cam Balkon">Isıcamlı Katlanır Cam Balkon</option>
                  <option value="Standart Katlanır Cam Balkon (8mm/10mm)">Standart Katlanır Cam Balkon (8mm/10mm)</option>
                  <option value="Sürgülü Eşiksiz Cam Balkon">Sürgülü Eşiksiz Cam Balkon</option>
                  <option value="Motorlu Giyotin Cam Balkon">Motorlu Giyotin Cam Balkon</option>
                  <option value="Kış Bahçesi / Teras Kapama">Kış Bahçesi / Teras Kapama</option>
                </select>
              </div>
              <button type="submit" class="w-full py-3 bg-cyan-600 hover:bg-cyan-500 text-white font-bold rounded-xl text-sm transition shadow-lg">
                Ücretsiz Keşif Randevusu Oluştur
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SYSTEMS SHOWCASE -->
  <section class="py-16 sm:py-24 bg-[#FAF9F6]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-[#006039] bg-emerald-50 px-3 py-1 rounded-full border border-emerald-100">
          MİMARİ ÇÖZÜMLER
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-[#15231C] mt-3 mb-4">
          İzmir Mekanlarına Özel 6 Farklı Cam Balkon Sistemi
        </h2>
        <p class="text-sm sm:text-base text-stone-600 leading-relaxed">
          İzmirin değişken rüzgar yükü ve güneş açısına göre dizayn edilmiş, paslanmaz donanımlı ve yüksek mukavemetli cam balkon modellerimiz.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {systems.map((s) => (
          <div class="bg-white rounded-2xl overflow-hidden border border-stone-200/80 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col">
            <div class="relative aspect-[16/10] bg-stone-100 overflow-hidden">
              <img
                src={s.img}
                alt={}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                width="480"
                height="300"
              />
              <div class="absolute top-3 left-3 bg-[#15231C]/85 backdrop-blur-sm text-cyan-300 px-2.5 py-1 rounded-lg text-xs font-semibold">
                {s.tag}
              </div>
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-lg font-bold text-[#15231C] mb-2">{s.title}</h3>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed mb-4">{s.desc}</p>
                <div class="space-y-1.5 mb-6">
                  {s.features.map(f => (
                    <div class="flex items-center gap-2 text-xs text-stone-700">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#006039]"></span>
                      <span>{f}</span>
                    </div>
                  ))}
                </div>
              </div>

              <a
                href={}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center px-4 py-2.5 bg-[#006039] hover:bg-[#004e2e] text-white text-xs font-bold rounded-xl transition gap-1.5 shadow-sm"
              >
                Bu Sistem İçin Fiyat Al
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TECHNICAL ADVANTAGE -->
  <section class="py-16 sm:py-24 bg-[#15231C] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-cyan-400 bg-white/10 px-3 py-1 rounded-full">
            TEKNİK STANDARTLAR
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold mt-4 mb-6 leading-tight">
            Neden Yeşilay Mutfak Cam Balkon Sistemleri?
          </h2>
          <p class="text-stone-300 text-sm sm:text-base leading-relaxed mb-6">
            Piyasadaki ucuz cam balkonların en büyük sorunu 1 yıl sonra tekerleklerin paslanması, kanatların sarkması ve cam arasından içeri rüzgar/ıslık sesi almasıdır. Yeşilay Mimarlık standartları bu sorunları kökten engeller:
          </p>
          <div class="space-y-4">
            <div class="flex items-start gap-3 bg-white/5 p-4 rounded-xl border border-white/10">
              <div class="text-cyan-400 font-bold text-lg">🛡️</div>
              <div>
                <h4 class="font-bold text-sm text-white">Paslanmaz Çelik Gövdeli Rulmanlar</h4>
                <p class="text-xs text-stone-300 mt-0.5">Plastik veya sarı rulman değil; deniz tuzu ve neme karşı %100 paslanmaz rulmanlar kullanıyoruz.</p>
              </div>
            </div>
            <div class="flex items-start gap-3 bg-white/5 p-4 rounded-xl border border-white/10">
              <div class="text-cyan-400 font-bold text-lg">🌊</div>
              <div>
                <h4 class="font-bold text-sm text-white">Eğimli Su Tahliye Havuzcukları</h4>
                <p class="text-xs text-stone-300 mt-0.5">Balkon tavanından veya camdan süzülen yağmur suyu gizli tahliye deliklerinden dışarı aktarılır.</p>
              </div>
            </div>
            <div class="flex items-start gap-3 bg-white/5 p-4 rounded-xl border border-white/10">
              <div class="text-cyan-400 font-bold text-lg">🔇</div>
              <div>
                <h4 class="font-bold text-sm text-white">Çift Sıra EPDM Conta & Manyetik Fitil</h4>
                <p class="text-xs text-stone-300 mt-0.5">Zamanla sararan ve kırılan şeffaf plastik fitiller yerine alüminyum ve manyetik fitil uygulanır.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl border-4 border-stone-800">
            <img
              src="/media/cam-balkon/izmir-cambalkon.webp"
              alt="İzmir Lüks Konut Cam Balkon Uygulaması"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section class="py-16 sm:py-24 bg-white border-t border-stone-200/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-[#006039] bg-emerald-50 px-3 py-1 rounded-full border border-emerald-100">
          SIKÇA SORULAN SORULAR
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#15231C] mt-3">
          Cam Balkon Hakkında Merak Edilenler
        </h2>
      </div>

      <div class="space-y-4">
        {faqItems.map((item) => (
          <details class="group bg-[#FAF9F6] rounded-xl p-5 border border-stone-200/80 open:border-cyan-600 transition">
            <summary class="font-bold text-sm sm:text-base text-[#15231C] cursor-pointer flex items-center justify-between list-none">
              <span>{item.q}</span>
              <span class="text-cyan-600 text-xl transition-transform group-open:rotate-45 font-light">+</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-stone-600 leading-relaxed border-t border-stone-200/50 pt-3">
              {item.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="py-16 bg-[#15231C] text-white text-center relative overflow-hidden">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-4">
        Balkonunuz İçin Ücretsiz Lazerli Keşif Alın
      </h2>
      <p class="text-stone-300 text-sm sm:text-base mb-8 max-w-xl mx-auto">
