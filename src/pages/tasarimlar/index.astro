  <!-- Arama, Filtre ve Modal Scripti -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const searchInput = document.getElementById("searchInput");
      const clearBtn = document.getElementById("clearSearch");
      const filterBtns = document.querySelectorAll(".filter-btn");
      const cards = document.querySelectorAll(".model-card");
      const noResults = document.getElementById("noResults");
      const resetBtn = document.getElementById("resetBtn");

      const modal = document.getElementById("lightboxModal");
      const closeModal = document.getElementById("closeModal");
      const modalImg = document.getElementById("modalImg");
      const modalTitle = document.getElementById("modalTitle");
      const modalCategory = document.getElementById("modalCategory");
      const modalModelNo = document.getElementById("modalModelNo");
      const modalDesc = document.getElementById("modalDesc");
      const modalWhatsappBtn = document.getElementById("modalWhatsappBtn");

      // =========================================================================
      // DİNAMİK INTERSECTION OBSERVER LAZY LOAD MOTORU (Preload Scanner Koruması)
      // =========================================================================
      const progressiveImages = document.querySelectorAll(".lazy-progressive-img");

      function loadProgressiveImg(img) {
        if (!img) return;
        const realSrc = img.getAttribute("data-src");
        if (!realSrc || img.src === realSrc) return;

        const preloader = new Image();
        preloader.onload = () => {
          img.src = realSrc;
          img.classList.remove("opacity-0");
        };
        preloader.src = realSrc;
      }

      let imageObserver = null;
      if ("IntersectionObserver" in window) {
        imageObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const targetImg = entry.target;
              loadProgressiveImg(targetImg);
              observer.unobserve(targetImg);
            }
          });
        }, {
          rootMargin: "250px 0px", // Kullanıcı yaklaşınca 250px önden yükleme
          threshold: 0.01
        });

        progressiveImages.forEach((img) => imageObserver.observe(img));
      } else {
        // Fallback: Eski tarayıcılarda doğrudan yükle
        progressiveImages.forEach(loadProgressiveImg);
      }

      // Filtreleme / arama yapıldığında ekrana yeni giren kartları anında tarayan tetikleyici
      function checkVisibleLazyImages() {
        if (!imageObserver) return;
        progressiveImages.forEach((img) => {
          const card = img.closest(".model-card");
          if (card && card.style.display !== "none") {
            const rect = card.getBoundingClientRect();
            if (rect.top < window.innerHeight + 400 && rect.bottom > -200) {
              loadProgressiveImg(img);
              imageObserver.unobserve(img);
            }
          }
        });
      }

      const urlParams = new URLSearchParams(window.location.search);
      const initialCat = urlParams.get("kategori");
      const currentHash = window.location.hash;
      let currentFilter = "all";

      if (currentHash === "#kahve-kosesi" || initialCat === "kahve-kosesi" || initialCat === "kahve") {
        currentFilter = "kahve-kosesi";
      } else if (initialCat) {
        if (initialCat === "mutfak") {
          // If hash is #kahve-kosesi, prioritize kahve
          if (currentHash === "#kahve-kosesi") {
            currentFilter = "kahve-kosesi";
          } else {
            currentFilter = "mutfak-tasarimlari";
          }
        }
        else if (initialCat === "kapilar" || initialCat === "kapi") currentFilter = "kapilar";
        else if (initialCat === "gomme-dolap" || initialCat === "gardrop") currentFilter = "gomme-dolap";
        else if (initialCat === "banyo") currentFilter = "banyo-dolaplari";
      }

      let currentQuery = "";
      if (currentFilter !== "all") {
        filterBtns.forEach(b => {
          if (b.getAttribute("data-filter") === currentFilter) {
            b.className = "filter-btn px-3 py-1.5 transition border-b-2 border-[#006039] text-[#1E1810] font-bold";
          } else {
            b.className = "filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]";
          }
        });
        filterCards();
      }

      const kahveSection = document.getElementById("kahve-kosesi");
      const kahveCards = document.querySelectorAll(".kahve-card");
      const standardGrid = document.getElementById("modelsGrid");

      function filterCards() {
        let count = 0;
        let kahveCount = 0;

        // Kahve kartları filtrelemesi
        kahveCards.forEach((kCard) => {
          const title = (kCard.getAttribute("data-title") || "").toLowerCase();
          const id = (kCard.getAttribute("data-id") || "").toLowerCase();
          const matchesQuery = !currentQuery || title.includes(currentQuery) || id.includes(currentQuery);
          const isKahveActive = currentFilter === "all" || currentFilter === "kahve-kosesi" || currentFilter === "mutfak-tasarimlari";

          if (isKahveActive && matchesQuery) {
            kCard.style.display = "";
            kahveCount++;
          } else {
            kCard.style.display = "none";
          }
        });

        if (kahveSection) {
          if (currentFilter === "kahve-kosesi") {
            kahveSection.style.display = "";
            if (standardGrid) standardGrid.style.display = "none";
          } else if (currentFilter === "all" || currentFilter === "mutfak-tasarimlari") {
            kahveSection.style.display = "";
            if (standardGrid) standardGrid.style.display = "";
          } else {
            kahveSection.style.display = "none";
            if (standardGrid) standardGrid.style.display = "";
          }
        }

        // Standart model kartları filtrelemesi
        cards.forEach((card) => {
          const cat = card.getAttribute("data-category");
          const model = card.getAttribute("data-model");
          const title = card.getAttribute("data-title");
          const kw = card.getAttribute("data-keywords") || "";
          const desc = card.getAttribute("data-desc") || "";

          const matchesCat = currentFilter === "all" || cat === currentFilter;
          const matchesQuery = !currentQuery || 
            model.includes(currentQuery) || 
            title.includes(currentQuery) || 
            kw.includes(currentQuery) || 
            desc.includes(currentQuery);

          if (currentFilter === "kahve-kosesi") {
            card.style.display = "none";
          } else if (matchesCat && matchesQuery) {
            card.style.display = "";
            count++;
          } else {
            card.style.display = "none";
          }
        });

        const totalVisible = (currentFilter === "kahve-kosesi" ? kahveCount : count + (currentFilter === "all" || currentFilter === "mutfak-tasarimlari" ? kahveCount : 0));

        if (noResults) {
          if (totalVisible === 0) {
            noResults.classList.remove("hidden");
          } else {
            noResults.classList.add("hidden");
          }
        }

        setTimeout(checkVisibleLazyImages, 50);
      }

      // Canlı arama
      searchInput?.addEventListener("input", (e) => {
        currentQuery = e.target.value.toLowerCase().trim();
        if (clearBtn) {
          if (currentQuery.length > 0) {
            clearBtn.classList.remove("hidden");
          } else {
            clearBtn.classList.add("hidden");
          }
        }
        filterCards();
      });

      // Temizle
      clearBtn?.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        currentQuery = "";
        clearBtn.classList.add("hidden");
        filterCards();
        searchInput?.focus();
      });

      // Sıfırla
      resetBtn?.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        currentQuery = "";
        clearBtn?.classList.add("hidden");
        currentFilter = "all";
        filterBtns.forEach(btn => {
          if (btn.getAttribute("data-filter") === "all") {
            btn.className = "filter-btn px-3 py-1.5 transition border-b-2 border-[#006039] text-[#1E1810] font-bold";
          } else {
            btn.className = "filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]";
          }
        });
        filterCards();
      });

      // Kategori filtreleri
      filterBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          filterBtns.forEach(b => {
            b.className = "filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]";
          });
          btn.className = "filter-btn px-3 py-1.5 transition border-b-2 border-[#006039] text-[#1E1810] font-bold";
          currentFilter = btn.getAttribute("data-filter");
          filterCards();
        });
      });

      // Modal açma
      cards.forEach((card) => {
        card.addEventListener("click", () => {
          const img = card.getAttribute("data-img");
          const title = card.getAttribute("data-title-raw");
          const category = card.getAttribute("data-category-name");
          const modelNo = card.getAttribute("data-model-id");

          const desc = card.getAttribute("data-desc") || "";
          if (modalImg) modalImg.src = img;
          if (modalTitle) modalTitle.textContent = title;
          if (modalCategory) modalCategory.textContent = category;
          if (modalModelNo) modalModelNo.textContent = modelNo;
          if (modalDesc) modalDesc.textContent = desc;

          const whatsappText = encodeURIComponent(`Merhaba, web sitenizdeki ${modelNo} (${title} - ${category}) modelini beğendim. Kendi evim için özel ölçü rölöve ve 3D çizim projelendirmesi hakkında bilgi almak istiyorum.`);
          if (modalWhatsappBtn) modalWhatsappBtn.href = `https://wa.me/905324261788?text=${whatsappText}`;

          if (modal) {
            modal.classList.remove("hidden");
            modal.classList.add("flex");
            document.body.style.overflow = "hidden";
          }
        });
      });

      // Modal kapatma
      function closeLightbox() {
        if (modal) {
          modal.classList.add("hidden");
          modal.classList.remove("flex");
          document.body.style.overflow = "";
        }
      }

      closeModal?.addEventListener("click", closeLightbox);
      modal?.addEventListener("click", (e) => {
        if (e.target === modal) closeLightbox();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
          closeLightbox();
        }
      });
    });
  </script>

<style>
  .model-card {
    content-visibility: auto;
    contain-intrinsic-size: 380px;
  }
</style>

</Layout>


  <script is:inline>
    // Kahve Köşesi Kart Slider Görsel Değiştirme Fonksiyonu
    window.changeCardImage = function(cardId, targetIdx) {
      const slider = document.getElementById(`slider-${cardId}`);
      if (!slider) return;
      const images = slider.querySelectorAll(".kahve-slide-img");
      const dots = document.querySelectorAll(`.slider-dot[data-card="${cardId}"]`);

      images.forEach((img, i) => {
        if (i === targetIdx) {
          const realSrc = img.getAttribute("data-src");
          if (realSrc && img.src !== realSrc) img.src = realSrc;
          img.classList.remove("opacity-0", "z-0");
          img.classList.add("opacity-100", "z-10");
        } else {
          img.classList.remove("opacity-100", "z-10");
          img.classList.add("opacity-0", "z-0");
        }
      });

      dots.forEach((dot, i) => {
        if (i === targetIdx) {
          dot.className = "slider-dot w-4 h-2 rounded-full transition-all duration-200 bg-white";
        } else {
          dot.className = "slider-dot w-2 h-2 rounded-full transition-all duration-200 bg-white/60 hover:bg-white";
        }
      });
    };

    // Kahve Köşesi Lightbox Açma Fonksiyonu
    window.openKahveModalDirect = function(cardId) {
      const card = document.querySelector(`.kahve-card[data-id="${cardId}"]`);
      if (!card) return;
      const title = card.getAttribute("data-title") || "";
      const img = card.getAttribute("data-img") || "";

      const modal = document.getElementById("lightboxModal");
      const modalImg = document.getElementById("modalImg");
      const modalTitle = document.getElementById("modalTitle");
      const modalCategory = document.getElementById("modalCategory");
      const modalModelNo = document.getElementById("modalModelNo");
      const modalDesc = document.getElementById("modalDesc");
      const modalWhatsappBtn = document.getElementById("modalWhatsappBtn");

      if (modalImg) modalImg.src = img;
      if (modalTitle) modalTitle.textContent = title;
      if (modalCategory) modalCategory.textContent = "Barista Kahve İstasyonu";
      if (modalModelNo) modalModelNo.textContent = cardId.replace("kahve-kosesi-", "KK-").toUpperCase();
      if (modalDesc) modalDesc.textContent = "%100 Terzi Usulü Özel İmalat: Mekanınızın tavan yüksekliğine, duvar genişliğine ve kahve makinesi/aksesuarlarınıza göre Buca atölyemizde üretilir.";

      const msg = encodeURIComponent(`Merhaba Yeşilay Mutfak & Mimarlık, ${title} (${cardId}) barista kahve köşesi modelini beğendim. Kendi evim için özel ölçü fiyat teklifi ve 3D çizim talep ediyorum.`);
      if (modalWhatsappBtn) modalWhatsappBtn.href = `https://wa.me/905324261788?text=${msg}`;

      if (modal) {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
      }
    };

    // Sayfa açılışında hash kontrolü (#kahve-kosesi)
    window.addEventListener("DOMContentLoaded", () => {
      if (window.location.hash === "#kahve-kosesi") {
        const btn = document.getElementById("btn-kahve-kosesi");
        if (btn) btn.click();
        const section = document.getElementById("kahve-kosesi");
        if (section) {
          setTimeout(() => {
            section.scrollIntoView({ behavior: "smooth", block: "start" });
          }, 150);
        }
      }
    });
  </script>
