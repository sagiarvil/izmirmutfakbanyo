---
import Layout from "../../layouts/Layout.astro";
import tasarimlar from "../../data/tasarimlarData.json";
import kahveKosesiData from "../../data/kahveKosesiData.json";

const seo = {
  title: "Tasarımlar & Yapılan İşler | 137 Özel İmalat Model Kataloğu | İzmir Mutfak",
  description: "Yeşilay Mutfak & Mimarlık atölyemizde üretilen 137 tescilli mutfak dolabı, lake iç oda kapısı, banyo dolabı ve gömme dolap modeli. Model numarası veya tarz arayarak 3D keşif isteyin.",
  canonical: "https://yesilaymutfak.com/tasarimlar/",
  serviceName: "Tasarımlar ve Yapılan İşler Model Kataloğu",
  breadcrumbs: [
    { name: "Ana Sayfa", url: "/" },
    { name: "Tasarımlar & Yapılan İşler", url: "/tasarimlar/" }
  ]
};

const kahveCount = kahveKosesiData.length;
const totalCount = tasarimlar.length + kahveCount;
const kitchenCount = tasarimlar.filter(t => t.category === "Mutfak Tasarımları").length;
const doorCount = tasarimlar.filter(t => t.category === "Kapılar").length;
const wardrobeCount = tasarimlar.filter(t => t.category === "Gömme Dolap").length;
const bathCount = tasarimlar.filter(t => t.category === "Banyo Dolapları").length;

// Google, Google Görseller & LLM Botları İçin Schema.org ImageGallery & ItemList
const schemaImageGallery = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": "Yeşilay Mutfak Özel Tasarım ve İmalat Model Kataloğu",
  "description": "Buca imalat atölyemizde üretilen 137 tescilli mutfak dolabı, lake iç oda kapısı, banyo dolabı ve gömme dolap modeli.",
  "url": "https://yesilaymutfak.com/tasarimlar/",
  "publisher": {
    "@type": "HomeAndConstructionBusiness",
    "name": "Yeşilay Mutfak & Mimarlık",
    "url": "https://yesilaymutfak.com",
    "telephone": "+902324411060",
    "areaServed": "İzmir",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Buca",
      "addressRegion": "İzmir",
      "addressCountry": "TR"
    }
  },
  "itemListElement": tasarimlar.map((item, idx) => ({
    "@type": "ImageObject",
    "position": idx + 1,
    "name": item.seoTitle,
    "caption": item.altText,
    "description": item.aiDescription,
    "keywords": item.keywords.join(", "),
    "contentUrl": `https://yesilaymutfak.com${item.img}`,
    "thumbnailUrl": `https://yesilaymutfak.com${item.img}`,
    "representativeOfPage": false,
    "creator": {
      "@type": "Organization",
      "name": "Yeşilay Mutfak & Mimarlık"
    }
  }))
};
---

<Layout seo={seo}>
  <!-- Google & LLM Botları İçin Zengin Yapısal Veri (UI Tasarımını Etkilemez) -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaImageGallery)} />

  <!-- Sayfa Üst Başlığı (Yeşilay Mutfak Standartı - Sade, Lüks, Sıcak Kırık Beyaz) -->
  <section class="bg-[#F8F7F3] border-b border-stone-200/80 pt-6 sm:pt-8 pb-5 sm:pb-6 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto text-center space-y-3">
      <h1 class="text-3xl sm:text-5xl font-serif font-bold text-[#1E1810] tracking-tight">
        Tasarımlar
      </h1>
      <p class="text-xs sm:text-sm text-stone-500 max-w-xl mx-auto font-normal">
        Özel üretim mutfak, kapı, banyo ve gömme dolap portfolyomuz. Model numarası veya aradığınız tarzı yazarak anında bulabilirsiniz.
      </p>

      <!-- Model Numarası & Arama Çubuğu (Genişletilmiş Ticari Arama) -->
      <div class="pt-2 max-w-md mx-auto">
        <div class="relative flex items-center bg-white border border-stone-300 shadow-xs focus-within:border-[#006039] transition">
          <div class="pl-3.5 text-stone-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Model No veya tarz ile ara (Örn: Model 46, Ada Mutfak, Lake...)" 
            class="w-full py-2.5 px-2.5 bg-transparent text-stone-900 placeholder-stone-400 text-xs sm:text-sm font-medium focus:outline-none"
            autocomplete="off"
          />
          <button 
            type="button" 
            id="clearSearch" 
            class="hidden pr-3 text-stone-400 hover:text-stone-700 text-[11px] font-bold tracking-wider uppercase"
          >
            Temizle
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Kategori Filtreleri (Yeşilay Mutfak Birebir Filtre Dizilimi) -->
  <section class="bg-white border-b border-stone-200 sticky top-16 z-30 shadow-xs">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex items-center justify-center gap-1 sm:gap-4 flex-wrap text-xs sm:text-sm font-medium">
        <button 
          type="button" 
          class="filter-btn px-3 py-1.5 transition border-b-2 border-[#006039] text-[#1E1810] font-bold" 
          data-filter="all"
        >
          Tümü ({totalCount})
        </button>
        <button 
          type="button" 
          class="filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]" 
          data-filter="mutfak-tasarimlari"
        >
          Mutfak Tasarımları ({kitchenCount})
        </button>
        <button 
          type="button" 
          class="filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-amber-900/80 hover:text-amber-950 flex items-center gap-1.5 font-medium" 
          data-filter="kahve-kosesi"
          id="btn-kahve-kosesi"
        >
          <span>☕ Kahve Köşesi ({kahveCount})</span>
          <span class="px-1.5 py-0.2 text-[9px] font-bold bg-amber-100 text-amber-900 rounded-full uppercase tracking-tighter">Yeni</span>
        </button>
        <button 
          type="button" 
          class="filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]" 
          data-filter="kapilar"
        >
          Kapılar ({doorCount})
        </button>
        <button 
          type="button" 
          class="filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]" 
          data-filter="gomme-dolap"
        >
          Gömme Dolap ({wardrobeCount})
        </button>
        <button 
          type="button" 
          class="filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]" 
          data-filter="banyo-dolaplari"
        >
          Banyo Dolapları ({bathCount})
        </button>
      </div>
    </div>
  </section>

  <!-- YENİ MODEL KOLEKSİYONLARI ÖZEL KART ŞERİDİ -->
  <section class="bg-[#F3EFEA] border-b border-[#E5E2DA] py-4 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2 text-xs font-bold text-[#15231C]">
          <span class="p-1 bg-[#C5A880] text-white rounded text-[10px]">YENİ</span>
          <span>Özel Mimari Koleksiyonlar:</span>
        </div>
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <a href="/yatak-odasi-modelleri/" class="px-3 py-1.5 bg-white hover:bg-[#FAF9F6] text-[#15231C] font-semibold rounded-lg border border-[#E5E2DA] hover:border-[#006039] transition flex items-center gap-1.5">
            <span>Yatak Odası</span>
            <span class="text-[#006039] font-bold">(99)</span>
          </a>
          <a href="/salon-modelleri/" class="px-3 py-1.5 bg-white hover:bg-[#FAF9F6] text-[#15231C] font-semibold rounded-lg border border-[#E5E2DA] hover:border-[#006039] transition flex items-center gap-1.5">
            <span>Salon & TV Ünitesi</span>
            <span class="text-[#006039] font-bold">(68)</span>
          </a>
          <a href="/genc-odasi-modelleri/" class="px-3 py-1.5 bg-white hover:bg-[#FAF9F6] text-[#15231C] font-semibold rounded-lg border border-[#E5E2DA] hover:border-[#006039] transition flex items-center gap-1.5">
            <span>Genç Odası</span>
            <span class="text-[#006039] font-bold">(92)</span>
          </a>
          <a href="/cocuk-odasi-modelleri/" class="px-3 py-1.5 bg-white hover:bg-[#FAF9F6] text-[#15231C] font-semibold rounded-lg border border-[#E5E2DA] hover:border-[#006039] transition flex items-center gap-1.5">
            <span>Çocuk Odası</span>
            <span class="text-[#006039] font-bold">(45)</span>
          </a>
          <a href="/camasir-odasi-modelleri/" class="px-3 py-1.5 bg-white hover:bg-[#FAF9F6] text-[#15231C] font-semibold rounded-lg border border-[#E5E2DA] hover:border-[#006039] transition flex items-center gap-1.5">
            <span>Çamaşır Odası</span>
            <span class="text-[#006039] font-bold">(9)</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Yeşilay Mutfak Birebir KARE KUTULAR Portfolyo Galerisi (1:1 Aspect Ratio & 15px Boşluk) -->
  <section class="py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto min-h-[70vh]">
    <div id="modelsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[15px]">
      {tasarimlar.map((item, idx) => (
        <figure 
          class="model-card group relative aspect-square w-full bg-stone-100 overflow-hidden cursor-pointer shadow-xs"
          data-category={item.categorySlug}
          data-model={item.modelNo.toLowerCase()}
          data-title={item.title.toLowerCase()}
          data-keywords={item.keywords.join(" ").toLowerCase()}
          data-desc={item.aiDescription.toLowerCase()}
          data-category-name={item.category}
          data-img={item.img}
          data-model-id={item.modelNo}
          data-title-raw={item.title}
          itemscope 
          itemtype="https://schema.org/ImageObject"
        >
          <!-- 1:1 Tam Kare Görsel (İlk 6 Model Eager LCP, Sonraki 131 Model Gerçek IntersectionObserver + Data-Src) -->
          {idx < 6 ? (
            <img 
              src={item.img} 
              alt={item.altText} 
              title={item.seoTitle}
              loading="eager" 
              decoding="async"
              fetchpriority="high"
              width="600"
              height="600"
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-106"
              itemprop="contentUrl"
            />
          ) : (
            <>
              <img 
                src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 600 600'%3E%3Crect width='100%25' height='100%25' fill='%23f5f5f4'/%3E%3C/svg%3E"
                data-src={item.img} 
                alt={item.altText} 
                title={item.seoTitle}
                loading="lazy" 
                decoding="async"
                fetchpriority="low"
                width="600"
                height="600"
                class="lazy-progressive-img w-full h-full object-cover transition-all duration-700 ease-out group-hover:scale-106 opacity-0"
                itemprop="contentUrl"
              />
              <noscript>
                <img src={item.img} alt={item.altText} width="600" height="600" class="w-full h-full object-cover" />
              </noscript>
            </>
          )}

          <!-- Google & AI Botları İçin Semantik W3C sr-only Katmanı (Görsel Tasarımı Asla Bozmaz) -->
          <div class="sr-only">
            <h2 itemprop="name">{item.seoTitle}</h2>
            <p itemprop="description">{item.aiDescription}</p>
            <span itemprop="keywords">{item.keywords.join(", ")}</span>
          </div>

          <!-- Sol Üst Köşe Model No Rozeti (Kullanıcı Her Zaman Görsün) -->
          <div class="absolute top-3 left-3 z-10 pointer-events-none">
            <span class="px-2 py-1 bg-stone-950/85 text-[#C5A880] font-mono text-xs font-bold tracking-wider uppercase border border-[#006039]/60 bg-[#042015]/90 backdrop-blur-xs">
              {item.modelNo}
            </span>
          </div>

          <!-- Yeşilay Mutfak Birebir Fly Overlay (Hover Durumunda Açılan Amber Katman) -->
          <figcaption class="absolute inset-0 bg-[#006039]/92 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center text-center p-6 text-white z-20 pointer-events-none backdrop-blur-xs">
            <span class="text-xs font-semibold tracking-widest uppercase text-white/90 mb-1 text-[11px] font-bold">
              {item.category}
            </span>
            <div class="text-lg sm:text-xl font-serif font-bold text-white leading-tight max-w-xs font-bold">
              {item.title}
            </div>
            <div class="mt-4 inline-flex items-center gap-1.5 px-4 py-2 bg-[#0E2017] text-white text-xs font-bold uppercase tracking-wider shadow-md">
              <span>İncele &bull; 3D Çizdir</span>
              <span>&rarr;</span>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>


  <!-- ========================================================================= -->
  <!-- #KAHVE-KÖŞESİ: ÖZEL İMALAT BARİSTA KAHVE İSTASYONLARI & DOLAP MODELLERİ -->
  <!-- ========================================================================= -->
  <section id="kahve-kosesi" class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto scroll-mt-28">
    
    <!-- Kahve Köşesi Özel Mimari Hero Banner -->
    <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-[#1c140d] via-[#2d2218] to-[#120e0a] text-white p-8 sm:p-12 mb-10 shadow-xl border border-amber-900/40">
      <div class="absolute -right-24 -bottom-24 w-96 h-96 bg-amber-600/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-950/80 border border-amber-500/40 text-amber-300 text-[11px] font-bold tracking-widest uppercase">
          <span>☕ YEŞİLAY ÖZEL ATÖLYE İMALATI</span>
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
          <span>%100 TERZİ USULÜ ÖLÇÜ</span>
        </div>
        
        <h2 class="text-3xl sm:text-5xl font-light text-white tracking-tight leading-tight" style="font-family: 'Playfair Display', Georgia, serif;">
          Mutfak &amp; Yaşam Alanlarına Özel <br />
          <span class="font-normal italic text-amber-200">Barista Kahve Köşesi Tasarımları</span>
        </h2>
        
        <p class="text-xs sm:text-sm text-stone-300 font-light leading-relaxed max-w-2xl">
          Evinize İtalyan kafe şıklığını taşıyan, fincan askılıkları, kapsül düzenleyiciler, temperli füme cam vitrinler ve entegre LED ambiyans aydınlatmalarıyla donatılmış 60 tescilli barista kahve istasyonu. Ölçünüze, mutfak renk kodunuza ve cihazlarınıza göre sıfırdan milimetrik üretilir.
        </p>

        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a href="https://wa.me/905324261788?text=Merhaba,%20web%20sitenizdeki%20Kahve%20Köşesi%20modellerini%20inceledim.%20Özel%20ölçü%20imalat%20için%20bilgi%20ve%20fiyat%20almak%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-amber-500 hover:bg-amber-400 text-stone-950 text-xs font-bold uppercase tracking-wider rounded-xl transition shadow-lg flex items-center gap-2">
            <span>💬 Özel Ölçü Kahve Köşesi Teklifi Al</span>
          </a>
          <span class="text-xs text-amber-200/80 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Hazır ölçü değil, terzi usulü mekanınıza tam uyum</span>
          </span>
        </div>
      </div>
    </div>

    <!-- 60 Barista Kahve İstasyonu Grid Kataloğu -->
    <div id="kahveGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {kahveKosesiData.map((item, idx) => (
        <article 
          class="kahve-card group bg-white rounded-2xl border border-stone-200 overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between"
          data-id={item.id}
          data-title={item.title}
          data-img={item.main_image}
          data-images={JSON.stringify(item.images)}
        >
          <!-- Üst Medya ve Çoklu Görsel Slider Dots -->
          <div class="relative aspect-[4/3] bg-stone-100 overflow-hidden cursor-pointer" onclick={`openKahveModalDirect('${item.id}')`}>
            <div class="card-slider-wrapper w-full h-full relative" id={`slider-${item.id}`}>
              {item.images.map((imgUrl, imgIdx) => (
                <img 
                  src={imgIdx === 0 ? imgUrl : "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 480 320'%3E%3Crect width='100%25' height='100%25' fill='%23f5f5f4'/%3E%3C/svg%3E"}
                  data-src={imgUrl}
                  alt={`${item.title} - Görsel ${imgIdx + 1}`}
                  loading="lazy"
                  decoding="async"
                  class={`kahve-slide-img absolute inset-0 w-full h-full object-cover transition-opacity duration-300 ${imgIdx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
                  data-index={imgIdx}
                />
              ))}
            </div>

            <!-- Görsel Sayısı Rozeti -->
            <span class="absolute top-3 left-3 z-20 px-2.5 py-1 bg-stone-900/80 backdrop-blur-xs text-white text-[10px] font-semibold tracking-wider rounded-lg flex items-center gap-1 shadow">
              <svg class="w-3 h-3 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span>{item.images.length} Görsel</span>
            </span>

            <!-- Özel İmalat Rozeti -->
            <span class="absolute top-3 right-3 z-20 px-2.5 py-1 bg-amber-600 text-white text-[10px] font-bold uppercase tracking-wider rounded-lg shadow">
              ÖZEL İMALAT
            </span>

            <!-- Slider Dots (Görseller Arası Hover/Tıklama) -->
            {item.images.length > 1 && (
              <div class="absolute bottom-3 inset-x-0 z-20 flex items-center justify-center gap-1.5" onclick="event.stopPropagation()">
                {item.images.map((_, dotIdx) => (
                  <button 
                    type="button" 
                    aria-label={`Görsel ${dotIdx + 1}`}
                    class={`slider-dot w-2 h-2 rounded-full transition-all duration-200 ${dotIdx === 0 ? 'bg-white w-4' : 'bg-white/60 hover:bg-white'}`}
                    data-card={item.id}
                    data-target={dotIdx}
                    onmouseenter={`changeCardImage('${item.id}', ${dotIdx})`}
                  />
                ))}
              </div>
            )}
          </div>

          <!-- Kart Gövdesi -->
          <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <div class="flex items-center justify-between text-[11px] text-amber-800 font-bold uppercase tracking-wider">
                <span>BARISTA KAHVE İSTASYONU</span>
                <span class="text-stone-400 font-mono">#{item.id.replace('kahve-kosesi-', 'KK-')}</span>
              </div>

              <h3 class="text-base font-bold text-stone-900 group-hover:text-amber-800 transition line-clamp-2 leading-snug">
                {item.title}
              </h3>

              <!-- %100 Terzi Usulü Bilgi Notu -->
              <div class="p-2.5 bg-amber-50/80 rounded-xl border border-amber-200/60 text-[11px] text-amber-950 flex items-start gap-2">
                <svg class="w-4 h-4 text-amber-700 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z"/></svg>
                <span><strong>%100 Terzi Usulü:</strong> Hazır ölçü değil; mutfağınızın ve kahve makinelerinizin ölçüsüne göre üretilir.</span>
              </div>
            </div>

            <!-- Aksiyon Butonları (Yeşilay WhatsApp & İncele) -->
            <div class="pt-3 border-t border-stone-100 flex items-center gap-2">
              <a 
                href={`https://wa.me/905324261788?text=${encodeURIComponent('Merhaba Yeşilay Mutfak, ' + item.title + ' kahve köşesi modeli hakkında özel ölçü imalat ve fiyat bilgisi almak istiyorum.')}`}
                target="_blank" 
                rel="noopener noreferrer" 
                class="flex-1 py-2.5 px-3 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold uppercase tracking-wider rounded-xl transition text-center shadow-xs flex items-center justify-center gap-1.5"
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
                <span>Fiyat Al</span>
              </a>
              <button 
                type="button" 
                onclick={`openKahveModalDirect('${item.id}')`}
