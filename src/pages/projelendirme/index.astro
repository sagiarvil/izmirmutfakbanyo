                  <option value="klinik" class="bg-slate-900">Klinik / Sağlık Merkezi</option>
                  <option value="otel" class="bg-slate-900">Otel / Butik Otel</option>
                  <option value="kuyumcu" class="bg-slate-900">Kuyumcu Mağazası</option>
