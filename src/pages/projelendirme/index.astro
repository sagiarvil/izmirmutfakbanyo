            </div>
          </div>

          <!-- Soru 2 -->
          <div class="border border-slate-200 rounded-lg overflow-hidden transition-all duration-200">
            <button
              type="button"
              class="w-full p-5 text-left font-semibold text-sm md:text-base text-slate-900 bg-slate-50 hover:bg-slate-100 flex items-center justify-between gap-4 transition-colors"
