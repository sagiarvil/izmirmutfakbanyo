---
import Layout from "../../layouts/Layout.astro";

// 20 Ticari Proje / Mağaza Konsept Görsel Verisi
const commercialProjects = [
  { no: 1, marka: "VELUNOR", kategori: "MİMARİ YAŞAM", baslik: "Velunor Mimari Yaşam Mağazası", konum: "Alsancak, İzmir", dosya: "/images/ticari-projeler/01_velunor_magaza.jpg" },
  { no: 2, marka: "CASTERA", kategori: "TASARIM ATÖLYESİ", baslik: "Castera Tasarım Atölyesi & Showroom", konum: "Bayraklı, İzmir", dosya: "/images/ticari-projeler/02_castera_magaza.jpg" },
  { no: 3, marka: "KORVEX", kategori: "TEKNİK MARKET", baslik: "Korvex Profesyonel Teknik Market", konum: "Bornova, İzmir", dosya: "/images/ticari-projeler/03_korvex_magaza.jpg" },
  { no: 4, marka: "PİKORA", kategori: "KONSEPT MAĞAZA", baslik: "Pikora Renkli Dünya Konsept Mağazası", konum: "Mavişehir, İzmir", dosya: "/images/ticari-projeler/04_pikora_magaza.jpg" },
  { no: 5, marka: "LUMORİ", kategori: "LIFESTYLE STORE", baslik: "Lumori Yaşam & Aydınlatma Mağazası", konum: "Urla, İzmir", dosya: "/images/ticari-projeler/05_lumori_magaza.jpg" },
  { no: 6, marka: "BEBYORA", kategori: "ANNE & BEBEK", baslik: "Bebyora Premium Bebek & Yaşam Alanı", konum: "Karşıyaka, İzmir", dosya: "/images/ticari-projeler/06_bebyora_magaza.jpg" },
  { no: 7, marka: "NİVERA", kategori: "ÇOCUK & YAŞAM", baslik: "Nivera Çocuk Deneyim Mağazası", konum: "Konak, İzmir", dosya: "/images/ticari-projeler/07_nivera_magaza.jpg" },
  { no: 8, marka: "KİDAVO", kategori: "MODA MAĞAZASI", baslik: "Kidavo Konsept Moda & Giyim", konum: "Bostanlı, İzmir", dosya: "/images/ticari-projeler/08_kidavo_magaza.jpg" },
  { no: 9, marka: "MİNORA", kategori: "OYUN & TASARIM", baslik: "Minora Deneyimsel Oyun & Tasarım Alanı", konum: "Güzelbahçe, İzmir", dosya: "/images/ticari-projeler/09_minora_magaza.jpg" },
  { no: 10, marka: "AVENORA", kategori: "MODA ATÖLYESİ", baslik: "Avenora Lüks Giyim & Terzilik Stüdyosu", konum: "Alsancak, İzmir", dosya: "/images/ticari-projeler/10_avenora_magaza.jpg" },
  { no: 11, marka: "MİRAVİ", kategori: "YAŞAM & TASARIM", baslik: "Miravi Ev Dekorasyonu & Aksesuar", konum: "Çeşme, İzmir", dosya: "/images/ticari-projeler/11_miravi_magaza.jpg" },
  { no: 12, marka: "MONELİ", kategori: "KOZMETİK & BAKIM", baslik: "Moneli Doğal Kozmetik & Bakım Mağazası", konum: "Buca, İzmir", dosya: "/images/ticari-projeler/12_moneli_magaza.jpg" },
  { no: 13, marka: "ARVİSA", kategori: "İŞ VE OFİS", baslik: "Arvisa Kurumsal Çözümler Showroomu", konum: "Gaziemir, İzmir", dosya: "/images/ticari-projeler/13_arvisa_magaza.jpg" },
  { no: 14, marka: "LORİNA", kategori: "KIDS CONCEPT", baslik: "Lorina Çocuk Mobilya & Dekorasyon", konum: "Balçova, İzmir", dosya: "/images/ticari-projeler/14_lorina_magaza.jpg" },
  { no: 15, marka: "EVONARA", kategori: "EV & YAŞAM", baslik: "Evonara Mobilya & İç Mekan Mağazası", konum: "Bayraklı, İzmir", dosya: "/images/ticari-projeler/15_evonara_magaza.jpg" },
  { no: 16, marka: "KİVORA", kategori: "CONCEPT STORE", baslik: "Kivora Butik Aksesuar & Tasarım Mağazası", konum: "Alaçatı, İzmir", dosya: "/images/ticari-projeler/16_kivora_magaza.jpg" },
  { no: 17, marka: "OYUNİVA", kategori: "OYUNCAK DÜNYASI", baslik: "Oyuniva Eğitici Oyuncak & Hobi Mağazası", konum: "Karşıyaka, İzmir", dosya: "/images/ticari-projeler/17_oyuniva_magaza.jpg" },
  { no: 18, marka: "FİORİSA", kategori: "KONSEPT MAĞAZA", baslik: "Fiorisa Çiçek Tasarım & Botanik Mağazası", konum: "Urla, İzmir", dosya: "/images/ticari-projeler/18_fiorisa_magaza.jpg" }
];

// Mimari Ticari Sektörler & B2B Dönüşüm Odaklı 10 Hero Slide
const heroSlides = [
  {
    baslik: "Ofis, Hukuk & Görüşme Ofisleri Projelendirme",
    kategori: "KURUMSAL OFİS & FİT-OUT TAAHHÜT",
    sektorler: ["Yönetim Ofisleri", "Hukuk Büroları", "Görüşme Ofisleri", "Finans Merkezleri"],
    resim: "/images/projelendirme/hero/hero_01.webp",
    aciklama: "Prestijli hukuk büroları, şirket yönetim merkezleri ve gizlilik odaklı görüşme ofislerinde akustik konfor, 3D mimari projelendirme ve anahtar teslim uygulama.",
    ctaText: "Ofis Projeniz İçin Teklif Alın",
    ctaLink: "https://wa.me/905446348344?text=Merhaba,%20Ofis%20ve%20Hukuk%20B%C3%BCrosu%20projelendirme%20i%C3%A7in%20teklif%20almak%20istiyorum."
  },
  {
    baslik: "Klinik, Diş & Veteriner Klinikleri Mimarisi",
    kategori: "SAĞLIK & KLİNİK MİMARİSİ",
    sektorler: ["Diş Klinikleri", "Estetik & Tıp Merkezleri", "Veteriner Klinikleri", "Poliklinikler"],
    resim: "/images/projelendirme/hero/hero_02.webp",
    aciklama: "Sağlık Bakanlığı standartlarına tam uyumlu sterilizasyon alanları, ergonomik hasta kabul ve fonksiyonel klinik fit-out uygulamaları.",
    ctaText: "Klinik Mimarisi İçin Keşif İsteyin",
    ctaLink: "https://wa.me/905446348344?text=Merhaba,%20Di%C5%9F%20Klinigi%20ve%20Sa%C4%9Fl%C4%B1k%20Merkezi%20projelendirme%20hakk%C4%B1nda%20g%C3%B6r%C3%BC%C5%9Fmek%20istiyorum."
  },
  {
    baslik: "Cafe, Restoran & Gastro Yaşam Alanları",
    kategori: "YEME-İÇME & AĞIRLAMA TASARIMI",
    sektorler: ["3. Nesil Cafeler", "Restoran & Brasserie", "Lounge Alanları", "Franchise Şubeleri"],
    resim: "/images/projelendirme/hero/hero_06.webp",
    aciklama: "Müşteriyi içine çeken sıcak ambiyans, doğru aydınlatma mühendisliği ve mutfak-servis akışını kusursuzlaştıran anahtar teslim şantiye yönetimi.",
    ctaText: "Cafe & Restoran Projenizi Başlatın",
    ctaLink: "https://wa.me/905446348344?text=Merhaba,%20Cafe%20ve%20Restoran%20tadilat%20ve%20projelendirme%20i%C3%A7in%20fiyat%20almak%20istiyorum."
  },
  {
    baslik: "Kuyumcu, Optik & Tekstil Mağazaları",
    kategori: "LÜKS PERAKENDE & SHOWROOM",
    sektorler: ["Kuyumcu Mağazaları", "Optik Mağazaları", "Tekstil & Moda", "Konsept Mağazalar"],
    resim: "/images/projelendirme/hero/hero_04.webp",
    aciklama: "Özel aydınlatmalı mücevher vitrinleri, optik teşhir üniteleri ve tekstil showroomlarında satış hacmini artıran stratejik mağazacılık mimarisi.",
    ctaText: "Mağaza Tasarımı İçin Teklif Alın",
    ctaLink: "https://wa.me/905446348344?text=Merhaba,%20Kuyumcu%20veya%20Optik%20ma%C4%9Faza%20kurulumu%20i%C3%A7in%20g%C3%B6r%C3%BC%C5%9Fmek%20istiyorum."
  },
  {
    baslik: "Otel & Butik Otel İç Mimari Projeleri",
    kategori: "TURİZM & OTELCİLİK FIT-OUT",
    sektorler: ["Butik Oteller", "Resort Tesisler", "Lobi & Karşılama", "Otel Odaları"],
    resim: "/images/projelendirme/hero/hero_10.webp",
    aciklama: "Otel lobilerinden oda renovasyonlarına, spa ve sosyal alanlardan resepsiyona kadar yüksek müşteri puanı sağlayan lüks mimari taahhüt.",
    ctaText: "Otel Projeniz İçin Keşif Alın",
    ctaLink: "https://wa.me/905446348344?text=Merhaba,%20Butik%20Otel%20veya%20Otel%20renovasyonu%20i%C3%A7in%20mimari%20teklif%20istiyorum."
  },
  {
    baslik: "Banka Şube Kurulumları & Kurumsal Alanlar",
    kategori: "KURUMSAL ZİNCİR ŞANTİYE YÖNETİMİ",
    sektorler: ["Banka Şubeleri", "Özel Bankacılık", "Finans Ofisleri", "ATM & Giriş Alanları"],
    resim: "/images/projelendirme/hero/hero_03.webp",
    aciklama: "Yüksek güvenlikli altyapı, kurumsal kimlik kılavuzuna %100 sadakat ve sıkı teslim takvimli banka şube mimari kurulumları.",
    ctaText: "Kurumsal Şube Kurulum Teklifi Alın",
    ctaLink: "https://wa.me/905446348344?text=Merhaba,%20Banka%20veya%20kurumsal%20zincir%20kurulumu%20i%C3%A7in%20teklif%20almak%20istiyorum."
  },
  {
    baslik: "Yurtdışı Ticari Projeler & İhracat Mimarisi",
    kategori: "GLOBAL MİMARLIK & FİT-OUT",
    sektorler: ["Avrupa Projeleri", "Körfez Ülkeleri", "Modüler İmalat", "Uluslararası Montaj"],
    resim: "/images/projelendirme/hero/hero_05.webp",
    aciklama: "İzmir atölyemizde üretilen hassas CNC mimari mobilyaların yurtdışına ihracatı ve yerinde anahtar teslim montaj koordinasyonu.",
    ctaText: "Yurtdışı Projenizi Birlikte Planlayalım",
    ctaLink: "https://wa.me/905446348344?text=Merhaba,%20Yurtd%C4%B1%C5%9F%C4%B1%20projelendirme%20ve%20mobilya%20imalat%C4%B1%20hakk%C4%B1nda%20g%C3%B6r%C3%BC%C5%9Fmek%20istiyorum."
  },
  {
    baslik: "Optik & Göz Sağlığı Deneyim Mağazaları",
    kategori: "OPTİK & MEDİKAL MAĞAZACILIK",
    sektorler: ["Optik Mağazaları", "Gözlük Teşhir", "Muayene Odaları", "Görsel Vitrin"],
    resim: "/images/projelendirme/hero/hero_08.webp",
    aciklama: "Parlamayan özel indeksli optik aydınlatması, kilitli güvenlikli teşhir çekmeceleri ve şık bekleme alanları ile modern optik mimarisi.",
    ctaText: "Optik Mağaza Teklifi Alın",
    ctaLink: "https://wa.me/905446348344?text=Merhaba,%20Optik%20ma%C4%9Faza%20projelendirme%20i%C3%A7in%20teklif%20istiyorum."
  },
  {
    baslik: "Tekstil, Butik & Moda Showroomları",
    kategori: "MODA & TEKSTİL RETAIL",
    sektorler: ["Moda Butikleri", "Giyim Showroom", "Provalık Alanları", "Kasa & Odak Noktaları"],
    resim: "/images/projelendirme/hero/hero_07.webp",
    aciklama: "Kıyafet renklerini doğru yansıtan CRI>95 aydınlatma, lüks kabin konforu ve akıcı askı sistemleriyle tekstil perakendeciliğinde fark yaratın.",
    ctaText: "Showroom Tasarımı İçin Başvurun",
    ctaLink: "https://wa.me/905446348344?text=Merhaba,%20Tekstil%20ve%20Moda%20showroom%20projelendirme%20hakk%C4%B1nda%20bilgi%20almak%20istiyorum."
  },
  {
    baslik: "Kuyumcu & Yüksek Güvenlikli Mücevherat",
    kategori: "KUYUMCULUK & LÜKS TİCARİ MİMARİ",
    sektorler: ["Kuyumcu Mağazaları", "Mücevher Vitrinleri", "VIP Satış Odası", "Zırhlı Kasalar"],
    resim: "/images/projelendirme/hero/hero_09.webp",
    aciklama: "Göz alıcı pırlanta/altın aydınlatma mühendisliği, kırılmaz lamine camlı vitrinler ve VIP müşteri ağırlama odalarıyla kusursuz kuyumcu mimarisi.",
    ctaText: "Kuyumcu Mimarisi İçin Teklif Alın",
    ctaLink: "https://wa.me/905446348344?text=Merhaba,%20Kuyumcu%20ma%C4%9Faza%20projelendirme%20ve%20vitrin%20imalat%C4%B1%20i%C3%A7in%20teklif%20istiyorum."
  }
];

const seo = {
  title: "İzmir Ticari Mekân Projelendirme & Fit-Out | Yeşilay Mutfak",
  description: "İzmir'de mağaza, ofis ve kafe-restoran için mimari projelendirme, 3D tasarım ve anahtar teslim fit-out çözümleri. Projeniz için görüşme talep edin.",
  canonical: "https://yesilaymutfak.com/projelendirme/"
};
---

<Layout seo={seo} activeService="projelendirme">
  <main class="w-full text-slate-800 font-sans antialiased selection:bg-amber-600 selection:text-white">

    <!-- BÖLÜM 1: OSO MİMARLIK FORMATINDA TAM EKRAN MİMARİ HERO SLIDER -->
    <section class="relative w-full bg-slate-900 text-white overflow-hidden" x-data="{
      activeSlide: 0,
      totalSlides: 10,
      timer: null,
      startAuto() {
        this.timer = setInterval(() => {
          this.activeSlide = (this.activeSlide + 1) % this.totalSlides;
        }, 5000);
      },
      stopAuto() {
        if (this.timer) clearInterval(this.timer);
      }
    }" x-init="startAuto()" @mouseenter="stopAuto()" @mouseleave="startAuto()">

      <!-- Slide Görselleri (Her Ekranda %100 Görünür, Taşmayan Dinamik Viewport) -->
      <div class="relative w-full h-[calc(100svh-72px)] sm:h-[calc(100svh-80px)] lg:h-[calc(100svh-88px)] min-h-[500px] max-h-[900px] overflow-hidden">
        {heroSlides.map((slide, index) => (
          <div
            class="absolute inset-0 transition-opacity duration-1000 ease-in-out"
            x-show={`activeSlide === ${index}`}
            x-transition:enter="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="opacity-100"
            x-transition:leave-end="opacity-0"
          >
            <img
              src={slide.resim}
              alt={slide.baslik}
              class="w-full h-full object-cover object-center transform scale-100 transition-transform duration-7000 ease-out"
              loading={index === 0 ? "eager" : "lazy"}
            />
            <!-- Gradient Overlay: OSO Mimarlık Saf Minimalist Gradyan -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/40"></div>

            <!-- Mimari Başlık & Tipografi Grubu (Alt Sol / Merkez) -->
            <div class="absolute inset-0 flex items-end">
              <div class="max-w-7xl mx-auto px-6 lg:px-12 pb-12 sm:pb-16 lg:pb-20 w-full">
                <div class="max-w-3xl space-y-4">
                  <div class="inline-flex items-center gap-3 flex-wrap">
                    <span class="w-8 h-[2px] bg-amber-500"></span>
                    <span class="text-xs md:text-sm font-semibold tracking-[0.25em] uppercase text-amber-400">
                      {slide.kategori}
                    </span>
                    <span class="text-[11px] font-mono text-slate-400 bg-black/40 px-2 py-0.5 rounded border border-white/10">
                      PROJE #{String(index + 1).padStart(2, "0")}
                    </span>
                  </div>

                  <!-- Dinamik Başlık -->
                  <h2 class="text-2xl sm:text-4xl md:text-5xl lg:text-5xl font-light text-white tracking-tight leading-snug">
                    {slide.baslik}
                  </h2>

                  <!-- Sektörel Etiketler (Kullanıcının Belirttiği Alanlar) -->
                  <div class="flex flex-wrap gap-2 pt-1">
                    {slide.sektorler.map((sek) => (
                      <span class="inline-flex items-center px-2.5 py-1 rounded bg-white/10 backdrop-blur-sm border border-white/15 text-[11px] font-medium text-slate-200">
                        ✓ {sek}
                      </span>
                    ))}
                  </div>

                  <p class="text-xs sm:text-sm md:text-base text-slate-300 font-normal leading-relaxed max-w-2xl">
                    {slide.aciklama}
                  </p>

                  <!-- Dönüşüm Odaklı Mimari CTA Buton Grubu -->
                  <div class="pt-2 flex flex-wrap items-center gap-3">
                    <a
                      href={slide.ctaLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2.5 px-6 py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs sm:text-sm font-bold tracking-wider uppercase rounded-xs transition-all duration-200 shadow-xl group/btn"
                    >
                      <span>{slide.ctaText}</span>
                      <svg class="w-4 h-4 group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                    </a>

                    <a
                      href="#ticari-projeler"
                      class="inline-flex items-center gap-2 px-5 py-3 bg-white/10 hover:bg-white/20 border border-white/30 text-white text-xs sm:text-sm font-semibold tracking-wider uppercase rounded-xs transition-all duration-200 backdrop-blur-sm"
                    >
                      <span>18 Örnek Projeyi Gör</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Slider Kontrolleri (Oklar & Göstergeler) -->
      <div class="absolute bottom-5 sm:bottom-8 right-4 sm:right-8 lg:right-12 z-20 flex items-center gap-3">
        <button
          type="button"
          @click="activeSlide = (activeSlide - 1 + totalSlides) % totalSlides"
          class="w-10 h-10 rounded-full border border-white/30 bg-black/40 hover:bg-white hover:text-slate-900 text-white flex items-center justify-center transition-all duration-200 backdrop-blur-sm"
          aria-label="Önceki Proje"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </button>
        <span class="text-xs font-mono tracking-widest text-white/80">
          <span x-text="String(activeSlide + 1).padStart(2, 0)"></span> / 10
        </span>
        <button
          type="button"
          @click="activeSlide = (activeSlide + 1) % totalSlides"
          class="w-10 h-10 rounded-full border border-white/30 bg-black/40 hover:bg-white hover:text-slate-900 text-white flex items-center justify-center transition-all duration-200 backdrop-blur-sm"
          aria-label="Sonraki Proje"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>

      <!-- Çizgisel Slide İlerleme Çubukları -->
      <div class="absolute bottom-0 left-0 right-0 h-1 bg-white/10 flex">
        {heroSlides.map((_, i) => (
          <div class="flex-1 h-full bg-white/20 relative overflow-hidden">
            <div
              class="h-full bg-amber-500 transition-all duration-300"
              :class={`activeSlide === ${i} ? w-full : w-0`}
            ></div>
          </div>
        ))}
      </div>
    </section>

    <!-- BÖLÜM 2: OSO MİMARLIK BİREBİR MANİFESTO VE ANA BAŞLIK -->
    <section class="py-20 md:py-24 border-b border-slate-200/80">
      <div class="max-w-4xl mx-auto px-6 text-center space-y-6">
        <span class="inline-block text-xs font-semibold tracking-[0.3em] uppercase text-amber-700 bg-amber-50 border border-amber-200/60 px-4 py-1.5 rounded-full">
          MİMARİ TASARIM & FIT-OUT YÖNETİMİ
        </span>
        <h1 class="text-3xl md:text-5xl font-light text-slate-900 tracking-tight leading-snug">
          İzmir Ticari Mekân <strong class="font-semibold text-slate-950">Projelendirme ve Fit-Out</strong> Çözümleri
        </h1>
        <div class="w-16 h-1 bg-amber-500 mx-auto"></div>
        <p class="text-base md:text-lg text-slate-600 font-normal leading-relaxed text-justify md:text-center">
          Yeşilay Mimarlık; modern ve çağdaş mimarlık anlayışını estetik, işlevsel ve yaratıcı çözümlerle birleştirerek her ölçekte yenilikçi mekânlar tasarlar. Firmamız mimari – iç mimari tasarım ve projelendirme ile anahtar teslim (fit-out) uygulama hizmetleri sunar. Tasarımdan uygulamaya uzanan tüm süreçlerde detay odaklı yaklaşımı ve teknik uzmanlığıyla; ofis, mağaza, konut ve cafe-restoran gibi tüm ticari ve yaşam alanlarını konforlu, prestijli ve yüksek verimli hâle getiriyoruz.
        </p>

        <!-- KAPSAMLI TİCARİ SEKTÖR MATRİSİ -->
        <div class="pt-8 text-left">
          <div class="p-6 bg-slate-50 border border-slate-200/90 rounded-lg space-y-4">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
              <h3 class="text-xs font-bold uppercase tracking-[0.15em] text-slate-900">
                Anahtar Teslim Projelendirme Yaptığımız Ticari ve Kurumsal Sektörler:
              </h3>
            </div>
            
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2.5 text-xs text-slate-700">
              <div class="flex items-center gap-1.5 p-2 bg-white rounded border border-slate-100 shadow-2xs font-medium">
                <span class="text-amber-600 font-bold">✓</span> Cafe & Restoranlar
              </div>
              <div class="flex items-center gap-1.5 p-2 bg-white rounded border border-slate-100 shadow-2xs font-medium">
                <span class="text-amber-600 font-bold">✓</span> Diş Klinikleri
              </div>
              <div class="flex items-center gap-1.5 p-2 bg-white rounded border border-slate-100 shadow-2xs font-medium">
