---
import Layout from "../../layouts/Layout.astro";
import { 
  manifestoProjects, 
  projectCategories, 
  meartPhases, 
  meartAboutData, 
  meartClients 
} from "../../data/projelendirmeData";

const seo = {
  title: "İzmir Ticari Mekân Projelendirme & Fit-Out | Yeşilay Mutfak",
  description: "İzmir'de mağaza, ofis ve kafe-restoran için mimari projelendirme, 3D tasarım ve anahtar teslim fit-out çözümleri. Projeniz için görüşme talep edin.",
  canonical: "https://yesilaymutfak.com/projelendirme/"
};
---

<Layout seo={seo} activeService="projelendirme">
  <link rel="stylesheet" href="/assets/lead-form.css" slot="head" />
  
  <main 
    class="w-full text-[#15231C] bg-[#FAF9F6] font-sans antialiased selection:bg-[#006039] selection:text-white"
    x-data="{
      activeFilter: 'all',
      modalOpen: false,
      selectedProject: null,
      openModal(project) {
        this.selectedProject = project;
        this.modalOpen = true;
        document.body.classList.add('overflow-hidden');
      },
      closeModal() {
        this.modalOpen = false;
        document.body.classList.remove('overflow-hidden');
      }
    }"
    @keydown.escape="closeModal()"
  >

    <!-- ===================================================================== -->
    <!-- BÖLÜM 1: HERO & SEMANTİK H1                                           -->
    <!-- Tek H1 Kuralı ve Kurumsal İhtiyaç Belirleme Metni                    -->
    <!-- ===================================================================== -->
    <section class="relative w-full pt-10 pb-16 sm:pt-14 sm:pb-20 border-b border-[#E5E2DA] overflow-hidden bg-gradient-to-b from-[#FAF9F6] via-[#F3EFEA] to-[#FAF9F6]">
      
      <!-- Arka Plan Mimari Dinamik Vektörel Watermark (Dinamik SVG, Üstte ve Taşmayan) -->
      <div class="absolute inset-x-0 top-0 h-44 overflow-hidden pointer-events-none select-none opacity-40">
        <svg viewBox="0 0 1200 140" class="w-full h-full text-[#ECEAE5] fill-current" preserveAspectRatio="xMidYMid meet">
          <text x="50%" y="65%" text-anchor="middle" font-size="88" font-weight="900" letter-spacing="0.18em" font-family="system-ui, sans-serif">PROJELENDİRME</text>
        </svg>
      </div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Üst Kategori Etiketi -->
        <div class="flex items-center justify-center gap-2 mb-4">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold tracking-widest uppercase bg-[#C5A880]/15 text-[#8F7249] border border-[#C5A880]/40">
            <span class="w-1.5 h-1.5 rounded-full bg-[#006039] animate-pulse"></span>
            YEŞİLAY MİMARLIK · PROJELENDİRME, TASARIM & FIT-OUT TAAHHÜT
          </span>
        </div>

        <!-- Tekil H1 Başlık (Mandate Kuralı) -->
        <div class="text-center max-w-4xl mx-auto">
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-[#15231C] leading-[1.12]">
            İzmir Ticari Mekân Projelendirme ve Anahtar Teslim Fit-Out
          </h1>
          <p class="mt-5 text-base sm:text-lg md:text-xl text-[#5A544C] leading-relaxed max-w-3xl mx-auto font-normal">
            <strong class="font-semibold text-[#15231C]">Mağaza, ofis veya kafe-restoran açmayı ya da mevcut iş yerinizi yenilemeyi mi planlıyorsunuz?</strong> Mekânınızın işlevini, markanızın ihtiyaçlarını ve uygulama kapsamını birlikte netleştirelim. Yeşilay Mutfak bünyesinde mimari tasarım ve uygulama hizmetlerinin kapsamını proje özelinde belirliyoruz.
          </p>
        </div>

        <!-- Eylemler (Zorunlu İki CTA) -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
          <a
            href="#proje-gorusmesi"
            class="px-6 py-3.5 bg-[#006039] hover:bg-[#00482B] text-white text-xs sm:text-sm font-bold uppercase tracking-wider rounded-lg shadow-[0_4px_16px_rgba(0,96,57,0.22)] transition-all duration-200 flex items-center gap-2 border border-[#C5A880]/50"
          >
            <span>TİCARİ PROJEM İÇİN GÖRÜŞME TALEP ET</span>
            <span class="text-[#C5A880]">↓</span>
          </a>
          <a
            href="#surec"
            class="px-6 py-3.5 bg-white hover:bg-[#F3EFEA] text-[#15231C] text-xs sm:text-sm font-bold uppercase tracking-wider rounded-lg border border-[#D0CAC0] shadow-sm transition-all duration-200 flex items-center gap-2"
          >
            <span>PROJELENDİRME SÜRECİNİ İNCELE</span>
            <span class="text-[#006039]">→</span>
          </a>
        </div>

        <!-- MeArt İstatistik & Türkiye Harita Bloğu -->
        <div class="mt-14 bg-white rounded-2xl border border-[#E5E2DA] shadow-[0_12px_40px_rgba(21,35,28,0.06)] overflow-hidden">
          <div class="grid grid-cols-1 lg:grid-cols-12 items-center">
            
            <!-- Sol: İstatistikler -->
            <div class="lg:col-span-5 p-6 sm:p-8 lg:p-10 border-b lg:border-b-0 lg:border-r border-[#E5E2DA] bg-[#FAF9F6]/50">
              <span class="text-[11px] font-bold text-[#8F7249] tracking-widest uppercase">KURUMSAL TAAHHÜT VE ALTYAPI</span>
              <h2 class="text-xl sm:text-2xl font-bold text-[#15231C] mt-1.5 leading-snug">
                Ticari Mekânlarda Fonksiyonel Mimarlık ve Doğrudan İmalat Gücü
              </h2>
              <p class="mt-3 text-xs sm:text-sm text-[#5A544C] leading-relaxed">
                1998 yılından bu yana kendi atölye imkanlarımız, CNC parkurumuz ve teknik şantiye kadromuzla mağaza, ofis ve ticari mekanların proje bazlı üretimini ve fit-out montajını yönetiyoruz.
              </p>

              <!-- 4 Metrik Kartı -->
              <div class="grid grid-cols-2 gap-3 sm:gap-4 mt-6">
                {meartAboutData.stats.map(st => (
                  <div class="p-3.5 rounded-xl bg-white border border-[#E5E2DA] shadow-sm">
                    <div class="text-2xl sm:text-3xl font-extrabold text-[#006039] tracking-tight">{st.value}</div>
                    <div class="text-xs font-bold text-[#15231C] mt-0.5">{st.label}</div>
                    <div class="text-[10px] text-[#756E65] mt-0.5">{st.sub}</div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Sağ: Türkiye Proje Haritası -->
            <div class="lg:col-span-7 p-4 sm:p-6 lg:p-8 flex flex-col items-center justify-center bg-white">
              <div class="relative w-full max-w-xl">
                <img
                  src="https://static.wixstatic.com/media/990e90_73a7a98912a1427a89dce7e048450c69~mv2.png"
                  alt="Türkiye Proje ve Şantiye Dağılımı - Yeşilay Mimarlık"
                  class="w-full h-auto object-contain drop-shadow-md rounded-lg"
                  loading="eager"
                  width="948"
                  height="542"
                />
              </div>
              <p class="mt-3 text-[11px] text-[#756E65] text-center font-medium">
                📍 İzmir merkezli; Ege Bölgesi ve Türkiye genelinde proje bazlı ticari fit-out ve şantiye koordinasyonu
              </p>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- BÖLÜM 2: İŞLETMENİZE UYGUN TİCARİ MEKÂN ÇÖZÜMLERİ                     -->
    <!-- 4 Sektörel Çözüm Kümesi (content/01-SAYFA-METINLERI.md)               -->
    <!-- ===================================================================== -->
    <section class="py-16 sm:py-20 bg-white border-b border-[#E5E2DA]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-[11px] font-bold text-[#8F7249] tracking-widest uppercase">TİCARİ HİZMET KAPSAMI</span>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#15231C] tracking-tight mt-1.5">
            İşletmenize Uygun Ticari Mekân Çözümleri
          </h2>
          <p class="mt-3 text-sm sm:text-base text-[#5A544C]">
            Ticari alanda başarı yalnızca görsel tasarımla değil; müşteri rotası, akustik, dayanıklı malzeme ve uygulanabilir metrajla sağlanır.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <!-- Sektör 1: Mağaza & Showroom -->
          <div class="p-6 rounded-2xl bg-[#FAF9F6] border border-[#E5E2DA] flex flex-col justify-between hover:shadow-md transition-shadow">
            <div>
              <div class="w-10 h-10 rounded-lg bg-[#006039]/10 text-[#006039] flex items-center justify-center font-bold text-lg mb-4">
                🛍️
              </div>
              <h3 class="text-lg font-bold text-[#15231C] tracking-tight">
                Mağaza ve Showroom Projelendirme
              </h3>
              <p class="mt-2.5 text-xs sm:text-sm text-[#5A544C] leading-relaxed">
                Bir mağazanın yerleşimi yalnızca görsel beğeni meselesi değildir. Müşteri dolaşımı, ürün teşhiri, vitrin, kasa, stok alanı ve aydınlatma birlikte planlanır. Mevcut alanınız ve marka ihtiyaçlarınız üzerinden proje kapsamı ve uygulanabilir seçenekler değerlendirilir.
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-[#E5E2DA] text-[11px] font-bold text-[#006039]">
              Ürün Teşhiri & Müşteri Rotası →
            </div>
          </div>

          <!-- Sektör 2: Ofis & Yönetim Alanları -->
          <div class="p-6 rounded-2xl bg-[#FAF9F6] border border-[#E5E2DA] flex flex-col justify-between hover:shadow-md transition-shadow">
            <div>
              <div class="w-10 h-10 rounded-lg bg-[#006039]/10 text-[#006039] flex items-center justify-center font-bold text-lg mb-4">
                🏢
              </div>
              <h3 class="text-lg font-bold text-[#15231C] tracking-tight">
                Ofis ve Yönetim Alanları Tasarımı
              </h3>
              <p class="mt-2.5 text-xs sm:text-sm text-[#5A544C] leading-relaxed">
                Çalışma alanlarının fonksiyonunu; toplantı gizliliği, akustik, depolama, kablolama, misafir karşılama ve büyüme ihtiyacına göre ele alıyoruz. Yönetim ofisi, hukuk bürosu veya danışmanlık ofisi için yerleşim kararlarını teknik ölçülere dayandırıyoruz.
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-[#E5E2DA] text-[11px] font-bold text-[#006039]">
              Ergonomi & Akustik Planlama →
            </div>
          </div>

          <!-- Sektör 3: Kafe & Restoran -->
          <div class="p-6 rounded-2xl bg-[#FAF9F6] border border-[#E5E2DA] flex flex-col justify-between hover:shadow-md transition-shadow">
            <div>
              <div class="w-10 h-10 rounded-lg bg-[#006039]/10 text-[#006039] flex items-center justify-center font-bold text-lg mb-4">
                ☕
              </div>
              <h3 class="text-lg font-bold text-[#15231C] tracking-tight">
                Kafe ve Restoran İç Mekân Tasarımı
              </h3>
              <p class="mt-2.5 text-xs sm:text-sm text-[#5A544C] leading-relaxed">
                Müşteri oturma alanı, servis rotası, mutfak-yemek hazırlık ilişkisi, aydınlatma, temizlik ve bakım erişimini aynı projede ele almak işletme sürecini kolaylaştırır. Projelendirme sırasında teknik altyapı ve gerekli izinlere ilişkin sorumluluklar yazılı kapsamda ayrıştırılır.
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-[#E5E2DA] text-[11px] font-bold text-[#006039]">
              Mutfak & Servis Akışı →
            </div>
          </div>

          <!-- Sektör 4: Diğer Ticari Projeler -->
          <div class="p-6 rounded-2xl bg-[#FAF9F6] border border-[#E5E2DA] flex flex-col justify-between hover:shadow-md transition-shadow">
            <div>
              <div class="w-10 h-10 rounded-lg bg-[#006039]/10 text-[#006039] flex items-center justify-center font-bold text-lg mb-4">
                🏨
              </div>
              <h3 class="text-lg font-bold text-[#15231C] tracking-tight">
                Diğer Ticari Projeler
              </h3>
              <p class="mt-2.5 text-xs sm:text-sm text-[#5A544C] leading-relaxed">
                Klinik, butik otel, optik mağazası, kuyumcu mağazası ve çok şubeli ticari projelerde hizmetin kapsamı; teknik gereklilikler, ilgili yetkiler, mevcut ekip kapasitesi ve işin yerine göre ayrıca değerlendirilir. <strong class="text-[#15231C]">Sektöre özgü yasal standartlara otomatik uyum garantisi verilmez.</strong>
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-[#E5E2DA] text-[11px] font-bold text-[#8F7249]">
              Özel Teknik Kapsam Değerlendirmesi →
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- BÖLÜM 3: PROJELENDİRME VE UYGULAMA NASIL İLERLİYOR? (#surec)          -->
    <!-- 4 Aşamalı Doğrulanmış Süreç                                           -->
    <!-- ===================================================================== -->
    <section id="surec" class="py-16 sm:py-20 bg-[#FAF9F6] border-b border-[#E5E2DA]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
          <span class="text-[11px] font-bold text-[#8F7249] tracking-widest uppercase">İŞ AKIŞI VE DİSİPLİN</span>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#15231C] tracking-tight mt-1.5">
            Projelendirme ve Uygulama Nasıl İlerliyor?
          </h2>
          <p class="mt-3 text-sm sm:text-base text-[#5A544C]">
            Hayal edilen mekânı şeffaf ve ölçülebilir adımlarla hayata geçiriyoruz.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <div class="bg-white rounded-2xl p-6 border border-[#E5E2DA] shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl font-black text-[#C5A880]/50">01</span>
                <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-[#F3EFEA] text-[#15231C]">ANALİZ</span>
              </div>
              <h3 class="text-base font-bold text-[#15231C]">Ön Görüşme ve İhtiyaç Analizi</h3>
              <p class="mt-2.5 text-xs text-[#5A544C] leading-relaxed">
                İşletme türü, konum, alan, açılış hedefi, mevcut durum, karar verici ve bütçe beklentisi belirlenir.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-[#F3EFEA] text-[11px] font-medium text-[#756E65]">
              Hedef ve öncelik tespiti
            </div>
          </div>

          <div class="bg-white rounded-2xl p-6 border border-[#E5E2DA] shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl font-black text-[#C5A880]/50">02</span>
                <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-[#F3EFEA] text-[#15231C]">KEŞİF</span>
              </div>
              <h3 class="text-base font-bold text-[#15231C]">Yerinde İnceleme ve Rölöve</h3>
              <p class="mt-2.5 text-xs text-[#5A544C] leading-relaxed">
                Uygun görülen projelerde ölçüler, mevcut tesisat ve kullanılabilir alan netleştirilir. Keşif ücreti ve kapsamı görüşmede açıklanır.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-[#F3EFEA] text-[11px] font-medium text-[#756E65]">
              Milimetrik lazer ölçüm
            </div>
          </div>

          <div class="bg-white rounded-2xl p-6 border border-[#E5E2DA] shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl font-black text-[#C5A880]/50">03</span>
                <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-[#F3EFEA] text-[#15231C]">MİMARLIK</span>
              </div>
              <h3 class="text-base font-bold text-[#15231C]">Mimari Seçenek, Metraj ve Teklif</h3>
              <p class="mt-2.5 text-xs text-[#5A544C] leading-relaxed">
                Teknik yerleşim, gerekiyorsa 3D sunum, malzeme/işçilik kapsamı, dahil-hariç işler ve uygulanabilir termin yazılı teklifin temelini oluşturur.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-[#F3EFEA] text-[11px] font-medium text-[#756E65]">
              Ayrıntılı keşif özeti
            </div>
          </div>

          <div class="bg-white rounded-2xl p-6 border border-[#E5E2DA] shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl font-black text-[#C5A880]/50">04</span>
                <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-[#F3EFEA] text-[#15231C]">TESLİM</span>
              </div>
              <h3 class="text-base font-bold text-[#15231C]">Sözleşme, Uygulama ve Kabul</h3>
              <p class="mt-2.5 text-xs text-[#5A544C] leading-relaxed">
                Taraflar şartlarda mutabık kaldığında iş programı, sorumlular ve kontrol noktaları yazılı hâle getirilir. Kapsam değişiklikleri ayrıca onaylanır.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-[#F3EFEA] text-[11px] font-medium text-[#756E65]">
              Resmi şantiye yönetimi
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- BÖLÜM 4: KONSEPT TASARIM & MİMARİ ETÜTLER (PORTFÖY)                   -->
    <!-- Şeffaf Etiketleme ve Alpine.js Filtreleme                             -->
    <!-- ===================================================================== -->
    <section id="projeler-grid" class="py-16 sm:py-20 bg-white border-b border-[#E5E2DA]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 pb-6 border-b border-[#E5E2DA]">
          <div>
            <span class="text-[11px] font-bold text-[#8F7249] tracking-widest uppercase">MİMARİ ETÜTLER VE VİZYON ÇALIŞMALARI</span>
            <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#15231C] tracking-tight mt-1.5">
              Konsept Tasarım & Mimari Etütler
            </h2>
            <p class="mt-2 text-xs sm:text-sm text-[#5A544C] max-w-xl">
              Lüks perakende mağazaları, holding ofisleri ve ticari mekanlar için hazırladığımız mimari görselleştirme ve konsept tasarım örnekleri.
            </p>
          </div>

          <div class="p-3 bg-[#FAF9F6] rounded-xl border border-[#E5E2DA] text-[11px] text-[#756E65] max-w-sm">
            ℹ️ <strong class="text-[#15231C]">Şeffaflık Notu:</strong> Yayımlanmış portföy örnekleri konsept görselleştirme ve mimari etüt niteliğindedir. Sahadaki her projede tasarım ile uygulama kapsamı karşılıklı sözleşmeyle netleştirilir.
          </div>
        </div>

        <!-- Kategori Sekmeleri -->
        <div class="flex flex-wrap items-center gap-2 mb-10">
          {projectCategories.map((cat) => (
            <button
              type="button"
              class="px-3.5 sm:px-4 py-2 rounded-lg text-xs font-bold tracking-tight transition-all duration-200 cursor-pointer"
              :class={`activeFilter === '${cat.id}' ? 'bg-[#15231C] text-white shadow-sm' : 'bg-[#F3EFEA] text-[#4A443D] hover:bg-[#EAE4DC] hover:text-[#15231C]'`}
              @click={`activeFilter = '${cat.id}'`}
            >
              <span>{cat.label}</span>
              <span
                class="ml-1.5 px-1.5 py-0.2 rounded text-[10px]"
                :class={`activeFilter === '${cat.id}' ? 'bg-white/20 text-white' : 'bg-[#E5E2DA] text-[#5A544C]'`}
              >
                {cat.count}
              </span>
            </button>
          ))}
        </div>

        <!-- 3-Kolonlu Mimari Kart Izgarası -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {manifestoProjects.map((p, index) => (
            <article
              class="group relative bg-[#FAF9F6] rounded-xl overflow-hidden border border-[#E5E2DA] hover:border-[#C5A880]/60 shadow-[0_2px_12px_rgba(21,35,28,0.04)] hover:shadow-[0_16px_36px_rgba(21,35,28,0.1)] transition-all duration-300 flex flex-col cursor-pointer"
              x-show={`activeFilter === 'all' || activeFilter === '${p.categoryGroup}'`}
              x-transition:enter="transition ease-out duration-200"
              x-transition:enter-start="opacity-0 scale-95"
              x-transition:enter-end="opacity-100 scale-100"
              @click={`openModal(${JSON.stringify(p)})`}
            >
              <div class="relative w-full aspect-[16/11] overflow-hidden bg-[#15231C]">
                <img
                  src={p.image}
                  alt={p.title}
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                  loading={index < 3 ? "eager" : "lazy"}
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity"></div>
                <div class="absolute top-3 left-3 flex items-center gap-1.5">
