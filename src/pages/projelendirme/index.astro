                  id="ym-company"
                  name="company"
                  type="text"
                  autocomplete="organization"
                  maxlength="120"
                  placeholder="Örn: Velunor Mimarlık A.Ş."
                  class="w-full bg-slate-900/90 border border-slate-600 focus:border-amber-400 rounded-lg px-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition-colors"
                />
              </div>

              <!-- Telefon -->
