const voloImages = ["/images/models/genc-odasi/volo/01.webp", "/images/models/genc-odasi/volo/02.webp", "/images/models/genc-odasi/volo/03.webp", "/images/models/genc-odasi/volo/04.webp", "/images/models/genc-odasi/volo/05.webp", "/images/models/genc-odasi/volo/06.webp", "/images/models/genc-odasi/volo/07.webp", "/images/models/genc-odasi/volo/08.webp", "/images/models/genc-odasi/volo/09.webp", "/images/models/genc-odasi/volo/10.webp", "/images/models/genc-odasi/volo/11.webp", "/images/models/genc-odasi/volo/12.webp", "/images/models/genc-odasi/volo/13.webp", "/images/models/genc-odasi/volo/14.webp", "/images/models/genc-odasi/volo/15.webp", "/images/models/genc-odasi/volo/16.webp", "/images/models/genc-odasi/volo/17.webp"];
const arcadiaImages = ["/images/models/genc-odasi/arcadia/01.webp", "/images/models/genc-odasi/arcadia/02.webp", "/images/models/genc-odasi/arcadia/03.webp", "/images/models/genc-odasi/arcadia/04.webp", "/images/models/genc-odasi/arcadia/05.webp", "/images/models/genc-odasi/arcadia/06.webp", "/images/models/genc-odasi/arcadia/07.webp", "/images/models/genc-odasi/arcadia/08.webp", "/images/models/genc-odasi/arcadia/09.webp", "/images/models/genc-odasi/arcadia/10.webp", "/images/models/genc-odasi/arcadia/11.webp", "/images/models/genc-odasi/arcadia/12.webp", "/images/models/genc-odasi/arcadia/13.webp", "/images/models/genc-odasi/arcadia/14.webp"];
---

<Layout seo={seo} activeService="genc-odasi">
  <main class="w-full bg-[#FAF9F6] text-[#15231C] min-h-screen py-8 sm:py-12">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 space-y-12 sm:space-y-16">
      
      <!-- BREADCRUMB -->
      <nav class="flex items-center space-x-2 text-[13px] text-[#756E65] font-normal" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#15231C] transition">Ana Sayfa</a>
        <span>/</span>
        <span class="text-[#15231C] font-semibold">Genç Odası</span>
      </nav>

      <!-- H1 BAŞLIK -->
      <div class="pt-2">
        <h1 class="text-3xl sm:text-5xl font-bold text-[#15231C] tracking-tight leading-none" style="font-family: 'Roboto', sans-serif;">
          Genç Odası
        </h1>
      </div>

      <!-- KOLEKSİYON SLIDERLARI (Özgün Koleksiyonlar: Moderna, Aura, Elegance) -->
      <div class="space-y-16 sm:space-y-24">
        <ModelSlider 
          name="Moderna"
          desc="Gençliğin ritmine ayak uyduran tasarımlar. Modüler çalışma üniteleri, geniş depolama çözümleri ve dinamik renk kombinasyonları ile gençlerin kendi alanlarını yaratmalarını sağlar."
          images={golfImages}
        />

        <ModelSlider 
          name="Aura"
          desc="Aura genç odası koleksiyonu, yalın tasarımıyla dikkat çekerken, gençlerin değişen ihtiyaçlarına pratik ve şık çözümler sunar. Modüler yapısıyla kişisel alanı özgürce düzenleme imkanı tanır; çalışmak, dinlenmek ve hayal kurmak için ideal bir ortam yaratır."
          images={voloImages}
        />

        <ModelSlider 
          name="Elegance"
          desc="Klasik stil, her yaşa uyum sağlar. Zamansız çizgiler, doğal ahşap dokunuşlar ve konforlu detaylarla uzun yıllar keyifle kullanılacak genç odaları."
          images={arcadiaImages}
        />
      </div>

      <!-- DİĞER KOLEKSİYONLAR -->
      <div class="pt-12 sm:pt-16 border-t border-[#E5E2DA]">
        <h2 class="text-xl sm:text-2xl font-bold text-[#15231C] tracking-tight mb-6" style="font-family: 'Roboto', sans-serif;">
          Diğer Koleksiyonlar
        </h2>
        <div class="flex flex-wrap gap-3 sm:gap-4">
          {otherCollections.map((c) => (
            <a 
              href={c.href}
              class="px-5 py-2.5 bg-white border border-[#D0CAC0] hover:border-[#15231C] hover:bg-[#15231C] hover:text-white text-xs font-semibold text-[#15231C] transition-all select-none"
            >
              {c.name}
            </a>
          ))}
        </div>
      </div>

      <!-- DAHA FAZLA BİLGİ ALIN -->
      <div class="pt-10 sm:pt-14 pb-8 border-t border-[#E5E2DA]" id="bilgi-al">
        <div class="max-w-2xl">
          <h2 class="text-2xl sm:text-3xl font-bold text-[#15231C] tracking-tight mb-2" style="font-family: 'Roboto', sans-serif;">
            Daha Fazla Bilgi Alın
          </h2>
          <p class="text-xs sm:text-sm text-[#756E65] font-normal mb-8">
            Genç odası projeniz için mimari ekibimizden detaylı bilgi ve 3D tasarım teklifi alın.
          </p>

          <form action="https://wa.me/905324261788" method="GET" target="_blank" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="adsoyad" class="block text-xs font-semibold text-[#15231C] mb-1.5">Ad Soyad*</label>
                <input type="text" id="adsoyad" name="adsoyad" required placeholder="Adınız ve Soyadınız" class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] focus:outline-none focus:border-[#15231C] transition" />
              </div>
              <div>
                <label for="telefon" class="block text-xs font-semibold text-[#15231C] mb-1.5">Telefon*</label>
                <input type="tel" id="telefon" name="telefon" required placeholder="05XX XXX XX XX" class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] focus:outline-none focus:border-[#15231C] transition" />
              </div>
            </div>
            <div>
              <label for="email" class="block text-xs font-semibold text-[#15231C] mb-1.5">E-posta*</label>
              <input type="email" id="email" name="email" required placeholder="ornek@email.com" class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] focus:outline-none focus:border-[#15231C] transition" />
            </div>
            <div>
              <label for="mesaj" class="block text-xs font-semibold text-[#15231C] mb-1.5">Mesajınız</label>
              <textarea id="mesaj" name="mesaj" rows="3" placeholder="İlgilendiğiniz genç odası modeli veya özel istekleriniz..." class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] focus:outline-none focus:border-[#15231C] transition"></textarea>
            </div>
            <div class="pt-2">
              <button type="submit" class="w-full sm:w-auto px-8 py-3 bg-[#15231C] hover:bg-[#006039] text-white text-xs font-bold uppercase tracking-wider transition-colors duration-200 select-none">
                Gönder
              </button>
            </div>
          </form>
        </div>
      </div>

    </div>
  </main>
</Layout>
