---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../data/siteConfig";
import tasarimlar from "../data/tasarimlarData.json";

// Kare formatta sergilenecek 8 seçkin tasarım modeli
const featuredModels = tasarimlar.slice(0, 8);

const seo = {
  title: "Yeşilay Mutfak — Lüks Mutfak Tasarımı, Banyo & Anahtar Teslim Renovasyon",
  description: "İzmir Buca Adatepe atölyemizden kişiye ve mekâna özel projelendirilen akrilik, lake mutfak dolapları, lüks banyo renovasyonu ve anahtar teslim konut taahhüdü. 28 yıllık tecrübe, 137 tescilli model arşivi.",
  canonical: `${siteConfig.siteUrl}/`,
  serviceName: "Lüks Mimarlık & Mutfak İmalatı",
  keywords: [
    "yeşilay mutfak luxury",
    "yeşilay mutfak mimarlık",
    "izmir özel mutfak dolabı",
    "lake mutfak modelleri 2026",
    "lüks banyo dolabı izmir",
    "adatepe mutfak atölyesi",
    "çeşme mutfak tadilatı",
    "urla lüks renovasyon"
  ],
  faqList: [
    {
      question: "Dolap kapaklarında parmak izi ve leke tutmayan malzeme kullanıyor musunuz?",
      answer: "Evet. Koleksiyonumuzda özel nanoteknolojik ipek mat lake ve İtalyan akrilik kapaklar kullanıyoruz. Yüzeyler parmak izi tutmaz, nemli mikro fiber bezle tek hamlede kolayca temizlenir."
    },
    {
      question: "Tasarım aşamasında renk ve malzeme uyumunu nasıl görebiliriz?",
      answer: "Mimarımız yerinde lazer rölöve aldıktan sonra evinizin ışık açısına uygun fotogerçekçi 3D mimari çizim hazırlar. Tezgah, kulp, zemin ve kapak renk uyumunu üretime geçmeden önce ekranınızda birebir görürsünüz."
    },
    {
      question: "Çekmece ve dolap iç mekanizmalarında hangi donanımları tercih ediyorsunuz?",
      answer: "Tüm sistemlerimizde Avusturya menşeili Blum ve Almanya menşeili Häfele entegre sessiz frenli raylar ve kiler sistemleri kullanıyoruz. Çekmeceler tek dokunuşla sessizce kapanır ve 10 yıl garantilidir."
    },
    {
      question: "İzmir genelinde mutfak yaptırırken Yeşilay Mutfak'ı tercih etmenin somut avantajı nedir?",
      answer: "Aracı veya komisyoncu showroom olmadan doğrudan Buca Adatepe imalat atölyemizden birinci el fiyat alırsınız. Gövdede standart olarak neme mukavemetli 18mm E1 MDF-Lam ve Avusturya Blum mekanizma kullanılır. Resmi sözleşmemizde taahhüt edilen teslim tarihine sadakat garantisi ve gecikilen her takvim günü için cezai şart güvencesi sunulur."
    },
    {
      question: "Türkiye genelinden veya şehir dışından (İstanbul, Bodrum, Ankara vb.) özel mutfak siparişi verebilir miyiz?",
      answer: "Evet. Mimari plan veya yaklaşık ölçü gönderen müşterilerimiz için 2 saat içinde fotogerçekçi 3D mimari modelleme ve net atölye maliyeti hazırlanır. Buca atölyemizde CNC ve fırın lake ile üretilen dolaplar korunaklı sandıklı lojistikle Türkiye geneline sevk edilir ve talep edilirse uzman montaj ekibimizce yerinde kurulur."
    },
    {
      question: "Mutfak tadilatında usta dolandırıcılığı veya sonradan fiyat artışına karşı güvenceniz nedir?",
      answer: "Yeşilay Mutfak tüm işlerinde resmi ıslak imzalı sözleşme yapar. Sözleşmede teslim günü kesin olarak yazılır ve gecikilen her takvim günü için resmi gecikme tazminatı ödenir. Sabit fiyat garantisi geçerlidir; iş başladıktan sonra malzeme veya işçilik adı altında 1 TL dahi ek ücret talep edilmez."
    },
    {
      question: "Sözleşmeli süre taahhüdü ve temiz teslimat garantiniz var mı?",
      answer: "Tüm projelerimizi resmi noter onaylı gecikme cezalı sözleşmeyle yürütüyoruz. İmalat ve montaj ekibimiz montaj bitiminde detaylı temizlik yaparak alanınızı kullanıma hazır teslim eder."
    }
  ]
};
---

<Layout seo={seo} activeService="Ana Sayfa">

  <!-- ===================================================================== -->
    <!-- ===================================================================== -->
    <!-- ===================================================================== -->
  <!-- 1. PREMİUM SİNEMATİK HERO SLIDER (%100 NETLİK, SOL ALT LOCUS TYPOGRAPHY)-->
  <!-- ===================================================================== -->
  <section class="relative w-full bg-[#161617] overflow-hidden select-none font-roboto">
    
    <div 
      class="relative w-full h-[54svh] sm:h-[62svh] lg:h-[68svh] max-h-[720px] min-h-[380px] sm:min-h-[440px] overflow-hidden"
      x-data="{ 
        current: 0,
        total: 4,
        timer: null,
        slides: [
          {
            title: 'Sakura',
            subtitle: 'El becerisi, yaratıcılık ve deneyim.',
            image: '/media/hero/hero-slide-1.webp',
            link: '/tasarimlar/'
          },
          {
            title: 'Iconica',
            subtitle: 'Geleneksel anlayışları aşan minimalist mimari estetik.',
            image: '/media/hero/hero-slide-2.webp',
            link: '/tasarimlar/'
          },
          {
            title: 'Milano',
            subtitle: 'İtalyan zarafeti ve büyük mimarlık anlayışı.',
            image: '/media/hero/hero-slide-3.webp',
            link: '/tasarimlar/'
          },
          {
            title: 'Lounge',
            subtitle: 'Fonksiyonel ve estetik açıdan kusursuz mekanlar.',
            image: '/media/hero/hero-slide-4.webp',
            link: '/tasarimlar/'
          }
        ],
        start() {
          this.timer = setInterval(() => { this.next() }, 6000);
        },
        stop() {
          if (this.timer) clearInterval(this.timer);
        },
        next() {
          this.current = (this.current + 1) % this.total;
        },
        prev() {
          this.current = (this.current - 1 + this.total) % this.total;
        }
      }"
      x-init="start()"
      @mouseenter="stop()"
      @mouseleave="start()"
    >
      <!-- Slide 1: Sakura (%100 Net Görsel) -->
      <div 
        class="absolute inset-0 w-full h-full transition-all duration-1000 ease-out"
        :class="current === 0 ? 'opacity-100 scale-100 z-10' : 'opacity-0 scale-105 z-0 pointer-events-none'"
      >
        <picture class="w-full h-full block">
          <source srcset="/media/hero/hero-slide-1.avif" type="image/avif" />
          <source srcset="/media/hero/hero-slide-1.webp" type="image/webp" />
          <img 
            src="/media/hero/hero-slide-1.webp" 
            alt="Yeşilay Mutfak Sakura Özel İmalat Yaşam Alanı" 
            class="w-full h-full object-cover object-center block brightness-100 contrast-100"
            loading="eager"
            decoding="sync"
            fetchpriority="high"
            width="1920"
            height="977"
          />
        </picture>
      </div>

      <!-- Slide 2: Iconica (%100 Net Görsel) -->
      <div 
        class="absolute inset-0 w-full h-full transition-all duration-1000 ease-out"
        :class="current === 1 ? 'opacity-100 scale-100 z-10' : 'opacity-0 scale-105 z-0 pointer-events-none'"
      >
        <picture class="w-full h-full block">
          <source srcset="/media/hero/hero-slide-2.avif" type="image/avif" />
          <source srcset="/media/hero/hero-slide-2.webp" type="image/webp" />
          <img 
            src="/media/hero/hero-slide-2.webp" 
            alt="Yeşilay Mutfak Iconica Mutfak ve Salon Tasarımı" 
            class="w-full h-full object-cover object-center block brightness-100 contrast-100"
            loading="lazy"
            decoding="async"
            width="1920"
            height="977"
          />
        </picture>
      </div>

      <!-- Slide 3: Milano (%100 Net Görsel) -->
      <div 
        class="absolute inset-0 w-full h-full transition-all duration-1000 ease-out"
        :class="current === 2 ? 'opacity-100 scale-100 z-10' : 'opacity-0 scale-105 z-0 pointer-events-none'"
      >
        <picture class="w-full h-full block">
          <source srcset="/media/hero/hero-slide-3.avif" type="image/avif" />
          <source srcset="/media/hero/hero-slide-3.webp" type="image/webp" />
          <img 
            src="/media/hero/hero-slide-3.webp" 
            alt="Yeşilay Mutfak Milano Gömme Dolap ve Mutfak Modelleri" 
            class="w-full h-full object-cover object-center block brightness-100 contrast-100"
            loading="lazy"
            decoding="async"
            width="1920"
            height="977"
          />
        </picture>
      </div>

      <!-- Slide 4: Lounge (%100 Net Görsel) -->
      <div 
        class="absolute inset-0 w-full h-full transition-all duration-1000 ease-out"
        :class="current === 3 ? 'opacity-100 scale-100 z-10' : 'opacity-0 scale-105 z-0 pointer-events-none'"
      >
        <picture class="w-full h-full block">
          <source srcset="/media/hero/hero-slide-4.webp" type="image/webp" />
          <img 
            src="/media/hero/hero-slide-4.webp" 
            alt="Yeşilay Mutfak Lounge Özel Ölçü Lake Tasarım" 
            class="w-full h-full object-cover object-center block brightness-100 contrast-100"
            loading="lazy"
            decoding="async"
            width="1024"
            height="642"
          />
        </picture>
      </div>

      <!-- SOL ALT BÖLÜM: LOCUS BİREBİR TARZ & FONT & FONT-SIZE AÇIKLAMA -->
      <!-- Font: Roboto, Title: 48px/bold, Subtitle: 18px/normal, Degrade: Locus framer-gnukv0 -->
      <div 
        class="absolute inset-0 z-20 flex flex-col justify-end items-start p-5 sm:p-7 lg:p-[30px] pointer-events-none"
        style="background: linear-gradient(180deg, rgba(84, 84, 84, 0) 59.95%, rgba(59, 59, 59, 0.3) 74.63%, rgba(5, 5, 5, 0.38) 94.23%);"
      >
        <a 
          :href="slides[current].link" 
          class="block text-left text-white pointer-events-auto group max-w-xl"
        >
          <h2 
            x-text="slides[current].title" 
            class="text-[32px] sm:text-[40px] lg:text-[48px] font-bold text-white tracking-[-0.04em] leading-[1.2] sm:leading-[1.4] m-0"
            style="font-family: 'Roboto', sans-serif;"
          >
            Sakura
          </h2>
          <p 
            x-text="slides[current].subtitle" 
            class="text-[15px] sm:text-[17px] lg:text-[18px] font-normal text-white tracking-[-0.04em] leading-[1.3] sm:leading-[1.4] mt-1 sm:mt-1.5 opacity-95"
            style="font-family: 'Roboto', sans-serif;"
          >
            El becerisi, yaratıcılık ve deneyim.
          </p>
        </a>
      </div>

      <!-- Locus Birebir Dairesel Oklar (37x37px, Radius 50%, font-size: 30px) -->
      <button 
        type="button" 
        @click="prev()" 
        class="absolute left-[15px] top-1/2 -translate-y-1/2 z-30 w-[37px] h-[37px] rounded-full bg-black/25 hover:bg-black/50 text-white flex items-center justify-center font-roboto text-[30px] font-light leading-none cursor-pointer border-0 transition-colors focus:outline-none"
        aria-label="Previous"
      >
        ‹
      </button>

      <button 
        type="button" 
        @click="next()" 
        class="absolute right-[15px] top-1/2 -translate-y-1/2 z-30 w-[37px] h-[37px] rounded-full bg-black/25 hover:bg-black/50 text-white flex items-center justify-center font-roboto text-[30px] font-light leading-none cursor-pointer border-0 transition-colors focus:outline-none"
        aria-label="Next"
      >
        ›
      </button>

      <!-- Sağ Alt: Minimal Slayt Göstergesi -->
      <div class="absolute bottom-5 right-5 sm:bottom-7 sm:right-8 z-30 flex items-center gap-1.5">
        <template x-for="(slide, i) in total" :key="i">
          <button 
            type="button" 
            @click="current = i" 
            class="h-1 rounded-full transition-all duration-300 focus:outline-none" 
            :class="current === i ? 'w-6 bg-white' : 'w-2 bg-white/40 hover:bg-white/80'" 
            :aria-label="'Slayt ' + (i + 1)"
          ></button>
        </template>
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 1.1. PREMİUM HERO ALTI TANITIM & CTA BÖLÜMÜ (MİMARİ DÜZEN, SIFIR AI İZİ) -->
  <!-- ===================================================================== -->
  <section class="relative w-full bg-[#FAF9F6] border-b border-[#E5DFD5] py-12 sm:py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- Sol Kolon: Başlık + Açıklama + CTA Butonları (7/12) -->
        <div class="lg:col-span-7 space-y-4 sm:space-y-5">
          
          <!-- Saf Kurumsal Eyebrow (Sıfır AI Rozeti, Yalın Mimari Metin) -->
          <span class="block text-[12px] font-semibold tracking-[0.14em] uppercase text-[#6E675F] font-roboto">
            ADATEPE İMALAT ATÖLYESİ • 28 YILLIK TECRÜBE
          </span>

          <!-- Dinamik Akıcı H1 Başlık (SIFIR İTALİK - DİK, GÜÇLÜ TİPOGRAFİ) -->
          <h1 class="text-[clamp(28px,3.2vw,48px)] font-bold text-[#1D1D1F] leading-[1.15] tracking-[-0.03em]">
            Hayalinizdeki Mutfağı, <br />
            <span class="text-[#006039]">Kişiye Özel Çizgilerle</span> <br />
            <span class="text-[#0A2E1F]">Gerçeğe Dönüştürüyoruz.</span>
          </h1>

          <!-- Dinamik Alt Metin -->
          <p id="hero-answer-engine" class="text-[15px] sm:text-[16px] text-[#424245] font-normal leading-[1.55] max-w-xl tracking-[-0.01em]">
            Leke tutmayan ipek mat kapaklar, fırçalanmış pirinç detaylar, kadife sessizliğinde Blum raylar ve ferahlatıcı mimari planlama. İzmir genelinde ücretsiz 3D keşif ve sözleşmeli üretim garantisi.
          </p>

          <!-- Call to Action Buttons (Hero Altında Ergonomik ve Kurumsal) -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
            <a 
              href={siteConfig.whatsappUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-7 py-3.5 sm:py-4 bg-[#006039] hover:bg-[#00482B] text-white text-[13px] sm:text-[13.5px] font-semibold tracking-[-0.01em] rounded-full border border-[#C5A880]/60 shadow-[0_8px_24px_rgba(0,96,57,0.3)] hover:shadow-[0_12px_32px_rgba(0,96,57,0.4)] transition duration-200 flex items-center justify-center gap-2 group"
            >
              <span>WhatsApp ile 3D Keşif İste</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
            <a 
              href="/tasarimlar/" 
              class="px-7 py-3.5 sm:py-4 bg-white hover:bg-[#F5F5F7] text-[#006039] border border-[#006039]/30 hover:border-[#006039] text-[13px] sm:text-[13.5px] font-semibold tracking-[-0.01em] rounded-full shadow-2xs hover:shadow-xs transition duration-200 flex items-center justify-center gap-2"
            >
              <span>450 Tasarım Modelini İncele</span>
            </a>
            <a 
              href="tel:+902324411060" 
              class="px-4 py-3 sm:py-3.5 text-[#55504A] hover:text-[#006039] text-[12.5px] sm:text-[13px] font-medium transition duration-200 flex items-center justify-center gap-1.5"
            >
              <span>📞 0 (232) 441 10 60</span>
            </a>
          </div>

        </div>

        <!-- Sağ Kolon: Genişletilmiş Premium Hareketli Sayaç Kartı (5/12) -->
        <div class="lg:col-span-5">
          <div id="statsDock" class="bg-white border border-[#006039]/20 rounded-2xl p-6 sm:p-7 shadow-[0_14px_40px_rgba(0,96,57,0.07)] relative overflow-hidden">
            <div class="absolute -right-8 -bottom-8 w-44 h-44 bg-[#006039]/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -left-8 -top-8 w-36 h-36 bg-[#C5A880]/10 rounded-full blur-2xl pointer-events-none"></div>

            <div class="grid grid-cols-2 gap-4 sm:gap-6 relative z-10">
              
              <!-- Sayaç 1: 137 Model -->
              <div class="space-y-1 pr-2 border-r border-[#E5DFD5]/80">
                <div class="flex items-baseline gap-1.5">
                  <span class="stat-counter text-2xl sm:text-3xl lg:text-[34px] font-bold tracking-tight text-[#1D1D1F] font-sans" data-target="137">137</span>
                  <span class="text-xs sm:text-sm font-bold text-[#C5A880]">Model</span>
                </div>
                <div class="text-[10px] sm:text-[10.5px] uppercase tracking-wider text-[#C5A880] font-bold">Özgün Koleksiyon</div>
                <p class="text-[11px] text-[#6E675F] leading-snug">Mutfak, banyo ve kapı arşivi.</p>
              </div>

              <!-- Sayaç 2: 28 Yıl -->
              <div class="space-y-1 pl-2">
                <div class="flex items-baseline gap-1.5">
                  <span class="stat-counter text-2xl sm:text-3xl lg:text-[34px] font-bold tracking-tight text-[#006039] font-sans" data-target="28">28</span>
                  <span class="text-xs sm:text-sm font-bold text-[#006039]">Yıl</span>
                </div>
                <div class="text-[10px] sm:text-[10.5px] uppercase tracking-wider text-[#006039] font-bold">Atölye Mirası</div>
                <p class="text-[11px] text-[#6E675F] leading-snug">1998'den bu yana imalat.</p>
              </div>

              <!-- Sayaç 3: 10 Yıl -->
              <div class="space-y-1 pr-2 pt-3 sm:pt-4 border-r border-t border-[#E5DFD5]/80">
                <div class="flex items-baseline gap-1.5">
                  <span class="stat-counter text-2xl sm:text-3xl lg:text-[34px] font-bold tracking-tight text-[#1D1D1F] font-sans" data-target="10">10</span>
                  <span class="text-xs sm:text-sm font-bold text-[#C5A880]">Yıl</span>
                </div>
                <div class="text-[10px] sm:text-[10.5px] uppercase tracking-wider text-[#C5A880] font-bold">Gövde Garantisi</div>
                <p class="text-[11px] text-[#6E675F] leading-snug">E1 neme dayanımlı MDF.</p>
              </div>

              <!-- Sayaç 4: 2.850+ -->
              <div class="space-y-1 pl-2 pt-3 sm:pt-4 border-t border-[#E5DFD5]/80">
                <div class="flex items-baseline gap-0.5">
                  <span class="stat-counter text-2xl sm:text-3xl lg:text-[34px] font-bold tracking-tight text-[#1D1D1F] font-sans" data-target="2850" data-format="comma">2.850</span>
                  <span class="text-xl sm:text-2xl font-extrabold text-[#006039]">+</span>
                </div>
                <div class="text-[10px] sm:text-[10.5px] uppercase tracking-wider text-[#006039] font-bold">Tamamlanan Proje</div>
                <p class="text-[11px] text-[#6E675F] leading-snug">Mutlu müşteri referansı.</p>
              </div>

            </div>

            <!-- Kurumsal Güvence Barı (Sıfır AI İzi) -->
            <div class="mt-4 pt-3 border-t border-[#E5DFD5]/80 flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 text-[11px] text-[#55504A] relative z-10">
              <div>
                <span><strong>Adatepe Atölyesi:</strong> Aracı komisyonsuz, milimetrik lazer rölöve ve 3D çizim.</span>
              </div>
              <a href="/tasarimlar/" class="text-[#006039] font-bold hover:underline inline-flex items-center gap-1 shrink-0">
                Koleksiyonu İncele →
              </a>
            </div>

          </div>
        </div>

      </div>

    </div>
  </section>
<!-- 2. APPLE 4-SÜTUNLU MİMARİ AVANTAJ KARTLARI (BÜYÜK & PREMİUM NUMARALAR)-->
  <!-- ===================================================================== -->
  <section class="py-16 sm:py-20 border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      
      <!-- GHOST / WATERMARK TYPOGRAPHY HEADER (Dev Enlemesine Soft Watermark Üstte, Altında Başlık Grubu) -->
      <div class="text-center w-full max-w-7xl mx-auto flex flex-col items-center justify-center space-y-2 sm:space-y-3">
        <div class="w-full max-w-3xl sm:max-w-4xl md:max-w-5xl px-4 flex items-center justify-center pointer-events-none select-none">
          <svg viewBox="0 0 580 165" class="w-full h-auto max-h-[85px] sm:max-h-[115px] md:max-h-[140px]" preserveAspectRatio="xMidYMid meet">
            <text x="50%" y="54%" dominant-baseline="central" text-anchor="middle" font-size="160" font-weight="700" font-style="normal" font-family="'Cormorant Garamond', 'Playfair Display', Georgia, serif" fill="#D5D0C5" letter-spacing="-0.02em">Zanaat.</text>
          </svg>
        </div>
        <div class="space-y-2.5 px-4 max-w-3xl mx-auto">
          <h2 class="text-[28px] sm:text-[38px] md:text-[44px] font-extrabold text-[#1D1D1F] tracking-tight leading-tight">
            Kusursuz Detaylar. Tavizsiz Kalite.
          </h2>
          <p class="text-[15px] sm:text-[16.5px] text-[#55504A] font-normal max-w-xl mx-auto leading-relaxed">
            Her milimetresi yaşam alışkanlıklarınıza ve mekanınızın ışığına göre şekillenen birinci sınıf atölye üretimi.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Kart 01 -->
        <div class="p-8 bg-white border border-[#E5DFD5] hover:border-[#006039]/50 rounded-2xl apple-card space-y-5 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_16px_36px_rgba(0,96,57,0.12)] transition duration-300 group">
          <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-[#006039] to-[#042015] text-[#C5A880] border border-[#C5A880]/50 flex items-center justify-center text-[38px] font-black font-sans shadow-[0_8px_24px_rgba(0,96,57,0.4)] group-hover:scale-105 transition-transform duration-300">
            01
          </div>
          <h3 class="text-[21px] sm:text-[22px] font-extrabold text-[#1D1D1F] tracking-tight leading-snug">Leke Tutmayan Mat Yüzeyler</h3>
          <p class="text-[15px] text-[#55504A] font-normal leading-[1.6]">
            Parmak izi bırakmayan, nem ve buhardan etkilenmeyen antibakteriyel İtalyan lake ve akrilik teknolojisi.
          </p>
        </div>

