---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../data/siteConfig";

const seo = {
  title: "Yeşilay Mutfak | İthal ve İtalyan Mutfak Tasarımı İzmir",
  description: "Yeşilay Mutfak; özgün İtalyan mutfak koleksiyonları, modern yaşam alanı mobilyaları ve projeye özel mimari çözümleri İzmir ve Ege Bölgesi'nde sunar.",
  canonical: `${siteConfig.siteUrl}/`,
  serviceName: "Lüks Mimarlık & Mutfak İmalatı",
  keywords: [
    "yeşilay mutfak",
    "izmir lüks mutfak tasarımı",
    "italyan mutfak izmir",
    "özel mutfak dolabı izmir",
    "modern mutfak modelleri",
    "buca mutfak atölyesi",
    "alsancak mutfak showroom",
    "mimari mutfak projelendirme"
  ]
};

// Modeller Verisi (Locus 2 Col Modeller Birebir)
const kitchenModels = [
  {
    id: "iconica",
    title: "Iconica",
    desc1: "Iconica, geleneksel tasarım anlayışlarını aşan ve üst gola profilini ortadan kaldıran bir sistemle yeni bir estetik bakış açısı sunuyor.",
    desc2: "Tezgah ve kapak arasında kusursuz bir bütünlük sağlanıyor. Farklı ve yeni malzemelerle sınırsız estetik seçenekler sunuyor.",
    image: "/images/locus/model-iconica.jpg",
    link: "/tasarimlar/"
  },
  {
    id: "lounge",
    title: "Lounge",
    desc1: "Lounge form fonksiyonu takip eder felsefesiyle şekillenerek, günlük yaşamı estetik ve işlevsellik odaklı yorumluyor. Böylece mutfak ortamını fonksiyonel ve estetik açıdan tatmin edici hale getiriyor.",
    desc2: "Alçaltılmış baza yapısı ile çağdaş ve minimalist bakış açısı vurgulanıyor.",
    image: "/images/locus/model-lounge.jpg",
    link: "/tasarimlar/"
  },
  {
    id: "milano",
    title: "Milano",
    desc1: 'Milano, "Made in Italy" tasarım geleneği ve büyük mimarlık anlayışına dayanan bir stilin ifadesidir. Gerçek bir "yeni stil" olarak, fazla süsleme veya abartıdan uzak, sade, net ve etkileyici bir anlayışla mekan kalitesini yansıtır.',
    desc2: "Asil ahşap ve taş dokusuyla zamansız bir dinginlik sunar.",
    image: "/images/locus/model-milano.jpg",
    link: "/tasarimlar/"
  },
  {
    id: "pavese",
    title: "Pavese",
    desc1: "Geçmişin tatlarına dönüş. Pavese, deneyim, zanaatkarlık ve ustalık değerlerini yaşatan bir işleme sürecinin sonucudur.",
    desc2: "45° kesimli çerçeve ve özel tasarım kulpuyla öne çıkan kapak, geleneksel dünyayı yeniden yorumlayarak benzersiz tatlarla dolu bir mutfak atmosferi sunuyor.",
    image: "/images/locus/model-pavese.jpg",
    link: "/tasarimlar/"
  }
];

// Mobilya ve Yaşam Alanları (Locus Colombini Slider Birebir)
const furnitureCategories = [
  { name: "Salon", image: "/images/locus/mob-salon.webp", link: "/salon-modelleri/" },
  { name: "Kitaplık", image: "/images/locus/mob-kitaplik.jpg", link: "/tasarimlar/" },
  { name: "Yatak Odası", image: "/images/locus/mob-yatak.webp", link: "/yatak-odasi-modelleri/" },
  { name: "Genç Odası", image: "/images/locus/mob-genc.webp", link: "/genc-odasi-modelleri/" },
  { name: "Çocuk Odası", image: "/images/locus/mob-cocuk.webp", link: "/cocuk-odasi-modelleri/" },
  { name: "Çamaşır Odası", image: "/images/locus/mob-camasir.jpg", link: "/camasir-odasi-modelleri/" }
];

// Sandalye & Masa Galeri Görselleri (Et al. Birebir)
const chairImages = [
  "/images/locus/sandalye-1.jpg",
  "/images/locus/sandalye-2.jpg",
  "/images/locus/sandalye-3.jpg",
  "/images/locus/sandalye-4.jpg",
  "/images/locus/sandalye-5.jpg",
  "/images/locus/sandalye-6.jpg",
  "/images/locus/sandalye-7.jpg",
  "/images/locus/sandalye-8.jpg",
  "/images/locus/sandalye-9.jpg",
  "/images/locus/sandalye-10.jpg",
  "/images/locus/sandalye-11.jpg",
  "/images/locus/sandalye-12.jpg"
];
---

<Layout seo={seo} activeService="Ana Sayfa">

  <!-- ===================================================================== -->
  <!-- 1. HERO SLIDER ALANI (LOCUS LIGHTWEIGHT HERO SLIDER BİREBİR)          -->
  <!-- Ölçü: max-w-[1200px], aspect-ratio: 2.4 (1200x500/600), Roboto Font   -->
  <!-- Oklar: Sol ve sağda 37px dairesel yarı saydam ‹ ve › butonları         -->
  <!-- ===================================================================== -->
  <section class="w-full bg-white font-roboto overflow-hidden">
    <div 
      class="w-full max-w-[1200px] mx-auto relative overflow-hidden aspect-[0.975] max-h-[500px] sm:aspect-[2.4] sm:max-h-[600px] select-none"
      x-data="{
        slides: [
          {
            title: 'Sakura',
            subtitle: 'El becerisi, yaratıcılık ve deneyim.',
            image: '/images/locus/hero-sakura.jpg',
            link: '/tasarimlar/'
          },
          {
            title: 'Iconica',
            subtitle: 'Geleneksel anlayışları aşan üst golasız estetik.',
            image: '/images/locus/model-iconica.jpg',
            link: '/tasarimlar/'
          },
          {
            title: 'Milano',
            subtitle: 'Büyük mimarlık anlayışına dayanan asil bir stil.',
            image: '/images/locus/model-milano.jpg',
            link: '/tasarimlar/'
          }
        ],
        current: 0,
        total: 3,
        timer: null,
        init() {
          this.start();
        },
        start() {
          this.timer = setInterval(() => { this.next(); }, 6000);
        },
        stop() {
          if (this.timer) clearInterval(this.timer);
        },
        next() {
          this.current = (this.current + 1) % this.total;
        },
        prev() {
          this.current = (this.current - 1 + this.total) % this.total;
        }
      }"
      @mouseenter="stop()"
      @mouseleave="start()"
    >
      <!-- Görsel Katmanları (Stable Hero Background + Slides) -->
      <template x-for="(slide, idx) in slides" :key="idx">
        <div 
          class="absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out"
          :class="current === idx ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'"
        >
          <img 
            :src="slide.image" 
            :alt="slide.title" 
            class="w-full h-full object-cover object-center block"
            loading="eager"
            fetchpriority="high"
            width="1200"
            height="600"
          />
        </div>
      </template>

      <!-- Server-rendered İlk Görsel (Zero CLS & Anında LCP) -->
      <div 
        class="absolute inset-0 w-full h-full"
        :class="current === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'"
      >
        <img 
          src="/images/locus/hero-sakura.jpg" 
          alt="Yeşilay Mutfak Sakura Koleksiyonu" 
          class="w-full h-full object-cover object-center block"
          loading="eager"
          fetchpriority="high"
          width="1200"
          height="600"
        />
      </div>

      <!-- Hero Gradient Overlay (Locus framer-gnukv0 Birebir CSS) -->
      <div 
        class="absolute inset-0 z-20 flex flex-col justify-end items-start p-5 sm:p-7 lg:p-[30px] gap-3 sm:gap-4 lg:gap-[17px]"
        style="background: linear-gradient(180deg, rgba(84, 84, 84, 0) 59.95%, rgba(59, 59, 59, 0.3) 74.63%, rgba(5, 5, 5, 0.38) 94.23%);"
      >
        <!-- Tıklanabilir Model Başlığı ve Açıklaması -->
        <a 
          :href="slides[current].link" 
          class="block group text-left text-white"
        >
          <h2 
            x-text="slides[current].title" 
            class="text-[34px] sm:text-[42px] lg:text-[48px] font-bold text-white tracking-[-0.04em] leading-[1.2] sm:leading-[1.4] m-0"
            style="font-family: 'Roboto', sans-serif;"
          >
            Sakura
          </h2>
          <p 
            x-text="slides[current].subtitle" 
            class="text-[15px] sm:text-[17px] lg:text-[18px] font-normal text-white tracking-[-0.04em] leading-[1.3] sm:leading-[1.4] mt-1 sm:mt-1.5 opacity-95"
            style="font-family: 'Roboto', sans-serif;"
          >
            El becerisi, yaratıcılık ve deneyim.
          </p>
        </a>

        <!-- Sertifika / Logo Nişanesi (Locus Venetalogo3 Birebir Boyutu: 219px x 28px) -->
        <div class="w-[137px] sm:w-[180px] lg:w-[219px] aspect-[7.856] flex items-center pt-1">
          <img 
            src="/images/locus/cert-badge.png" 
            alt="Yeşilay Mutfak Sertifikası" 
            class="h-6 sm:h-7 lg:h-8 w-auto object-contain brightness-0 invert opacity-90"
            width="219"
            height="28"
          />
        </div>
      </div>

      <!-- Slider Navigasyon Okları (Locus Birebir: 37x37px, radius 50%, top 50%, translate-y-50%) -->
      <button 
        type="button"
        @click="prev()"
        aria-label="Previous"
        class="absolute left-[15px] top-1/2 -translate-y-1/2 z-30 w-[37px] h-[37px] rounded-full bg-black/20 hover:bg-black/40 text-white flex items-center justify-center font-roboto text-[30px] font-light leading-none cursor-pointer border-0 transition-colors"
      >
        ‹
      </button>
      <button 
        type="button"
        @click="next()"
        aria-label="Next"
        class="absolute right-[15px] top-1/2 -translate-y-1/2 z-30 w-[37px] h-[37px] rounded-full bg-black/20 hover:bg-black/40 text-white flex items-center justify-center font-roboto text-[30px] font-light leading-none cursor-pointer border-0 transition-colors"
      >
        ›
      </button>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. BİZ KİMİZ? (LOCUS FEATURES / CONTENT BLOĞU BİREBİR)                -->
  <!-- Max-Width: 1200px | Roboto Font | Eyebrow + H1 + 2 Paragraf + Buton  -->
  <!-- ===================================================================== -->
  <section class="w-full bg-white font-roboto">
    <div class="max-w-[1200px] mx-auto py-16 sm:py-20 lg:py-[70px] px-6 sm:px-10 lg:px-0">
      
      <!-- Eyebrow: BİZ KİMİZ? -->
      <span 
        class="block text-[12px] font-normal tracking-[0.08em] uppercase mb-4"
        style="color: #575757; font-family: 'Roboto', sans-serif;"
      >
        BİZ KİMİZ?
      </span>

      <!-- H1 Başlık (Locus: 31px - 37px, font-weight: 500, letter-spacing: -0.04em, line-height: 1.1em, color: #575757) -->
      <h1 
        class="text-[26px] sm:text-[31px] lg:text-[37px] font-medium tracking-[-0.04em] leading-[1.1] mb-8 max-w-[850px]"
        style="color: #575757; font-family: 'Roboto', sans-serif;"
      >
        Mutfak ve Mobilyayı Bir Bütün Olarak Planlıyoruz
      </h1>

      <!-- Paragraflar (Locus: font-size 16px - 20px, line-height 1.3em, color #575757) -->
      <div 
        class="space-y-6 text-[15px] sm:text-[18px] lg:text-[20px] font-normal leading-[1.3] max-w-[950px] mb-10"
        style="color: #575757; font-family: 'Roboto', sans-serif; letter-spacing: -0.04em;"
      >
        <p>
          Yeşilay Mutfak, 1992’den bu yana İzmir merkezli olarak mutfak ve mobilya projelendirmesi ile kişiye özel imalat hizmeti sunar. Modern İtalyan çizgisine sahip özgün mutfak koleksiyonlarını ve yaşam alanı mobilyalarını; mekanınıza, ihtiyaçlarınıza ve yaşam alışkanlıklarınıza göre planlıyoruz.
        </p>
        <p>
          İzmir ve Ege Bölgesi’ndeki konut ve ticari projelerde, mutfak ve mobilya seçimini tezgah ve ankastre cihazlarla birlikte ele alıyoruz. Yerleşimden malzeme uyumuna kadar tasarım kararlarını, estetik ve günlük kullanım ihtiyaçlarını birlikte gözeterek oluşturuyoruz.
        </p>
      </div>

      <!-- Buton (Locus Birebir: 204px x 45px, border: 1px solid #d5d5d5, font 12px, tracking 0.08em) -->
      <div>
        <a 
          href="/hakkimizda/" 
          class="inline-flex items-center justify-center w-[204px] h-[45px] border border-[#d5d5d5] hover:border-[#111111] hover:bg-[#111111] hover:text-white text-[rgb(97,97,97)] text-[12px] font-normal tracking-[0.08em] uppercase transition-all duration-200"
          style="font-family: 'Roboto', sans-serif;"
        >
          YEŞİLAY MUTFAK’I TANIYIN
        </a>
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. TASARIM VE UYGULAMA SÜRECİ (LOCUS PROCESS BLOĞU BİREBİR)          -->
  <!-- Padding: 0 70px 70px | 3 Kolon: Mekan ve yerleşim | Mutfak | Teslimat -->
  <!-- ===================================================================== -->
  <section class="w-full bg-white font-roboto">
    <div class="max-w-[1200px] mx-auto px-6 sm:px-10 lg:px-0 pb-16 lg:pb-[70px]">
      
      <!-- Üst Başlık Grubu -->
      <div class="mb-12 lg:mb-16">
        <span 
          class="block text-[12px] font-normal tracking-[0.08em] uppercase mb-3"
          style="color: #575757; font-family: 'Roboto', sans-serif;"
        >
          TASARIM VE UYGULAMA SÜRECİ
        </span>
        <h2 
          class="text-[26px] sm:text-[31px] lg:text-[37px] font-medium tracking-[-0.04em] leading-[1.1]"
          style="color: #575757; font-family: 'Roboto', sans-serif;"
        >
          Mutfağınızdan yaşam alanınıza
        </h2>
      </div>

      <!-- 3 Kolonlu Süreç Konuları (Locus: border-top: 1px solid #bdbdbd, gap: 70px) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-[70px] pt-8 lg:pt-[70px] border-t border-[#bdbdbd]">
        
        <!-- 1. Konu -->
        <div class="space-y-3">
          <h3 
            class="text-[18px] sm:text-[20px] lg:text-[25px] font-medium tracking-[-0.04em] leading-[1.3]"
            style="color: #222222; font-family: 'Roboto', sans-serif;"
          >
            Mekan ve yerleşim
          </h3>
          <p 
            class="text-[15px] sm:text-[16px] font-normal leading-[1.4]"
            style="color: #575757; font-family: 'Roboto', sans-serif; letter-spacing: -0.04em;"
          >
            Ölçüleri ve günlük kullanım ihtiyaçlarınızı değerlendiriyor, mutfak ve mobilya yerleşimini birlikte netleştiriyoruz.
          </p>
        </div>

        <!-- 2. Konu -->
        <div class="space-y-3">
          <h3 
            class="text-[18px] sm:text-[20px] lg:text-[25px] font-medium tracking-[-0.04em] leading-[1.3]"
            style="color: #222222; font-family: 'Roboto', sans-serif;"
          >
            Mutfak, tezgah ve tamamlayıcı ürünler
          </h3>
          <p 
            class="text-[15px] sm:text-[16px] font-normal leading-[1.4]"
            style="color: #575757; font-family: 'Roboto', sans-serif; letter-spacing: -0.04em;"
          >
            Mutfağı tezgah ve ankastre cihazlarla birlikte ele alıyoruz. Mobilya, masa ve sandalye seçimlerinde de ölçü, malzeme ve kullanım uyumunu gözetiyoruz.
          </p>
        </div>

        <!-- 3. Konu -->
        <div class="space-y-3">
          <h3 
            class="text-[18px] sm:text-[20px] lg:text-[25px] font-medium tracking-[-0.04em] leading-[1.3]"
            style="color: #222222; font-family: 'Roboto', sans-serif;"
          >
            Teslimat, montaj ve destek
          </h3>
          <p 
            class="text-[15px] sm:text-[16px] font-normal leading-[1.4]"
            style="color: #575757; font-family: 'Roboto', sans-serif; letter-spacing: -0.04em;"
          >
            Teslimat ve montajı üstleniyor, satış sonrası desteğimizle kullanım sürecinde de yanınızda oluyoruz.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 4. ÖNE ÇIKAN MUTFAK MODELLERİ (LOCUS 2 COL MODELLER BİREBİR)        -->
  <!-- Üst Bant: bg #e6e0d7, border-top 1px solid #222, padding 35px 70px   -->
  <!-- Modeller: bg #ede9e6a1, 2 Kolon, 460px görsel                        -->
  <!-- Alt Bant: bg #e6e0d7, border-bottom 1px solid #222                   -->
  <!-- ===================================================================== -->
  <section class="w-full font-roboto">
    
    <!-- Üst Başlık Bandı (Locus framer-1p36md6 Birebir) -->
    <div 
      class="w-full py-8 lg:py-[35px] px-6 sm:px-10 lg:px-[70px] text-center"
      style="background-color: #e6e0d7; border-top: 1px solid #222;"
    >
      <span 
        class="block text-[12px] font-normal tracking-[0.08em] uppercase mb-1"
        style="color: #575757; font-family: 'Roboto', sans-serif;"
      >
        Mutfak
      </span>
      <h2 
        class="text-[24px] sm:text-[28px] lg:text-[31px] font-medium tracking-[-0.04em] leading-[1.1]"
        style="color: #575757; font-family: 'Roboto', sans-serif;"
      >
        Öne Çıkan Mutfak Modelleri
      </h2>
    </div>

    <!-- 4 Model Bloğu (Locus 2 Col Modeller Birebir) -->
    <div style="background-color: #ede9e6a1;">
      {kitchenModels.map((m, idx) => (
        <div class="w-full max-w-[2018px] mx-auto border-b border-[#d5d5d5]/50 last:border-b-0">
          <div class={`grid grid-cols-1 lg:grid-cols-2 items-center min-h-[460px] ${idx % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
            
            <!-- Görsel Kolonu (Locus: height 460px) -->
            <div class={`w-full h-[320px] sm:h-[400px] lg:h-[460px] overflow-hidden ${idx % 2 === 1 ? 'lg:order-2' : 'lg:order-1'}`}>
              <a href={m.link} class="block w-full h-full group overflow-hidden">
                <img 
                  src={m.image} 
                  alt={m.title} 
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  loading="lazy"
                  width="960"
                  height="460"
                />
              </a>
            </div>

            <!-- Metin Kolonu (Locus: padding 70px) -->
            <div class={`p-8 sm:p-12 lg:p-[70px] space-y-6 ${idx % 2 === 1 ? 'lg:order-1' : 'lg:order-2'}`}>
              <h3 
                class="text-[26px] sm:text-[31px] font-medium tracking-[-0.04em] leading-[1.1]"
                style="color: #575757; font-family: 'Roboto', sans-serif;"
              >
                {m.title}
              </h3>
              
              <div 
                class="space-y-4 text-[15px] sm:text-[16px] font-normal leading-[1.4]"
                style="color: #575757; font-family: 'Roboto', sans-serif; letter-spacing: -0.04em;"
              >
                <p>{m.desc1}</p>
                {m.desc2 && <p>{m.desc2}</p>}
              </div>

              <div class="pt-2">
                <a 
                  href={m.link} 
                  class="inline-flex items-center justify-center w-[204px] h-[45px] border border-[#d5d5d5] hover:border-[#111111] hover:bg-[#111111] hover:text-white text-[rgb(97,97,97)] text-[12px] font-normal tracking-[0.08em] uppercase transition-all duration-200"
                  style="font-family: 'Roboto', sans-serif;"
                >
                  KOLEKSİYONU KEŞFEDİN
                </a>
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>

    <!-- Alt Buton Bandı (Locus framer-46r3lr Birebir) -->
    <div 
      class="w-full py-8 lg:py-[35px] px-6 sm:px-10 lg:px-[70px] flex items-center justify-center"
      style="background-color: #e6e0d7; border-bottom: 1px solid #222;"
    >
      <a 
        href="/tasarimlar/" 
        class="inline-flex items-center justify-center w-[204px] h-[45px] border border-[#222] bg-[#222] text-white hover:bg-transparent hover:text-[#222] text-[12px] font-normal tracking-[0.08em] uppercase transition-all duration-200"
        style="font-family: 'Roboto', sans-serif;"
      >
        TÜM MODELLER
      </a>
    </div>

  </section>

  <!-- ===================================================================== -->
  <!-- 5. TAMAMLAYICI ÜRÜNLER (SANDALYE VE MASA / ET AL. BLOĞU BİREBİR)     -->
  <!-- Border-Top: 1px solid #222 | Padding: 35px 70px | Görsel Izgarası     -->
  <!-- ===================================================================== -->
  <section class="w-full bg-white font-roboto" style="border-top: 1px solid #222;">
    <div class="w-full max-w-[1400px] mx-auto py-12 lg:py-[70px] px-6 sm:px-10 lg:px-[70px]">
      
      <!-- Başlık ve Giriş -->
      <div class="max-w-[700px] mx-auto text-center mb-10">
        <span 
          class="block text-[12px] font-normal tracking-[0.08em] uppercase mb-2"
          style="color: #575757; font-family: 'Roboto', sans-serif;"
        >
          Tamamlayıcı Ürünler
        </span>
        <h3 
          class="text-[26px] sm:text-[31px] font-medium tracking-[-0.04em] leading-[1.1] mb-4"
          style="color: #575757; font-family: 'Roboto', sans-serif;"
        >
          Sandalye ve Masa
        </h3>
        <p 
          class="text-[15px] sm:text-[16px] leading-[1.5] mb-6"
          style="color: #575757; font-family: 'Roboto', sans-serif; letter-spacing: -0.04em;"
        >
          Modern yaşamın ihtiyaçlarına uygun, sürdürülebilir ve şık masa ve sandalye koleksiyonlarıyla fark yaratır. Hem iç mekanlarda hem de dış mekanlarda kullanıma uygun estetik çözümler sunar.
        </p>
        <div>
          <a 
            href="/tasarimlar/" 
            class="inline-flex items-center justify-center w-[204px] h-[45px] border border-[#d5d5d5] hover:border-[#111111] hover:bg-[#111111] hover:text-white text-[rgb(97,97,97)] text-[12px] font-normal tracking-[0.08em] uppercase transition-all duration-200"
            style="font-family: 'Roboto', sans-serif;"
          >
            KOLEKSİYONU KEŞFEDİN
          </a>
        </div>
      </div>

      <!-- Sandalye ve Masa Izgarası (Locus aspect-ratio: 1.93878 Birebir) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6 pt-6">
        {chairImages.map((img, i) => (
          <div class="overflow-hidden bg-[#fbf9f6] aspect-square group border border-[#ede9e6]">
            <img 
              src={img} 
              alt={`Tasarım Sandalye ve Masa Koleksiyonu ${i + 1}`} 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              width="400"
              height="400"
            />
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 6. MOBİLYA VE YAŞAM ALANLARI (COLOMBINI CASA BİREBİR)                 -->
  <!-- Salon, Kitaplık, Yatak Odası, Genç Odası, Çocuk Odası, Çamaşır Odası   -->
  <!-- ===================================================================== -->
  <section class="w-full bg-[#fbf9f6] font-roboto border-t border-[#ede9e6]">
    <div class="w-full max-w-[1300px] mx-auto py-16 lg:py-[70px] px-6 sm:px-10">
      
      <!-- Başlık Grubu -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12">
        <div>
          <span 
            class="block text-[12px] font-normal tracking-[0.08em] uppercase mb-2"
            style="color: #575757; font-family: 'Roboto', sans-serif;"
          >
            MOBİLYA & YAŞAM ALANLARI
          </span>
          <h2 
            class="text-[26px] sm:text-[31px] font-medium tracking-[-0.04em] leading-[1.1]"
            style="color: #222222; font-family: 'Roboto', sans-serif;"
          >
            Yeşilay Casa Koleksiyonu
          </h2>
        </div>
        <div 
          class="text-[14px] max-w-[420px]"
          style="color: #575757; font-family: 'Roboto', sans-serif;"
        >
          Mutfaktan salona, giyinme odalarından genç ve çocuk odalarına kadar evinizin her köşesinde mimari uyum.
        </div>
      </div>

      <!-- 6 Kategori Kartı (Locus Birebir Kart Yapısı) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {furnitureCategories.map((c) => (
          <a 
            href={c.link} 
            class="group block bg-white border border-[#ede9e6] overflow-hidden transition-all duration-300 hover:shadow-md"
          >
            <div class="aspect-[16/10] overflow-hidden bg-[#f2efe9]">
              <img 
                src={c.image} 
                alt={c.name} 
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
                width="600"
                height="375"
              />
            </div>
            <div class="p-6 flex items-center justify-between">
              <h3 
                class="text-[18px] sm:text-[20px] font-medium tracking-[-0.03em] group-hover:text-[#575757] transition-colors"
                style="color: #111111; font-family: 'Roboto', sans-serif;"
              >
                {c.name}
              </h3>
              <span class="text-[18px] text-[#111111] transform transition-transform group-hover:translate-x-1">
                →
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- Keşfet Butonu -->
      <div class="mt-12 text-center">
        <a 
          href="/salon-modelleri/" 
          class="inline-flex items-center justify-center w-[204px] h-[45px] border border-[#d5d5d5] hover:border-[#111111] hover:bg-[#111111] hover:text-white text-[rgb(97,97,97)] text-[12px] font-normal tracking-[0.08em] uppercase transition-all duration-200"
          style="font-family: 'Roboto', sans-serif;"
        >
          KOLEKSİYONU KEŞFEDİN
        </a>
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 7. MULTI-STEP İLETİŞİM & TEKLİF FORMU (LOCUS MULTI-STEP FORM BİREBİR) -->
  <!-- Max-width: 800px | Padding: 35px 20px | Adım 1 / 2 & Adım 2 / 2      -->
  <!-- ===================================================================== -->
  <section class="w-full bg-white font-roboto border-t border-[#ede9e6]" id="iletisim-formu">
    <div class="max-w-[800px] mx-auto py-16 lg:py-[70px] px-6 sm:px-10">
      
      <!-- Form Kartı -->
      <div 
        class="bg-white border border-[#ede9e6] p-6 sm:p-10 shadow-[0_2px_16px_rgba(0,0,0,0.03)]"
        x-data="{
          step: 1,
          name: '',
          email: '',
          phone: '',
          message: '',
          kvkk: false,
          submitted: false,
          errorMsg: '',
          goNext() {
            if (!this.name.trim() || !this.email.trim() || !this.phone.trim()) {
              this.errorMsg = 'Lütfen zorunlu alanları (*) doldurunuz.';
              return;
            }
            this.errorMsg = '';
            this.step = 2;
          },
          goBack() {
            this.step = 1;
            this.errorMsg = '';
          },
          submitForm() {
            if (!this.kvkk) {
              this.errorMsg = 'Lütfen KVKK aydınlatma metnini onaylayınız.';
              return;
            }
            this.submitted = true;
          }
        }"
      >
        <!-- Başlık ve Adım Bilgisi -->
        <div class="flex items-center justify-between border-b border-[#ede9e6] pb-5 mb-7">
          <div>
            <span 
              class="block text-[11px] font-normal tracking-[0.08em] uppercase mb-1"
              style="color: #888888; font-family: 'Roboto', sans-serif;"
            >
              MİMARİ DANIŞMANLIK & TEKLİF
            </span>
            <h2 
              class="text-[22px] sm:text-[26px] font-medium tracking-[-0.04em]"
              style="color: #111111; font-family: 'Roboto', sans-serif;"
            >
              Daha Fazla Bilgi Alın
            </h2>
          </div>
          <div class="text-[12px] font-normal text-[#888888] tracking-wider uppercase">
            <span x-text="'Adım ' + step + ' / 2'">Adım 1 / 2</span>
          </div>
        </div>

        <!-- Hata Mesajı -->
        <div x-show="errorMsg" class="mb-6 p-3 bg-red-50 border border-red-200 text-red-700 text-[13px]" style="display: none;">
          <span x-text="errorMsg"></span>
        </div>

        <!-- Başarı Mesajı -->
        <div x-show="submitted" class="py-12 text-center space-y-4" style="display: none;">
          <div class="w-12 h-12 bg-green-100 text-green-700 rounded-full flex items-center justify-center mx-auto text-xl font-bold">
            ✓
          </div>
          <h3 class="text-[22px] font-medium text-[#111111]">Talebiniz Alındı</h3>
          <p class="text-[15px] text-[#575757] max-w-[460px] mx-auto leading-relaxed">
            Mimari ekibimiz bilgilerinizi inceleyerek en kısa sürede sizinle iletişime geçecektir. İlginiz için teşekkür ederiz.
          </p>
        </div>

        <!-- FORM ADIMLARI -->
        <div x-show="!submitted">
          
          <!-- ADIM 1: İLETİŞİM ALANLARI -->
          <div x-show="step === 1" class="space-y-5">
            <div>
              <label class="block text-[13px] font-medium text-[#111111] mb-2">
                Ad Soyad <span class="text-red-500">*</span>
              </label>
              <input 
                type="text" 
                x-model="name" 
                placeholder="Adınız ve soyadınız" 
                class="w-full h-[45px] px-4 border border-[#d5d5d5] focus:border-[#111111] focus:outline-none text-[14px] text-[#111111] transition-colors"
                required
              />
            </div>

            <div>
              <label class="block text-[13px] font-medium text-[#111111] mb-2">
                Email <span class="text-red-500">*</span>
              </label>
              <input 
                type="email" 
                x-model="email" 
                placeholder="ornek@email.com" 
                class="w-full h-[45px] px-4 border border-[#d5d5d5] focus:border-[#111111] focus:outline-none text-[14px] text-[#111111] transition-colors"
                required
              />
            </div>

            <div>
              <label class="block text-[13px] font-medium text-[#111111] mb-2">
                Telefon <span class="text-red-500">*</span>
              </label>
              <input 
                type="tel" 
                x-model="phone" 
                placeholder="0 (5XX) XXX XX XX" 
                class="w-full h-[45px] px-4 border border-[#d5d5d5] focus:border-[#111111] focus:outline-none text-[14px] text-[#111111] transition-colors"
                required
              />
            </div>

            <div class="pt-4 flex justify-end">
              <button 
                type="button"
                @click="goNext()"
                class="w-[160px] h-[45px] bg-[#111111] hover:bg-[#333333] text-white text-[12px] font-medium tracking-[0.08em] uppercase transition-colors flex items-center justify-center cursor-pointer"
              >
                Sonraki →
              </button>
            </div>
          </div>

          <!-- ADIM 2: MESAJ & DOSYA YÜKLEME -->
          <div x-show="step === 2" class="space-y-5" style="display: none;">
            <div>
              <label class="block text-[13px] font-medium text-[#111111] mb-2">
                Mesajınız
              </label>
              <textarea 
                x-model="message" 
                rows="4"
                placeholder="Projeniz hakkında detaylar, ölçüler veya merak ettikleriniz..." 
                class="w-full p-4 border border-[#d5d5d5] focus:border-[#111111] focus:outline-none text-[14px] text-[#111111] transition-colors"
              ></textarea>
            </div>

            <!-- Dosya Yükleme (Dropzone - Locus Birebir) -->
            <div>
              <label class="block text-[13px] font-medium text-[#111111] mb-2">
                Ölçü ve Fotoğraf Yükleyin
              </label>
              <div class="border-2 border-dashed border-[#d5d5d5] hover:border-[#111111] p-6 text-center cursor-pointer transition-colors bg-[#faf9f7]">
                <div class="text-2xl mb-1 text-[#888888]">📎</div>
                <p class="text-[13px] text-[#575757] font-medium">
                  Dosya yüklemek için tıklayın veya dosyayı buraya sürükleyin.
                </p>
                <p class="text-[11px] text-[#888888] mt-1">
                  PDF, DWG, JPG veya PNG • Maks. 25 MB
                </p>
                <input type="file" multiple class="hidden" id="fileUploadInput" />
              </div>
            </div>

            <!-- KVKK Onay Kutusu -->
            <div class="space-y-3 pt-2 text-[12px] text-[#575757]">
              <label class="flex items-start gap-2.5 cursor-pointer select-none">
                <input 
                  type="checkbox" 
                  x-model="kvkk" 
                  class="mt-0.5 rounded-none border-[#d5d5d5] text-[#111111] focus:ring-0"
                />
                <span>
                  Bu formda vermiş olduğum kişisel verilerimin Yeşilay Mutfak Ltd. tarafından <a href="/hakkimizda/" class="text-[#111111] underline">KVKK Aydınlatma Metninde</a> belirtilen şekilde ve amaçlarda işlenmesine rıza veriyorum.
                </span>
              </label>
            </div>

            <!-- Butonlar: Geri & Gönder -->
            <div class="pt-4 flex items-center justify-between">
              <button 
                type="button"
                @click="goBack()"
                class="h-[45px] px-6 border border-[#d5d5d5] text-[#575757] hover:text-[#111111] hover:border-[#111111] text-[12px] font-medium tracking-[0.08em] uppercase transition-colors cursor-pointer"
              >
                ← Geri
              </button>
              <button 
                type="button"
                @click="submitForm()"
                class="w-[160px] h-[45px] bg-[#111111] hover:bg-[#333333] text-white text-[12px] font-medium tracking-[0.08em] uppercase transition-colors flex items-center justify-center cursor-pointer"
              >
                Gönder
              </button>
            </div>

          </div>

        </div>

      </div>

    </div>
  </section>

</Layout>
