---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../data/siteConfig";

const seo = {
  title: "Yeşilay Mutfak | İthal ve İtalyan Mutfak Tasarımı İzmir",
  description: "Yeşilay Mutfak; özgün İtalyan mutfak koleksiyonları, modern yaşam alanı mobilyaları ve projeye özel mimari çözümleri İzmir ve Ege Bölgesi'nde sunar.",
  canonical: `${siteConfig.siteUrl}/`,
  serviceName: "Lüks Mimarlık & Mutfak İmalatı",
  keywords: [
    "yeşilay mutfak",
    "izmir lüks mutfak tasarımı",
    "italyan mutfak izmir",
    "özel mutfak dolabı izmir",
    "modern mutfak modelleri",
    "buca mutfak atölyesi",
    "alsancak mutfak showroom",
    "mimari mutfak projelendirme"
  ],
  faqList: [
    {
      question: "Mutfak ve mobilya tasarım süreciniz nasıl ilerliyor?",
      answer: "İlk aşamada mekanınızın ölçülerini lazer rölöve ile alıyor ve ihtiyaçlarınızı belirliyoruz. Ardından 3D fotogerçekçi mimari projelendirme hazırlıyor, malzeme ve tezgah uyumunu netleştirerek üretime geçiyoruz."
    },
    {
      question: "Mutfak modellerinizde hangi mekanizma ve malzemeleri kullanıyorsunuz?",
      answer: "Koleksiyonlarımızda uluslararası standartlarda neme dayanıklı gövdeler, nanoteknolojik mat ve parlak yüzeyler ile Avusturya Blum entegre sessiz fren sistemleri kullanılmaktadır."
    },
    {
      question: "Teslimat ve montaj süreci nasıl yönetiliyor?",
      answer: "Tüm üretim kendi atölyemizde CNC hassasiyetiyle tamamlanır, kendi uzman montaj ekibimiz tarafından anahtar teslim monte edilir ve kullanım garantisiyle teslim edilir."
    }
  ]
};

// Modeller Verisi
const kitchenModels = [
  {
    id: "iconica",
    title: "Iconica",
    desc1: "Iconica, geleneksel tasarım anlayışlarını aşan ve üst gola profilini ortadan kaldıran bir sistemle yeni bir estetik bakış açısı sunuyor.",
    desc2: "Tezgah ve kapak arasında kusursuz bir bütünlük sağlanıyor. Farklı ve yeni malzemelerle sınırsız estetik seçenekler sunuyor.",
    image: "/images/locus/model-iconica.jpg",
    link: "/tasarimlar/"
  },
  {
    id: "lounge",
    title: "Lounge",
    desc1: "Lounge form fonksiyonu takip eder felsefesiyle şekillenerek, günlük yaşamı estetik ve işlevsellik odaklı yorumluyor. Böylece mutfak ortamını fonksiyonel ve estetik açıdan tatmin edici hale getiriyor.",
    desc2: "Alçaltılmış baza yapısı ile çağdaş ve minimalist bakış açısı vurgulanıyor.",
    image: "/images/locus/model-lounge.jpg",
    link: "/tasarimlar/"
  },
  {
    id: "milano",
    title: "Milano",
    desc1: 'Milano, "Made in Italy" tasarım geleneği ve büyük mimarlık anlayışına dayanan bir stilin ifadesidir. Gerçek bir "yeni stil" olarak, fazla süsleme veya abartıdan uzak, sade, net ve etkileyici bir anlayışla mekan kalitesini yansıtır.',
    desc2: "Asil ahşap ve taş dokusuyla zamansız bir dinginlik sunar.",
    image: "/images/locus/model-milano.jpg",
    link: "/tasarimlar/"
  },
  {
    id: "pavese",
    title: "Pavese",
    desc1: "Geçmişin tatlarına dönüş. Pavese, deneyim, zanaatkarlık ve ustalık değerlerini yaşatan bir işleme sürecinin sonucudur.",
    desc2: "45° kesimli çerçeve ve özel tasarım kulpuyla öne çıkan kapak, geleneksel dünyayı yeniden yorumlayarak, benzersiz tatlarla dolu sıcak bir mutfak atmosferi sunuyor.",
    image: "/images/locus/model-pavese.jpg",
    link: "/tasarimlar/"
  }
];

// Mobilya ve Yaşam Alanları
const furnitureCategories = [
  { name: "Salon", image: "/images/locus/mob-salon.webp", link: "/salon-modelleri/" },
  { name: "Kitaplık", image: "/images/locus/mob-kitaplik.jpg", link: "/tasarimlar/" },
  { name: "Yatak Odası", image: "/images/locus/mob-yatak.webp", link: "/yatak-odasi-modelleri/" },
  { name: "Genç Odası", image: "/images/locus/mob-genc.webp", link: "/genc-odasi-modelleri/" },
  { name: "Çocuk Odası", image: "/images/locus/mob-cocuk.webp", link: "/cocuk-odasi-modelleri/" },
  { name: "Çamaşır Odası", image: "/images/locus/mob-camasir.jpg", link: "/camasir-odasi-modelleri/" }
];

// Sandalye & Masa Galeri Görselleri
const chairImages = [
  "/images/locus/sandalye-1.jpg",
  "/images/locus/sandalye-2.jpg",
  "/images/locus/sandalye-3.jpg",
  "/images/locus/sandalye-4.jpg",
  "/images/locus/sandalye-5.jpg",
  "/images/locus/sandalye-6.jpg",
  "/images/locus/sandalye-7.jpg",
  "/images/locus/sandalye-8.jpg",
  "/images/locus/sandalye-9.jpg",
  "/images/locus/sandalye-10.jpg",
  "/images/locus/sandalye-11.jpg",
  "/images/locus/sandalye-12.jpg"
];
---

<Layout seo={seo} activeService="Ana Sayfa">

  <!-- ===================================================================== -->
  <!-- 1. HERO SLIDER ALANI (LOCUS LIGHTWEIGHT HERO SLIDER BİREBİR KLON)     -->
  <!-- Ölçü: Full viewport (100vh - 80px), Min-Height: 650px, Roboto Font    -->
  <!-- ===================================================================== -->
  <section 
    class="relative w-full h-[calc(100svh-70px)] lg:h-[calc(100vh-80px)] min-h-[620px] max-h-[1080px] bg-[#111111] overflow-hidden select-none font-roboto"
    x-data="{
      slides: [
        {
          title: 'Sakura',
          subtitle: 'El becerisi, yaratıcılık ve deneyim.',
          image: '/images/locus/hero-sakura.jpg',
          link: '/tasarimlar/'
        },
        {
          title: 'Iconica',
          subtitle: 'Üst gola profilini ortadan kaldıran mimari estetik.',
          image: '/images/locus/model-iconica.jpg',
          link: '/tasarimlar/'
        },
        {
          title: 'Milano',
          subtitle: 'İtalyan zarafeti ve büyük mimarlık anlayışı.',
          image: '/images/locus/model-milano.jpg',
          link: '/tasarimlar/'
        }
      ],
      current: 0,
      total: 3,
      timer: null,
      init() {
        this.start();
      },
      start() {
        this.timer = setInterval(() => { this.next(); }, 6000);
      },
      stop() {
        if (this.timer) clearInterval(this.timer);
      },
      next() {
        this.current = (this.current + 1) % this.total;
      },
      prev() {
        this.current = (this.current - 1 + this.total) % this.total;
      }
    }"
    @mouseenter="stop()"
    @mouseleave="start()"
  >
    <!-- Background Image 1 (Server-Rendered for Instant LCP) -->
    <div 
      class="absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out"
      :class="current === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'"
    >
      <img 
        src="/images/locus/hero-sakura.jpg" 
        alt="Yeşilay Mutfak Sakura Koleksiyonu" 
        class="w-full h-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
        width="1920"
        height="977"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent"></div>
    </div>

    <!-- Background Image 2 -->
    <div 
      class="absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out"
      :class="current === 1 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'"
    >
      <img 
        src="/images/locus/model-iconica.jpg" 
        alt="Yeşilay Mutfak Iconica Modeli" 
        class="w-full h-full object-cover object-center"
        loading="lazy"
        width="1920"
        height="977"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent"></div>
    </div>

    <!-- Background Image 3 -->
    <div 
      class="absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out"
      :class="current === 2 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'"
    >
      <img 
        src="/images/locus/model-milano.jpg" 
        alt="Yeşilay Mutfak Milano Modeli" 
        class="w-full h-full object-cover object-center"
        loading="lazy"
        width="1920"
        height="977"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent"></div>
    </div>

    <!-- Sol Alt İçerik Bloğu (Locus Birebir Layout) -->
    <div class="absolute bottom-8 sm:bottom-12 lg:bottom-16 left-6 sm:left-12 lg:left-20 z-20 max-w-[650px] text-white">
      
      <!-- Model İsmi ve Slogan -->
      <a 
        :href="slides[current].link" 
        class="group block transition-all"
      >
        <h2 
          x-text="slides[current].title" 
          class="text-[32px] sm:text-[42px] lg:text-[48px] font-medium tracking-[-0.04em] text-white leading-none mb-3 drop-shadow-sm"
        >
          Sakura
        </h2>
        <p 
          x-text="slides[current].subtitle" 
          class="text-[15px] sm:text-[17px] text-white/90 font-normal tracking-normal leading-relaxed drop-shadow-sm mb-6"
        >
          El becerisi, yaratıcılık ve deneyim.
        </p>
      </a>

      <!-- Kalite Sertifikası / Rozet & Navigasyon Okları -->
      <div class="flex items-center gap-6 sm:gap-8 pt-2">
        <!-- Sertifika / Nişane -->
        <div class="flex items-center gap-3">
          <img 
            src="/images/locus/cert-badge.png" 
            alt="Yeşilay Mutfak Mimari Üretim Sertifikası" 
            class="h-9 sm:h-11 w-auto object-contain opacity-95 invert brightness-0"
            width="120"
            height="93"
          />
          <div class="hidden sm:block text-[11px] leading-tight text-white/80 font-normal tracking-wide">
            <div>Tescilli Mimari Tasarım</div>
            <div>& Özel Üretim Güvencesi</div>
          </div>
        </div>

        <span class="w-[1px] h-6 bg-white/30 hidden sm:block"></span>

        <!-- Oklar (‹ ve ›) -->
        <div class="flex items-center gap-3">
          <button 
            type="button"
            @click="prev()"
            class="w-10 h-10 border border-white/40 hover:border-white hover:bg-white/10 rounded-full flex items-center justify-center text-white text-lg transition-all cursor-pointer"
            aria-label="Önceki Model"
          >
            ‹
          </button>
          <button 
            type="button"
            @click="next()"
            class="w-10 h-10 border border-white/40 hover:border-white hover:bg-white/10 rounded-full flex items-center justify-center text-white text-lg transition-all cursor-pointer"
            aria-label="Sonraki Model"
          >
            ›
          </button>
        </div>
      </div>

    </div>

  </section>

  <!-- ===================================================================== -->
  <!-- 2. BİZ KİMİZ? (LOCUS FEATURES / CONTENT BLOĞU BİREBİR)                -->
  <!-- Max-Width: 1200px | Roboto Font | Eyebrow + H1 + 2 Paragraf + Buton  -->
  <!-- ===================================================================== -->
  <section class="w-full bg-white py-20 lg:py-28 px-6 sm:px-10 font-roboto border-b border-[#ede9e6]">
    <div class="max-w-[1200px] mx-auto">
      
      <!-- Eyebrow -->
      <span class="text-[12px] font-medium tracking-[0.1em] text-[#888888] uppercase block mb-4">
        BİZ KİMİZ?
      </span>

      <!-- H1 Başlık (Locus: 31px-37px, Roboto 500, letter-spacing: -0.04em) -->
      <h1 class="text-[28px] sm:text-[34px] lg:text-[38px] font-medium text-[#111111] tracking-[-0.04em] leading-[1.18] mb-8 max-w-[900px]">
        Mutfak ve Mobilyayı Bir Bütün Olarak Planlıyoruz
      </h1>

      <!-- Paragraflar (Locus font-size 16px-18px, text-color #575757, line-height 1.6) -->
      <div class="space-y-6 text-[16px] sm:text-[17px] text-[#575757] font-normal leading-[1.65] max-w-[980px] mb-10">
        <p>
          Yeşilay Mutfak, 1992’den bu yana İzmir merkezli olarak mutfak ve mobilya projelendirmesi ile kişiye özel imalat hizmeti sunar. Modern İtalyan çizgisine sahip özgün mutfak koleksiyonlarını ve yaşam alanı mobilyalarını; mekanınıza, ihtiyaçlarınıza ve yaşam alışkanlıklarınıza göre planlıyoruz.
        </p>
        <p>
          İzmir ve Ege Bölgesi’ndeki konut ve ticari projelerde, mutfak ve mobilya seçimini tezgah ve ankastre cihazlarla birlikte ele alıyoruz. Yerleşimden malzeme uyumuna kadar tasarım kararlarını, estetik ve günlük kullanım ihtiyaçlarını birlikte gözeterek oluşturuyoruz.
        </p>
      </div>

      <!-- Buton (Locus: 204px x 45px, border, font 12px Roboto letter-spacing 0.08em) -->
      <div>
        <a 
          href="/hakkimizda/" 
          class="inline-flex items-center justify-center w-[204px] h-[45px] border border-[#d5d5d5] hover:border-[#111111] hover:bg-[#111111] hover:text-white text-[#575757] text-[12px] font-medium tracking-[0.08em] uppercase transition-all duration-200"
        >
          YEŞİLAY MUTFAK’I TANIYIN
        </a>
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. TASARIM VE UYGULAMA SÜRECİ (LOCUS PROCESS BLOĞU BİREBİR)          -->
  <!-- 3 Kolon: Mekan ve Yerleşim | Mutfak, Tezgah | Teslimat ve Destek      -->
  <!-- ===================================================================== -->
  <section class="w-full bg-white py-16 lg:py-24 px-6 sm:px-10 font-roboto border-b border-[#ede9e6]">
    <div class="max-w-[1200px] mx-auto">
      
      <!-- Üst Başlıklar -->
      <div class="mb-12 lg:mb-16">
        <span class="text-[12px] font-medium tracking-[0.1em] text-[#888888] uppercase block mb-3">
          TASARIM VE UYGULAMA SÜRECİ
        </span>
        <h2 class="text-[26px] sm:text-[32px] font-medium text-[#111111] tracking-[-0.04em] leading-[1.2]">
          Mutfağınızdan yaşam alanınıza
        </h2>
      </div>

      <!-- 3 Kolonlu Süreç Kartları (Locus Birebir) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-14 pt-8 border-t border-[#ede9e6]">
        
        <!-- 1. Konu -->
        <div class="space-y-3">
          <h3 class="text-[20px] lg:text-[22px] font-medium text-[#111111] tracking-[-0.04em]">
            Mekan ve yerleşim
          </h3>
          <p class="text-[15px] sm:text-[15.5px] text-[#575757] font-normal leading-[1.6]">
            Ölçüleri ve günlük kullanım ihtiyaçlarınızı değerlendiriyor, mutfak ve mobilya yerleşimini birlikte netleştiriyoruz.
          </p>
        </div>

        <!-- 2. Konu -->
        <div class="space-y-3">
          <h3 class="text-[20px] lg:text-[22px] font-medium text-[#111111] tracking-[-0.04em]">
            Mutfak, tezgah ve tamamlayıcı ürünler
          </h3>
          <p class="text-[15px] sm:text-[15.5px] text-[#575757] font-normal leading-[1.6]">
            Mutfağı tezgah ve ankastre cihazlarla birlikte ele alıyoruz. Mobilya, masa ve sandalye seçimlerinde de ölçü, malzeme ve kullanım uyumunu gözetiyoruz.
          </p>
        </div>

        <!-- 3. Konu -->
        <div class="space-y-3">
          <h3 class="text-[20px] lg:text-[22px] font-medium text-[#111111] tracking-[-0.04em]">
            Teslimat, montaj ve destek
          </h3>
          <p class="text-[15px] sm:text-[15.5px] text-[#575757] font-normal leading-[1.6]">
            Teslimat ve montajı üstleniyor, satış sonrası desteğimizle kullanım sürecinde de yanınızda oluyoruz.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 4. ÖNE ÇIKAN MUTFAK MODELLERİ (LOCUS 2 COL MODELLER BİREBİR)        -->
  <!-- Iconica | Lounge | Milano | Pavese + TÜM MODELLER Butonu              -->
  <!-- ===================================================================== -->
  <section class="w-full bg-[#fbf9f6] py-20 lg:py-28 px-6 sm:px-10 font-roboto border-b border-[#ede9e6]">
    <div class="max-w-[1300px] mx-auto">
      
      <!-- Bölüm Başlığı -->
      <div class="mb-16 lg:mb-24 text-center">
        <span class="text-[12px] font-medium tracking-[0.1em] text-[#888888] uppercase block mb-3">
          Mutfak
        </span>
        <h2 class="text-[28px] sm:text-[36px] font-medium text-[#111111] tracking-[-0.04em]">
          Öne Çıkan Mutfak Modelleri
        </h2>
      </div>

      <!-- Modeller Listesi (Alternatif 2 Kolon Grid Düzeni) -->
      <div class="space-y-20 lg:space-y-28">
        {kitchenModels.map((m, idx) => (
          <div class={`grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center`}>
            
            <!-- Görsel Alanı (7 Sütun) -->
            <div class={`lg:col-span-7 ${idx % 2 === 1 ? 'lg:order-2' : 'lg:order-1'}`}>
              <a href={m.link} class="block overflow-hidden group">
                <img 
                  src={m.image} 
                  alt={m.title} 
                  class="w-full h-[320px] sm:h-[440px] lg:h-[500px] object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
                  loading="lazy"
                  width="1920"
                  height="977"
                />
              </a>
            </div>

            <!-- Metin Alanı (5 Sütun) -->
            <div class={`lg:col-span-5 space-y-6 ${idx % 2 === 1 ? 'lg:order-1' : 'lg:order-2'}`}>
              <h3 class="text-[28px] sm:text-[34px] font-medium text-[#111111] tracking-[-0.04em] leading-tight">
                {m.title}
              </h3>
              
              <div class="space-y-4 text-[15px] sm:text-[16px] text-[#575757] font-normal leading-[1.65]">
                <p>{m.desc1}</p>
                {m.desc2 && <p>{m.desc2}</p>}
              </div>

              <div class="pt-2">
                <a 
                  href={m.link} 
                  class="inline-flex items-center justify-center w-[204px] h-[45px] border border-[#d5d5d5] hover:border-[#111111] hover:bg-[#111111] hover:text-white text-[#575757] text-[12px] font-medium tracking-[0.08em] uppercase transition-all duration-200"
                >
                  KOLEKSİYONU KEŞFEDİN
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>

      <!-- TÜM MODELLER Butonu (Locus: Sayfa ortasında geniş buton) -->
      <div class="mt-20 lg:mt-24 text-center">
        <a 
          href="/tasarimlar/" 
          class="inline-flex items-center justify-center w-[204px] h-[45px] border border-[#111111] bg-[#111111] text-white hover:bg-transparent hover:text-[#111111] text-[12px] font-medium tracking-[0.08em] uppercase transition-all duration-200"
        >
          TÜM MODELLER
        </a>
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 5. TAMAMLAYICI ÜRÜNLER (SANDALYE VE MASA / ET AL. BLOĞU BİREBİR)     -->
  <!-- Başlık + Açıklama + Buton + 12'li Sandalye/Masa Görsel Galerisi        -->
  <!-- ===================================================================== -->
  <section class="w-full bg-white py-20 lg:py-28 px-6 sm:px-10 font-roboto border-b border-[#ede9e6]">
    <div class="max-w-[1300px] mx-auto">
      
      <!-- Başlık ve Giriş Metni -->
      <div class="max-w-[760px] mx-auto text-center mb-12">
        <span class="text-[12px] font-medium tracking-[0.1em] text-[#888888] uppercase block mb-3">
          Tamamlayıcı Ürünler
        </span>
        <h3 class="text-[28px] sm:text-[34px] font-medium text-[#111111] tracking-[-0.04em] mb-4">
          Sandalye ve Masa
        </h3>
        <p class="text-[15.5px] sm:text-[16.5px] text-[#575757] leading-relaxed mb-8">
          Modern yaşamın ihtiyaçlarına uygun, sürdürülebilir ve şık masa ve sandalye koleksiyonlarıyla fark yaratır. Hem iç mekanlarda hem de dış mekanlarda kullanıma uygun estetik çözümler sunar.
        </p>
        <div>
          <a 
            href="/tasarimlar/" 
            class="inline-flex items-center justify-center w-[204px] h-[45px] border border-[#d5d5d5] hover:border-[#111111] hover:bg-[#111111] hover:text-white text-[#575757] text-[12px] font-medium tracking-[0.08em] uppercase transition-all duration-200"
          >
            KOLEKSİYONU KEŞFEDİN
          </a>
        </div>
      </div>

      <!-- 12 Görselli Mozaik / Izgara (Locus Birebir Galeri) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6 pt-6">
        {chairImages.map((img, i) => (
          <div class="overflow-hidden bg-[#fbf9f6] aspect-square group">
            <img 
              src={img} 
              alt={`Tasarım Sandalye ve Masa Koleksiyonu ${i + 1}`} 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              width="400"
              height="400"
            />
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 6. MOBİLYA VE YAŞAM ALANLARI (COLOMBINI CASA BİREBİR KLON)            -->
  <!-- Salon, Kitaplık, Yatak Odası, Genç Odası, Çocuk Odası, Çamaşır Odası   -->
  <!-- ===================================================================== -->
  <section class="w-full bg-[#fbf9f6] py-20 lg:py-28 px-6 sm:px-10 font-roboto border-b border-[#ede9e6]">
    <div class="max-w-[1300px] mx-auto">
      
      <!-- Marka / Başlık -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12">
        <div>
          <span class="text-[12px] font-medium tracking-[0.1em] text-[#888888] uppercase block mb-2">
            MOBİLYA & YAŞAM ALANLARI
          </span>
          <h2 class="text-[28px] sm:text-[36px] font-medium text-[#111111] tracking-[-0.04em]">
            Yeşilay Casa Koleksiyonu
          </h2>
        </div>
        <div class="text-[13px] text-[#575757] max-w-[420px]">
          Mutfaktan salona, giyinme odalarından genç ve çocuk odalarına kadar evinizin her köşesinde mimari uyum.
        </div>
      </div>

      <!-- 6 Kategori Izgarası (Locus Kart Yapısı) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {furnitureCategories.map((c) => (
          <a 
            href={c.link} 
            class="group block bg-white border border-[#ede9e6] overflow-hidden transition-all duration-300 hover:shadow-lg"
          >
            <div class="aspect-[16/10] overflow-hidden bg-[#f2efe9]">
              <img 
                src={c.image} 
                alt={c.name} 
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
                width="600"
                height="375"
              />
            </div>
            <div class="p-6 flex items-center justify-between">
              <h3 class="text-[18px] sm:text-[20px] font-medium text-[#111111] tracking-[-0.03em] group-hover:text-[#575757] transition-colors">
                {c.name}
              </h3>
              <span class="text-[18px] text-[#111111] transform transition-transform group-hover:translate-x-1">
                →
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- Keşfet Butonu -->
      <div class="mt-14 text-center">
        <a 
          href="/salon-modelleri/" 
          class="inline-flex items-center justify-center w-[204px] h-[45px] border border-[#d5d5d5] hover:border-[#111111] hover:bg-[#111111] hover:text-white text-[#575757] text-[12px] font-medium tracking-[0.08em] uppercase transition-all duration-200"
        >
          KOLEKSİYONU KEŞFEDİN
        </a>
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 7. MULTI-STEP İLETİŞİM & TEKLİF FORMU (LOCUS MULTI-STEP FORM BİREBİR) -->
  <!-- Adım 1: İletişim Bilgileri | Adım 2: Mesaj & Dosya Yükleme            -->
  <!-- ===================================================================== -->
  <section class="w-full bg-white py-20 lg:py-28 px-6 sm:px-10 font-roboto border-b border-[#ede9e6]" id="iletisim-formu">
    <div class="max-w-[800px] mx-auto">
      
      <!-- Form Kartı -->
      <div 
        class="bg-white border border-[#ede9e6] p-8 sm:p-12 lg:p-14 shadow-[0_4px_24px_rgba(0,0,0,0.03)]"
        x-data="{
          step: 1,
          name: '',
          email: '',
          phone: '',
          message: '',
          kvkk: false,
          submitted: false,
          errorMsg: '',
          goNext() {
            if (!this.name.trim() || !this.email.trim() || !this.phone.trim()) {
              this.errorMsg = 'Lütfen zorunlu alanları (*) doldurunuz.';
              return;
            }
            this.errorMsg = '';
            this.step = 2;
          },
          goBack() {
            this.step = 1;
            this.errorMsg = '';
          },
          submitForm() {
            if (!this.kvkk) {
              this.errorMsg = 'Lütfen KVKK aydınlatma metnini onaylayınız.';
              return;
            }
            this.submitted = true;
          }
        }"
      >
        <!-- Başlık ve Adım Bilgisi -->
        <div class="flex items-center justify-between border-b border-[#ede9e6] pb-6 mb-8">
          <div>
            <span class="text-[11px] font-medium tracking-[0.1em] text-[#888888] uppercase block mb-1">
              MİMARİ DANIŞMANLIK & TEKLİF
            </span>
            <h2 class="text-[24px] sm:text-[28px] font-medium text-[#111111] tracking-[-0.04em]">
              Daha Fazla Bilgi Alın
            </h2>
          </div>
          <div class="text-[12px] font-medium text-[#888888] tracking-wider uppercase">
            <span x-text="'Adım ' + step + ' / 2'">Adım 1 / 2</span>
          </div>
        </div>

        <!-- Hata Mesajı -->
        <div x-show="errorMsg" class="mb-6 p-3 bg-red-50 border border-red-200 text-red-700 text-[13px]" style="display: none;">
          <span x-text="errorMsg"></span>
        </div>

        <!-- Başarı Mesajı -->
        <div x-show="submitted" class="py-12 text-center space-y-4" style="display: none;">
          <div class="w-12 h-12 bg-green-100 text-green-700 rounded-full flex items-center justify-center mx-auto text-xl font-bold">
            ✓
          </div>
          <h3 class="text-[22px] font-medium text-[#111111]">Talebiniz Alındı</h3>
          <p class="text-[15px] text-[#575757] max-w-[460px] mx-auto leading-relaxed">
            Mimari ekibimiz bilgilerinizi inceleyerek en kısa sürede sizinle iletişime geçecektir. İlginiz için teşekkür ederiz.
          </p>
        </div>

        <!-- FORM ADIMLARI -->
        <div x-show="!submitted">
          
          <!-- ADIM 1: İLETİŞİM ALANLARI -->
          <div x-show="step === 1" class="space-y-6">
            <div>
              <label class="block text-[13px] font-medium text-[#111111] mb-2">
                Ad Soyad <span class="text-red-500">*</span>
              </label>
              <input 
                type="text" 
                x-model="name" 
                placeholder="Adınız ve soyadınız" 
                class="w-full h-[48px] px-4 border border-[#d5d5d5] focus:border-[#111111] focus:outline-none text-[14px] text-[#111111] transition-colors"
                required
              />
            </div>

            <div>
              <label class="block text-[13px] font-medium text-[#111111] mb-2">
                Email <span class="text-red-500">*</span>
              </label>
              <input 
                type="email" 
                x-model="email" 
                placeholder="ornek@email.com" 
                class="w-full h-[48px] px-4 border border-[#d5d5d5] focus:border-[#111111] focus:outline-none text-[14px] text-[#111111] transition-colors"
                required
              />
            </div>

            <div>
              <label class="block text-[13px] font-medium text-[#111111] mb-2">
                Telefon <span class="text-red-500">*</span>
              </label>
              <input 
                type="tel" 
                x-model="phone" 
                placeholder="0 (5XX) XXX XX XX" 
                class="w-full h-[48px] px-4 border border-[#d5d5d5] focus:border-[#111111] focus:outline-none text-[14px] text-[#111111] transition-colors"
                required
              />
            </div>

            <div class="pt-4 flex justify-end">
              <button 
                type="button"
                @click="goNext()"
                class="w-[160px] h-[45px] bg-[#111111] hover:bg-[#333333] text-white text-[12px] font-medium tracking-[0.08em] uppercase transition-colors flex items-center justify-center cursor-pointer"
              >
                Sonraki →
              </button>
            </div>
          </div>

          <!-- ADIM 2: MESAJ & DOSYA YÜKLEME -->
          <div x-show="step === 2" class="space-y-6" style="display: none;">
            <div>
              <label class="block text-[13px] font-medium text-[#111111] mb-2">
                Mesajınız
              </label>
              <textarea 
                x-model="message" 
                rows="4"
                placeholder="Projeniz hakkında detaylar, ölçüler veya merak ettikleriniz..." 
                class="w-full p-4 border border-[#d5d5d5] focus:border-[#111111] focus:outline-none text-[14px] text-[#111111] transition-colors"
              ></textarea>
            </div>

            <!-- Dosya Yükleme (Dropzone - Locus Birebir) -->
            <div>
              <label class="block text-[13px] font-medium text-[#111111] mb-2">
                Ölçü ve Fotoğraf Yükleyin
              </label>
              <div class="border-2 border-dashed border-[#d5d5d5] hover:border-[#111111] p-8 text-center cursor-pointer transition-colors bg-[#faf9f7]">
                <div class="text-2xl mb-2 text-[#888888]">📎</div>
                <p class="text-[13px] text-[#575757] font-medium">
                  Dosya yüklemek için tıklayın veya dosyayı buraya sürükleyin.
                </p>
                <p class="text-[11px] text-[#888888] mt-1">
                  PDF, DWG, JPG veya PNG • Maks. 25 MB
                </p>
                <input type="file" multiple class="hidden" id="fileUploadInput" />
              </div>
            </div>

            <!-- KVKK Onay Kutusu -->
            <div class="space-y-3 pt-2 text-[12px] text-[#575757]">
              <label class="flex items-start gap-2.5 cursor-pointer select-none">
                <input 
                  type="checkbox" 
                  x-model="kvkk" 
                  class="mt-0.5 rounded-none border-[#d5d5d5] text-[#111111] focus:ring-0"
                />
                <span>
                  Bu formda vermiş olduğum kişisel verilerimin Yeşilay Mutfak Ltd. tarafından <a href="/hakkimizda/" class="text-[#111111] underline">KVKK Aydınlatma Metninde</a> belirtilen şekilde ve amaçlarda işlenmesine rıza veriyorum.
                </span>
              </label>
            </div>

            <!-- Butonlar: Geri & Gönder -->
            <div class="pt-4 flex items-center justify-between">
              <button 
                type="button"
                @click="goBack()"
                class="h-[45px] px-6 border border-[#d5d5d5] text-[#575757] hover:text-[#111111] hover:border-[#111111] text-[12px] font-medium tracking-[0.08em] uppercase transition-colors cursor-pointer"
              >
                ← Geri
              </button>
              <button 
                type="button"
                @click="submitForm()"
                class="w-[160px] h-[45px] bg-[#111111] hover:bg-[#333333] text-white text-[12px] font-medium tracking-[0.08em] uppercase transition-colors flex items-center justify-center cursor-pointer"
              >
                Gönder
              </button>
            </div>

          </div>

        </div>

      </div>

    </div>
  </section>

</Layout>
