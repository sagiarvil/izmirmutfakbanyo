---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "İzmir Mutfak Dolabı Modelleri | Özel İmalat Mutfak Koleksiyonu",
  description: "Yeşilay Mutfak özel imalat mutfak dolabı modelleri. Lake, akrilik, doğal ahşap ve porselen tezgahlı modern ve zamansız ada mutfak tasarımları.",
  canonical: "https://yesilaymutfak.com/izmir-mutfak-dolabi-imalati/",
  serviceName: "Mutfak Dolabı Modelleri",
  breadcrumbs: [
    { name: "Ana Sayfa", url: "/" },
    { name: "Mutfak", url: "/izmir-mutfak-dolabi-imalati/" }
  ]
};

const kitchenModels = [
  {
    name: "Lumina",
    title: "Lumina Lake Ada Mutfak",
    badge: "Yeni model",
    image: "/images/models/mutfak/sakura.jpg",
    desc: "İpek mat lake yüzeyler, gizli kulp mimarisi ve heykelsi ada entegrasyonu."
  },
  {
    name: "Statuario",
    title: "Statuario Porselen Mutfak",
    badge: "",
    image: "/images/models/mutfak/iconica.jpg",
    desc: "Monolitik porselen ada tezgahı ve geniş hacimli mimari çekmece sistemleri."
  },
  {
    name: "Solyma",
    title: "Solyma Akrilik & Ahşap",
    badge: "",
    image: "/images/models/mutfak/convivio.jpg",
    desc: "Çizilmeye dayanıklı akrilik kapaklar ve doğal meşe detayların sıcak dengesi."
  },
  {
    name: "Linea",
    title: "Linea Minimalist Mutfak",
    badge: "",
    image: "/images/models/mutfak/start-time.jpg",
    desc: "Genç ve dinamik yaşam alanları için ergonomik, yalın ve akıcı dolap kurgusu."
  },
  {
    name: "Portofino",
    title: "Portofino İpek Mat Lake",
    badge: "",
    image: "/images/models/mutfak/milano.jpg",
    desc: "Poliüretan mat lake işçiliği ve fırçalanmış pirinç profil geçişleri."
  },
  {
    name: "Belvedere",
    title: "Belvedere Ada & Yaşam Alanı",
    badge: "",
    image: "/images/models/mutfak/lounge.jpg",
    desc: "Monolitik ada kurgusu ve sıcak ahşap açık raf sistemleriyle bütünleşik mekanlar."
  },
  {
    name: "Serena",
    title: "Serena Neo-Klasik Mutfak",
    badge: "",
    image: "/images/models/mutfak/armonia.jpg",
    desc: "Geleneksel çerçeve profilinin çağdaş ve zarif çizgilerle zamansız sentezi."
  },
  {
    name: "Vetro",
    title: "Vetro Reflekte Cam Mutfak",
    badge: "",
    image: "/images/models/mutfak/ri-flex.jpg",
    desc: "Füme reflekte cam kapaklar ve antrasit eloksallı alüminyum gövde mimarisi."
  },
  {
    name: "Plana",
    title: "Plana Entegre Kulplu Mutfak",
    badge: "",
    image: "/images/models/mutfak/tablet.jpg",
    desc: "Yatayda akıcı j-kulp profili ve parmak izi bırakmayan pürüzsüz dokunma hissi."
  },
  {
    name: "Natura",
    title: "Natura Masif Meşe & Akrilik",
    badge: "",
    image: "/images/models/mutfak/like.jpg",
    desc: "Doğal ahşap dokusunun sıcaklığı ile modern akrilik yüzeylerin dengesi."
  },
  {
    name: "Nostalgia",
    title: "Nostalgia Country Mutfak",
    badge: "",
    image: "/images/models/mutfak/memory.jpg",
    desc: "Sıcak ahşap dokuları, nostaljik çıtalı kapaklar ve modern konfor."
  },
  {
    name: "Onyx",
    title: "Onyx Koyu Antrasit Ada Mutfak",
    badge: "",
    image: "/images/models/mutfak/oyster.jpg",
    desc: "Antrasit ipek mat dokunuş, gizli kiler üniteleri ve mimari aydınlatma."
  },
  {
    name: "Toscana",
    title: "Toscana Çıtalı İtalyan Lake",
    badge: "",
    image: "/images/models/mutfak/pavese.jpg",
    desc: "Zarif çıtalı kapaklar ve doğal taş tezgah uyumuyla asil bir atmosfer."
  },
  {
    name: "Spazio",
    title: "Spazio Tavana Kadar Depolama",
    badge: "",
    image: "/images/models/mutfak/ethica.jpg",
    desc: "Tavan boyu dolaplar, köşe fasulye mekanizmaları ve akıllı kiler alanları."
  },
  {
    name: "Canaletto",
    title: "Canaletto Yivli Fluted Mutfak",
    badge: "",
    image: "/images/models/mutfak/extra.jpg",
    desc: "Dikey yivli ahşap paneller ve entegre ambiyans aydınlatma mimarisi."
  }
];
---

<Layout seo={seo} activeService="Mutfak Dolabı İmalatı">
  
  <!-- ===================================================================== -->
  <!-- REFERANS: atolyelocus.com/venetacucine/modeller BİREBİR KLON (Mutfak)   -->
  <!-- ===================================================================== -->
  <main class="w-full bg-[#FAF9F6] text-[#15231C] min-h-screen py-8 sm:py-12">
    
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 space-y-8 sm:space-y-12">
      
      <!-- BREADCRUMB (Locus Birebir: Ana Sayfa / Mutfak) -->
      <nav class="flex items-center space-x-2 text-[13px] text-[#756E65] font-normal" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#15231C] transition">Ana Sayfa</a>
        <span>/</span>
        <span class="text-[#15231C] font-semibold">Mutfak</span>
      </nav>

      <!-- H1 BAŞLIK (Locus Birebir: Roboto, 48px/36px, Bold, Saf Siyah/Koyu) -->
      <div class="pt-2">
        <h1 class="text-3xl sm:text-5xl font-bold text-[#15231C] tracking-tight leading-none" style="font-family: 'Roboto', sans-serif;">
          Modeller
        </h1>
      </div>

      <!-- MODEL KARTLARI GRİDİ (Locus Birebir: 3 Sütun Masaüstü, 2 Tablet, 1 Mobil, 1.755 Aspect Ratio) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-12 lg:gap-x-[24px] lg:gap-y-14">
        {kitchenModels.map((item) => {
          const waMsg = `Merhaba, Yeşilay Mutfak ${item.name} (${item.title}) modeli hakkında detaylı bilgi, ölçü ve fiyat teklifi almak istiyorum.`;
          const waHref = `https://wa.me/905324261788?text=${encodeURIComponent(waMsg)}`;
          return (
            <a 
              href={waHref}
              target="_blank"
              rel="noopener noreferrer"
              class="group block w-full text-decoration-none"
              aria-label={`${item.name} Mutfak Modeli`}
            >
              <!-- GÖRSEL ALANI (aspect-[1.755] = 1000/570, Tam Netlik, Hover Scale) -->
              <div class="relative w-full aspect-[1.755] overflow-hidden bg-[#ECEAE5]">
                <img 
                  src={item.image} 
                  alt={`${item.name} Mutfak Dolabı Modeli`}
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04] brightness-100 contrast-100"
                  loading="lazy"
                  width="1000"
                  height="570"
                />
                
                {/* Sol Üst Rozet (Locus Birebir: rgba(165, 189, 128, 0.89) Adaçayı Yeşili) */}
                {item.badge && (
                  <div class="absolute top-4 left-0 bg-[#A5BD80]/90 text-white text-[11px] font-normal tracking-wide px-2.5 py-0.5 z-10 select-none">
                    {item.badge}
                  </div>
                )}
              </div>

              <!-- MODEL ADI (Locus Birebir: h3, Roboto, 16px/18px, Bold, Resmin Hemen Altında) -->
              <div class="pt-3.5 pb-1 flex items-baseline justify-between">
                <h3 class="text-[#15231C] group-hover:text-[#006039] text-base sm:text-lg font-bold tracking-tight transition-colors" style="font-family: 'Roboto', sans-serif;">
                  {item.name}
                </h3>
                <span class="text-xs text-[#756E65] font-normal opacity-0 group-hover:opacity-100 transition-opacity">
                  Bilgi Al →
                </span>
              </div>
              <p class="text-xs text-[#756E65] font-normal line-clamp-1 leading-relaxed">
                {item.desc}
              </p>
            </a>
          );
        })}
      </div>

      <!-- AÇIKLAMA METNİ (Locus Birebir İçerik Yapısı) -->
      <div class="pt-12 sm:pt-16 max-w-4xl border-t border-[#E5E2DA]">
        <p class="text-sm sm:text-base text-[#4A443D] font-normal leading-relaxed">
          Mutfak tasarımının temelinde iki önemli adım vardır: ürünün estetik ve işlevsel kalitesi ile mekanın mimari potansiyeline uygun kişiselleştirme. Yeşilay Mutfak, Buca imalat atölyesinde 28 yıllık zanaat ustalığını çağdaş tasarım vizyonuyla buluşturarak hayalinizdeki yaşam alanını gerçeğe dönüştürür.
        </p>
      </div>

      <!-- DAHA FAZLA BİLGİ ALIN (Locus Birebir Teklif & İletişim Formu) -->
      <div class="pt-10 sm:pt-16 pb-8 border-t border-[#E5E2DA]" id="bilgi-al">
        <div class="max-w-2xl">
          <h2 class="text-2xl sm:text-3xl font-bold text-[#15231C] tracking-tight mb-2" style="font-family: 'Roboto', sans-serif;">
            Daha Fazla Bilgi Alın
          </h2>
          <p class="text-xs sm:text-sm text-[#756E65] font-normal mb-8">
            Beğendiğiniz model veya mekanınızın ölçüleri hakkında doğrudan mimari ekibimizden detaylı bilgi ve 3D tasarım teklifi alın.
          </p>

          <form 
            action="https://wa.me/905324261788" 
            method="GET" 
            target="_blank"
            class="space-y-4"
          >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="adsoyad" class="block text-xs font-semibold text-[#15231C] mb-1.5">Ad Soyad*</label>
                <input 
                  type="text" 
                  id="adsoyad" 
                  name="adsoyad" 
                  required 
                  placeholder="Adınız ve Soyadınız" 
                  class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] placeholder-[#9E9689] focus:outline-none focus:border-[#15231C] transition"
                />
              </div>
              <div>
                <label for="telefon" class="block text-xs font-semibold text-[#15231C] mb-1.5">Telefon*</label>
                <input 
                  type="tel" 
                  id="telefon" 
                  name="telefon" 
                  required 
                  placeholder="05XX XXX XX XX" 
                  class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] placeholder-[#9E9689] focus:outline-none focus:border-[#15231C] transition"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-xs font-semibold text-[#15231C] mb-1.5">E-posta*</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="ornek@email.com" 
                class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] placeholder-[#9E9689] focus:outline-none focus:border-[#15231C] transition"
              />
            </div>

            <div>
              <label for="mesaj" class="block text-xs font-semibold text-[#15231C] mb-1.5">Mesajınız</label>
              <textarea 
                id="mesaj" 
                name="mesaj" 
                rows="3" 
                placeholder="İlgilendiğiniz mutfak modeli, tahmini ölçüleriniz veya özel istekleriniz..." 
                class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] placeholder-[#9E9689] focus:outline-none focus:border-[#15231C] transition"
              ></textarea>
            </div>

            <div class="pt-2">
              <button 
                type="submit" 
                class="w-full sm:w-auto px-8 py-3 bg-[#15231C] hover:bg-[#006039] text-white text-xs font-bold uppercase tracking-wider transition-colors duration-200 select-none"
              >
                Gönder
              </button>
            </div>
          </form>
        </div>
      </div>

    </div>
  </main>
</Layout>
