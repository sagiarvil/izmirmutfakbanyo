---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "Hakkımızda — Yeşilay Mutfak Mimarlık & Özel İmalat Atölyesi",
  description: "1998'den bu yana İzmir Buca Adatepe'deki kendi imalat atölyemizde kişiye özel lüks mutfak dolapları, ıslak hacim renovasyonları ve anahtar teslim mimari taahhüt üretiyoruz. 28 yıllık tecrübe, 2.850+ tamamlanan proje ve 10 yıl sözleşmeli gövde garantisi.",
  canonical: `${siteConfig.siteUrl}/hakkimizda/`,
  serviceName: "Yeşilay Mutfak & İç Mimari",
  breadcrumbs: [
    { name: "Hakkımızda", url: "/hakkimizda/" }
  ],
  keywords: [
    "yeşilay mutfak kimdir",
    "yeşilay mutfak mimarlık hakkımızda",
    "buca adatepe mutfak atölyesi",
    "izmir özel mobilya imalatçısı",
    "lüks mutfak dolabı üreticisi izmir",
    "cem yeşilay mimarlık"
  ]
};
---

<Layout seo={seo} activeService="Hakkımızda">

  <!-- ===================================================================== -->
  <!-- 1. HERO BÖLÜMÜ (ZARİF MİMARİ MİRAS & DEV WATERMARK)                 -->
  <!-- ===================================================================== -->
  <section class="relative py-20 sm:py-28 bg-[#FAF9F6] border-b border-[#E5DFD5] overflow-hidden">
    <!-- Dekoratif Arka Plan Işık Dalgası -->
    <div class="absolute inset-0 pointer-events-none opacity-40">
      <div class="absolute -top-32 right-1/4 w-96 h-96 bg-[#C5A880]/15 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-32 left-10 w-96 h-96 bg-[#006039]/10 rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10 space-y-8">
      
      <!-- Ghost Watermark Dinamik SVG Başlık (Kurumsal Standart: Üstte ve Asla Çakışmaz) -->
      <div class="w-full max-w-4xl mx-auto flex items-center justify-center pointer-events-none select-none">
        <svg viewBox="0 0 880 140" class="w-full h-auto max-h-[70px] sm:max-h-[95px] md:max-h-[120px]" preserveAspectRatio="xMidYMid meet">
          <text x="50%" y="54%" dominant-baseline="central" text-anchor="middle" font-size="120" font-weight="700" font-style="italic" font-family="'Cormorant Garamond', 'Playfair Display', Georgia, serif" fill="#EFECE6" letter-spacing="-0.02em">Miras & Güven.</text>
        </svg>
      </div>

      <!-- Rozet -->
      <div class="flex items-center justify-center">
        <div class="inline-flex items-center gap-2.5 px-4 py-2 bg-white border border-[#E5DFD5] rounded-full shadow-[0_2px_8px_rgba(21,35,28,0.04)]">
          <span class="w-2.5 h-2.5 rounded-full bg-[#006039] animate-pulse"></span>
          <span class="text-[#15231C] text-[11px] sm:text-[12px] font-bold tracking-[0.14em] uppercase font-sans">
            1998'DEN BUGÜNE 28 YILLIK DOĞRUDAN ATÖLYE İMALATI
          </span>
        </div>
      </div>

      <!-- Ana Başlık & Açıklama -->
      <div class="text-center max-w-4xl mx-auto space-y-5">
        <h1 class="text-[36px] sm:text-[52px] lg:text-[60px] font-extrabold text-[#15231C] leading-[1.1] tracking-[-0.03em]">
          Aracısız Kendi Atölyesinde Üreten, <br class="hidden sm:inline" />
          <span class="text-[#006039] font-serif italic font-normal">Sözleşmeli & Garantili</span> <br class="hidden sm:inline" />
          Mimari Mutfak & Yaşam Alanı Uzmanı.
        </h1>

        <p class="text-[16px] sm:text-[18.5px] text-[#55504A] font-normal leading-relaxed max-w-3xl mx-auto">
          Yeşilay Mutfak; taşeron komisyonu veya fason üretim bantları yerine, <strong>İzmir Buca Adatepe'deki kendi modern tesisinde</strong> milimetrik lazer rölöve, fırın boyalı lake kabinleri ve Avusturya Blum mekanizmalarıyla kişiye özel yaşam alanları inşa eder.
        </p>

        <!-- Hızlı Aksiyon Butonları -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 pt-4">
          <a 
            href="https://wa.me/905324261788?text=Merhaba,%20Ye%C5%9Filay%20Mutfak%20hakk%C4%B1nda%20bilgi%20ve%20%C3%BCcretsiz%203D%20ke%C5%9Fif%20g%C3%B6r%C3%BC%C5%9Fmesi%20istiyorum." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-[#006039] hover:bg-[#00482B] text-white font-bold text-xs sm:text-[13px] tracking-wider uppercase rounded-xl border border-[#C5A880]/50 shadow-[0_6px_20px_rgba(0,96,57,0.25)] transition duration-200"
            data-track="cta_click"
            data-category="hakkimizda_hero"
            data-label="whatsapp_kesif"
          >
            <span>Showroom Randevusu & 3D Keşif Al</span>
            <span class="text-[#C5A880]">→</span>
          </a>

          <a 
            href="/yapilan-isler/" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-white hover:bg-[#F3EFEA] text-[#15231C] font-bold text-xs sm:text-[13px] tracking-wider uppercase rounded-xl border border-[#E5DFD5] shadow-xs transition duration-200"
            data-track="nav_click"
            data-category="hakkimizda_hero"
            data-label="yapilan_isler"
          >
            <span>Gerçek Teslim Edilmiş İşler</span>
            <span class="text-[#C5A880]">↗</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. RAKAMLARLA KURUMSAL OTORİTE & GÜVEN METRİKLERİ                     -->
  <!-- ===================================================================== -->
  <section class="py-14 bg-white border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
        
        <div class="p-6 bg-[#FAF9F6] rounded-2xl border border-[#E5DFD5] space-y-1.5 transition hover:border-[#C5A880]">
          <div class="text-[34px] sm:text-[42px] font-extrabold text-[#15231C] tracking-tight">28+ Yıl</div>
          <div class="text-[13px] font-bold text-[#006039] uppercase tracking-wide">Kesintisiz İmalat Mirası</div>
          <p class="text-[12px] text-[#6E675F] leading-snug">1998'den bu yana İzmir Buca'da kendi mülk ve makinelerimizle üretim gücü.</p>
        </div>

        <div class="p-6 bg-[#FAF9F6] rounded-2xl border border-[#E5DFD5] space-y-1.5 transition hover:border-[#C5A880]">
          <div class="text-[34px] sm:text-[42px] font-extrabold text-[#15231C] tracking-tight">2.850+</div>
          <div class="text-[13px] font-bold text-[#006039] uppercase tracking-wide">Eksiksiz Teslim Edilmiş Proje</div>
          <p class="text-[12px] text-[#6E675F] leading-snug">İzmir, Çeşme, Urla ve Güzelbahçe genelinde daire, villa ve ticari fit-out teslimi.</p>
        </div>

        <div class="p-6 bg-[#FAF9F6] rounded-2xl border border-[#E5DFD5] space-y-1.5 transition hover:border-[#C5A880]">
          <div class="text-[34px] sm:text-[42px] font-extrabold text-[#15231C] tracking-tight">137 Model</div>
          <div class="text-[13px] font-bold text-[#006039] uppercase tracking-wide">Kişiye Özel Tasarım Arşivi</div>
          <p class="text-[12px] text-[#6E675F] leading-snug">Mutfak, lüks banyo, ada üniteleri, giyinme odaları ve özel lake iç kapılar.</p>
        </div>

        <div class="p-6 bg-[#FAF9F6] rounded-2xl border border-[#E5DFD5] space-y-1.5 transition hover:border-[#C5A880]">
          <div class="text-[34px] sm:text-[42px] font-extrabold text-[#15231C] tracking-tight">10 Yıl</div>
          <div class="text-[13px] font-bold text-[#006039] uppercase tracking-wide">Sözleşmeli Gövde Güvencesi</div>
          <p class="text-[12px] text-[#6E675F] leading-snug">E1 sınıfı marin gövde ve Blum Avusturya mekanizma parçalarında hukuki taahhüt.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. CANLI SHOWROOM & GERÇEK İMALAT FOTOĞRAFLARI (SOMUT KANIT)          -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-white border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      
      <!-- GHOST / WATERMARK TYPOGRAPHY HEADER -->
      <div class="text-center w-full max-w-7xl mx-auto flex flex-col items-center justify-center space-y-2 sm:space-y-3">
        <div class="w-full max-w-3xl sm:max-w-4xl px-4 flex items-center justify-center pointer-events-none select-none">
          <svg viewBox="0 0 760 140" class="w-full h-auto max-h-[70px] sm:max-h-[95px] md:max-h-[110px]" preserveAspectRatio="xMidYMid meet">
            <text x="50%" y="54%" dominant-baseline="central" text-anchor="middle" font-size="130" font-weight="700" font-style="italic" font-family="'Cormorant Garamond', 'Playfair Display', Georgia, serif" fill="#EFECE6" letter-spacing="-0.02em">Somut Zanaat.</text>
          </svg>
        </div>
        <div class="space-y-2.5 px-4 max-w-3xl mx-auto">
          <span class="text-[12px] uppercase font-bold tracking-[0.16em] text-[#C5A880] block">CANLI SHOWROOM & İMALAT KANITLARI</span>
          <h2 class="text-[28px] sm:text-[38px] md:text-[44px] font-extrabold text-[#15231C] tracking-tight leading-tight">
            Sözde Değil, Yerinde Görülen Gerçek Üretim Gücü
          </h2>
          <p class="text-[15px] sm:text-[16.5px] text-[#55504A] font-normal max-w-2xl mx-auto leading-relaxed">
            Buca Gaziler'deki amiral showroomumuz ve Adatepe'deki modern üretim tesisimiz; müşterilerimizin malzemeyi dokunarak seçtiği, şeffaf süreçlerin merkezidir.
          </p>
        </div>
      </div>

      <!-- RESİM MOZAİĞİ (GRID) -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-stretch">
        
        <!-- Büyük Görsel: Showroom Gece Işıklı Cephe (8 Kolon) -->
        <div class="md:col-span-8 group relative rounded-2xl sm:rounded-3xl overflow-hidden border border-[#E5DFD5] shadow-lg bg-[#15231C]">
          <div class="aspect-[16/10] w-full overflow-hidden">
            <img 
              src="/media/real/yesilay-showroom-gece-cephe.webp" 
              alt="Yeşilay Mutfak Buca Gaziler Lüks Showroom Dış Cephesi" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
              loading="lazy" 
              width="960"
              height="600"
            />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6 text-white space-y-1.5">
            <span class="px-3 py-1 bg-[#006039] text-white text-[11px] font-bold uppercase tracking-wider rounded-md inline-block">
              AMİRAL MAĞAZA & SHOWROOM
            </span>
            <h3 class="text-xl sm:text-2xl font-bold">Cem Yeşilay Luxury • Buca Gaziler Showroom</h3>
            <p class="text-xs sm:text-sm text-gray-200 font-light">En yeni mimari trendler, ada mutfaklar, lüks banyo dolapları ve giyinme odaları teşhiri.</p>
          </div>
        </div>

        <!-- Yan Görsel: Mimari Danışmanlık ve Müşteri Masası (4 Kolon) -->
        <div class="md:col-span-4 group relative rounded-2xl sm:rounded-3xl overflow-hidden border border-[#E5DFD5] shadow-lg bg-[#15231C] flex flex-col justify-end">
          <div class="aspect-[3/4] md:aspect-auto h-full w-full overflow-hidden">
            <img 
              src="/media/real/yesilay-mimari-danismanlik-toplanti.webp" 
              alt="Yeşilay Mutfak Mimari Danışmanlık ve 3D Proje Sunumu Masası" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
              loading="lazy" 
              width="480"
              height="640"
            />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6 text-white space-y-1.5">
            <span class="px-3 py-1 bg-[#C5A880] text-[#15231C] text-[11px] font-bold uppercase tracking-wider rounded-md inline-block">
              MİMARİ DANIŞMANLIK
            </span>
            <h3 class="text-lg font-bold">Birebir Projelendirme</h3>
            <p class="text-xs text-gray-200 font-light">Her detay müşterimizin beklentilerine ve bütçesine göre masada şeffafça şekillenir.</p>
          </div>
        </div>

        <!-- Alt 3'lü Grid: İç Mekan, Giriş Lobisi ve Buca Bina Lokasyonu -->
        <div class="md:col-span-4 group relative rounded-2xl overflow-hidden border border-[#E5DFD5] shadow-md bg-white">
          <div class="aspect-[16/11] w-full overflow-hidden">
            <img 
              src="/media/real/yesilay-showroom-ic-mekan.webp" 
              alt="Yeşilay Mutfak Showroom İç Mekan ve Teşhir Alanı" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              loading="lazy" 
              width="600"
              height="412"
            />
          </div>
          <div class="p-5 space-y-1.5">
            <span class="text-[11px] font-bold text-[#006039] uppercase tracking-wider block">PANORAMİK SHOWROOM</span>
            <h3 class="text-[15px] font-bold text-[#15231C]">Lüks Teşhir & Canlı Deneyim</h3>
            <p class="text-[12px] text-[#6E675F] leading-snug">Mermer paneller, gizli profil LED aydınlatmalar ve akrilik lake dolap sistemleri.</p>
          </div>
        </div>

        <div class="md:col-span-4 group relative rounded-2xl overflow-hidden border border-[#E5DFD5] shadow-md bg-white">
          <div class="aspect-[16/11] w-full overflow-hidden">
            <img 
              src="/media/real/yesilay-showroom-karsilama-giris.webp" 
              alt="Yeşilay Mutfak Showroom Giriş ve Karşılama Alanı" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              loading="lazy" 
              width="600"
              height="412"
            />
          </div>
          <div class="p-5 space-y-1.5">
            <span class="text-[11px] font-bold text-[#C5A880] uppercase tracking-wider block">PRESTİJLİ GİRİŞ</span>
            <h3 class="text-[15px] font-bold text-[#15231C]">Modern Karşılama Alanı</h3>
            <p class="text-[12px] text-[#6E675F] leading-snug">Müşterilerimizi sıcak bir ortamda ağırlıyor, kahve eşliğinde projelerini dinliyoruz.</p>
          </div>
        </div>

        <div class="md:col-span-4 group relative rounded-2xl overflow-hidden border border-[#E5DFD5] shadow-md bg-white">
          <div class="aspect-[16/11] w-full overflow-hidden">
            <img 
              src="/media/real/yesilay-buca-showroom-dis-bina.webp" 
              alt="Yeşilay Mutfak Buca Gaziler Köşe Bina ve Mağaza Konumu" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              loading="lazy" 
              width="600"
              height="412"
            />
          </div>
          <div class="p-5 space-y-1.5">
            <span class="text-[11px] font-bold text-[#006039] uppercase tracking-wider block">KOLAY ULAŞIM & PARK</span>
            <h3 class="text-[15px] font-bold text-[#15231C]">Buca Gaziler Köşe Mağaza</h3>
            <p class="text-[12px] text-[#6E675F] leading-snug">Gazi Osman Paşa Caddesi köşesinde, otopark imkânı ve ferah vitrin konumu.</p>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 4. PİYASADAKİ ARACILARDAN FARKIMIZ (MİMARİ YETKİNLİK MATRİSİ)          -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-[#FAF9F6] border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      
      <div class="max-w-3xl mx-auto text-center space-y-3">
        <span class="text-[12px] uppercase font-bold tracking-[0.16em] text-[#C5A880] block">ŞEFFAF KARŞILAŞTIRMA</span>
        <h2 class="text-[30px] sm:text-[40px] font-extrabold text-[#15231C] tracking-tight">
          Neden Yeşilay Mutfak? Farkımız Nerede?
        </h2>
        <p class="text-[15px] sm:text-[16px] text-[#55504A] leading-relaxed">
          Tadilat ve mutfak sektöründe yaşanan mağduriyetleri biliyoruz. Bu yüzden tüm işleyişimizi şeffaf, ölçülebilir ve kanıtlanabilir kurallara bağladık.
        </p>
      </div>

      <!-- Karşılaştırma Tablosu / Matrisi -->
      <div class="overflow-x-auto bg-white rounded-2xl border border-[#E5DFD5] shadow-xs">
        <table class="w-full text-left text-xs sm:text-[13px] border-collapse">
          <thead>
            <tr class="border-b border-[#E5DFD5] bg-[#F3EFEA]/70 text-[#15231C]">
              <th class="p-4 sm:p-5 font-bold uppercase tracking-wider text-[11px]">Kriter / Aşama</th>
              <th class="p-4 sm:p-5 font-bold uppercase tracking-wider text-[11px] text-[#006039] bg-[#E8F3EE]/60">Yeşilay Mutfak Standartı</th>
              <th class="p-4 sm:p-5 font-bold uppercase tracking-wider text-[11px] text-[#86868B]">Piyasadaki Tipik Aracılar / Taşeronlar</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#E5DFD5] text-[#282421]">
            <tr class="hover:bg-[#FAF9F6] transition">
              <td class="p-4 sm:p-5 font-bold text-[#15231C]">Üretim Modeli</td>
              <td class="p-4 sm:p-5 font-semibold text-[#006039] bg-[#E8F3EE]/30">
                ✅ Buca Adatepe'deki kendi modern atölyemizde kadrolu ustalarımızla üretim.
              </td>
              <td class="p-4 sm:p-5 text-[#6E675F]">
                ❌ Fason marangozlara iş paslama, komisyon ekleme, kontrolsüz taşeron zinciri.
              </td>
            </tr>
            <tr class="hover:bg-[#FAF9F6] transition">
              <td class="p-4 sm:p-5 font-bold text-[#15231C]">Ölçü & Rölöve</td>
              <td class="p-4 sm:p-5 font-semibold text-[#006039] bg-[#E8F3EE]/30">
                ✅ Lazer metre ile milimetrik rölöve, köşe açı taraması ve sıfır hata toleransı.
              </td>
              <td class="p-4 sm:p-5 text-[#6E675F]">
                ❌ Klasik şerit metreyle kabataslak ölçü, montajda uymayan dolaplar ve kesimler.
              </td>
            </tr>
            <tr class="hover:bg-[#FAF9F6] transition">
              <td class="p-4 sm:p-5 font-bold text-[#15231C]">Görselleştirme</td>
              <td class="p-4 sm:p-5 font-semibold text-[#006039] bg-[#E8F3EE]/30">
                ✅ Evinize birebir fotogerçekçi 3D simülasyon ve renk onayı ile sürprize yer yok.
              </td>
              <td class="p-4 sm:p-5 text-[#6E675F]">
                ❌ Elle karalanmış kağıt çizimler veya internetten kopyalanmış sahte kataloglar.
              </td>
            </tr>
            <tr class="hover:bg-[#FAF9F6] transition">
              <td class="p-4 sm:p-5 font-bold text-[#15231C]">Gövde & Malzeme</td>
              <td class="p-4 sm:p-5 font-semibold text-[#006039] bg-[#E8F3EE]/30">
                ✅ Sadece E1 sertifikalı nem dirençli marin yeşil MDF ve 1mm kalın PVC bant.
              </td>
              <td class="p-4 sm:p-5 text-[#6E675F]">
                ❌ Neme dayanıksız suntalam gövdeler, zamanla kabaran ve koku yapan suntalar.
              </td>
            </tr>
            <tr class="hover:bg-[#FAF9F6] transition">
              <td class="p-4 sm:p-5 font-bold text-[#15231C]">Donanım & Mekanizma</td>
              <td class="p-4 sm:p-5 font-semibold text-[#006039] bg-[#E8F3EE]/30">
                ✅ Avusturya menşeili orijinal Blum & Häfele frenli menteşe ve tandem raylar.
              </td>
              <td class="p-4 sm:p-5 text-[#6E675F]">
                ❌ Menşei belirsiz fason raylar, 6 ay sonra sarkan ve çarpan kapaklar.
              </td>
            </tr>
            <tr class="hover:bg-[#FAF9F6] transition">
              <td class="p-4 sm:p-5 font-bold text-[#15231C]">Sözleşme & Teslim</td>
              <td class="p-4 sm:p-5 font-semibold text-[#006039] bg-[#E8F3EE]/30">
                ✅ Noter geçerliliğinde resmi sözleşme, gecikme cezalı kesin teslim tarihi.
              </td>
              <td class="p-4 sm:p-5 text-[#6E675F]">
                ❌ Sözlü taahhütler, haftalarca sarkan teslimatlar ve ulaşılamayan telefonlar.
              </td>
            </tr>
          </tbody>
        </table>
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 5. 5 ADIMDA ŞEFFAF VE KUSURSUZ İŞ AKIŞI                              -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-white border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-[12px] uppercase font-bold tracking-[0.16em] text-[#C5A880] block">DİSİPLİNLİ SÜREÇ</span>
        <h2 class="text-[30px] sm:text-[40px] font-extrabold text-[#15231C] tracking-tight">
          Yeşilay Mutfak İle Projeniz Nasıl İlerler?
        </h2>
        <p class="text-[15px] sm:text-[16px] text-[#55504A] leading-relaxed">
