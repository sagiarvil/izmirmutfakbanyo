---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "Hakkımızda — 1998'den Bugüne İzmir Buca Atölye İmalatı & Mimarlık",
  description: "İzmir Buca Gaziler Caddesi showroomumuz ve Adatepe imalat atölyemizde 1998'den bu yana aracısız, fason üretimsiz ve resmi sözleşmeyle özel mutfak dolapları ve anahtar teslim konut tadilatı gerçekleştiriyoruz.",
  canonical: `${siteConfig.siteUrl}/hakkimizda/`,
  serviceName: "Yeşilay Mutfak & Mimarlık",
  breadcrumbs: [
    { name: "Ana Sayfa", url: "/" },
    { name: "Hakkımızda", url: "/hakkimizda/" }
  ],
  keywords: [
    "yeşilay mutfak kimdir",
    "yeşilay mutfak bakiye yeşilay cem yeşilay",
    "buca adatepe mutfak imalat atölyesi",
    "izmir mutfak dolabı üreticisi fabrika",
    "sözleşmeli mutfak tadilatı izmir",
    "gaziler mahallesi yeşilay mutfak",
    "buca mutfak mağazası"
  ]
};
---

<Layout seo={seo} activeService="Hakkımızda">

  <!-- ===================================================================== -->
  <!-- 1. HERO BÖLÜMÜ: GERÇEK MEKAN, KÖKLÜ MİRAS & SIFIR SLOP                -->
  <!-- ===================================================================== -->
  <section class="relative py-16 sm:py-24 bg-[#0E2017] text-white overflow-hidden border-b border-[#0A1A12]">
    <!-- Arka Plan Gerçek Showroom Dış Cephe Binası (Buca Gaziler Cd.) -->
    <div class="absolute inset-0 bg-cover bg-center opacity-30 mix-blend-luminosity scale-105" style="background-image: url('/media/real/yesilay-buca-showroom-dis-bina.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A1A12] via-[#0E2017]/90 to-[#0A1A12]/80"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10 space-y-8">
      
      <!-- Ghost Watermark Dinamik SVG (Üstte, Asla Başlığa Basmaz) -->
      <div class="w-full max-w-4xl mx-auto flex items-center justify-center pointer-events-none select-none">
        <svg viewBox="0 0 880 120" class="w-full h-auto max-h-[60px] sm:max-h-[85px] md:max-h-[105px]" preserveAspectRatio="xMidYMid meet">
          <text x="50%" y="54%" dominant-baseline="central" text-anchor="middle" font-size="110" font-weight="700" font-style="italic" font-family="'Playfair Display', Georgia, serif" fill="#1C3829" letter-spacing="-0.02em">1998'DEN BUGÜNE</text>
        </svg>
      </div>

      <!-- Rozet -->
      <div class="flex items-center justify-center">
        <div class="inline-flex items-center gap-2.5 px-4 py-2 bg-emerald-950/80 border border-emerald-500/40 rounded-full shadow-lg">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-emerald-200 text-[11px] sm:text-[12px] font-bold tracking-[0.16em] uppercase">
            28 YILLIK FİZİKİ ŞİRKET &bull; ARACISIZ BUCA ATÖLYE İMALATI
          </span>
        </div>
      </div>

      <!-- Ana Başlık & Açıklama -->
      <div class="text-center max-w-4xl mx-auto space-y-5">
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight leading-[1.15]" style="font-family: 'Playfair Display', Georgia, serif;">
          Masa Başı Aracı Değil; <br />
          <span class="font-normal italic text-emerald-300">Kendi Atölyesinde Üreten,</span> <br />
          28 Yıllık İzmirli İmalatçı ve Mimarlık Kuruluşu.
        </h1>

        <p class="text-base sm:text-lg text-stone-300 font-light leading-relaxed max-w-3xl mx-auto">
          İzmir Buca Gaziler Caddesi köşesindeki 3 katlı mağazamız ve Adatepe’deki kendi mobilya imalat atölyemizle 1998 yılından bu yana hizmetinizdeyiz. Fason taşeron komisyonu ödemeden, kadrolu mimarlarımızın 3D projesi ve resmi sözleşme güvencesiyle evinizi yeniliyoruz.
        </p>

        <!-- Güven Göstergeleri Dock -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6 max-w-3xl mx-auto text-left">
          <div class="p-4 bg-white/5 border border-white/10 rounded-2xl backdrop-blur-xs">
            <div class="text-2xl sm:text-3xl font-bold text-emerald-400">1998</div>
            <div class="text-xs text-stone-300 font-light mt-0.5">Buca Kuruluş Yılı</div>
          </div>
          <div class="p-4 bg-white/5 border border-white/10 rounded-2xl backdrop-blur-xs">
            <div class="text-2xl sm:text-3xl font-bold text-emerald-400">2.850+</div>
            <div class="text-xs text-stone-300 font-light mt-0.5">Teslim Edilmiş Ev &amp; Villa</div>
          </div>
          <div class="p-4 bg-white/5 border border-white/10 rounded-2xl backdrop-blur-xs">
            <div class="text-2xl sm:text-3xl font-bold text-emerald-400">%100</div>
            <div class="text-xs text-stone-300 font-light mt-0.5">Öz Sermayeli Atölye</div>
          </div>
          <div class="p-4 bg-white/5 border border-white/10 rounded-2xl backdrop-blur-xs">
            <div class="text-2xl sm:text-3xl font-bold text-emerald-400">10 Yıl</div>
            <div class="text-xs text-stone-300 font-light mt-0.5">Yazılı Gövde Taahhüdü</div>
          </div>
        </div>

        <!-- Butonlar -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
          <a 
            href="https://wa.me/905324261788?text=Merhaba,%20Yeşilay%20Mutfak%20showroomunuza%20gelmek%20ve%20ücretsiz%203D%20keşif%20görüşmesi%20almak%20istiyorum." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-full sm:w-auto px-8 py-3.5 bg-emerald-500 hover:bg-emerald-400 text-stone-950 font-bold text-xs uppercase tracking-wider rounded-xl shadow-lg transition"
          >
            <span>💬 Buca Showroom Randevusu Al</span>
          </a>
          <a 
            href="tel:02324411060" 
            class="w-full sm:w-auto px-8 py-3.5 bg-white/10 hover:bg-white hover:text-stone-950 text-white border border-white/20 font-bold text-xs uppercase tracking-wider rounded-xl transition"
          >
            <span>📞 0232 441 10 60 — Atölyeyi Arayın</span>
          </a>
        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. BİZ KİMİZ? GERÇEK FİZİKİ KİMLİK, ADRES VE ŞİRKET HİKAYESİ         -->
  <!-- ===================================================================== -->
  <section class="py-20 sm:py-24 bg-white border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-16">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Sol: Detaylı Açıklama -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-stone-100 border border-stone-200 rounded-lg text-xs font-bold text-emerald-800 uppercase tracking-wider">
            <span>FİZİKİ KİMLİK &bull; TİCARİ GEÇMİŞİMİZ</span>
          </div>

          <h2 class="text-3xl sm:text-4xl font-light text-stone-950 leading-tight" style="font-family: 'Playfair Display', Georgia, serif;">
            İnternet Vitrini Değil; <br />
            <span class="font-normal italic text-emerald-800">Kapısını Çalıp Çayımızı İçebileceğiniz</span> <br />
            Gerçek Bir İzmir Müessesesi.
          </h2>

          <div class="text-stone-700 text-sm sm:text-base leading-relaxed space-y-4 font-light">
            <p>
              Bugün internette gördüğünüz pek çok tadilat ve mutfak sitesi; ne bir tezgaha, ne bir marangoz tezgahına ne de bir makine parkına sahiptir. Çoğu, internetten topladıkları işleri komisyon karşılığı dışarıdaki ustalara dağıtan aracılardır. Bir sorun çıktığında telefonlara bakacak tek bir yetkili dahi bulamazsınız.
            </p>
            <p>
              <strong>Yeşilay Mutfak &amp; Mimarlık olarak biz 1998 yılından bu yana aynı yerdeyiz.</strong> Bakiye Yeşilay ve Cem Yeşilay yönetiminde; İzmir Buca Gaziler Mahallesi'ndeki kendi teşhir mağazamız ve Adatepe’deki imalat tesisimizde üretim yapıyoruz. Ahşabın tozunu yutan kadrolu ustalarımız, CNC kesim ve tozsuz fırın lake kabinlerimizle her dolabın gövdesini milimetrik olarak kendimiz üretiyoruz.
            </p>
            <p>
              Bizimle çalıştığınızda üçüncü şahıslarla, komisyoncularla veya fason atölyelerle muhatap olmazsınız. Rölöveyi alan iç mimarımız, çizimi yapan ekibimiz, atölyede imalatı gerçekleştiren ustamız ve evinize gelip montajı yapan ekibimiz tek bir çatının kadrolu personelleridir.
            </p>
          </div>

          <!-- Kurumsal Bilgiler Kutusu -->
          <div class="p-5 bg-stone-50 border border-stone-200 rounded-2xl grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div>
              <span class="text-stone-400 block font-medium uppercase text-[10px] tracking-wider">TİCARİ ÜNVAN &amp; MARKA</span>
              <strong class="text-stone-900 text-sm">Yeşilay Mutfak &amp; Özel İmalat</strong>
              <div class="text-stone-500 mt-0.5">Tescilli Tasarım ve Üretim Şirketi</div>
            </div>
            <div>
              <span class="text-stone-400 block font-medium uppercase text-[10px] tracking-wider">SHOWROOM &amp; TEŞHİR MAĞAZASI</span>
              <strong class="text-stone-900 text-sm">Gaziler Mh. 1084/2 Sk. No: 1/A Buca</strong>
              <div class="text-stone-500 mt-0.5">Gazi Osman Paşa Cd. Köşesi (3 Katlı Mağaza)</div>
            </div>
            <div>
              <span class="text-stone-400 block font-medium uppercase text-[10px] tracking-wider">İMALAT ATÖLYESİ</span>
              <strong class="text-stone-900 text-sm">Adatepe Mahallesi Üretim Tesisleri</strong>
              <div class="text-stone-500 mt-0.5">Öz Mal CNC, Ebatlama ve Fırın Lake Hattı</div>
            </div>
            <div>
              <span class="text-stone-400 block font-medium uppercase text-[10px] tracking-wider">SABİT TELEFON &amp; İLETİŞİM</span>
              <strong class="text-emerald-700 text-sm">0232 441 10 60 &bull; 0532 426 17 88</strong>
              <div class="text-stone-500 mt-0.5">Haftanın 6 Günü 09:00 - 19:30 Kesintisiz</div>
            </div>
          </div>
        </div>

        <!-- Sağ: Gerçek Mekan Fotoğrafları Kolajı -->
        <div class="lg:col-span-5 space-y-4">
          <div class="group rounded-2xl overflow-hidden border border-stone-200 shadow-md relative aspect-[4/3] bg-stone-100">
            <img 
              src="/media/real/yesilay-buca-showroom-dis-bina.webp" 
              alt="Yeşilay Mutfak Buca Mağazası Dış Görünüm" 
              class="w-full h-full object-cover group-hover:scale-103 transition duration-500" 
              loading="lazy"
            />
            <div class="absolute bottom-3 left-3 right-3 p-3 bg-stone-950/80 backdrop-blur-xs text-white rounded-xl text-xs flex items-center justify-between">
              <div>
                <strong class="block text-white">Buca Showroom Mağazamız</strong>
                <span class="text-stone-300 text-[11px]">Gaziler Mah. Gazi Osman Paşa Cd. Köşesi</span>
              </div>
              <span class="px-2 py-1 bg-emerald-600 text-[10px] font-bold rounded">CANLI ZİYARET</span>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="rounded-2xl overflow-hidden border border-stone-200 shadow-xs aspect-square bg-stone-100 relative group">
              <img 
                src="/media/real/yesilay-showroom-ic-mekan.webp" 
                alt="Yeşilay Mutfak Showroom İç Mekan Teşhir" 
                class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
                loading="lazy"
              />
              <span class="absolute bottom-2 left-2 px-2 py-1 bg-stone-900/80 text-white text-[10px] font-medium rounded backdrop-blur-xs">İç Mekan Teşhir</span>
            </div>
            <div class="rounded-2xl overflow-hidden border border-stone-200 shadow-xs aspect-square bg-stone-100 relative group">
              <img 
                src="/media/real/yesilay-mimari-danismanlik-toplanti.webp" 
                alt="Mimari Danışmanlık ve Malzeme Seçimi Toplantısı" 
                class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
                loading="lazy"
              />
              <span class="absolute bottom-2 left-2 px-2 py-1 bg-stone-900/80 text-white text-[10px] font-medium rounded backdrop-blur-xs">Birebir Mimari Proje</span>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. MÜŞTERİ NEDEN GÜVEN DUYMALI? 6 KATMANLI SÖZLEŞME VE İMALAT ZIRHI -->
  <!-- ===================================================================== -->
  <section class="py-20 sm:py-24 bg-stone-50 border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-16">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-800">TÜKETİCİYİ KORUYAN ÇELİK GİBİ KURALLAR</span>
        <h2 class="text-3xl sm:text-4xl font-light text-stone-950 font-editorial">
          İzmir'de Evinizi Yenilerken Sizi Risklerden Koruyan 6 İlke
        </h2>
        <p class="text-stone-600 text-sm font-light leading-relaxed">
          Sektörde en çok şikayet edilen konuları (sürpriz ek maliyetler, günlerce geciken teslimatlar, kalitesiz yan sanayi malzeme kullanımı) sistemimizden tamamen eledik.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Güven 1: Sabit Fiyat Sözleşmesi -->
        <div class="p-8 bg-white rounded-2xl border border-stone-200 shadow-xs space-y-4 hover:border-emerald-600 transition">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-xl font-bold font-mono">
            01
          </div>
          <h3 class="text-lg font-bold text-stone-900">Tek Kuruş Sürpriz Masraf Yok</h3>
          <p class="text-xs sm:text-sm text-stone-600 font-light leading-relaxed">
            İşe başlamadan önce hazırlanan sözleşmede metretüller, kapak cinsi, tezgah markası ve armatür kodları açıkça yazılır. İş bittiğinde veya montaj esnasında asla "malzemeye zam geldi, ek masraf çıktı" denilmez.
          </p>
          <div class="text-[11px] font-semibold text-emerald-800 flex items-center gap-1.5 pt-2 border-t border-stone-100">
            <span>✓ Noter &amp; Hukuki Şartnameye Uygun</span>
          </div>
        </div>

        <!-- Güven 2: Gecikme Cezası -->
        <div class="p-8 bg-white rounded-2xl border border-stone-200 shadow-xs space-y-4 hover:border-emerald-600 transition">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-xl font-bold font-mono">
            02
          </div>
          <h3 class="text-lg font-bold text-stone-900">Gecikme Cezalı Teslim Taahhüdü</h3>
          <p class="text-xs sm:text-sm text-stone-600 font-light leading-relaxed">
            Evinizin teslim tarihi sözleşmede gün ve ay olarak kesinleştirilir. Olası bir gecikme durumunda tarafımızdan işverene günlük cezai bedel ödenmesi taahhüt edilir. 28 yıldır işimizi gününden önce teslim etmekle övünüyoruz.
          </p>
          <div class="text-[11px] font-semibold text-emerald-800 flex items-center gap-1.5 pt-2 border-t border-stone-100">
            <span>✓ Zamanında Teslim Taahhüdü</span>
          </div>
        </div>

        <!-- Güven 3: Orijinal İthal Mekanizma -->
        <div class="p-8 bg-white rounded-2xl border border-stone-200 shadow-xs space-y-4 hover:border-emerald-600 transition">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-xl font-bold font-mono">
            03
          </div>
          <h3 class="text-lg font-bold text-stone-900">Sertifikalı Orijinal Blum &amp; Häfele</h3>
          <p class="text-xs sm:text-sm text-stone-600 font-light leading-relaxed">
            Piyasada "frenli menteşe" adı altında satılan markasız yan sanayi ürünleri asla kullanmayız. Avusturya menşeili orijinal Blum ve Häfele menteşe, tandembox çekmece ve kalkar kapak amortisörleri monte edilir.
          </p>
          <div class="text-[11px] font-semibold text-emerald-800 flex items-center gap-1.5 pt-2 border-t border-stone-100">
            <span>✓ 200.000 Kez Açma-Kapama Garantili</span>
          </div>
        </div>

        <!-- Güven 4: Fotogerçekçi 3D Çizim -->
        <div class="p-8 bg-white rounded-2xl border border-stone-200 shadow-xs space-y-4 hover:border-emerald-600 transition">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-xl font-bold font-mono">
            04
          </div>
          <h3 class="text-lg font-bold text-stone-900">Görmediğiniz Hiçbir İşi Onaylamazsınız</h3>
          <p class="text-xs sm:text-sm text-stone-600 font-light leading-relaxed">
            Lazer ölçüm cihazlarıyla milimetrik rölöve alınır. Kadrolu iç mimarlarımız odanızı birebir 3D simüle eder; dolap renklerini, tezgah uyumunu ve LED ışıklandırmaları üretimden önce ekranda canlı görürsünüz.
          </p>
          <div class="text-[11px] font-semibold text-emerald-800 flex items-center gap-1.5 pt-2 border-t border-stone-100">
            <span>✓ Birebir 3D Mimari Modelleme</span>
          </div>
        </div>

        <!-- Güven 5: Tek Muhatap Şantiye Şefliği -->
        <div class="p-8 bg-white rounded-2xl border border-stone-200 shadow-xs space-y-4 hover:border-emerald-600 transition">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-xl font-bold font-mono">
            05
          </div>
          <h3 class="text-lg font-bold text-stone-900">Usta Aramak Yok: Tek Elden Yönetim</h3>
          <p class="text-xs sm:text-sm text-stone-600 font-light leading-relaxed">
            Tesisatçı ayrı, fayansçı ayrı, boyacı ayrı stresine son veriyoruz. Kırım ve moloz atımından elektrik kablolamasına, porselen tezgahtan dolap montajına kadar her aşama mimarımızın şefliğinde yürür.
          </p>
          <div class="text-[11px] font-semibold text-emerald-800 flex items-center gap-1.5 pt-2 border-t border-stone-100">
            <span>✓ Anahtar Teslim Sıfır Sürtünme</span>
          </div>
        </div>

        <!-- Güven 6: 10 Yıl Gövde Garantisi -->
        <div class="p-8 bg-white rounded-2xl border border-stone-200 shadow-xs space-y-4 hover:border-emerald-600 transition">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-xl font-bold font-mono">
            06
          </div>
          <h3 class="text-lg font-bold text-stone-900">10 Yıl Sözleşmeli İmalat Garantisi</h3>
          <p class="text-xs sm:text-sm text-stone-600 font-light leading-relaxed">
            Kullandığımız E1 standartlı, neme mukavim yoğun MDF gövdeler ve poliüretan PUR tutkallı kenar bantları sayesinde mutfaklarınız neme, buhara ve sarkmaya karşı 10 yıl boyunca Yeşilay garantisi altındadır.
          </p>
          <div class="text-[11px] font-semibold text-emerald-800 flex items-center gap-1.5 pt-2 border-t border-stone-100">
            <span>✓ Satış Sonrası Doğrudan Servis</span>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 4. İŞİNİZE KİM DOKUNUYOR? YÖNETİM & MİMARİ KADRO                       -->
  <!-- ===================================================================== -->
  <section class="py-20 sm:py-24 bg-white border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-800">KURUCU VE UZMAN KADROMUZ</span>
        <h2 class="text-3xl sm:text-4xl font-light text-stone-950 font-editorial">
          Evinizi Emanet Ettiğiniz Ekibi Tanıyın
        </h2>
        <p class="text-stone-600 text-sm font-light leading-relaxed">
          Gölge şirketler gibi arkasına saklanılan anonim yapılar yok. 1998'den bu yana imzasını attığı her işin arkasında duran bir aile ve profesyonel mimari kadro.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Kişi 1: Bakiye Yeşilay -->
        <div class="bg-stone-50 rounded-2xl p-6 border border-stone-200 space-y-4">
          <div class="w-16 h-16 rounded-full bg-emerald-900 text-emerald-200 flex items-center justify-center text-2xl font-serif font-bold">
            BY
          </div>
          <div class="space-y-1">
            <h3 class="text-lg font-bold text-stone-900">Bakiye Yeşilay</h3>
            <div class="text-xs font-semibold text-emerald-700 uppercase tracking-wider">Kurucu Ortak &bull; Müşteri Deneyimi &amp; Finans</div>
          </div>
          <p class="text-xs text-stone-600 leading-relaxed font-light">
            1998'den bu yana şirketin mali disiplini, şeffaf sözleşme esasları ve müşteri memnuniyeti süreçlerini bizzat yönetir. Kadın girişimci vizyonuyla mutfaklarda estetik ve ergonominin kusursuz buluşmasını denetler.
          </p>
          <div class="text-[11px] text-stone-500 pt-2 border-t border-stone-200">
            📍 Buca Showroom Yönetim Ofisi
          </div>
        </div>

        <!-- Kişi 2: Cem Yeşilay -->
        <div class="bg-stone-50 rounded-2xl p-6 border border-stone-200 space-y-4">
