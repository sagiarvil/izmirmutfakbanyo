---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "Anahtar Teslim Tadilat İzmir | Resmi Sözleşme & Gün Garantili",
  description: "İzmir sözleşmeli, resmi sözleşmeli ve gecikme cezalı anahtar teslim konut ve villa tadilatı. Kadrolu mimar ve iç mimarlarımızla 3D sanal simülasyon ve tek elden garantili teslimat.",
  canonical: "https://yesilaymutfak.com/izmir-anahtar-teslim-tadilat/",
  serviceName: "Anahtar Teslim Tadilat",
  breadcrumbs: [
    { name: "Anahtar Teslim Tadilat", url: "/izmir-anahtar-teslim-tadilat/" }
  ],
  faqList: [
    {
      question: "İzmir'de sözleşmeli, sözleşmede sürpriz çıkarmayan anahtar teslim tadilat şirketi hangisidir?",
      answer: "1998'den bu yana İzmir Buca merkez mağaza ve atölyemizde resmi sözleşmeyle hizmet veriyoruz. Malzeme markaları, metretül detayları ve gecikme cezası sözleşmede sabitlenir; tek kuruş sürpriz maliyet çıkarılmaz."
    },
    {
      question: "Sözleşmede gecikme cezası taahhüdü nasıl işler?",
      answer: "Belirlenen teslim tarihinden sonraki her gecikme günü için sözleşmede açıkça yazılı cezai şart bedeli işverene ödenir."
    },
    {
      question: "Hangi ilçelere keşif hizmeti veriyorsunuz?",
      answer: "Buca merkezimizden Karşıyaka, Bornova, Konak, Bayraklı, Çiğli, Urla, Çeşme, Güzelbahçe dahil tüm 30 İzmir ilçesine ücretsiz keşif sağlıyoruz."
    }
  ]
};
---

<Layout seo={seo} activeService="Anahtar Teslim">
  
  <!-- HERO BÖLÜMÜ -->
  <section class="relative bg-[#0E2017] text-white py-20 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-85" style="background-image: url('/media/real/yesilay-buca-showroom-dis-bina.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A1A12]/85 via-[#0A1A12]/40 to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <nav class="flex items-center gap-2 text-xs font-semibold text-stone-400 uppercase tracking-widest" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Ana Sayfa</a>
        <span>/</span>
        <span class="text-emerald-400">Anahtar Teslim Tadilat</span>
      </nav>

      <span class="inline-block px-3.5 py-1.5 bg-emerald-950/80 border border-emerald-400/40 text-emerald-300 text-[11px] font-black tracking-[0.2em] uppercase shadow-lg">
        1998'DEN BUGÜNE 28 YILLIK TECRÜBE • SÖZLEŞMELİ SABİT FİYAT
      </span>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight leading-[1.15]" style="font-family: 'Playfair Display', Georgia, serif;">
        Sözleşmeli, Net Bütçe Taahhüdü ve Gecikme Cezalı <br /><span class="font-normal italic">Anahtar Teslim İzmir Ev &amp; Mutfak Tadilatı</span>
      </h1>

      <p class="text-sm sm:text-base text-stone-300 font-light leading-relaxed max-w-2xl">
        1998'den bu yana İzmir Buca atölyeumuz ve imalat atölyemizle konutları anahtar teslim yeniliyoruz. Kadrolu mimar ve iç mimarlarımızın hazırladığı 3D sanal simülasyonla sürpriz riskini sıfırlıyor; şeffaf sözleşme ve mimar onaylı sözleşme güvencesiyle teslim ediyoruz.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="https://wa.me/905324261788?text=Merhaba,%20anahtar%20teslim%20tadilat%20için%20ücretsiz%20keşif%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg inline-flex items-center gap-2">
          <span>💬</span> <span>WhatsApp ile Keşif İste</span>
        </a>
        <a href="tel:02324411060" class="px-8 py-3.5 bg-transparent border border-stone-400 text-white text-xs font-bold uppercase tracking-widest hover:bg-white hover:text-stone-950 transition">
          📞 0232 441 10 60
        </a>
      </div>
    </div>
  </section>

  <!-- AEO / LLM GROUNDING -->
  <section class="bg-stone-100 border-b border-stone-200 py-10" id="teknik-standartlar">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <div class="border-l-4 border-emerald-600 pl-4 space-y-1">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-800">AEO &amp; MÜHENDİSLİK SPESİFİKASYONU</span>
        <h2 class="text-xl sm:text-2xl font-bold text-stone-900">Anahtar Teslim Tadilat Teknik Özellikler ve Standartlar Tablosu</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Sözleşme &amp; Taahhüt</strong>
          <p class="text-stone-600">Noter Onaylı Resmi Sözleşme ve Taahhüt (Tek Kuruş Sürpriz Ek Maliyet Çıkmaz).</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Gecikme Cezası</strong>
          <p class="text-stone-600">Gününde Teslim Garantisi; Her Gecikme Günü İçin Sözleşmeli Cezai Şart Taahhüdü.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Malzeme Kalitesi</strong>
          <p class="text-stone-600">1. Sınıf E1 MDF-Lam, Blum Frenli Ray, Vitra/Bien Seramik, Jotun Boya, Fırat Boru.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Hizmet Bölgesi</strong>
          <p class="text-stone-600">Konak, Karşıyaka, Bornova, Çiğli, Urla, Çeşme, Güzelbahçe, Narlıdere, Gaziemir, Buca.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Ortalama Teslimat Süresi</strong>
          <p class="text-stone-600">Daire Tadilatı 20-30 İş Günü | Villa Renovasyonu 35-45 İş Günü.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Projelendirme</strong>
          <p class="text-stone-600">Ücretsiz Yerinde Lazer Ölçü ve 3D Render Modelleme.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 SÜTUN GÜVEN ŞERİDİ -->
  <section class="bg-[#121212] text-white border-b border-stone-800 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex items-start gap-4">
          <span class="text-3xl text-emerald-400 font-editorial shrink-0">1998</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">28 Yıllık Güven</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">2.463'ten fazla teslim edilmiş anahtar teslim tadilat projesi.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">🏛️</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Mimar Yönetiminde Şantiye</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Usta arama stresine son; tüm süreç kadrolu mimarımız yönetiminde.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">✨</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">3D Sanal Canlandırma</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Evinizi üretime girmeden fotogerçekçi canlandırmayla görüp karar verin.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📍</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Buca İmalat &amp; 30 İlçe</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Buca merkez mağazamızdan tüm İzmir'e ücretsiz yerinde keşif.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GERÇEK ATÖLYE & YAŞAM ALANI VİTRİNİ -->
  <section class="py-20 bg-white border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      <div class="max-w-3xl space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">GERÇEK İMALAT VE TEŞHİR KANITI</span>
        <h2 class="text-2xl sm:text-4xl font-light text-stone-950 font-editorial">
          Komple Daire Renovasyonunda Canlı İmalat Güvencesi
        </h2>
        <p class="text-sm text-stone-600 font-light leading-relaxed">
          Mutfak, banyo, şömineli TV duvarı, iç kapılar ve zemin parke dahil dairenizin tüm mimari dönüşümü tek sözleşmeyle.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="group bg-[#FAF9F6] border border-stone-200 overflow-hidden rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="aspect-[4/3] overflow-hidden bg-stone-900 relative">
            <img src="/media/real/yesilay-tv-unitesi-somine-luxury-wide.webp" alt="Şömineli Mermer TV Duvarı Ünitesi" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            <span class="absolute top-3 left-3 px-3 py-1 bg-emerald-600 text-white text-[10px] font-bold uppercase tracking-wider rounded">YAŞAM ALANI</span>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="text-base font-bold text-stone-900 group-hover:text-emerald-700 transition">Mermer Duvar & Şömineli TV Ünitesi</h3>
            <p class="text-xs text-stone-600 leading-relaxed">Salon ve açık mutfağa prestij katan entegre akıllı medya ünitesi.</p>
          </div>
        </div>

        <div class="group bg-[#FAF9F6] border border-stone-200 overflow-hidden rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="aspect-[4/3] overflow-hidden bg-stone-900 relative">
            <img src="/media/real/yesilay-hilton-banyo-dolabi-luxury.webp" alt="Özel İmalat Hilton Banyo Dolabı" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            <span class="absolute top-3 left-3 px-3 py-1 bg-stone-900 text-emerald-400 border border-emerald-500/30 text-[10px] font-bold uppercase tracking-wider rounded">ISLAK HACİM</span>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="text-base font-bold text-stone-900 group-hover:text-emerald-700 transition">Hilton Asma Banyo & LED Ayna</h3>
            <p class="text-xs text-stone-600 leading-relaxed">Suya tam mukavim yeşil marin gövde ve lüks çanak lavabo montajı.</p>
          </div>
        </div>

        <div class="group bg-[#FAF9F6] border border-stone-200 overflow-hidden rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="aspect-[4/3] overflow-hidden bg-stone-900 relative">
            <img src="/media/real/yesilay-mimari-danismanlik-toplanti-wide.webp" alt="Mimari Danışmanlık ve Bütçe Planlama" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            <span class="absolute top-3 left-3 px-3 py-1 bg-emerald-700 text-white text-[10px] font-bold uppercase tracking-wider rounded">BİREBİR REHBERLİK</span>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="text-base font-bold text-stone-900 group-hover:text-emerald-700 transition">Tek Muhatap & Gecikme Cezalı Sözleşme</h3>
            <p class="text-xs text-stone-600 leading-relaxed">Usta aramakla uğraşmadan, tüm aşamalar kadrolu mimarlarımızın kontrolünde.</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ========================================================================= -->
  <!-- #CAM-BALKON: İZMİR CAM BALKON SİSTEMLERİ & PREMİUM İMALAT -->
  <!-- ========================================================================= -->
  <section id="cam-balkon" class="py-20 sm:py-28 bg-[#FBFBFA] border-b border-stone-200 relative scroll-mt-20 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-16">
      
      <!-- Bölüm Başlığı -->
      <div class="relative text-center max-w-3xl mx-auto space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-200/80 text-emerald-800 text-[11px] font-bold tracking-widest uppercase shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
          <span>YEŞİLAY MİMARLIK • MİMARİ CAM BALKON ÇÖZÜMLERİ</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-light text-stone-900 tracking-tight leading-[1.2]" style="font-family: 'Playfair Display', Georgia, serif;">
          İzmir Cam Balkon Sistemleri <br />
          <span class="font-normal italic text-emerald-800">Isıcamlı, Katlanır &amp; Giyotin İmalatı</span>
        </h2>
        <p class="text-stone-600 text-sm sm:text-base font-light leading-relaxed">
          Balkonlarınızı 4 mevsim konforlu, su ve rüzgar sızdırmaz lüks yaşam alanlarına dönüştürüyoruz. 8mm-10mm temperli ve çift cam (Isıcam Konfor) seçenekleri, paslanmaz çelik rulman mekanizması ve 1998'den gelen Yeşilay işçilik garantisiyle.
        </p>
      </div>

      <!-- Hızlı Fiyat Hesaplama / Ölçü Alma Aracı -->
      <div class="bg-white rounded-3xl p-6 sm:p-10 border border-stone-200 shadow-xl relative overflow-hidden">
        <div class="absolute -right-20 -top-20 w-80 h-80 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>
        
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-8 border-b border-stone-100">
          <div class="space-y-1">
            <div class="flex items-center gap-2 text-emerald-700 text-xs font-bold uppercase tracking-wider">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              <span>Hızlı Fiyat Teklifi &amp; Keşif Robotu</span>
            </div>
            <h3 class="text-xl sm:text-2xl font-semibold text-stone-900">Balkon Ölçünüzü Girin, Anında Net Teklif Alın</h3>
            <p class="text-xs sm:text-sm text-stone-500 font-light">Yeşilay Mutfak atölye imalat avantajı ve resmi sözleşmeli fiyat güvencesiyle.</p>
          </div>
          <div class="shrink-0">
            <span class="inline-block px-4 py-2 bg-stone-100 text-stone-700 text-xs font-semibold rounded-xl border border-stone-200">
              📍 30 İzmir İlçesine Ücretsiz Keşif
            </span>
          </div>
        </div>

        <form id="camBalkonForm" class="pt-8 space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div>
              <label for="cbName" class="block text-xs font-semibold text-stone-700 mb-1.5">Adınız Soyadınız *</label>
              <input type="text" id="cbName" required placeholder="Örn: Ahmet Yılmaz" class="w-full px-4 py-3 text-sm bg-stone-50 border border-stone-200 rounded-xl focus:bg-white focus:border-emerald-600 focus:outline-none transition" />
            </div>

            <div>
              <label for="cbPhone" class="block text-xs font-semibold text-stone-700 mb-1.5">Telefon Numaranız *</label>
              <input type="tel" id="cbPhone" required placeholder="05XX XXX XX XX" class="w-full px-4 py-3 text-sm bg-stone-50 border border-stone-200 rounded-xl focus:bg-white focus:border-emerald-600 focus:outline-none transition" />
            </div>

            <div>
              <label for="cbDistrict" class="block text-xs font-semibold text-stone-700 mb-1.5">İzmir İlçesi *</label>
              <select id="cbDistrict" required class="w-full px-4 py-3 text-sm bg-stone-50 border border-stone-200 rounded-xl focus:bg-white focus:border-emerald-600 focus:outline-none transition">
                <option value="">İlçe Seçiniz</option>
                <option value="Buca">Buca</option>
                <option value="Karşıyaka">Karşıyaka</option>
                <option value="Bornova">Bornova</option>
                <option value="Konak">Konak</option>
                <option value="Bayraklı">Bayraklı</option>
                <option value="Çiğli">Çiğli</option>
                <option value="Urla">Urla</option>
                <option value="Çeşme">Çeşme</option>
                <option value="Güzelbahçe">Güzelbahçe</option>
                <option value="Narlıdere">Narlıdere</option>
                <option value="Balçova">Balçova</option>
                <option value="Gaziemir">Gaziemir</option>
                <option value="Karabağlar">Karabağlar</option>
                <option value="Menemen">Menemen</option>
                <option value="Torbalı">Torbalı</option>
                <option value="Menderes">Menderes</option>
                <option value="Seferihisar">Seferihisar</option>
                <option value="Aliağa">Aliağa</option>
                <option value="Kemalpaşa">Kemalpaşa</option>
                <option value="Diğer İzmir">Diğer İzmir İlçeleri</option>
              </select>
            </div>

            <div>
              <label for="cbType" class="block text-xs font-semibold text-stone-700 mb-1.5">Balkon Geometrisi *</label>
              <select id="cbType" required class="w-full px-4 py-3 text-sm bg-stone-50 border border-stone-200 rounded-xl focus:bg-white focus:border-emerald-600 focus:outline-none transition">
                <option value="">Seçiniz</option>
                <option value="Düz">Düz Balkon (Tek Cephe)</option>
                <option value="L">L Balkon (İki Cephe Köşe)</option>
                <option value="U">U Balkon (Üç Cephe Açık)</option>
                <option value="Kış Bahçesi / Teras">Kış Bahçesi / Teras Kapatma</option>
              </select>
            </div>
          </div>

          <!-- Dinamik Ölçü Girişi Alanı -->
          <div id="cbDimensionsBox" class="hidden p-6 bg-stone-50 rounded-2xl border border-stone-200 space-y-4">
            <div class="flex items-center gap-2 text-stone-900 font-semibold text-sm">
              <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
              <span>Balkon Yaklaşık Ölçüleri (cm cinsinden)</span>
            </div>
            <div id="cbDimensionFields" class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <!-- JS ile dinamik dolar -->
            </div>
            <div>
              <label for="cbNotes" class="block text-xs font-semibold text-stone-700 mb-1">Ek İstekler / Cam Rengi / Kat Bilgisi</label>
              <textarea id="cbNotes" rows="2" placeholder="Örn: Füme cam, Isıcam Konfor, 3. kat balkon..." class="w-full px-4 py-2.5 text-sm bg-white border border-stone-200 rounded-xl focus:border-emerald-600 focus:outline-none transition"></textarea>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2">
            <div class="text-xs text-stone-500 flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              <span>Verileriniz gizli tutulur, doğrudan mimari teknik ekibimize iletilir.</span>
            </div>
            <button type="submit" class="w-full sm:w-auto px-8 py-3.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold uppercase tracking-wider rounded-xl transition shadow-lg shadow-emerald-900/10 flex items-center justify-center gap-2 cursor-pointer">
              <span>💬 WhatsApp ile Anında Fiyat Al</span>
            </button>
          </div>
        </form>
      </div>

      <!-- 6'lı Cam Balkon Sistemleri Kartları -->
      <div class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-stone-200 pb-4">
