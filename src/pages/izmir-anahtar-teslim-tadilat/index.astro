              const h = parseFloat(hInput.value) || 0;
              if (w > 0 && h > 0) {
                const m2 = ((w * h) / 10000).toFixed(2);
                m2Input.value = `${m2} m²`;
              } else {
                m2Input.value = "";
              }
            }
          }
          if (wInput && hInput) {
            wInput.addEventListener("input", updateM2);
            hInput.addEventListener("input", updateM2);
          }
        });
      }

      if (form) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          const name = document.getElementById("cbName")?.value || "";
          const phone = document.getElementById("cbPhone")?.value || "";
          const district = document.getElementById("cbDistrict")?.value || "";
          const type = document.getElementById("cbType")?.value || "";
          const notes = document.getElementById("cbNotes")?.value || "";

          let dimSummary = "";
          const w = document.getElementById("cbDimWidth")?.value;
          const w1 = document.getElementById("cbDimWidth1")?.value;
          const w2 = document.getElementById("cbDimWidth2")?.value;
          const h = document.getElementById("cbDimHeight")?.value;
          const m2 = document.getElementById("cbDimM2")?.value;

          if (w && h) dimSummary += ` (${w}cm x ${h}cm ${m2 ? '- ' + m2 : ''})`;
          else if (w1 && w2 && h) dimSummary += ` (Ön: ${w1}cm, Yan: ${w2}cm, Yük: ${h}cm)`;

          const msg = `Merhaba Yeşilay Mutfak & Mimarlık,%0A%0Aİzmir Cam Balkon sistemi için fiyat teklifi ve keşif randevusu almak istiyorum.%0A%0A👤 *Ad Soyad:* ${name}%0A📞 *Telefon:* ${phone}%0A📍 *İlçe:* ${district}%0A📐 *Balkon Tipi:* ${type}${dimSummary}%0A📝 *Notlar:* ${notes || 'Belirtilmedi'}%0A%0AEn kısa sürede dönüşünüzü rica ederim.`;

          window.open(`https://wa.me/905324261788?text=${msg}`, '_blank');
        });
      }
    });
  </script>


