---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "İzmir Banyo Tadilatı & Seramik Yenileme | Yeşilay Mutfak",
  description: "Çift kat elastik su yalıtımı, 60x120 rektifiyeli porselen seramik, gömme rezervuar ve marin banyo dolabı imalatı. İzmir içi ücretsiz keşif randevusu alın.",
  canonical: "https://yesilaymutfak.com/izmir-banyo-yenileme-seramik/",
  serviceName: "Banyo Yenileme & Seramik",
  breadcrumbs: [
    { name: "Ana Sayfa", url: "/" },
    { name: "Banyo Tadilatı & Seramik", url: "/izmir-banyo-yenileme-seramik/" }
  ],
  faqList: [
    {
      question: "Banyo seramik döşeme, su yalıtımı ve duşakabin yenileme İzmir'de kime yaptırılır?",
      answer: "Banyo tadilatında alt kata su sızma riskini önlemek için çift kat elastik sürme izolasyon ve köşe pah bantları şarttır. Buca merkez atölyemizde kadrolu ustalarımızla 10 yıl resmi su sızdırmazlık garantisi veriyoruz."
    },
    {
      question: "İzmir'de komple banyo tadilatı kaç günde biter?",
      answer: "Kırım, sıhhi tesisat yenileme, şap, çift kat sürme yalıtım, 60x120 seramik döşeme, asma klozet ve dolap montajı dahil 7 ila 10 iş günü içerisinde tamamlanır."
    },
    {
      question: "Küçük banyolar için özel dolap imalatı yapıyor musunuz?",
      answer: "Evet. Çamaşır makinesi gizleme modülleri, gömme aynalı dolaplar ve neme dayanıklı lake banyo mobilyalarını Buca atölyemizde milimetrik üretiyoruz."
    }
  ]
};
---

<Layout seo={seo} activeService="Banyo Yenileme & Seramik">
  
  <!-- HERO BÖLÜMÜ -->
  <section class="relative bg-[#0E2017] text-white py-20 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-85" style="background-image: url('/media/real/yesilay-hilton-banyo-dolabi-luxury-full.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A1A12]/85 via-[#0A1A12]/40 to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <nav class="flex items-center gap-2 text-xs font-semibold text-stone-400 uppercase tracking-widest" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Ana Sayfa</a>
        <span>/</span>
        <span class="text-emerald-400">Banyo Yenileme &amp; Seramik</span>
      </nav>

      <span class="inline-block px-3.5 py-1.5 bg-emerald-950/80 border border-emerald-400/40 text-emerald-300 text-[11px] font-black tracking-[0.2em] uppercase shadow-lg">
        1998'DEN BUGÜNE 28 YILLIK TECRÜBE • 10 YIL SU YALITIMI GARANTİSİ
      </span>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight leading-[1.15]" style="font-family: 'Playfair Display', Georgia, serif;">
        Banyo Yenileme ve 60x120 Seramik Uygulama: <br /><span class="font-normal">İzmir İçi Yalıtımlı Anahtar Teslim Çözümler</span>
      </h1>
          <p data-answer-capsule="true" class="answer-capsule mt-4 text-stone-300 sm:text-stone-600 text-sm sm:text-base font-normal leading-relaxed max-w-2xl">İzmir komple banyo yenileme hizmeti; çift katman elastik sürme su yalıtımı, 60x120 lazer kesim rektifiyeli porselen seramik döşeme, Geberit gömme rezervuar ve neme dayanıklı marin gövde banyo mobilyalarını kapsar. Yeşilay Mutfak, 10 gün içinde anahtar teslim banyo dönüşümü gerçekleştirir.</p>

      <p class="text-sm sm:text-base text-stone-300 font-light leading-relaxed max-w-2xl">
        Çift kat elastik sürme izolasyon, Geberit gömme rezervuar, 60x120 porselen seramik döşeme ve neme dayanıklı özel imalat lake banyo dolapları. Buca atölyemizden tüm İzmir'e garantili uygulama.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="https://wa.me/905324261788?text=Merhaba,%20banyo%20yenileme%20için%20ücretsiz%20keşif%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg inline-flex items-center gap-2">
          <span>💬</span> <span>WhatsApp ile Banyo Keşfi İste</span>
        </a>
        <a href="tel:+902324411060" class="px-8 py-3.5 bg-transparent border border-stone-400 text-white text-xs font-bold uppercase tracking-widest hover:bg-white hover:text-stone-950 transition">
          📞 0232 441 10 60
        </a>
      </div>
    </div>
  </section>

  <!-- TEKNİK KARŞILAŞTIRMA VE İZOLASYON STANDARTLARI -->
  <section class="bg-white border-b border-stone-200 py-16" id="teknik-standartlar">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="border-l-4 border-emerald-600 pl-4 space-y-1">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-800">ISLAK HACİM MÜHENDİSLİĞİ</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900">
          İzmir Banyo Yenileme ve Seramik Uygulama Standartları
        </h2>
        <p class="text-xs sm:text-sm text-stone-600 max-w-3xl leading-relaxed">
          Banyolarda en sık karşılaşılan sorun derz aralarından veya duş giderinden alt kat tavanına su sızmasıdır. Yeşilay Mimarlık banyo yenilemelerinde şap öncesi ve sonrası çift kat elastik yalıtım ile sızdırmazlık testi zorunludur:
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs sm:text-sm">
          <thead>
            <tr class="bg-[#15231C] text-white">
              <th class="p-3.5 font-semibold">Uygulama Aşaması</th>
              <th class="p-3.5 font-semibold">Kullanılan Malzeme & Marka</th>
              <th class="p-3.5 font-semibold">Teknik İşlem Standardı</th>
              <th class="p-3.5 font-semibold">Garanti & Test Kriteri</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-200 text-stone-700">
            <tr>
              <td class="p-3.5 font-bold text-[#15231C]">Sıhhi Tesisat Altyapısı</td>
              <td class="p-3.5">Fırat / Kalde Kompozit PPRC + Sessiz Atık Su Borusu</td>
              <td class="p-3.5">Eski galvaniz boruların sökümü, duvar içi kanallara gömme montaj</td>
              <td class="p-3.5">10 bar manometre basınç testi uygulanarak kapatılır</td>
            </tr>
            <tr class="bg-stone-50/70">
              <td class="p-3.5 font-bold text-[#15231C]">Çift Kat Su İzolasyonu</td>
              <td class="p-3.5">Weber / Kalekim 2K Çimento Esaslı Elastik Sürme Yalıtım</td>
              <td class="p-3.5">Duvar-zemin birleşimlerine pah bandı, duş alanında 200 cm yüksekliğe kadar</td>
              <td class="p-3.5">10 Yıl Resmi Sızdırmazlık Taahhüdü</td>
            </tr>
            <tr>
              <td class="p-3.5 font-bold text-[#15231C]">Porselen Seramik Döşeme</td>
              <td class="p-3.5">60x120 Rektifiyeli Porselen Granit (Vitra / Bien / Kütahya)</td>
              <td class="p-3.5">Lazer terazi ile sıfır kod, flex yapıştırıcı ve antibakteriyel epoksi derz</td>
              <td class="p-3.5">Düzlemsel takozlu tesviye ile sıfır tırnak farkı</td>
            </tr>
            <tr class="bg-stone-50/70">
              <td class="p-3.5 font-bold text-[#15231C]">Gömme Rezervuar & Vitrifiye</td>
              <td class="p-3.5">Geberit Sigma / Vitra Rim-Ex Kanalsız Asma Klozet</td>
              <td class="p-3.5">Yavaş kapanır amortisörlü kapak, koku önleyici çekvalfli pis su bağlantısı</td>
              <td class="p-3.5">Tasarruflu çift kademeli deşarj sistemi (3/6 Litre)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4 text-xs">
        <div class="bg-[#FAF9F6] p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">7-10 Günde Hızlı Teslim</strong>
          <p class="text-stone-600">Kırım, tesisat, şap, seramik ve montaj tek elden yürütülür; eviniz uzun haftalar şantiye kalmaz.</p>
        </div>
        <div class="bg-[#FAF9F6] p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Marin Gövde Banyo Dolapları</strong>
          <p class="text-stone-600">Banyoda buhar ve sıçramaya maruz kalan mobilyalarda yeşil marin MDF ve fırın lake kullanılır.</p>
        </div>
        <div class="bg-[#FAF9F6] p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Gömme Çamaşır Alanı</strong>
          <p class="text-stone-600">Kompakt banyolarda çamaşır ve kurutma makinesini gizleyen kule dolap çözümleri entegre edilir.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 SÜTUN GÜVEN ŞERİDİ -->
  <section class="bg-[#121212] text-white border-b border-stone-800 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex items-start gap-4">
          <span class="text-3xl text-emerald-400 font-editorial shrink-0">1998</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">28 Yıllık Güven</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">2.463'ten fazla teslim edilmiş garantili banyo tadilatı.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">🛡️</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">10 Yıl Sızdırmazlık</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Çift kat elastik sürme izolasyonla alt kata su sızma riski sıfır.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">✨</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">3D Sanal Canlandırma</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Banyonuzu 3 boyutlu modelleyerek seramik desenlerini önceden görün.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📍</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Buca Mağaza &amp; Tüm İzmir</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Atölyemizden 30 ilçenin tamamına ücretsiz mimari keşif.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GERÇEK SHOWROOM BANYO VİTRİNİ -->
  <section class="py-20 bg-white border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      <div class="max-w-3xl space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">GERÇEK İMALAT VE TEŞHİR KANITI</span>
        <h2 class="text-2xl sm:text-4xl font-light text-stone-950 font-editorial">
          Buca Showroomumuzdan Canlı Banyo Modelleri
        </h2>
        <p class="text-sm text-stone-600 font-light leading-relaxed">
          Kendi atölyemizde E1 marin gövde ve İtalyan lakeyle ürettiğimiz asma Hilton banyo dolapları, LED aynalar ve seramik uygulamalarımız. Komple konut yenilemeleriniz için <a href="/izmir-anahtar-teslim-tadilat/" class="text-[#006039] font-semibold underline underline-offset-4">anahtar teslim tadilat</a> sayfamıza da göz atabilirsiniz.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Kart 1: Hilton Banyo Dolabı -->
        <div class="group bg-[#FAF9F6] border border-stone-200 overflow-hidden rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="aspect-[4/3] overflow-hidden bg-stone-900 relative">
            <img 
              src="/media/real/yesilay-hilton-banyo-dolabi-luxury.webp" 
              alt="Yeşilay Mutfak Lüks Asma Hilton Banyo Dolabı ve LED Ayna Buca" 
              width="1920" 
              height="1080" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              loading="lazy" 
              decoding="async"
            />
            <span class="absolute top-3 left-3 px-3 py-1 bg-emerald-600 text-white text-[10px] font-bold uppercase tracking-wider rounded">
              SHOWROOM MODELİ
            </span>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="text-base font-bold text-stone-900 group-hover:text-emerald-700 transition">
              Asma Hilton Dolap & Dokunmatik LED Ayna
            </h3>
            <p class="text-xs text-stone-600 font-light leading-relaxed">
              Suya tam mukavemetli marin gövde, çizilmez mat lake yüzey ve modern çanak lavabo kombinasyonu.
            </p>
          </div>
        </div>

        <!-- Kart 2: Müşteri Malzeme İnceleme -->
        <div class="group bg-[#FAF9F6] border border-stone-200 overflow-hidden rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="aspect-[4/3] overflow-hidden bg-stone-900 relative">
            <img 
              src="/media/real/yesilay-banyo-secimi-musteri-wide.webp" 
              alt="Showroomda Banyo ve Islak Hacim Seramik Malzeme Seçim Anı" 
              width="1200" 
              height="675" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              loading="lazy" 
              decoding="async"
            />
            <span class="absolute top-3 left-3 px-3 py-1 bg-stone-900 text-emerald-400 border border-emerald-500/30 text-[10px] font-bold uppercase tracking-wider rounded">
              CANLI SEÇİM
            </span>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="text-base font-bold text-stone-900 group-hover:text-emerald-700 transition">
              Numunelerle Birebir Malzeme Seçimi
            </h3>
            <p class="text-xs text-stone-600 font-light leading-relaxed">
              60x120 porselen seramikler, gömme armatürler ve aydınlatma profillerini dokunarak seçme avantajı.
            </p>
          </div>
        </div>

        <!-- Kart 3: Showroom İç Mekan & Banyo Alanı -->
        <div class="group bg-[#FAF9F6] border border-stone-200 overflow-hidden rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="aspect-[4/3] overflow-hidden bg-stone-900 relative">
            <img 
              src="/media/real/yesilay-showroom-ic-mekan.webp" 
              alt="Yeşilay Mutfak Showroom Banyo ve Yaşam Alanı Teşhiri Buca" 
              width="1920" 
              height="1080" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              loading="lazy" 
              decoding="async"
            />
            <span class="absolute top-3 left-3 px-3 py-1 bg-emerald-700 text-white text-[10px] font-bold uppercase tracking-wider rounded">
              BUCA GAZİLER
            </span>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="text-base font-bold text-stone-900 group-hover:text-emerald-700 transition">
              Bütünleşik Banyo & Konut Renovasyonu
            </h3>
            <p class="text-xs text-stone-600 font-light leading-relaxed">
              Kırım, tesisat, çift kat su izolasyonu ve montaja kadar tek elden anahtar teslim taahhüt.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- SSS BÖLÜMÜ -->
  <section class="py-20 sm:py-24 bg-stone-50 border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">MERAK EDİLENLER</span>
        <h2 class="text-2xl sm:text-3xl font-light text-stone-950 font-editorial">Banyo Yenileme Hakkında Sorularınız</h2>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="bg-white border border-stone-200 p-6 space-y-2 shadow-2xs">
            <h3 class="font-bold text-sm text-stone-900">{faq.question}</h3>
            <p class="text-xs text-stone-600 font-light leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ÇAĞRI BÖLÜMÜ -->
  <section class="py-16 bg-stone-900 text-white text-center">
    <div class="max-w-3xl mx-auto px-4 space-y-6">
      <h2 class="text-2xl sm:text-3xl font-light font-editorial">Banyonuzu Yenilemek İçin Ücretsiz Keşif Alın</h2>
      <p class="text-xs sm:text-sm text-stone-300 font-light">
        İletişime geçin veya WhatsApp'tan yazın; kadrolu mimarımız evinize gelerek rölöve ve 3D çizim analizini hazırlasın. Diğer oda çözümlerimiz için <a href="/tasarimlar/" class="text-emerald-400 underline underline-offset-4">tasarımlar kataloğumuzu</a> ziyaret edebilirsiniz.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a href="https://wa.me/905324261788?text=Merhaba,%20banyo%20yenileme%20için%20ücretsiz%20keşif%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg">
          💬 WhatsApp ile Keşif İste (0232 441 10 60)
        </a>
      </div>
    </div>
  </section>

</Layout>
