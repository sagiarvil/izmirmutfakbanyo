---
import Layout from "../../layouts/Layout.astro";
import modellerData from "../../data/modellerData.json";

const models = modellerData["yatak-odasi"];
const totalCount = models.length;
const golfCount = models.filter(m => m.series === "Golf").length;
const voloCount = models.filter(m => m.series === "Volo").length;
const arcadiaCount = models.filter(m => m.series === "Arcadia").length;

const seo = {
  title: "İzmir Yatak Odası Modelleri & Özel İmalat Gardırop | 99 Model Kataloğu",
  description: "İzmir Buca atölyemizde kişiye özel ölçüyle imal edilen 99 lüks yatak odası modeli. İtalyan lake gardıroplar, füme cam kapaklı giyinme odaları, Blum mekanizmalı karyola ve şifonyerler.",
  canonical: "https://yesilaymutfak.com/yatak-odasi-modelleri/",
  image: models[0]?.image || "/yesilay-mutfak-logo.png",
  serviceName: "Özel İmalat Yatak Odası & Gardırop Sistemleri",
  breadcrumbs: [
    { name: "Ana Sayfa", url: "/" },
    { name: "Modeller", url: "/tasarimlar/" },
    { name: "Yatak Odası Modelleri", url: "/yatak-odasi-modelleri/" }
  ],
  faqList: [
    {
      question: "Yatak odası ve giyinme odası dolapları hazır standart ölçü mü?",
      answer: "Hayır. Yeşilay Mutfak olarak fabrikasyon standart dolap üretmiyoruz. Buca Adatepe imalat atölyemizde tamamen odanızın milimetrik rölövesine ve tavan yüksekliğine göre terzi usulü özel üretim yapıyoruz."
    },
    {
      question: "Gardıroplarda hangi malzeme ve mekanizmalar kullanılıyor?",
      answer: "Gövdede E1 sertifikalı neme ve yüke dayanıklı 18mm marin MDF, kapaklarda sararmaz İtalyan fırın lake, doğal ahşap kaplama veya füme temperli alüminyum cam kapaklar; ray ve menteşelerde ise ömür boyu garantili Blum/Hettich yavaşlatıcılı fren sistemleri kullanılmaktadır."
    },
    {
      question: "Giyinme odası için yerinde ücretsiz keşif ve 3D çizim hizmetiniz var mı?",
      answer: "Evet. Buca, Karşıyaka, Bornova, Çeşme, Urla ve tüm İzmir ilçelerinde lazerli hassas ölçü alımı ve fotogerçekçi 3D mimari simülasyon hizmetimiz tamamen ücretsizdir."
    },
    {
      question: "Yatak odası teslim süresi ve garanti şartları nelerdir?",
      answer: "Proje onayı ve sözleşme akabinde ortalama 18-25 iş günü içerisinde imalat, nakliye ve montaj tamamlanır. Tüm ürünlerimiz 10 yıl bütünleşik atölye garantisi altındadır."
    }
  ]
};

const jsonLdGallery = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": "Yeşilay Mutfak Özel İmalat Yatak Odası ve Gardırop Koleksiyonu",
  "description": "İzmir Buca imalat atölyemizde kişiye ve mekana özel üretilen 99 özgün yatak odası, giyinme odası ve gardırop tasarımı.",
  "url": "https://yesilaymutfak.com/yatak-odasi-modelleri/",
  "numberOfItems": totalCount
};
---

<Layout seo={seo} activeService="yatak-odasi">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdGallery)} />

  <!-- 1. GHOST WATERMARK & HERO SECTION -->
  <section class="relative pt-8 pb-12 sm:pt-12 sm:pb-16 bg-[#FAF9F6] border-b border-[#E5E2DA] overflow-hidden">
    
    <!-- DEV WATERMARK: ÜSTTE DİNAMİK VE SIFIR ÇAKIŞMALI SVG VIEWBOX -->
    <div class="w-full max-w-5xl mx-auto px-4 select-none pointer-events-none mb-2" aria-hidden="true">
      <svg viewBox="0 0 1000 90" class="w-full h-auto max-h-16 sm:max-h-20 fill-[#ECEAE5] tracking-[0.25em] uppercase font-black">
        <text x="50%" y="68%" text-anchor="middle">YATAK ODASI KOLEKSİYONU</text>
      </svg>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- BREADCRUMB -->
      <nav class="flex items-center space-x-2 text-xs text-[#756E65] mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#006039] transition">Ana Sayfa</a>
        <span>/</span>
        <a href="/tasarimlar/" class="hover:text-[#006039] transition">Modeller</a>
        <span>/</span>
        <span class="text-[#15231C] font-semibold">Yatak Odası ({totalCount} Model)</span>
      </nav>

      <!-- ANA BAŞLIK & VİTRİN METNİ -->
      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#F3EFEA] border border-[#E5E2DA] text-[#006039] text-xs font-bold uppercase tracking-wider mb-3">
          <span>✨ 28 Yıllık Buca Atölye Zanaatı</span>
          <span>•</span>
          <span>99 Özgün Model</span>
        </div>
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-[#15231C] tracking-tight leading-[1.15]">
          İzmir Özel İmalat Yatak Odası & Gardırop Modelleri
        </h1>
        <p class="mt-4 text-sm sm:text-base text-[#4A443D] leading-relaxed max-w-3xl">
          Evinizin mimarisine, tavan yüksekliğine ve giyim alışkanlıklarınıza tam uyumlu walk-in closet giyinme odaları, akordeon ve sürgü kapaklı gardıroplar, şifonyer ve komodin grupları. 
          Blum sessiz fren sistemleri, E1 marin neme mukavim gövde ve 10 yıl bütünleşik Yeşilay Mutfak atölye garantisiyle.
        </p>
      </div>

      <!-- HIZLI AKSİYON DÜĞMELERİ -->
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a 
          href="https://wa.me/905324261788?text=Merhaba,%20Yatak%20Odas%C4%B1%20Modelleriniz%20ve%203D%20ke%C5%9Fif%20hakk%C4%B1nda%20bilgi%20almak%20istiyorum." 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-[#006039] hover:bg-[#00482B] text-white text-xs sm:text-sm font-bold uppercase tracking-wider shadow-sm transition active:scale-95"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.075-1.115-.06-.275-.088-.63-.223-1.096-.425-1.986-.86-3.274-2.871-3.373-3.003-.099-.133-.804-1.072-.804-2.044 0-.972.508-1.45.69-1.65.182-.2.398-.25.53-.25.133 0 .265.001.382.007.123.006.288-.047.45.344.167.404.57 1.391.62 1.492.05.101.083.22.016.353-.066.133-.1.216-.199.332-.099.117-.208.261-.297.351-.099.099-.202.207-.087.404.116.198.514.849 1.103 1.374.757.675 1.396.884 1.595.983.199.099.315.083.431-.05.116-.134.498-.58.63-.779.133-.199.265-.166.448-.099.182.066 1.157.546 1.356.645.199.1.332.15.381.233.05.083.05.479-.094.884z"/>
          </svg>
          <span>WhatsApp 3D Keşif & Fiyat İste</span>
        </a>
        <a 
          href="tel:+902324411060" 
          class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-[#F3EFEA] hover:bg-[#EAE4DC] text-[#15231C] text-xs sm:text-sm font-bold border border-[#E5E2DA] transition active:scale-95"
        >
          <span>📞 0232 441 10 60 — Buca Showroom</span>
        </a>
      </div>

    </div>
  </section>

  <!-- 2. KATALOG & MODELLER GRID (ALPINE.JS FİLTRELEME & MODAL PREVIEW) -->
  <section 
    class="py-10 sm:py-16 bg-[#FAF9F6]"
    x-data="{ 
      activeFilter: 'all', 
      previewModal: false, 
      previewImage: '', 
      previewTitle: '', 
      previewCode: '',
      openPreview(img, title, code) {
        this.previewImage = img;
        this.previewTitle = title;
        this.previewCode = code;
        this.previewModal = true;
      }
    }"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- FİLTRELEME SEKMELERİ -->
      <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-[#E5E2DA] mb-8">
        <div class="flex flex-wrap items-center gap-2">
          <button 
            type="button"
            @click="activeFilter = 'all'"
            :class="activeFilter === 'all' ? 'bg-[#006039] text-white' : 'bg-white text-[#15231C] border border-[#E5E2DA] hover:bg-[#F3EFEA]'"
            class="px-4 py-2 rounded-lg text-xs sm:text-sm font-bold transition flex items-center gap-1.5"
          >
            <span>Tüm Modeller</span>
            <span class="px-1.5 py-0.2 bg-black/15 rounded text-[11px] font-semibold">{totalCount}</span>
          </button>
          <button 
            type="button"
            @click="activeFilter = 'Golf'"
            :class="activeFilter === 'Golf' ? 'bg-[#006039] text-white' : 'bg-white text-[#15231C] border border-[#E5E2DA] hover:bg-[#F3EFEA]'"
            class="px-4 py-2 rounded-lg text-xs sm:text-sm font-bold transition flex items-center gap-1.5"
          >
            <span>Golf Serisi (İtalyan Modüler)</span>
            <span class="px-1.5 py-0.2 bg-black/15 rounded text-[11px] font-semibold">{golfCount}</span>
          </button>
          <button 
            type="button"
            @click="activeFilter = 'Volo'"
            :class="activeFilter === 'Volo' ? 'bg-[#006039] text-white' : 'bg-white text-[#15231C] border border-[#E5E2DA] hover:bg-[#F3EFEA]'"
            class="px-4 py-2 rounded-lg text-xs sm:text-sm font-bold transition flex items-center gap-1.5"
          >
            <span>Volo Serisi (Minimal Hatlar)</span>
            <span class="px-1.5 py-0.2 bg-black/15 rounded text-[11px] font-semibold">{voloCount}</span>
          </button>
          <button 
            type="button"
            @click="activeFilter = 'Arcadia'"
            :class="activeFilter === 'Arcadia' ? 'bg-[#006039] text-white' : 'bg-white text-[#15231C] border border-[#E5E2DA] hover:bg-[#F3EFEA]'"
            class="px-4 py-2 rounded-lg text-xs sm:text-sm font-bold transition flex items-center gap-1.5"
          >
            <span>Arcadia Serisi (Klasik Zarafet)</span>
            <span class="px-1.5 py-0.2 bg-black/15 rounded text-[11px] font-semibold">{arcadiaCount}</span>
          </button>
        </div>

        <div class="text-xs text-[#756E65]">
          Toplam <strong class="text-[#15231C]">{totalCount}</strong> özel imalat model listeleniyor
        </div>
      </div>

      <!-- KARTLAR GRID -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {models.map((item, idx) => (
          <article 
            class="bg-white rounded-2xl border border-[#E5E2DA] shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden flex flex-col group"
            x-show={`activeFilter === 'all' || activeFilter === '${item.series}'`}
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 translate-y-2"
            x-transition:enter-end="opacity-100 translate-y-0"
          >
            <!-- GÖRSEL ALANI -->
            <div class="relative aspect-[4/3] bg-[#F3EFEA] overflow-hidden cursor-pointer">
              <img 
                src={item.image} 
                alt={`${item.title} - Yeşilay Mutfak Özel İmalat Yatak Odası`}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading={idx < 6 ? "eager" : "lazy"}
                decoding="async"
                width="800"
                height="600"
                @click={`openPreview('${item.image}', '${item.title}', '${item.modelCode}')`}
              />
              
              <!-- MODEL KODU & SERİ ROZETİ -->
              <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                <span class="px-2.5 py-1 bg-[#15231C]/90 backdrop-blur-sm text-white font-mono font-bold text-xs rounded-md shadow-sm">
                  {item.modelCode}
                </span>
                <span class="px-2 py-1 bg-[#C5A880] text-white font-semibold text-[11px] rounded-md shadow-sm">
                  {item.series} Serisi
                </span>
              </div>

              <!-- ZOOM İKONU -->
              <button 
                type="button"
                @click={`openPreview('${item.image}', '${item.title}', '${item.modelCode}')`}
                class="absolute bottom-3 right-3 p-2 bg-white/90 hover:bg-white text-[#15231C] rounded-lg shadow-md transition opacity-0 group-hover:opacity-100 focus:opacity-100"
                aria-label="Görseli büyüt"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                </svg>
              </button>
            </div>

            <!-- İÇERİK ALANI -->
            <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
              <div>
                <h2 class="text-base sm:text-lg font-bold text-[#15231C] group-hover:text-[#006039] transition leading-snug">
                  {item.title}
                </h2>
                <p class="mt-2.5 text-xs text-[#756E65] leading-relaxed line-clamp-3">
                  {item.description}
                </p>

                <!-- TEKNİK NİTELİKLER -->
                <div class="mt-4 pt-3 border-t border-[#F3EFEA] space-y-1.5">
                  <div class="flex items-center gap-2 text-xs text-[#4A443D]">
                    <span class="text-[#006039] font-bold">✓</span>
                    <span>{item.specs}</span>
                  </div>
                  <div class="flex items-center gap-2 text-xs text-[#4A443D]">
                    <span class="text-[#006039] font-bold">✓</span>
                    <span>10 Yıl Bütünleşik Yeşilay Mutfak Atölye Garantisi</span>
                  </div>
                </div>
              </div>

              <!-- CTA AKSİYONU -->
              <div class="mt-5 pt-4 border-t border-[#E5E2DA] flex items-center justify-between gap-3">
                <a 
                  href={`https://wa.me/905324261788?text=Merhaba,%20${encodeURIComponent(item.modelCode)}%20kodlu%20${encodeURIComponent(item.title)}%20hakk%C4%B1nda%203D%20ke%C5%9Fif%20ve%20fiyat%20bilgisi%20almak%20istiyorum.`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 py-2.5 px-3 bg-[#006039] hover:bg-[#00482B] text-white text-xs font-bold rounded-lg text-center transition flex items-center justify-center gap-1.5 shadow-sm active:scale-95"
                >
                  <span>Fiyat & Keşif İste</span>
                  <span>→</span>
                </a>
                <button 
                  type="button"
                  @click={`openPreview('${item.image}', '${item.title}', '${item.modelCode}')`}
                  class="p-2.5 bg-[#F3EFEA] hover:bg-[#EAE4DC] text-[#15231C] rounded-lg text-xs font-semibold transition"
                  title="Detaylı İncele"
                >
                  🔍
                </button>
              </div>

            </div>
          </article>
        ))}
      </div>

    </div>

    <!-- LIGHTBOX PREVIEW MODAL -->
    <div 
      x-show="previewModal" 
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm"
      style="display: none;"
      @keydown.escape.window="previewModal = false"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
    >
      <div 
        class="bg-white rounded-2xl max-w-4xl w-full overflow-hidden shadow-2xl border border-white/20 relative"
        @click.outside="previewModal = false"
      >
        <div class="p-4 bg-[#FAF9F6] border-b border-[#E5E2DA] flex items-center justify-between">
          <div>
            <span class="px-2 py-0.5 bg-[#15231C] text-white font-mono text-xs font-bold rounded" x-text="previewCode"></span>
            <span class="ml-2 font-bold text-sm text-[#15231C]" x-text="previewTitle"></span>
          </div>
          <button 
            type="button" 
            @click="previewModal = false"
            class="text-[#756E65] hover:text-[#15231C] text-xl font-bold p-1 rounded-md"
          >
            ✕
          </button>
        </div>
        
        <div class="max-h-[75vh] bg-[#F3EFEA] overflow-auto flex items-center justify-center p-2">
          <img :src="previewImage" :alt="previewTitle" class="max-w-full max-h-[70vh] object-contain rounded-lg" />
        </div>

        <div class="p-4 bg-white border-t border-[#E5E2DA] flex flex-wrap items-center justify-between gap-3">
          <span class="text-xs text-[#756E65]">İzmir Buca Adatepe Atölyesi • Kişiye Özel Ölçü İmalat</span>
          <a 
            :href="`https://wa.me/905324261788?text=Merhaba,%20${encodeURIComponent(previewCode)}%20modeli%20i%C3%A7in%20teklif%20almak%20istiyorum.`"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 bg-[#006039] text-white font-bold text-xs rounded-lg hover:bg-[#00482B] transition"
          >
            WhatsApp İle Bu Modeli Sor →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. KURUMSAL GÜVENCE VE MİMARİ STANDARTLAR -->
  <section class="py-12 bg-white border-t border-[#E5E2DA]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="p-5 bg-[#FAF9F6] rounded-xl border border-[#E5E2DA]">
          <div class="text-2xl mb-2">📐</div>
          <h3 class="font-bold text-sm text-[#15231C]">Milimetrik Lazer Rölöve</h3>
          <p class="text-xs text-[#756E65] mt-1">Odanızın girinti, kolon ve tavan ölçüleri milimetrik lazerle çıkarılır, sıfır hata ile üretilir.</p>
        </div>
        <div class="p-5 bg-[#FAF9F6] rounded-xl border border-[#E5E2DA]">
          <div class="text-2xl mb-2">🎨</div>
          <h3 class="font-bold text-sm text-[#15231C]">Sararmaz İtalyan Lake</h3>
          <p class="text-xs text-[#756E65] mt-1">Güneş ışığına ve neme karşı renk değiştirmeyen fırınlanmış poliüretan ipek mat lake kapaklar.</p>
        </div>
        <div class="p-5 bg-[#FAF9F6] rounded-xl border border-[#E5E2DA]">
          <div class="text-2xl mb-2">⚙️</div>
          <h3 class="font-bold text-sm text-[#15231C]">Blum & Hettich Donanım</h3>
          <p class="text-xs text-[#756E65] mt-1">100.000 açma-kapama testli, sessiz hidrolik frenli ray ve menteşe sistemleri.</p>
        </div>
        <div class="p-5 bg-[#FAF9F6] rounded-xl border border-[#E5E2DA]">
          <div class="text-2xl mb-2">🛡️</div>
          <h3 class="font-bold text-sm text-[#15231C]">10 Yıl Bütünleşik Garanti</h3>
          <p class="text-xs text-[#756E65] mt-1">İzmir Buca Adatepe imalat atölyemizin doğrudan üretici ve servis güvencesi.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. SIKÇA SORULAN SORULAR -->
  <section class="py-12 sm:py-16 bg-[#FAF9F6] border-t border-[#E5E2DA]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <span class="text-xs font-bold text-[#006039] uppercase tracking-wider">Merak Edilenler</span>
        <h2 class="text-xl sm:text-2xl font-extrabold text-[#15231C] mt-2">
          Yatak Odası & Gardırop İmalatı Sıkça Sorulan Sorular
        </h2>
      </div>

      <div class="space-y-3">
        {seo.faqList.map(item => (
          <details class="bg-white rounded-xl border border-[#E5E2DA] p-4 group transition">
            <summary class="font-bold text-sm text-[#15231C] cursor-pointer flex items-center justify-between list-none">
              <span>{item.question}</span>
              <span class="text-[#006039] text-lg font-light transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 pt-3 border-t border-[#F3EFEA] text-xs text-[#4A443D] leading-relaxed">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

</Layout>
