---
import Layout from "../../layouts/Layout.astro";

const seo = {
  title: "Yatak Odası Modelleri | Özel İmalat Gardırop & Giyinme Odası",
  description: "Yeşilay Mutfak modern yatak odası ve giyinme odası koleksiyonları. Akıllı iç donanımlı sürgülü dolaplar, lake gardıroplar ve ada şifonyerler.",
  canonical: "https://yesilaymutfak.com/yatak-odasi-modelleri/",
  serviceName: "Yatak Odası Modelleri",
  breadcrumbs: [
    { name: "Ana Sayfa", url: "/" },
    { name: "Mobilya", url: "/tasarimlar/" },
    { name: "Yatak Odası", url: "/yatak-odasi-modelleri/" }
  ]
};

const collections = [
  {
    name: "Golf",
    title: "Golf Gardırop & Giyinme Odası",
    desc: "Golf gardırop ve giyinme odası çözümleri, zarafetle tasarlanmış iç mekanlarda hem estetik hem de fonksiyonel beklentilere eksiksiz yanıt verir.",
    image: "/images/models/koleksiyonlar/yatak-golf.webp"
  },
  {
    name: "Volo",
    title: "Volo Yatak Odası Koleksiyonu",
    desc: "Volo yatak odası koleksiyonu, yalın çizgileri ve akıllı tasarım detaylarıyla çağdaş yaşam alanları için benzersiz bir konfor sunar. Sade ama güçlü estetik anlayışı, mekanlara ferahlık kazandırırken, kişiselleştirilebilir kombinasyonları sayesinde her zevke hitap eden çözümler üretir.",
    image: "/images/models/koleksiyonlar/yatak-volo.webp"
  },
  {
    name: "Arcadia",
    title: "Arcadia Klasik Yatak Odası",
    desc: "Zarif gelenek, romantik dokunuşlarla yeniden yorumlandı. Arcadia koleksiyonu, sıcak ahşap detayları ve asil lake yüzeyleriyle yatak odanızı huzur dolu bir sığınağa dönüştürür.",
    image: "/images/models/koleksiyonlar/yatak-arcadia.webp"
  }
];

const otherCollections = [
  { name: "Mutfak", href: "/izmir-mutfak-dolabi-imalati/" },
  { name: "Salon", href: "/salon-modelleri/" },
  { name: "Genç Odası", href: "/genc-odasi-modelleri/" },
  { name: "Çocuk Odası", href: "/cocuk-odasi-modelleri/" },
  { name: "Çamaşır", href: "/camasir-odasi-modelleri/" }
];
---

<Layout seo={seo} activeService="yatak-odasi">
  <main class="w-full bg-[#FAF9F6] text-[#15231C] min-h-screen py-8 sm:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 sm:space-y-16">
      
      <!-- BREADCRUMB -->
      <nav class="flex items-center space-x-2 text-[13px] text-[#756E65] font-normal" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#15231C] transition">Ana Sayfa</a>
        <span>/</span>
        <span class="text-[#15231C] font-semibold">Yatak Odası</span>
      </nav>

      <!-- H1 BAŞLIK -->
      <div class="pt-2">
        <h1 class="text-3xl sm:text-5xl font-bold text-[#15231C] tracking-tight leading-none" style="font-family: 'Roboto', sans-serif;">
          Yatak Odası
        </h1>
      </div>

      <!-- KOLEKSİYONLAR -->
      <div class="space-y-16 sm:space-y-24">
        {collections.map((item) => (
          <section class="space-y-4 sm:space-y-6">
            <div class="max-w-3xl space-y-3">
              <h2 class="text-2xl sm:text-3xl font-bold text-[#15231C] tracking-tight" style="font-family: 'Roboto', sans-serif;">
                {item.name}
              </h2>
              <p class="text-xs sm:text-sm text-[#4A443D] font-normal leading-relaxed">
                {item.desc}
              </p>
            </div>
            <div class="w-full overflow-hidden bg-[#ECEAE5]">
              <img 
                src={item.image} 
                alt={`${item.name} Yatak Odası Modeli`}
                class="w-full h-auto object-cover max-h-[720px] brightness-100 contrast-100"
                loading="lazy"
              />
            </div>
          </section>
        ))}
      </div>

      <!-- DİĞER KOLEKSİYONLAR -->
      <div class="pt-12 sm:pt-16 border-t border-[#E5E2DA]">
        <h2 class="text-xl sm:text-2xl font-bold text-[#15231C] tracking-tight mb-6" style="font-family: 'Roboto', sans-serif;">
          Diğer Koleksiyonlar
        </h2>
        <div class="flex flex-wrap gap-3 sm:gap-4">
          {otherCollections.map((c) => (
            <a 
              href={c.href}
              class="px-5 py-2.5 bg-white border border-[#D0CAC0] hover:border-[#15231C] hover:bg-[#15231C] hover:text-white text-xs font-semibold text-[#15231C] transition-all select-none"
            >
              {c.name}
            </a>
          ))}
        </div>
      </div>

      <!-- DAHA FAZLA BİLGİ ALIN -->
      <div class="pt-10 sm:pt-14 pb-8 border-t border-[#E5E2DA]" id="bilgi-al">
        <div class="max-w-2xl">
          <h2 class="text-2xl sm:text-3xl font-bold text-[#15231C] tracking-tight mb-2" style="font-family: 'Roboto', sans-serif;">
            Daha Fazla Bilgi Alın
          </h2>
          <p class="text-xs sm:text-sm text-[#756E65] font-normal mb-8">
            Yatak odası veya giyinme odası alanınız için mimari ekibimizden detaylı bilgi ve 3D tasarım teklifi alın.
          </p>

          <form action="https://wa.me/905324261788" method="GET" target="_blank" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="adsoyad" class="block text-xs font-semibold text-[#15231C] mb-1.5">Ad Soyad*</label>
                <input type="text" id="adsoyad" name="adsoyad" required placeholder="Adınız ve Soyadınız" class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] focus:outline-none focus:border-[#15231C] transition" />
              </div>
              <div>
                <label for="telefon" class="block text-xs font-semibold text-[#15231C] mb-1.5">Telefon*</label>
                <input type="tel" id="telefon" name="telefon" required placeholder="05XX XXX XX XX" class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] focus:outline-none focus:border-[#15231C] transition" />
              </div>
            </div>
            <div>
              <label for="email" class="block text-xs font-semibold text-[#15231C] mb-1.5">E-posta*</label>
              <input type="email" id="email" name="email" required placeholder="ornek@email.com" class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] focus:outline-none focus:border-[#15231C] transition" />
            </div>
            <div>
              <label for="mesaj" class="block text-xs font-semibold text-[#15231C] mb-1.5">Mesajınız</label>
              <textarea id="mesaj" name="mesaj" rows="3" placeholder="İlgilendiğiniz yatak odası koleksiyonu veya özel istekleriniz..." class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] focus:outline-none focus:border-[#15231C] transition"></textarea>
            </div>
            <div class="pt-2">
              <button type="submit" class="w-full sm:w-auto px-8 py-3 bg-[#15231C] hover:bg-[#006039] text-white text-xs font-bold uppercase tracking-wider transition-colors duration-200 select-none">
                Gönder
              </button>
            </div>
          </form>
        </div>
      </div>

    </div>
  </main>
</Layout>
