const arcadiaImages = ["/images/models/yatak-odasi/arcadia/01.webp", "/images/models/yatak-odasi/arcadia/02.webp", "/images/models/yatak-odasi/arcadia/03.webp", "/images/models/yatak-odasi/arcadia/04.webp", "/images/models/yatak-odasi/arcadia/05.webp", "/images/models/yatak-odasi/arcadia/06.webp", "/images/models/yatak-odasi/arcadia/07.webp", "/images/models/yatak-odasi/arcadia/08.webp", "/images/models/yatak-odasi/arcadia/09.webp", "/images/models/yatak-odasi/arcadia/10.webp", "/images/models/yatak-odasi/arcadia/11.webp", "/images/models/yatak-odasi/arcadia/12.webp", "/images/models/yatak-odasi/arcadia/13.webp", "/images/models/yatak-odasi/arcadia/14.webp", "/images/models/yatak-odasi/arcadia/15.webp", "/images/models/yatak-odasi/arcadia/16.webp", "/images/models/yatak-odasi/arcadia/17.webp", "/images/models/yatak-odasi/arcadia/18.webp", "/images/models/yatak-odasi/arcadia/19.webp", "/images/models/yatak-odasi/arcadia/20.webp", "/images/models/yatak-odasi/arcadia/21.webp", "/images/models/yatak-odasi/arcadia/22.webp"];
---

<Layout seo={seo} activeService="yatak-odasi">
  <main class="w-full bg-[#FAF9F6] text-[#15231C] min-h-screen py-8 sm:py-12">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 space-y-12 sm:space-y-16">
      
      <!-- BREADCRUMB -->
      <nav class="flex items-center space-x-2 text-[13px] text-[#756E65] font-normal" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#15231C] transition">Ana Sayfa</a>
        <span>/</span>
        <a href="/tasarimlar/" class="hover:text-[#15231C] transition">Tasarımlar</a>
        <span>/</span>
        <span class="text-[#15231C] font-semibold">Yatak Odası</span>
      </nav>

      <!-- H1 BAŞLIK -->
      <div class="pt-2">
        <h1 class="text-3xl sm:text-5xl font-bold text-[#15231C] tracking-tight leading-tight" style="font-family: 'Roboto', sans-serif;">
          Özel Ölçü Yatak Odası ve Gardırop Modelleri
        </h1>
          <p data-answer-capsule="true" class="answer-capsule mt-4 text-stone-300 sm:text-stone-600 text-sm sm:text-base font-normal leading-relaxed max-w-2xl">İzmir özel ölçü yatak odası mobilyaları; tavana kadar sürgülü veya kapaklı akıllı gardırop üniteleri, entegre sensörlü LED aydınlatmalar, pantolonluk ve aksesuar çekmeceleriyle depolama alanını maksimize eder. Yeşilay Mutfak, Buca atölyesinde E1 sınıfı MDF gövdeyle 10 yıl garantili üretir.</p>
        <p class="mt-3 text-xs sm:text-sm text-[#756E65] max-w-2xl leading-relaxed">
          İzmir Buca Adatepe imalat atölyemizde kişiye özel üretilen 99 mimari gardırop, giyinme odası ve yatak odası tasarımı. Tavan boyu raylı ve menteşeli dolaplar, füme cam kapaklar, entegre LED aydınlatmalar ve kadife çekmece içi aksesuarlar.
        </p>
      </div>

      <!-- KOLEKSİYON SLIDERLARI -->
      <div class="space-y-16 sm:space-y-24">
        <ModelSlider 
          name="Zenith Özel Ölçü Gardırop ve Yatak Odası Serisi"
          desc="Moderna gardırop ve giyinme odası çözümleri, zarafetle tasarlanmış iç mekanlarda hem estetik hem de fonksiyonel beklentilere eksiksiz yanıt verir."
          images={golfImages}
          categoryLabel="Gardırop & Giyinme Odası"
          priorityFirst={true}
        />

        <ModelSlider 
          name="Sera Giyinme Odası ve Raylı Dolap Serisi"
          desc="Aura yatak odası koleksiyonu, yalın çizgileri ve akıllı tasarım detaylarıyla çağdaş yaşam alanları için benzersiz bir konfor sunar. Sade ama güçlü estetik anlayışı, mekanlara ferahlık kazandırırken, kişiselleştirilebilir kombinasyonları sayesinde her zevke hitap eden çözümler üretir."
          images={voloImages}
          categoryLabel="Sürgülü Raylı Gardırop"
        />

        <ModelSlider 
          name="Palazzo Klasik ve Lake Gardırop Serisi"
          desc="Zarif gelenek, romantik dokunuşlarla yeniden yorumlandı. Elegance koleksiyonu, sıcak ahşap detayları ve asil lake yüzeyleriyle yatak odanızı huzur dolu bir sığınağa dönüştürür."
          images={arcadiaImages}
          categoryLabel="Lake Gardırop Koleksiyonu"
        />
      </div>

      <!-- TEKNİK DOLAP İÇİ ERGONOMİ VE DÜZENLEME TABLOSU -->
      <div class="pt-8 border-t border-[#E5E2DA]">
        <div class="bg-white rounded-2xl border border-stone-200 p-6 sm:p-10 shadow-sm space-y-6">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-[#006039] bg-emerald-50 px-3 py-1 rounded-full border border-emerald-100">
              GİYİNME ODASI & GARDIROP MİMARİSİ
            </span>
            <h2 class="text-xl sm:text-3xl font-extrabold text-[#15231C] mt-3">
              Özel Ölçü Gardırop İç Bölümleme ve Ergonomi Standartları
            </h2>
            <p class="mt-2 text-xs sm:text-sm text-stone-600 leading-relaxed max-w-3xl">
              Hazır seri dolaplarda kıyafetlerin sığmaması veya askılıkların yetersiz kalması sık karşılaşılan sorunlardır. Atölyemizde gardıropları gardırop derinliği (60-65 cm) ve askı boylarına göre milimetrik bölümlendiriyoruz:
            </p>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs sm:text-sm">
              <thead>
                <tr class="bg-[#15231C] text-white">
                  <th class="p-3.5 font-semibold">Bölüm Fonksiyonu</th>
                  <th class="p-3.5 font-semibold">Önerilen Net Yükseklik</th>
                  <th class="p-3.5 font-semibold">İdeal Modül Derinliği</th>
                  <th class="p-3.5 font-semibold">Mekanizma / Donanım</th>
                  <th class="p-3.5 font-semibold">Kullanım Avantajı</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-stone-200 text-stone-700">
                <tr>
                  <td class="p-3.5 font-bold text-[#15231C]">Uzun Elbise & Palto Askılığı</td>
                  <td class="p-3.5">140 – 165 cm</td>
                  <td class="p-3.5">60 – 65 cm</td>
                  <td class="p-3.5">Işıklı alüminyum LED askı borusu</td>
                  <td class="p-3.5">Elbise ve montların tabana değmesini ve kırışmasını önler</td>
                </tr>
                <tr class="bg-stone-50/70">
                  <td class="p-3.5 font-bold text-[#15231C]">Gömlek & Ceket Askılığı (Çift Kat)</td>
                  <td class="p-3.5">90 – 105 cm (x2)</td>
                  <td class="p-3.5">60 – 62 cm</td>
                  <td class="p-3.5">Üstte asansörlü askı (servetto), altta sabit</td>
                  <td class="p-3.5">Tavan yüksekliğini çift katlı kullanarak depolamayı 2 katına çıkarır</td>
                </tr>
                <tr>
                  <td class="p-3.5 font-bold text-[#15231C]">Aksesuarlık & Saat / Takı Çekmecesi</td>
                  <td class="p-3.5">12 – 16 cm</td>
                  <td class="p-3.5">50 – 55 cm</td>
                  <td class="p-3.5">Blum Tandem tam açılım frenli ray, füme cam tabla</td>
                  <td class="p-3.5">Kadife kaplı bölmeler ile saat, kravat ve takı düzeni sağlar</td>
                </tr>
                <tr class="bg-stone-50/70">
                  <td class="p-3.5 font-bold text-[#15231C]">Gizli Ayakkabılık ve Çanta Rafları</td>
                  <td class="p-3.5">25 – 35 cm (Eğimli/Düz)</td>
                  <td class="p-3.5">38 – 45 cm</td>
                  <td class="p-3.5">Alüminyum stoplu çekme raflar, gizli koku filtresi</td>
                  <td class="p-3.5">Ayakkabı ve çantaların ezilmeden hava alarak saklanmasını sağlar</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="pt-4 text-xs sm:text-sm text-stone-600 leading-relaxed border-t border-stone-100">
            <p>
              Banyo ve yatak odasını birleştiren ebeveyn süit projelerimiz için <a href="/izmir-banyo-yenileme-seramik/" class="text-[#006039] font-semibold underline underline-offset-4">İzmir lüks banyo yenileme</a> çözümlerimizi, genel ev mobilyalarımız için <a href="/tasarimlar/" class="text-[#006039] font-semibold underline underline-offset-4">özel imalat modeller kataloğumuzu</a> inceleyebilirsiniz.
            </p>
          </div>
        </div>
      </div>

      <!-- DİĞER KOLEKSİYONLAR -->
      <div class="pt-12 sm:pt-16 border-t border-[#E5E2DA]">
        <h2 class="text-xl sm:text-2xl font-bold text-[#15231C] tracking-tight mb-6" style="font-family: 'Roboto', sans-serif;">
          Diğer Koleksiyonlar
        </h2>
        <div class="flex flex-wrap gap-3 sm:gap-4">
          {otherCollections.map((c) => (
            <a 
              href={c.href}
              class="px-5 py-2.5 bg-white border border-[#D0CAC0] hover:border-[#15231C] hover:bg-[#15231C] hover:text-white text-xs font-semibold text-[#15231C] transition-all select-none"
            >
              {c.name}
            </a>
          ))}
        </div>
      </div>

      <!-- DAHA FAZLA BİLGİ ALIN -->
      <div class="pt-10 sm:pt-14 pb-8 border-t border-[#E5E2DA]" id="bilgi-al">
        <div class="max-w-2xl">
          <h2 class="text-2xl sm:text-3xl font-bold text-[#15231C] tracking-tight mb-2" style="font-family: 'Roboto', sans-serif;">
            Daha Fazla Bilgi Alın
          </h2>
          <p class="text-xs sm:text-sm text-[#756E65] font-normal mb-8">
            Yatak odası veya giyinme odası alanınız için mimari ekibimizden detaylı bilgi ve 3D tasarım teklifi alın.
          </p>

          <form action="https://wa.me/905324261788" method="GET" target="_blank" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="adsoyad" class="block text-xs font-semibold text-[#15231C] mb-1.5">Ad Soyad*</label>
                <input type="text" id="adsoyad" name="adsoyad" required placeholder="Adınız ve Soyadınız" class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] focus:outline-none focus:border-[#15231C] transition" />
              </div>
              <div>
                <label for="telefon" class="block text-xs font-semibold text-[#15231C] mb-1.5">Telefon*</label>
                <input type="tel" id="telefon" name="telefon" required placeholder="05XX XXX XX XX" class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] focus:outline-none focus:border-[#15231C] transition" />
              </div>
            </div>
            <div>
              <label for="email" class="block text-xs font-semibold text-[#15231C] mb-1.5">E-posta*</label>
              <input type="email" id="email" name="email" required placeholder="ornek@email.com" class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] focus:outline-none focus:border-[#15231C] transition" />
            </div>
            <div>
              <label for="mesaj" class="block text-xs font-semibold text-[#15231C] mb-1.5">Mesajınız</label>
              <textarea id="mesaj" name="mesaj" rows="3" placeholder="İlgilendiğiniz yatak odası koleksiyonu veya özel istekleriniz..." class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] focus:outline-none focus:border-[#15231C] transition"></textarea>
            </div>
            <div class="pt-2">
              <button type="submit" class="w-full sm:w-auto px-8 py-3 bg-[#15231C] hover:bg-[#006039] text-white text-xs font-bold uppercase tracking-wider transition-colors duration-200 select-none">
                Gönder
              </button>
            </div>
          </form>
        </div>
      </div>

    </div>
  </main>
</Layout>
