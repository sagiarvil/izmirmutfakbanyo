---
import Layout from "../../layouts/Layout.astro";
import ModelSlider from "../../components/ModelSlider.astro";

const seo = {
  title: "Özel Ölçü Salon & TV Ünitesi Modelleri | Yeşilay Mutfak",
  description: "Moderna, Aura ve Elegance serisi özel ölçü TV üniteleri, duvar kütüphaneleri ve asma konsollar. İzmir Buca atölyemizden ücretsiz 3D keşif randevusu alın.",
  canonical: "https://yesilaymutfak.com/salon-modelleri/",
  serviceName: "Salon Modelleri",
  breadcrumbs: [
    { name: "Ana Sayfa", url: "/" },
    { name: "Tasarımlar", url: "/tasarimlar/" },
    { name: "Salon & TV Ünitesi Modelleri", url: "/salon-modelleri/" }
  ]
};

const otherCollections = [
  { name: "Mutfak", href: "/izmir-mutfak-dolabi-imalati/" },
  { name: "Yatak Odası", href: "/yatak-odasi-modelleri/" },
  { name: "Genç Odası", href: "/genc-odasi-modelleri/" },
  { name: "Çocuk Odası", href: "/cocuk-odasi-modelleri/" },
  { name: "Çamaşır", href: "/camasir-odasi-modelleri/" }
];

const golfImages = ["/images/models/salon/golf/golf-01.webp", "/images/models/salon/golf/golf-02.webp", "/images/models/salon/golf/golf-03.webp", "/images/models/salon/golf/golf-04.webp", "/images/models/salon/golf/golf-05.webp", "/images/models/salon/golf/golf-06.webp", "/images/models/salon/golf/golf-07.webp", "/images/models/salon/golf/golf-08.webp", "/images/models/salon/golf/golf-09.webp", "/images/models/salon/golf/golf-10.webp", "/images/models/salon/golf/golf-11.webp", "/images/models/salon/golf/golf-12.webp", "/images/models/salon/golf/golf-13.webp", "/images/models/salon/golf/golf-14.webp", "/images/models/salon/golf/golf-15.webp", "/images/models/salon/golf/golf-16.webp", "/images/models/salon/golf/golf-17.webp", "/images/models/salon/golf/golf-18.webp", "/images/models/salon/golf/golf-19.webp", "/images/models/salon/golf/golf-20.webp", "/images/models/salon/golf/golf-21.webp", "/images/models/salon/golf/golf-22.webp", "/images/models/salon/golf/golf-23.webp", "/images/models/salon/golf/golf-24.webp", "/images/models/salon/golf/golf-25.webp", "/images/models/salon/golf/golf-26.webp", "/images/models/salon/golf/golf-27.webp", "/images/models/salon/golf/golf-28.webp"];
const voloImages = ["/images/models/salon/volo/volo-01.webp", "/images/models/salon/volo/volo-02.webp", "/images/models/salon/volo/volo-03.webp", "/images/models/salon/volo/volo-04.webp", "/images/models/salon/volo/volo-05.webp", "/images/models/salon/volo/volo-06.webp", "/images/models/salon/volo/volo-07.webp", "/images/models/salon/volo/volo-08.webp", "/images/models/salon/volo/volo-09.webp", "/images/models/salon/volo/volo-10.webp", "/images/models/salon/volo/volo-11.webp", "/images/models/salon/volo/volo-12.webp", "/images/models/salon/volo/volo-13.webp", "/images/models/salon/volo/volo-14.webp", "/images/models/salon/volo/volo-15.webp", "/images/models/salon/volo/volo-16.webp", "/images/models/salon/volo/volo-17.webp", "/images/models/salon/volo/volo-18.webp"];
const arcadiaImages = ["/images/models/salon/arcadia/arcadia-01.webp", "/images/models/salon/arcadia/arcadia-02.webp", "/images/models/salon/arcadia/arcadia-03.webp", "/images/models/salon/arcadia/arcadia-04.webp", "/images/models/salon/arcadia/arcadia-05.webp", "/images/models/salon/arcadia/arcadia-06.webp", "/images/models/salon/arcadia/arcadia-07.webp", "/images/models/salon/arcadia/arcadia-08.webp", "/images/models/salon/arcadia/arcadia-09.webp", "/images/models/salon/arcadia/arcadia-10.webp", "/images/models/salon/arcadia/arcadia-11.webp", "/images/models/salon/arcadia/arcadia-12.webp", "/images/models/salon/arcadia/arcadia-13.webp", "/images/models/salon/arcadia/arcadia-14.webp", "/images/models/salon/arcadia/arcadia-15.webp", "/images/models/salon/arcadia/arcadia-16.webp", "/images/models/salon/arcadia/arcadia-17.webp", "/images/models/salon/arcadia/arcadia-18.webp", "/images/models/salon/arcadia/arcadia-19.webp", "/images/models/salon/arcadia/arcadia-20.webp"];
---

<Layout seo={seo} activeService="salon">
  <main class="w-full bg-[#FAF9F6] text-[#15231C] min-h-screen py-8 sm:py-12">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 space-y-12 sm:space-y-16">
      
      <!-- BREADCRUMB -->
      <nav class="flex items-center space-x-2 text-[13px] text-[#756E65] font-normal" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#15231C] transition">Ana Sayfa</a>
        <span>/</span>
        <a href="/tasarimlar/" class="hover:text-[#15231C] transition">Tasarımlar</a>
        <span>/</span>
        <span class="text-[#15231C] font-semibold">Salon & TV Ünitesi</span>
      </nav>

      <!-- H1 BAŞLIK -->
      <div class="pt-2">
        <h1 class="text-3xl sm:text-5xl font-bold text-[#15231C] tracking-tight leading-tight" style="font-family: 'Roboto', sans-serif;">
          Özel Ölçü Salon ve TV Ünitesi Modelleri
        </h1>
          <p data-answer-capsule="true" class="answer-capsule mt-4 text-stone-300 sm:text-stone-600 text-sm sm:text-base font-normal leading-relaxed max-w-2xl">İzmir özel ölçü salon ve TV ünitesi imalatı; akustik ahşap çıta paneller, gizli kablo geçiş kanalları, füme camlı LED aydınlatmalı vitrinler ve kitaplık kombinasyonlarıyla salonunuzun mimari dengesini kurar. Yeşilay Mutfak, Buca atölyesinde E1 sınıfı dayanıklı malzemelerle 10 yıl garantili üretir.</p>
        <p class="mt-3 text-xs sm:text-sm text-[#756E65] max-w-2xl leading-relaxed">
          İzmir Buca Adatepe imalat atölyemizde salon duvarınızın net ölçüsüne göre üretilen 68 mimari TV ünitesi, kütüphane ve asma konsol tasarımı. Akustik ahşap paneller, gizli kablo kanalları ve şömine entegrasyonu.
        </p>
      </div>

      <!-- KOLEKSİYON SLIDERLARI -->
      <div class="space-y-16 sm:space-y-24">
        <ModelSlider 
          name="Moderna Modüler Salon ve TV Ünitesi Koleksiyonu"
          desc="Yeşilay Mutfak'ın çağdaş Moderna koleksiyonu, modern yaşam alanlarına zarafet, düzen ve işlev kazandırır. Modüler yapısı sayesinde esnek çözümler sunarken, rafine malzeme seçenekleri ve sade çizgileriyle zamansız bir estetik yaratır."
          images={golfImages}
          categoryLabel="Salon & TV Ünitesi"
          priorityFirst={true}
        />

        <ModelSlider 
          name="Aura Asma Konsol ve Duvar Sistemi Koleksiyonu"
          desc="Her yaşam alanı, kişisel bir dokunuşu hak eder. Aura, sadece mobilya değil, yaşam tarzınızı yansıtan bir kompozisyon sunar. Her detayında estetik, işlevsellik ve mimari zarafet barındıran Aura koleksiyonu; bulunduğu her mekana hafiflik ve ferahlık katar."
          images={voloImages}
          categoryLabel="Asma Duvar Ünitesi"
        />

        <ModelSlider 
          name="Elegance Kütüphaneli Yaşam Ünitesi Koleksiyonu"
          desc="Modern çizgiler, rafine bir zevk ve zarif bir yaşam alanı… Elegance, salonunuzda estetikle konforu kusursuz bir dengede buluşturur. Göz alıcı sadeliği ve detaylara verilen özen ile her mekanda sofistike bir atmosfer yaratır."
          images={arcadiaImages}
          categoryLabel="Kütüphaneli TV Konsolu"
        />
      </div>

      <!-- TEKNİK MİMARİ TABLO VE DONANIM BİLGİSİ -->
      <div class="pt-8 border-t border-[#E5E2DA]">
        <div class="bg-white rounded-2xl border border-stone-200 p-6 sm:p-10 shadow-sm space-y-6">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-[#006039] bg-emerald-50 px-3 py-1 rounded-full border border-emerald-100">
              SALON ERGONOMİSİ & MİMARİ STANDARTLAR
            </span>
            <h2 class="text-xl sm:text-3xl font-extrabold text-[#15231C] mt-3">
              Özel Ölçü TV Ünitesi ve Duvar Paneli Teknik Seçim Tablosu
            </h2>
            <p class="mt-2 text-xs sm:text-sm text-stone-600 leading-relaxed max-w-3xl">
              Televizyon inç boyutu, oturma mesafesi ve ses sistemi amfi yerleşimine göre salon ünitelerinde uyguladığımız modüler ölçü ve malzeme standartları:
            </p>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs sm:text-sm">
              <thead>
                <tr class="bg-[#15231C] text-white">
                  <th class="p-3.5 font-semibold">Tasarım Konsepti</th>
                  <th class="p-3.5 font-semibold">İdeal TV Boyutu</th>
                  <th class="p-3.5 font-semibold">Duvar Genişliği</th>
                  <th class="p-3.5 font-semibold">Kablo & Tesisat Kanalı</th>
                  <th class="p-3.5 font-semibold">Öne Çıkan Malzeme Kombinasyonu</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-stone-200 text-stone-700">
                <tr>
                  <td class="p-3.5 font-bold text-[#15231C]">Asma Konsol & Akustik Çıta</td>
                  <td class="p-3.5">55″ – 65″ TV</td>
                  <td class="p-3.5">240 – 300 cm</td>
                  <td class="p-3.5">Gizli fırçalı priz tüneli, sıfır kablo görünümü</td>
                  <td class="p-3.5">Doğal meşe çıta arkası antrasit akustik keçe ve mat lake konsol</td>
                </tr>
                <tr class="bg-stone-50/70">
                  <td class="p-3.5 font-bold text-[#15231C]">Mermer / Porselen Panelli TV Duvarı</td>
                  <td class="p-3.5">65″ – 85″ TV</td>
                  <td class="p-3.5">300 – 420 cm</td>
                  <td class="p-3.5">Çift bölmeli amfi ve oyun konsolu hava kanalı</td>
                  <td class="p-3.5">12 mm Statuario porselen plaka, bronz alüminyum profil ve LED kanal</td>
                </tr>
                <tr>
                  <td class="p-3.5 font-bold text-[#15231C]">Biyoetanol Şömineli Konsol</td>
                  <td class="p-3.5">65″ – 75″ TV</td>
                  <td class="p-3.5">280 – 380 cm</td>
                  <td class="p-3.5">Isı kalkanlı yalıtım kutusu ve alt menfez</td>
                  <td class="p-3.5">Isıya dayanıklı seramik cephe, Blum bas-aç çekmeceler</td>
                </tr>
                <tr class="bg-stone-50/70">
                  <td class="p-3.5 font-bold text-[#15231C]">Kütüphaneli Tam Boy Salon Sistemi</td>
                  <td class="p-3.5">55″ – 75″ TV</td>
                  <td class="p-3.5">320 – 500 cm (Tavan boyu)</td>
                  <td class="p-3.5">Entegre sensörlü LED spot ve kitaplık kanalları</td>
                  <td class="p-3.5">18 mm E1 fırın lake gövde, füme cam vitrin ve pirinç kulp</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="pt-4 text-xs sm:text-sm text-stone-600 leading-relaxed border-t border-stone-100">
            <p>
              Salon ünitenizi açık plan mutfakla birlikte tasarlatmak istiyorsanız <a href="/yasam-alanlari-mutfak-modelleri/" class="text-[#006039] font-semibold underline underline-offset-4">açık mutfak ve yaşam alanları modellerimizi</a> inceleyebilir veya tüm evi yenilemek için <a href="/izmir-komple-daire-tadilati/" class="text-[#006039] font-semibold underline underline-offset-4">İzmir komple daire tadilatı</a> hizmetimizden faydalanabilirsiniz.
            </p>
          </div>
        </div>
      </div>

      <!-- DİĞER KOLEKSİYONLAR -->
      <div class="pt-12 sm:pt-16 border-t border-[#E5E2DA]">
        <h2 class="text-xl sm:text-2xl font-bold text-[#15231C] tracking-tight mb-6" style="font-family: 'Roboto', sans-serif;">
          Diğer Koleksiyonlar
        </h2>
        <div class="flex flex-wrap gap-3 sm:gap-4">
          {otherCollections.map((c) => (
            <a 
              href={c.href}
              class="px-5 py-2.5 bg-white border border-[#D0CAC0] hover:border-[#15231C] hover:bg-[#15231C] hover:text-white text-xs font-semibold text-[#15231C] transition-all select-none"
            >
              {c.name}
            </a>
          ))}
        </div>
      </div>

      <!-- DAHA FAZLA BİLGİ ALIN (Locus Birebir Form) -->
      <div class="pt-10 sm:pt-14 pb-8 border-t border-[#E5E2DA]" id="bilgi-al">
        <div class="max-w-2xl">
          <h2 class="text-2xl sm:text-3xl font-bold text-[#15231C] tracking-tight mb-2" style="font-family: 'Roboto', sans-serif;">
            Daha Fazla Bilgi Alın
          </h2>
          <p class="text-xs sm:text-sm text-[#756E65] font-normal mb-8">
            Salonunuzun ölçüleri veya ilgilendiğiniz koleksiyon hakkında mimari ekibimizden detaylı bilgi ve 3D tasarım teklifi alın.
          </p>

          <form action="https://wa.me/905324261788" method="GET" target="_blank" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="adsoyad" class="block text-xs font-semibold text-[#15231C] mb-1.5">Ad Soyad*</label>
                <input type="text" id="adsoyad" name="adsoyad" required placeholder="Adınız ve Soyadınız" class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] focus:outline-none focus:border-[#15231C] transition" />
              </div>
              <div>
                <label for="telefon" class="block text-xs font-semibold text-[#15231C] mb-1.5">Telefon*</label>
                <input type="tel" id="telefon" name="telefon" required placeholder="05XX XXX XX XX" class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] focus:outline-none focus:border-[#15231C] transition" />
              </div>
            </div>
            <div>
              <label for="email" class="block text-xs font-semibold text-[#15231C] mb-1.5">E-posta*</label>
              <input type="email" id="email" name="email" required placeholder="ornek@email.com" class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] focus:outline-none focus:border-[#15231C] transition" />
            </div>
            <div>
              <label for="mesaj" class="block text-xs font-semibold text-[#15231C] mb-1.5">Mesajınız</label>
              <textarea id="mesaj" name="mesaj" rows="3" placeholder="İlgilendiğiniz salon koleksiyonu veya özel istekleriniz..." class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] focus:outline-none focus:border-[#15231C] transition"></textarea>
            </div>
            <div class="pt-2">
              <button type="submit" class="w-full sm:w-auto px-8 py-3 bg-[#15231C] hover:bg-[#006039] text-white text-xs font-bold uppercase tracking-wider transition-colors duration-200 select-none">
                Gönder
              </button>
            </div>
          </form>
        </div>
      </div>

    </div>
  </main>
</Layout>
