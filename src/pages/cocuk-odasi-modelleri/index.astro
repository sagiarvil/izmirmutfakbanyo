---
import Layout from "../../layouts/Layout.astro";
import ModelSlider from "../../components/ModelSlider.astro";

const seo = {
  title: "Montessori & Lake Çocuk Odası Modelleri | Yeşilay Mutfak",
  description: "EN 71-3 su bazlı anti-alerjik lake boyalı, yuvarlatılmış güvenli köşeli ve Montessori uyumlu özel ölçü çocuk odası mobilyaları. Ücretsiz 3D keşif alın.",
  canonical: "https://yesilaymutfak.com/cocuk-odasi-modelleri/",
  serviceName: "Çocuk Odası Modelleri",
  breadcrumbs: [
    { name: "Ana Sayfa", url: "/" },
    { name: "Tasarımlar", url: "/tasarimlar/" },
    { name: "Çocuk Odası Modelleri", url: "/cocuk-odasi-modelleri/" }
  ]
};

const otherCollections = [
  { name: "Mutfak", href: "/izmir-mutfak-dolabi-imalati/" },
  { name: "Salon", href: "/salon-modelleri/" },
  { name: "Yatak Odası", href: "/yatak-odasi-modelleri/" },
  { name: "Genç Odası", href: "/genc-odasi-modelleri/" },
  { name: "Çamaşır", href: "/camasir-odasi-modelleri/" }
];

const golfImages = ["/images/models/cocuk-odasi/golf/golf-01.webp", "/images/models/cocuk-odasi/golf/golf-02.webp", "/images/models/cocuk-odasi/golf/golf-03.webp", "/images/models/cocuk-odasi/golf/golf-04.webp", "/images/models/cocuk-odasi/golf/golf-05.webp", "/images/models/cocuk-odasi/golf/golf-06.webp", "/images/models/cocuk-odasi/golf/golf-07.webp", "/images/models/cocuk-odasi/golf/golf-08.webp", "/images/models/cocuk-odasi/golf/golf-09.webp", "/images/models/cocuk-odasi/golf/golf-10.webp"];
const voloImages = ["/images/models/cocuk-odasi/volo/volo-01.webp", "/images/models/cocuk-odasi/volo/volo-02.webp", "/images/models/cocuk-odasi/volo/volo-03.webp", "/images/models/cocuk-odasi/volo/volo-04.webp", "/images/models/cocuk-odasi/volo/volo-05.webp", "/images/models/cocuk-odasi/volo/volo-06.webp", "/images/models/cocuk-odasi/volo/volo-07.webp", "/images/models/cocuk-odasi/volo/volo-08.webp", "/images/models/cocuk-odasi/volo/volo-09.webp", "/images/models/cocuk-odasi/volo/volo-10.webp", "/images/models/cocuk-odasi/volo/volo-11.webp", "/images/models/cocuk-odasi/volo/volo-12.webp", "/images/models/cocuk-odasi/volo/volo-13.webp", "/images/models/cocuk-odasi/volo/volo-14.webp", "/images/models/cocuk-odasi/volo/volo-15.webp", "/images/models/cocuk-odasi/volo/volo-16.webp", "/images/models/cocuk-odasi/volo/volo-17.webp", "/images/models/cocuk-odasi/volo/volo-18.webp", "/images/models/cocuk-odasi/volo/volo-19.webp", "/images/models/cocuk-odasi/volo/volo-20.webp", "/images/models/cocuk-odasi/volo/volo-21.webp", "/images/models/cocuk-odasi/volo/volo-22.webp", "/images/models/cocuk-odasi/volo/volo-23.webp", "/images/models/cocuk-odasi/volo/volo-24.webp", "/images/models/cocuk-odasi/volo/volo-25.webp", "/images/models/cocuk-odasi/volo/volo-26.webp", "/images/models/cocuk-odasi/volo/volo-27.webp", "/images/models/cocuk-odasi/volo/volo-28.webp", "/images/models/cocuk-odasi/volo/volo-29.webp", "/images/models/cocuk-odasi/volo/volo-30.webp", "/images/models/cocuk-odasi/volo/volo-31.webp", "/images/models/cocuk-odasi/volo/volo-32.webp", "/images/models/cocuk-odasi/volo/volo-33.webp"];
---

<Layout seo={seo} activeService="cocuk-odasi">
  <div class="w-full bg-[#FAF9F6] text-[#15231C] min-h-screen py-8 sm:py-12">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 space-y-12 sm:space-y-16">
      
      <!-- BREADCRUMB -->
      <nav class="flex items-center space-x-2 text-[13px] text-[#756E65] font-normal" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#15231C] transition">Ana Sayfa</a>
        <span>/</span>
        <a href="/tasarimlar/" class="hover:text-[#15231C] transition">Tasarımlar</a>
        <span>/</span>
        <span class="text-[#15231C] font-semibold">Çocuk Odası</span>
      </nav>

      <!-- H1 BAŞLIK -->
      <div class="pt-2">
        <h1 class="text-3xl sm:text-5xl font-bold text-[#15231C] tracking-tight leading-tight" style="font-family: 'Roboto', sans-serif;">
          Montessori ve Su Bazlı Lake Çocuk Odası Modelleri
        </h1>
        <p class="mt-3 text-xs sm:text-sm text-[#756E65] max-w-2xl leading-relaxed">
          İzmir Buca Adatepe imalat atölyemizde miniklerin sağlığı ve güvenliği için üretilen 43 çocuk odası mobilyası. EN 71-3 oyuncak güvenlik standartlı su bazlı kokusuz boyalar, çarpmayı önleyen yuvarlak hatlar ve bağımsız hareket imkanı sunan Montessori karyolalar.
        </p>
      </div>

      <!-- KOLEKSİYON SLIDERLARI -->
      <div class="space-y-16 sm:space-y-24">
        <ModelSlider 
          name="Neşe Montessori Uyumlu Çocuk Odası Koleksiyonu"
          desc="Oyunla büyüyen, düzenle şekillenen odalar. Çocukların hayal dünyasını zenginleştiren, güvenli yuvarlatılmış köşeler ve modüler oyuncak depolama sistemleri."
          images={golfImages}
          categoryLabel="Montessori Çocuk Odası"
          priorityFirst={true}
        />

        <ModelSlider 
          name="Masal Anti-Alerjik Su Bazlı Lake Çocuk Odası"
          desc="Aura çocuk odası koleksiyonu, yalın ve neşeli tasarımıyla dikkat çekerken, çocukların değişen ihtiyaçlarına pratik ve şık çözümler sunar. Sağlığa zararsız E1 standartlarında su bazlı boyalar ve dayanıklı mekanizmalar."
          images={voloImages}
          categoryLabel="Anti-Alerjik Lake Çocuk Odası"
        />
      </div>

      <!-- DİĞER KOLEKSİYONLAR -->
      <div class="pt-12 sm:pt-16 border-t border-[#E5E2DA]">
        <h2 class="text-xl sm:text-2xl font-bold text-[#15231C] tracking-tight mb-6" style="font-family: 'Roboto', sans-serif;">
          Diğer Koleksiyonlar
        </h2>
        <div class="flex flex-wrap gap-3 sm:gap-4">
          {otherCollections.map((c) => (
            <a 
              href={c.href}
              class="px-5 py-2.5 bg-white border border-[#D0CAC0] hover:border-[#15231C] hover:bg-[#15231C] hover:text-white text-xs font-semibold text-[#15231C] transition-all select-none"
            >
              {c.name}
            </a>
          ))}
        </div>
      </div>

      <!-- DAHA FAZLA BİLGİ ALIN -->
      <div class="pt-10 sm:pt-14 pb-8 border-t border-[#E5E2DA]" id="bilgi-al">
        <div class="max-w-2xl">
          <h2 class="text-2xl sm:text-3xl font-bold text-[#15231C] tracking-tight mb-2" style="font-family: 'Roboto', sans-serif;">
            Daha Fazla Bilgi Alın
          </h2>
          <p class="text-xs sm:text-sm text-[#756E65] font-normal mb-8">
            Çocuk odası projeniz için mimari ekibimizden detaylı bilgi ve 3D tasarım teklifi alın.
          </p>

          <form action="https://wa.me/905324261788" method="GET" target="_blank" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="adsoyad" class="block text-xs font-semibold text-[#15231C] mb-1.5">Ad Soyad*</label>
                <input type="text" id="adsoyad" name="adsoyad" required placeholder="Adınız ve Soyadınız" class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] focus:outline-none focus:border-[#15231C] transition" />
              </div>
              <div>
                <label for="telefon" class="block text-xs font-semibold text-[#15231C] mb-1.5">Telefon*</label>
                <input type="tel" id="telefon" name="telefon" required placeholder="05XX XXX XX XX" class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] focus:outline-none focus:border-[#15231C] transition" />
              </div>
            </div>
            <div>
              <label for="email" class="block text-xs font-semibold text-[#15231C] mb-1.5">E-posta*</label>
              <input type="email" id="email" name="email" required placeholder="ornek@email.com" class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] focus:outline-none focus:border-[#15231C] transition" />
            </div>
            <div>
              <label for="mesaj" class="block text-xs font-semibold text-[#15231C] mb-1.5">Mesajınız</label>
              <textarea id="mesaj" name="mesaj" rows="3" placeholder="İlgilendiğiniz çocuk odası modeli veya özel istekleriniz..." class="w-full px-3.5 py-2.5 bg-white border border-[#D0CAC0] rounded-none text-xs text-[#15231C] focus:outline-none focus:border-[#15231C] transition"></textarea>
            </div>
            <div class="pt-2">
              <button type="submit" class="w-full sm:w-auto px-8 py-3 bg-[#15231C] hover:bg-[#006039] text-white text-xs font-bold uppercase tracking-wider transition-colors duration-200 select-none">
                Gönder
              </button>
            </div>
          </form>
        </div>
      </div>

    </div>
  </div>
</Layout>
