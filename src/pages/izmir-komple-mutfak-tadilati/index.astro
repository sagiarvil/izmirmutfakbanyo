---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "İzmir Komple Mutfak Tadilatı: Kırım, Tesisat & Dolap | Yeşilay",
  description: "İzmir komple mutfak tadilatı: kırım, elektrik-su tesisatı, porselen tezgah ve Buca üretimi dolap montajı. Ücretsiz 3D keşif ve sabit bütçe garantisi.",
  canonical: "https://yesilaymutfak.com/izmir-komple-mutfak-tadilati/",
  serviceName: "Komple Mutfak Tadilatı",
  breadcrumbs: [
    { name: "Ana Sayfa", url: "/" },
    { name: "Komple Mutfak Tadilatı", url: "/izmir-komple-mutfak-tadilati/" }
  ],
  faqList: [
    {
      question: "İzmir'de mutfak kırımından tesisatına komple mutfak yenileme süreci ve maliyeti nedir?",
      answer: "Komple mutfak yenileme süreci; kırım, hafriyat, elektrik-su tesisatı yenileme, seramik kaplama, dolap ve tezgah montajı dahil 12-16 iş günüdür. Maliyet seçilen kapak ve tezgah sınıfına göre şeffaf metretül ve işçilik cetveliyle belirlenir."
    },
    {
      question: "Tadilat süresince elektrik ve su tesisatında hangi markalar kullanılır?",
      answer: "Tüm boru tesisatında Fıratpen / Hakan Plastik kompozit borular, elektrik altyapısında Siemens / Schneider sigortalar ve Viko yanmaz kablolar kullanılır."
    },
    {
      question: "Tadilat sürecinde ek bütçe veya maliyet çıkar mı?",
      answer: "Kesinlikle olmaz. 1998 yılından gelen kurumsal disiplinimizle tüm kalemler noter onaylı resmi sözleşmeyle kilitlenir; tek kuruş sürpriz maliyet çıkarılmaz."
    }
  ]
};
---

<Layout seo={seo} activeService="Komple Mutfak Tadilatı">
  
  <!-- HERO BÖLÜMÜ -->
  <section class="relative bg-[#0E2017] text-white py-20 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-85" style="background-image: url('/media/real/yesilay-showroom-ic-mekan.webp');"></div>
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(10, 26, 18, 0.90), rgba(10, 26, 18, 0.48), rgba(10, 26, 18, 0.62));"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <nav class="flex items-center gap-2 text-xs font-semibold text-stone-300 uppercase tracking-widest" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Ana Sayfa</a>
        <span>/</span>
        <span class="text-emerald-400">Komple Mutfak Tadilatı</span>
      </nav>

      <span class="inline-block px-3.5 py-1.5 bg-emerald-950/80 border border-emerald-400/40 text-emerald-300 text-[11px] font-black tracking-[0.2em] uppercase shadow-lg">
        1998'DEN BUGÜNE 28 YILLIK TECRÜBE • 2.850+ TESLİM EDİLMİŞ PROJE
      </span>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight leading-[1.15]" style="font-family: 'Playfair Display', Georgia, serif;">
        İzmir Komple Mutfak Tadilatı: <br /><span class="font-normal">Tesisat, Kırım, Tezgah ve Dolap Yenileme Projeleri</span>
      </h1>

      <p class="text-sm sm:text-base text-stone-300 font-light leading-relaxed max-w-2xl">
        Kırım, moloz tahliyesi, elektrik-su tesisatı, zemin seramikleri, porselen tezgah ve özel imalat mutfak dolaplarını tek elden yönetiyoruz. Kadrolu iç mimarlarımızın hazırladığı 3D sanal simülasyon ile şantiyeye başlamadan mutfağınızı her açısıyla görün; noter onaylı sabit fiyat sözleşmesiyle sürpriz masrafsız teslim alın.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="https://wa.me/905324261788?text=Merhaba,%20komple%20mutfak%20tadilatı%20için%20ücretsiz%20keşif%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg inline-flex items-center gap-2">
          <span>💬</span> <span>WhatsApp ile 3D Keşif İste</span>
        </a>
        <a href="tel:02324411060" class="px-8 py-3.5 bg-transparent border border-stone-400 text-white text-xs font-bold uppercase tracking-widest hover:bg-white hover:text-stone-950 transition">
          📞 0232 441 10 60
        </a>
      </div>
    </div>
  </section>

  <!-- MİMARİ TADİLAT VE MALZEME CETVELİ TABLOSU -->
  <section class="bg-white border-b border-stone-200 py-16" id="teknik-standartlar">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="border-l-4 border-emerald-600 pl-4 space-y-1">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-800">ŞANTİYE VE MÜHENDİSLİK DİSİPLİNİ</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900">
          İzmir Komple Mutfak Tadilatı İş Aşamaları ve Teknik Malzeme Cetveli
        </h2>
        <p class="text-xs sm:text-sm text-stone-600 max-w-3xl leading-relaxed">
          Mutfak renovasyonunda farklı ustaların birbirini beklemesi sonucu oluşan gecikmeleri ve plansız masrafları ortadan kaldırıyoruz. Kırımdan temizlik aşamasına kadar 12-16 iş gününde tamamlanan iş takvimimiz:
        </p>
      </div>

      <div class="overflow-x-auto border border-stone-200 rounded-xl shadow-xs">
        <table class="w-full text-left border-collapse text-xs sm:text-sm">
          <thead>
            <tr class="bg-stone-900 text-white">
              <th class="p-3 sm:p-4 font-bold border-b border-stone-800">İşlem Aşaması</th>
              <th class="p-3 sm:p-4 font-bold border-b border-stone-800">Uygulanan Teknik & Malzeme</th>
              <th class="p-3 sm:p-4 font-bold border-b border-stone-800">Kalite ve Dayanım Standardı</th>
              <th class="p-3 sm:p-4 font-bold border-b border-stone-800">Uygulama Süresi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-200 text-stone-700 bg-white">
            <tr class="hover:bg-stone-50 transition">
              <td class="p-3 sm:p-4 font-semibold text-stone-900">1. Kırım ve Moloz Tahliyesi</td>
              <td class="p-3 sm:p-4">Mevcut dolap, fayans, şap ve tezgahın tozsuz kırım makineleriyle sökümü, çuvallanarak lisanslı döküm sahasına nakliyesi.</td>
              <td class="p-3 sm:p-4">Bina ortak alanlarının koruyucu naylon ve mukavva ile muhafaza altına alınması.</td>
              <td class="p-3 sm:p-4 font-medium text-emerald-800">1 - 2 İş Günü</td>
            </tr>
            <tr class="hover:bg-stone-50 transition">
              <td class="p-3 sm:p-4 font-semibold text-stone-900">2. Sıhhi ve Elektrik Altyapısı</td>
              <td class="p-3 sm:p-4">Fıratpen kompozit temiz/pis su hatları, Siemens/Schneider bağımsız sigorta panosu, yanmaz halojensiz bakır kablolama.</td>
              <td class="p-3 sm:p-4">Bulaşık makinesi, fırın, mikrodalga ve ada prizleri için ayrı linye ve 10 bar basınç sızdırmazlık testi.</td>
              <td class="p-3 sm:p-4 font-medium text-emerald-800">2 - 3 İş Günü</td>
            </tr>
            <tr class="hover:bg-stone-50 transition">
              <td class="p-3 sm:p-4 font-semibold text-stone-900">3. Sıva, Alçı ve Zemin İzolasyonu</td>
              <td class="p-3 sm:p-4">Kaba sıva tamiratları, fileli saten alçı duvar tesviyesi, çimento esaslı çift komponentli su yalıtım membranı.</td>
              <td class="p-3 sm:p-4">Lazer terazi ile 90 derece gönye kontrolü (köşe mutfak dolabı montajında sıfır boşluk için zorunludur).</td>
              <td class="p-3 sm:p-4 font-medium text-emerald-800">2 - 3 İş Günü</td>
            </tr>
            <tr class="hover:bg-stone-50 transition">
              <td class="p-3 sm:p-4 font-semibold text-stone-900">4. Seramik ve Zemin Kaplama</td>
              <td class="p-3 sm:p-4">60x120 cm rektifiyeli porselen seramik veya suya dayanıklı 32. sınıf derzli laminat parke döşemesi.</td>
              <td class="p-3 sm:p-4">Epoksi derz dolgusu ile leke, küf ve kimyasal deterjan aşınmalarına karşı %100 tam sızdırmazlık.</td>
              <td class="p-3 sm:p-4 font-medium text-emerald-800">2 İş Günü</td>
            </tr>
            <tr class="hover:bg-stone-50 transition">
              <td class="p-3 sm:p-4 font-semibold text-stone-900">5. Özel Dolap ve Ray İmalatı</td>
              <td class="p-3 sm:p-4">Buca atölyemizde üretilen E1 neme dayanıklı MDF gövde, İtalyan akrilik veya CNC lake kapaklar, Blum raylar.</td>
              <td class="p-3 sm:p-4">Blum Clip-Top BLUMOTION frenli menteşeler ve Legrabox çekmeceler (200.000 açma-kapama garantisi).</td>
              <td class="p-3 sm:p-4 font-medium text-emerald-800">2 İş Günü</td>
            </tr>
            <tr class="hover:bg-stone-50 transition">
              <td class="p-3 sm:p-4 font-semibold text-stone-900">6. Tezgah, Lavabo ve Son Montaj</td>
              <td class="p-3 sm:p-4">Lamar / Dekton porselen veya Belenco / Çimstone kuvars tezgah kesimi, tezgaha sıfır evye montajı ve LED aydınlatma.</td>
              <td class="p-3 sm:p-4">Lazer şablon ile CNC tezgah kesimi, anti-bakteriyel nötr silikon fitil uygulaması ve test teslimi.</td>
              <td class="p-3 sm:p-4 font-medium text-emerald-800">1 - 2 İş Günü</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 4 SÜTUN GÜVEN ŞERİDİ -->
  <section class="bg-[#121212] text-white border-b border-stone-800 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex items-start gap-4">
          <span class="text-3xl text-emerald-400 font-editorial shrink-0">1998</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">28 Yıllık Güven</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">2.850+ teslim edilmiş konut mutfak tadilatı referansı.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">🏛️</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Tek Muhatap Mimar</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Usta karmaşasına son; tüm şantiye kadrolu mimarımız yönetiminde.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">✨</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">3D Sanal Mekan Deneyimi</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Sürprizsiz sonuç için üretime girmeden fotogerçekçi canlandırma.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📍</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Buca Mağaza &amp; 30 İlçe</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Atölyemizden tüm İzmir geneline yerinde ücretsiz keşif.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GERÇEK ATÖLYE & SHOWROOM VİTRİNİ -->
  <section class="py-20 bg-white border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      <div class="max-w-3xl space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">GERÇEK İMALAT VE TEŞHİR KANITI</span>
        <h2 class="text-2xl sm:text-4xl font-light text-stone-950 font-editorial">
          Komple Mutfak Renovasyonunda Gerçek Atölye Güvencesi
        </h2>
        <p class="text-sm text-stone-600 font-light leading-relaxed">
          Kırım ve tesisattan lake dolap imalatına, porselen tezgahtan montaja kadar tek muhatap garantisi sunuyoruz. Dilerseniz <a href="/izmir-mutfak-dolabi-imalati/" class="text-emerald-700 font-semibold underline underline-offset-4">özel imalat dolap modellerimizi</a> veya <a href="/2026-mutfak-dolabi-fiyatlari/" class="text-emerald-700 font-semibold underline underline-offset-4">2026 mutfak dolabı fiyat cetvelimizi</a> inceleyebilir, banyonuz için <a href="/izmir-banyo-yenileme-seramik/" class="text-emerald-700 font-semibold underline underline-offset-4">banyo tadilatı çözümlerimize</a> göz atabilirsiniz.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="group bg-[#FAF9F6] border border-stone-200 overflow-hidden rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="aspect-[4/3] overflow-hidden bg-stone-900 relative">
            <img src="/media/real/yesilay-showroom-gece-cephe.webp" alt="Yeşilay Mutfak Showroom Buca Dış Cephe Görünümü" width="1672" height="941" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
            <span class="absolute top-3 left-3 px-3 py-1 bg-emerald-600 text-white text-[10px] font-bold uppercase tracking-wider rounded">AMİRAL SHOWROOM</span>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="text-base font-bold text-stone-900 group-hover:text-emerald-700 transition">Buca Gaziler Showroom</h3>
            <p class="text-xs text-stone-600 leading-relaxed">Yeni nesil ada mutfak modellerini ve kapak seçeneklerini canlı görün.</p>
          </div>
        </div>

        <div class="group bg-[#FAF9F6] border border-stone-200 overflow-hidden rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="aspect-[4/3] overflow-hidden bg-stone-900 relative">
            <img src="/media/real/yesilay-aluminyum-fluted-cam-kapak-square.webp" alt="Alüminyum Profil ve Fluted Cam Kapak Donanımları" width="800" height="800" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
            <span class="absolute top-3 left-3 px-3 py-1 bg-stone-900 text-emerald-400 border border-emerald-500/30 text-[10px] font-bold uppercase tracking-wider rounded">İTALYAN DONANIM</span>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="text-base font-bold text-stone-900 group-hover:text-emerald-700 transition">Fluted Cam & Çerçeve Profiller</h3>
            <p class="text-xs text-stone-600 leading-relaxed">Buhara ve çizilmeye dayanıklı modern cam kiler dolap sistemleri.</p>
          </div>
        </div>

        <div class="group bg-[#FAF9F6] border border-stone-200 overflow-hidden rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="aspect-[4/3] overflow-hidden bg-stone-900 relative">
            <img src="/media/real/yesilay-mimari-danismanlik-toplanti-wide.webp" alt="İç Mimar Eşliğinde Mutfak Tasarım ve Projelendirme Toplantısı" width="1200" height="675" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
            <span class="absolute top-3 left-3 px-3 py-1 bg-emerald-700 text-white text-[10px] font-bold uppercase tracking-wider rounded">BİREBİR REHBERLİK</span>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="text-base font-bold text-stone-900 group-hover:text-emerald-700 transition">3D Projelendirme & Sabit Fiyat</h3>
            <p class="text-xs text-stone-600 leading-relaxed">Lazer rölöve sonrası noter onaylı sözleşmeyle sürpriz masrafsız teslim.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS BÖLÜMÜ -->
  <section class="py-20 sm:py-24 bg-stone-50 border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">MERAK EDİLENLER</span>
        <h2 class="text-2xl sm:text-3xl font-light text-stone-950 font-editorial">Komple Mutfak Tadilatı Hakkında Sorularınız</h2>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="bg-white border border-stone-200 p-6 space-y-2 shadow-2xs">
            <h3 class="font-bold text-sm text-stone-900">{faq.question}</h3>
            <p class="text-xs text-stone-600 font-light leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ÇAĞRI BÖLÜMÜ -->
  <section class="py-16 bg-stone-900 text-white text-center">
    <div class="max-w-3xl mx-auto px-4 space-y-6">
      <h2 class="text-2xl sm:text-3xl font-light font-editorial">Mutfağınızı Yenilemek İçin Ücretsiz Keşif Randevusu Alın</h2>
      <p class="text-xs sm:text-sm text-stone-300 font-light">
        İletişime geçin veya WhatsApp üzerinden randevu oluşturun; iç mimarımız adresinizde ücretsiz lazer keşif yapsın. Daha önce teslim ettiğimiz işleri görmek için <a href="/yapilan-isler/" class="text-emerald-400 underline underline-offset-4">referans projelerimizi</a> inceleyin.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a href="https://wa.me/905324261788?text=Merhaba,%20komple%20mutfak%20tadilatı%20için%20ücretsiz%20keşif%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg">
          💬 WhatsApp ile Keşif İste (0532 426 17 88)
        </a>
      </div>
    </div>
  </section>

</Layout>
