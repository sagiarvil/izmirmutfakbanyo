---
import { siteConfig } from "../data/siteConfig";

export interface Props {
  pageTitle?: string;
  canonicalUrl: string;
}

const { pageTitle = "Yeşilay Mutfak", canonicalUrl } = Astro.props;
const cleanTitle = (pageTitle || "Yeşilay Mutfak").split("|")[0].trim();
const waMessage = encodeURIComponent(
  `Merhaba, ${canonicalUrl} (${cleanTitle}) sayfası üzerinden 3D keşif ve atölye teklifi almak istiyorum.`
);
const waHref = `https://wa.me/905324261788?text=${waMessage}`;
---

<section class="bg-[#FAF9F6] border-t border-[#E5DFD5] py-12 px-4 sm:px-8" aria-label="Atölye Hesaplama, Doğrulama ve Kaynak Merkezi">
  <div class="max-w-7xl mx-auto space-y-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[#E5DFD5] pb-4">
      <div class="space-y-1">
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-[#006039]">
          1998'DEN BUGÜNE BUCA ADATEPE İMALAT ATÖLYESİ
        </p>
        <p class="text-xs text-[#6E675F]">
          Son teknik doğrulama: <time datetime="2026-11-26" class="font-semibold text-[#1D1D1F]">26 Kasım 2026</time> &bull; Sorumlu: Cem Yeşilay (Kurucu Ortak &amp; Üretim Direktörü)
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a
          data-cro-cta="true"
          data-conversion-event="whatsapp_lead"
          href={waHref}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class="px-5 py-2.5 bg-[#006039] hover:bg-[#00482B] text-white text-xs font-bold uppercase tracking-wider rounded-lg transition shadow-sm"
        >
          {cleanTitle} İçin 3D Teklif Al
        </a>
        <a
          data-conversion-event="phone_call"
          href={`tel:${siteConfig.phoneE164}`}
          class="px-4 py-2.5 bg-white border border-[#D2D2D7] hover:border-[#006039] text-[#1D1D1F] text-xs font-bold rounded-lg transition"
        >
          {siteConfig.phoneFormatted}
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
      <!-- G069 & G073: Chrome WebMCP + NavBoost İnteraktif Hesaplayıcı -->
      <div data-seo-interactive="true" class="bg-white border border-[#E5DFD5] rounded-xl p-6 shadow-xs space-y-4">
        <div class="space-y-1">
          <span class="text-[10px] font-bold uppercase tracking-widest text-[#C5A880]">İNTERAKTİF ATÖLYE HESAPLAYICI</span>
          <p class="text-base font-bold text-[#1D1D1F]">2026 Metretül &amp; Malzeme Bütçe Hesaplama Aracı</p>
          <p class="text-xs text-[#6E675F]">Tezgah ve dolap uzunluğunuzu seçerek Buca atölye imalat aralığını anında hesaplayın.</p>
        </div>

        <form
          toolname="calculateKitchenEstimate"
          tooldescription="Girilen mutfak metretülü ve kapak malzemesi segmentine göre 2026 İzmir atölye imalat bütçe aralığını hesaplar"
          data-conversion-event="calculator_use"
          class="grid grid-cols-1 sm:grid-cols-3 gap-3 items-end"
          onsubmit="event.preventDefault(); var f=this; var m=parseFloat(f.meters.value)||4; var r=parseFloat(f.segment.value)||18500; var min=Math.round(m*r*0.92); var max=Math.round(m*r*1.12); f.querySelector('[data-calc-out]').textContent = min.toLocaleString('tr-TR') + ' TL - ' + max.toLocaleString('tr-TR') + ' TL';"
        >
          <label class="block text-xs font-semibold text-[#1D1D1F]">
            Uzunluk (Metretül)
            <input type="number" name="meters" min="2" max="20" step="0.5" value="4.5" class="mt-1 w-full px-3 py-2 border border-[#D2D2D7] rounded-lg text-xs bg-[#FAF9F6]" />
          </label>
          <label class="block text-xs font-semibold text-[#1D1D1F]">
            Kapak Segmenti
            <select name="segment" class="mt-1 w-full px-3 py-2 border border-[#D2D2D7] rounded-lg text-xs bg-[#FAF9F6]">
              <option value="13500">E1 MDF-Lam (13.500 TL/mt)</option>
              <option value="18500" selected>UV Akrilik (18.500 TL/mt)</option>
              <option value="26500">İpek Mat Lake (26.500 TL/mt)</option>
            </select>
          </label>
          <button type="submit" class="px-4 py-2.5 bg-[#15231C] hover:bg-[#006039] text-white text-xs font-bold rounded-lg transition cursor-pointer">
            Tahmini Hesapla
          </button>
          <div class="sm:col-span-3 pt-2 text-xs text-[#1D1D1F] bg-[#F5F5F7] px-3 py-2 rounded-lg flex items-center justify-between">
            <span>Tahmini Atölye İmalat Aralığı:</span>
            <strong data-calc-out class="text-[#006039] font-bold">76.590 TL - 93.240 TL</strong>
          </div>
        </form>
      </div>

      <!-- G074: Pasif Doğal Backlink & Kaynak Gösterme Mıknatısı -->
      <aside data-backlink-magnet="true" class="bg-white border border-[#E5DFD5] rounded-xl p-6 shadow-xs space-y-3">
        <span class="text-[10px] font-bold uppercase tracking-widest text-[#C5A880] block">KAYNAK GÖSTER &amp; PAYLAŞ</span>
        <p class="text-xs text-[#6E675F] leading-relaxed">
          Bu teknik veri rehberini ve 2026 İzmir atölye standartlarını makalenizde veya projenizde kaynak göstererek paylaşabilirsiniz:
        </p>
        <div class="p-3 bg-[#F5F5F7] border border-[#D2D2D7] rounded-lg text-[11px] font-mono text-[#1D1D1F] break-all">
          Kaynak: <a href={canonicalUrl} class="text-[#006039] underline font-semibold">{siteConfig.name} — {cleanTitle}</a>
        </div>
      </aside>
    </div>
  </div>
</section>
