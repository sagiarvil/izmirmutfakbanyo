---
import { siteConfig } from '../data/siteConfig';

export interface Props {
  activeService?: string;
}

const { activeService } = Astro.props;
---

<!-- ===================================================================== -->
<!-- LOCUS BİREBİR HEADER (Masaüstü: 80px, Mobil: 70px, Fixed, 1200px Max) -->
<!-- Renkler: rgb(116, 113, 108) linkler, rgb(36, 36, 36) İletişim bold   -->
<!-- Kenarlık: 0.5px solid rgb(133, 133, 133)                              -->
<!-- ===================================================================== -->
<header 
  class="fixed top-0 left-0 right-0 z-50 w-full bg-white transition-all duration-200"
  style="border-bottom: 0.5px solid rgb(133, 133, 133);"
  id="siteHeader"
  x-data="{ mobileOpen: false }"
  @keydown.escape="mobileOpen = false"
>
  <div class="w-full max-w-[1200px] h-[70px] lg:h-[80px] mx-auto px-5 lg:px-[30px] flex items-center justify-between lg:justify-start gap-2.5 relative">
    
    <!-- SOL: LOGO (LOCUS BİREBİR BOYUT: 100x60px, Mobilde: 82px) -->
    <a 
      href="/" 
      class="flex flex-col justify-center select-none group w-[82px] lg:w-[100px] h-[60px] flex-none"
      aria-label="Yeşilay Mutfak Ana Sayfa"
    >
      <span 
        class="font-roboto text-[16px] lg:text-[18px] tracking-[0.16em] uppercase text-[#111111] font-bold leading-none"
      >
        YEŞİLAY
      </span>
      <span 
        class="font-roboto text-[10px] lg:text-[11px] tracking-[0.24em] uppercase text-[rgb(116,113,108)] font-normal leading-none mt-1"
      >
        MUTFAK
      </span>
    </a>

    <!-- ORTA / SAĞ: ANA MENÜ (LOCUS BİREBİR FONT, ÖLÇÜ VE RENKLER) -->
    <nav 
      class="hidden md:flex items-center gap-[28px] lg:gap-[38px] pl-[20px] lg:pl-[30px] flex-1 font-roboto"
      aria-label="Ana menü"
    >
      <a 
        href="/tasarimlar/" 
        class="text-[13px] leading-none uppercase tracking-normal transition-colors"
        style="color: rgb(116, 113, 108); font-family: 'Roboto', sans-serif;"
        onmouseover="this.style.color='rgb(36, 36, 36)'"
        onmouseout="this.style.color='rgb(116, 113, 108)'"
      >
        MUTFAK
      </a>
      <a 
        href="/salon-modelleri/" 
        class="text-[13px] leading-none uppercase tracking-normal transition-colors"
        style="color: rgb(116, 113, 108); font-family: 'Roboto', sans-serif;"
        onmouseover="this.style.color='rgb(36, 36, 36)'"
        onmouseout="this.style.color='rgb(116, 113, 108)'"
      >
        MOBİLYA
      </a>
      <a 
        href="/hazir-mutfak/" 
        class="text-[13px] leading-none uppercase tracking-normal transition-colors"
        style="color: rgb(116, 113, 108); font-family: 'Roboto', sans-serif;"
        onmouseover="this.style.color='rgb(36, 36, 36)'"
        onmouseout="this.style.color='rgb(116, 113, 108)'"
      >
        TAMAMLAYICI ÜRÜNLER
      </a>
      <a 
        href="/izmir-komple-mutfak-tadilati/" 
        class="text-[13px] leading-none uppercase tracking-normal transition-colors"
        style="color: rgb(116, 113, 108); font-family: 'Roboto', sans-serif;"
        onmouseover="this.style.color='rgb(36, 36, 36)'"
        onmouseout="this.style.color='rgb(116, 113, 108)'"
      >
        CİHAZ
      </a>
      <a 
        href="/hakkimizda/" 
        class="text-[13px] leading-none uppercase tracking-normal transition-colors"
        style="color: rgb(116, 113, 108); font-family: 'Roboto', sans-serif;"
        onmouseover="this.style.color='rgb(36, 36, 36)'"
        onmouseout="this.style.color='rgb(116, 113, 108)'"
      >
        KURUMSAL
      </a>

      <!-- SAĞ GRUP (İLETİŞİM BOLD + 4 İKON - LOCUS framer-18odg87 BİREBİR) -->
      <div class="ml-auto flex items-center gap-[10px]">
        <a 
          href="/iletisim/" 
          class="text-[13px] font-bold leading-none uppercase tracking-normal text-[rgb(36,36,36)] hover:text-black transition-colors mr-3"
          style="font-family: 'Roboto', sans-serif;"
        >
          İLETİŞİM
        </a>

        <!-- Harita İkonu (framer-1ma8swo: 21x24px) -->
        <a 
          href="/iletisim/" 
          class="w-[21px] h-[24px] flex items-center justify-center text-[rgb(51,51,51)] hover:text-black transition-colors"
          aria-label="Konum ve Harita"
        >
          <svg width="20" height="20" viewBox="0 0 256 256" fill="currentColor">
            <path d="M128,64a40,40,0,1,0,40,40A40,40,0,0,0,128,64Zm0,64a24,24,0,1,1,24-24A24,24,0,0,1,128,128Zm0-112a88.1,88.1,0,0,0-88,88c0,31.4,14.51,64.68,42,96.25a254.19,254.19,0,0,0,41.45,38.3,8,8,0,0,0,9.18,0A254.19,254.19,0,0,0,174,204.25c27.45-31.57,42-64.85,42-96.25A88.1,88.1,0,0,0,128,16Zm0,206c-16.53-13-72-60.75-72-118a72,72,0,0,1,144,0C200,161.23,144.53,209,128,222Z"></path>
          </svg>
        </a>

        <!-- E-posta İkonu (framer-19f35xi: 27x24px) -->
        <a 
          href="mailto:bilgi@yesilaymutfak.com" 
          class="w-[27px] h-[24px] flex items-center justify-center text-[rgb(51,51,51)] hover:text-black transition-colors"
          aria-label="E-posta Gönder"
        >
          <svg width="22" height="20" viewBox="0 0 256 256" fill="currentColor">
            <path d="M224,48H32a8,8,0,0,0-8,8V192a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A8,8,0,0,0,224,48ZM208,192H48V64H208V192Zm-80-50.69L68.8,92.53a8,8,0,0,1,10.4-12.16L128,119.53l48.8-39.16a8,8,0,0,1,10.4,12.16Z"></path>
          </svg>
        </a>

        <!-- Katalog İkonu (framer-rhul9e: 31x24px) -->
        <a 
          href="/kataloglar/" 
          class="w-[31px] h-[24px] flex items-center justify-center text-[rgb(51,51,51)] hover:text-black transition-colors"
          aria-label="Kataloglar"
        >
          <svg width="22" height="20" viewBox="0 0 256 256" fill="currentColor">
            <path d="M216,40H72A40,40,0,0,0,32,80V200a40,40,0,0,0,40,40H216a8,8,0,0,0,8-8V48A8,8,0,0,0,216,40ZM72,56H208V184H72a23.86,23.86,0,0,1-13.84,4.41A23.82,23.82,0,0,1,48,185.09V80A24,24,0,0,1,72,56Zm136,168H72a24.11,24.11,0,0,0-20.73,11.83A39.69,39.69,0,0,0,72,224H208Z"></path>
          </svg>
        </a>

        <!-- Arama İkonu (framer-359z46: 24x24px) -->
        <a 
          href="/tasarimlar/" 
          class="w-[24px] h-[24px] flex items-center justify-center text-[rgb(51,51,51)] hover:text-black transition-colors"
          aria-label="Arama"
        >
          <svg width="20" height="20" viewBox="0 0 256 256" fill="currentColor">
            <path d="M232.49,215.51,185,168a92.12,92.12,0,1,0-17,17l47.53,47.54a12,12,0,0,0,17-17ZM44,112a68,68,0,1,1,68,68A68.07,68.07,0,0,1,44,112Z"></path>
          </svg>
        </a>
      </div>

    </nav>

    <!-- MOBİL HAMBURGER BUTONU (Locus framer-1qqtfod BİREBİR) -->
    <button 
      type="button"
      class="md:hidden w-[44px] h-[44px] flex flex-col justify-center items-center gap-[5px] text-[rgb(97,97,97)] focus:outline-none"
      @click="mobileOpen = !mobileOpen"
      aria-label="Menüyü Aç/Kapat"
      :aria-expanded="mobileOpen"
    >
      <span class="w-5 h-[1.5px] bg-[rgb(97,97,97)] rounded-full transition-transform duration-200" :class="mobileOpen ? 'rotate-45 translate-y-[6.5px]' : ''"></span>
      <span class="w-5 h-[1.5px] bg-[rgb(97,97,97)] rounded-full transition-opacity duration-200" :class="mobileOpen ? 'opacity-0' : ''"></span>
      <span class="w-5 h-[1.5px] bg-[rgb(97,97,97)] rounded-full transition-transform duration-200" :class="mobileOpen ? '-rotate-45 -translate-y-[6.5px]' : ''"></span>
    </button>

  </div>

  <!-- MOBİL MENÜ ÇEKMECESİ -->
  <div 
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-2"
    class="md:hidden bg-white border-b border-[rgb(133,133,133)] px-6 py-8 shadow-xl"
    style="display: none;"
  >
    <nav class="flex flex-col space-y-5 font-roboto text-[13px] tracking-normal uppercase">
      <a href="/tasarimlar/" class="text-[rgb(116,113,108)] hover:text-black pb-2 border-b border-[#f3efe8]">
        MUTFAK
      </a>
      <a href="/salon-modelleri/" class="text-[rgb(116,113,108)] hover:text-black pb-2 border-b border-[#f3efe8]">
        MOBİLYA
      </a>
      <a href="/hazir-mutfak/" class="text-[rgb(116,113,108)] hover:text-black pb-2 border-b border-[#f3efe8]">
        TAMAMLAYICI ÜRÜNLER
      </a>
      <a href="/izmir-komple-mutfak-tadilati/" class="text-[rgb(116,113,108)] hover:text-black pb-2 border-b border-[#f3efe8]">
        CİHAZ
      </a>
      <a href="/hakkimizda/" class="text-[rgb(116,113,108)] hover:text-black pb-2 border-b border-[#f3efe8]">
        KURUMSAL
      </a>
      <a href="/iletisim/" class="text-[rgb(36,36,36)] font-bold pb-2 border-b border-[#f3efe8]">
        İLETİŞİM
      </a>
    </nav>
    <div class="mt-6 pt-4 border-t border-[#ede9e6] flex flex-col gap-3">
      <a 
        href="tel:+902324411060" 
        class="text-[13px] font-roboto font-medium text-[rgb(36,36,36)] flex items-center justify-center gap-2"
      >
        <span>📞</span> 0 (232) 441 10 60
      </a>
    </div>
  </div>
</header>

<!-- NAV_SPACE: Fixed Header Arkasında Kalan 80px / 70px Boşluk (Locus framer-16rri12 Birebir) -->
<div class="w-full h-[70px] lg:h-[80px] flex-none" aria-hidden="true"></div>
