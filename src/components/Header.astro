---
import { siteConfig } from "../data/siteConfig";

export interface Props {
  activeService?: string;
}

const { activeService } = Astro.props;
---

<!-- ===================================================================== -->
<!-- LOCUS TARZI MİMARİ MİNİMALİST HEADER (80px Masaüstü / 70px Mobil)     -->
<!-- Renk: #111111 | Harf Aralığı: 0.08em | Font: Roboto & Inter           -->
<!-- ===================================================================== -->
<header 
  class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md border-b border-[#ede9e6] transition-all duration-200"
  id="siteHeader"
  x-data="{ mobileOpen: false }"
  @keydown.escape="mobileOpen = false"
>
  <div class="w-full max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16 h-[70px] lg:h-[80px] flex items-center justify-between">
    
    <!-- SOL: LOGO (MİNİMALİST İTALYAN MİMARLIK TİPOGRAFİSİ) -->
    <a 
      href="/" 
      class="flex items-center gap-2 text-[#111111] hover:text-[#575757] transition-colors select-none"
      aria-label="Yeşilay Mutfak Ana Sayfa"
    >
      <span class="font-roboto font-medium text-[16px] sm:text-[18px] tracking-[0.16em] uppercase text-[#111111]">
        YEŞİLAY
      </span>
      <span class="w-[1px] h-3.5 bg-[#d5d5d5]"></span>
      <span class="font-roboto font-normal text-[11px] sm:text-[12px] tracking-[0.12em] uppercase text-[#777777]">
        MUTFAK
      </span>
    </a>

    <!-- ORTA / SAĞ: MENÜ LİNKLERİ (LOCUS BİREBİR STRÜKTÜRÜ) -->
    <nav 
      class="hidden md:flex items-center gap-8 lg:gap-11 text-[12.5px] lg:text-[13px] font-roboto font-medium tracking-[0.08em] uppercase text-[#111111]"
      aria-label="Masaüstü Menü"
    >
      <a href="/tasarimlar/" class="hover:text-[#777777] transition-colors py-2">
        MUTFAK
      </a>
      <a href="/salon-modelleri/" class="hover:text-[#777777] transition-colors py-2">
        MOBİLYA
      </a>
      <a href="/hazir-mutfak/" class="hover:text-[#777777] transition-colors py-2">
        TAMAMLAYICI ÜRÜNLER
      </a>
      <a href="/izmir-komple-mutfak-tadilati/" class="hover:text-[#777777] transition-colors py-2">
        CİHAZ
      </a>
      <a href="/hakkimizda/" class="hover:text-[#777777] transition-colors py-2">
        KURUMSAL
      </a>
      <a href="/iletisim/" class="hover:text-[#777777] transition-colors py-2">
        İLETİŞİM
      </a>
    </nav>

    <!-- SAĞ: HIZLI TELEFON / MAĞAZA (MİNİMAL BUTON) -->
    <div class="hidden lg:flex items-center gap-6">
      <a 
        href="tel:+902324411060" 
        class="text-[12px] font-roboto font-medium tracking-[0.06em] text-[#575757] hover:text-[#111111] transition-colors"
      >
        0 (232) 441 10 60
      </a>
      <a 
        href="/iletisim/" 
        class="h-[38px] px-5 border border-[#111111] text-[11px] font-roboto font-medium tracking-[0.1em] uppercase text-[#111111] hover:bg-[#111111] hover:text-white transition-all flex items-center justify-center"
      >
        RANDEVU AL
      </a>
    </div>

    <!-- MOBİL HAMBURGER BUTONU -->
    <button 
      type="button"
      class="md:hidden p-2 text-[#111111] hover:text-[#575757] focus:outline-none"
      @click="mobileOpen = !mobileOpen"
      aria-label="Menüyü Aç/Kapat"
      :aria-expanded="mobileOpen"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path x-show="!mobileOpen" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7h16M4 12h16M4 17h16"/>
        <path x-show="mobileOpen" style="display: none;" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

  </div>

  <!-- MOBİL MENÜ ÇEKMECESİ -->
  <div 
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-2"
    class="md:hidden bg-white border-b border-[#ede9e6] px-6 py-8 shadow-xl"
    style="display: none;"
  >
    <nav class="flex flex-col space-y-6 text-[14px] font-roboto font-medium tracking-[0.1em] uppercase text-[#111111]">
      <a href="/tasarimlar/" class="hover:text-[#575757] transition-colors pb-2 border-b border-[#f3efe8]">
        MUTFAK
      </a>
      <a href="/salon-modelleri/" class="hover:text-[#575757] transition-colors pb-2 border-b border-[#f3efe8]">
        MOBİLYA
      </a>
      <a href="/hazir-mutfak/" class="hover:text-[#575757] transition-colors pb-2 border-b border-[#f3efe8]">
        TAMAMLAYICI ÜRÜNLER
      </a>
      <a href="/izmir-komple-mutfak-tadilati/" class="hover:text-[#575757] transition-colors pb-2 border-b border-[#f3efe8]">
        CİHAZ
      </a>
      <a href="/hakkimizda/" class="hover:text-[#575757] transition-colors pb-2 border-b border-[#f3efe8]">
        KURUMSAL
      </a>
      <a href="/iletisim/" class="hover:text-[#575757] transition-colors pb-2 border-b border-[#f3efe8]">
        İLETİŞİM
      </a>
    </nav>
    <div class="mt-8 pt-6 border-t border-[#ede9e6] flex flex-col gap-4">
      <a 
        href="tel:+902324411060" 
        class="text-[13px] font-roboto font-medium text-[#575757] flex items-center justify-center gap-2"
      >
        <span>📞</span> 0 (232) 441 10 60
      </a>
      <a 
        href="/iletisim/" 
        class="w-full h-[45px] border border-[#111111] text-[12px] font-roboto font-medium tracking-[0.1em] uppercase text-[#111111] flex items-center justify-center hover:bg-[#111111] hover:text-white transition-all"
      >
        RANDEVU AL
      </a>
    </div>
  </div>
</header>
