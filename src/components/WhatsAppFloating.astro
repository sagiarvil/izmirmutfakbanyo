---
import { siteConfig } from '../data/siteConfig';

export interface Props {
  service?: string;
}

const { service } = Astro.props;

let dynamicWaText = "Merhaba, Yeşilay Mutfak'tan keşif ve teklif almak istiyorum.";
if (service) {
  const norm = service.toLowerCase();
  if (norm.includes('hazır mutfak') || norm.includes('modüler')) {
    dynamicWaText = 'Merhaba, hazır mutfak modelleriniz ve teslim seçenekleriniz hakkında bilgi almak istiyorum.';
  } else if (norm.includes('mutfak dolabı') || norm.includes('komple mutfak') || norm.includes('mutfak')) {
    dynamicWaText = 'Merhaba, mutfak dolabı veya komple mutfak tadilatı için teklif almak istiyorum.';
  } else if (norm.includes('banyo')) {
    dynamicWaText = 'Merhaba, banyo yenileme için keşif ve teklif almak istiyorum.';
  } else if (norm.includes('ev tadilatı') || norm.includes('anahtar teslim') || norm.includes('daire')) {
    dynamicWaText = 'Merhaba, komple ev tadilatı için keşif görüşmesi istiyorum.';
  } else if (norm.includes('ticari') || norm.includes('projelendirme') || norm.includes('ofis') || norm.includes('fit-out')) {
    dynamicWaText = 'Merhaba, iş yerim için mimari proje ve uygulama teklifi almak istiyorum.';
  }
}

const waUrl = `${siteConfig.whatsappUrl}?text=${encodeURIComponent(dynamicWaText)}`;
---

<!-- ===================================================================== -->
<!-- WHATSAPP FLOATING BUTTON (Locus Birebir: Koyu Gri Daire + Beyaz İkon + Kırmızı Nokta) -->
<!-- ===================================================================== -->
<div class="fixed bottom-6 right-5 sm:right-7 z-50 flex items-center justify-center select-none" aria-label="WhatsApp İletişim">
  <a 
    id="sm-cb-link" 
    href={waUrl} 
    target="_blank" 
    rel="noopener noreferrer" 
    class="relative block rounded-full shadow-[0_4px_18px_rgba(0,0,0,0.28)] hover:opacity-90 transition-transform duration-200 hover:scale-105 active:scale-95" 
    style="width: 50px; height: 50px; background-color: rgb(84, 84, 84);"
    aria-label="WhatsApp ile İletişime Geçin"
    data-track="contact_start"
    data-category="whatsapp_floating"
  >
    <svg width="50" height="50" viewBox="0 0 50 50" class="block w-[50px] h-[50px]">
      <g>
        <circle cx="25" cy="25" r="25" style="fill: rgb(84, 84, 84);"></circle>
        <path d="M39.8,23.4A14.64,14.64,0,0,1,25.1,38,15.25,15.25,0,0,1,18,36.2L9.8,38.8,12.5,31a14.84,14.84,0,0,1-2.1-7.5,14.7,14.7,0,0,1,29.4-.1ZM25.1,11.2A12.38,12.38,0,0,0,12.7,23.5a12,12,0,0,0,2.4,7.2l-1.5,4.6,4.8-1.5A12.44,12.44,0,0,0,37.6,23.5,12.53,12.53,0,0,0,25.1,11.2Zm7.4,15.6a3.22,3.22,0,0,0-.7-.4l-2.5-1.2c-.3-.1-.6-.2-.8.2a8.54,8.54,0,0,1-1.1,1.4.59.59,0,0,1-.8.1,11,11,0,0,1-2.9-1.8,9.88,9.88,0,0,1-2-2.5.46.46,0,0,1,.2-.7,2.65,2.65,0,0,0,.5-.6c.2-.2.2-.4.4-.6a.64.64,0,0,0,0-.6c-.1-.2-.8-1.9-1.1-2.7s-.6-.6-.8-.6h-.7a1.85,1.85,0,0,0-1,.4,4.16,4.16,0,0,0-1.3,3,6.45,6.45,0,0,0,1.5,3.7c.2.2,2.5,4,6.2,5.4s3.7,1,4.3.9a3.74,3.74,0,0,0,2.4-1.7A2.82,2.82,0,0,0,32.5,26.8Z" style="fill: rgb(255, 255, 255);"></path>
      </g>
    </svg>
    <div class="sm-red-dot" style="position: absolute; right: 4px; top: 4px; background: rgba(255,0,0,.85); width: 8px; height: 8px; border-radius: 50%;"></div>
  </a>
</div>
