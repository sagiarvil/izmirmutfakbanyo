---
import { siteConfig } from "../data/siteConfig";

const currentYear = new Date().getFullYear();
---

<!-- BÖLÜM: KURUMSAL ŞEFFAFLIK & DOĞRULAMA (FOOTER ÜSTÜ) -->
<section class="bg-[#F4F1EA] text-[#6E675F] py-10 border-t border-[#E5DFD5] text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[#E5DFD5] pb-6">
      <div class="space-y-1">
        <span class="text-[10px] uppercase font-bold tracking-[0.25em] text-[#C5A880] block">
          ŞEFFAF MİMARİ & ATÖLYE GÜVENCESİ
        </span>
        <h4 class="text-base font-serif font-semibold text-[#1A1918]">
          Yeşilay Mutfak & İç Mekân Tasarımı
        </h4>
      </div>
      <div class="flex items-center gap-4 text-xs font-medium text-[#282421] whitespace-nowrap">
        <span>📍 Adatepe İmalat Atölyesi</span>
        <span>•</span>
        <span>📐 3D Lazer Rölöve</span>
        <span>•</span>
        <span>🏛️ 28 Yıllık Tasarım Mirası</span>
      </div>
    </div>
    
    <!-- Linkler -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 text-[11.5px]">
      <a href="/sitemap.xml" target="_blank" class="p-3 bg-white border border-[#E5DFD5] hover:border-[#006039] transition flex items-center justify-between group rounded-xs shadow-2xs">
        <span class="group-hover:text-[#006039] text-[#282421] font-medium">XML Site Haritası</span>
        <span class="text-[#C5A880] group-hover:text-[#006039]">↗</span>
      </a>
      <a href="/robots.txt" target="_blank" class="p-3 bg-white border border-[#E5DFD5] hover:border-[#006039] transition flex items-center justify-between group rounded-xs shadow-2xs">
        <span class="group-hover:text-[#006039] text-[#282421] font-medium">Robots.txt İndeksi</span>
        <span class="text-[#C5A880] group-hover:text-[#006039]">↗</span>
      </a>
      <a href="/llms.txt" target="_blank" class="p-3 bg-white border border-[#E5DFD5] hover:border-[#006039] transition flex items-center justify-between group rounded-xs shadow-2xs">
        <span class="group-hover:text-[#006039] text-[#282421] font-medium">LLMs.txt Marka Dizini</span>
        <span class="text-[#C5A880] group-hover:text-[#006039]">↗</span>
      </a>
      <a href="/iletisim/" class="p-3 bg-white border border-[#E5DFD5] hover:border-[#006039] transition flex items-center justify-between group rounded-xs shadow-2xs">
        <span class="group-hover:text-[#006039] text-[#282421] font-medium">Showroom & Yol Tarifi</span>
        <span class="text-[#C5A880] group-hover:text-[#006039]">→</span>
      </a>
      <a href="https://www.instagram.com/yesilaymutfak" target="_blank" rel="noopener noreferrer" class="p-3 bg-white border border-[#E5DFD5] hover:border-[#006039] transition flex items-center justify-between group rounded-xs shadow-2xs">
        <span class="group-hover:text-[#006039] text-[#282421] font-medium">Instagram @yesilaymutfak</span>
        <span class="text-[#C5A880] group-hover:text-[#006039]">↗</span>
      </a>
    </div>
  </div>
</section>

<!-- ANA AÇIK RENK PREMİUM FOOTER -->
<footer class="bg-[#FAF9F6] text-[#6E675F] border-t border-[#E5DFD5] py-16 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
    
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 border-b border-[#E5DFD5] pb-12">
      
      <!-- Kolon 1: Marka & Açıklama -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img src="/logo-emblem.png" alt="Yeşilay Mutfak İzmir Özel Ölçü İmalat Amblemi" class="h-11 w-auto object-contain shrink-0" width="61" height="44" loading="lazy" decoding="async" />
          <div>
            <span class="text-sm font-serif tracking-wider text-[#1A1918] uppercase block leading-none font-bold">YEŞİLAY MUTFAK</span>
            <span class="text-[9px] uppercase tracking-[0.25em] text-[#C5A880] font-semibold block mt-1">MİMARLIK & İÇ MEKÂN TASARIMI</span>
          </div>
        </div>
        <p class="text-[#282421] font-light leading-relaxed text-[11.5px]">
          Kişiye ve mekânın karakterine özel tasarlanan mutfak dolapları, lüks banyo renovasyonları ve anahtar teslim mimari taahhüt. 2.850'den fazla tamamlanan proje, 137+ özel model arşivi.
        </p>
        <div class="text-[11px] text-[#282421] font-medium space-y-1 pt-1">
          <div>📍 <strong>Mağaza & Atölye:</strong> <a href={siteConfig.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[#006039] transition">Gaziler Mahallesi 1084/2 Sokak No: 1/A Buca/İzmir <span class="text-[#006039] font-bold">Haritada Gör ↗</span></a></div>
          <div>📞 <strong>Telefon:</strong> <a href="tel:+902324411060" class="hover:text-[#006039] transition font-bold">0232 441 10 60</a></div>
          <div>💬 <strong>WhatsApp:</strong> <a href="https://wa.me/905324261788" target="_blank" rel="noopener noreferrer" class="text-[#006039] font-bold hover:underline">0532 426 17 88</a></div>
          <div>✉️ <strong>E-Posta:</strong> <a href="mailto:yesilaymutfak@gmail.com" class="hover:text-[#006039] transition font-semibold">yesilaymutfak@gmail.com</a></div>
          <div>📷 <strong>Instagram:</strong> <a href="https://www.instagram.com/yesilaymutfak" target="_blank" rel="noopener noreferrer" class="text-[#C5A880] font-bold hover:underline">@yesilaymutfak</a></div>
        </div>
      </div>

      <!-- Kolon 2: Mimari Hizmetler -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-widest text-[#1A1918]">Mimari Hizmetler</h4>
        <ul class="space-y-2.5 text-[11.5px]">
          <li><a href="/projelendirme/" class="text-[#D4AF37] font-bold hover:underline transition">Projelendirme & Fit-Out (B2B)</a></li>
          <li><a href="/izmir-mutfak-dolabi-imalati/" class="hover:text-[#006039] transition">Özel Ölçü Mutfak Dolabı Modelleri</a></li>
          <li><a href="/izmir-komple-mutfak-tadilati/" class="hover:text-[#006039] transition">Komple Mutfak Renovasyonu</a></li>
          <li><a href="/izmir-banyo-yenileme-seramik/" class="hover:text-[#006039] transition">Lüks Banyo Tasarımı & Seramik</a></li>
          <li><a href="/izmir-komple-daire-tadilati/" class="hover:text-[#006039] transition">Komple Daire Renovasyonu</a></li>
          <li><a href="/izmir-anahtar-teslim-tadilat/" class="hover:text-[#006039] transition">Anahtar Teslim Taahhüt</a></li>
          <li><a href="/izmir-cam-balkon-sistemleri/" class="hover:text-[#006039] transition">İzmir Cam Balkon Sistemleri</a></li>
          <li><a href="/kahve-kosesi-modelleri/" class="hover:text-[#006039] transition">Kahve Köşesi Modelleri</a></li>
          <li><a href="/2026-mutfak-dolabi-fiyatlari/" class="hover:text-[#006039] font-semibold text-[#C5A880] transition">2026 Mutfak Dolabı Fiyatları Rehberi</a></li>
        </ul>
      </div>

      <!-- Kolon 3: Tasarım Koleksiyonu -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-widest text-[#1A1918]">Tasarım Koleksiyonu</h4>
        <ul class="space-y-2 text-[11px]">
          <li><a href="/modern-mutfak-modelleri/" class="hover:text-[#006039] font-semibold text-[#006039] transition">Modern & Kulpsuz Mutfaklar</a></li>
          <li><a href="/klasik-country-mutfak-modelleri/" class="hover:text-[#006039] font-semibold text-[#006039] transition">Klasik & Country Mutfaklar</a></li>
          <li><a href="/yasam-alanlari-mutfak-modelleri/" class="hover:text-[#006039] font-semibold text-[#006039] transition">Açık Mutfak & Yaşam Alanları</a></li>
          <li><a href="/hazir-mutfak-modelleri-izmir/" class="hover:text-[#006039] transition">Hazır & Modüler Mutfaklar</a></li>
          <li><a href="/yatak-odasi-modelleri/" class="hover:text-[#006039] transition">Yatak Odası & Gardırop (99)</a></li>
          <li><a href="/salon-modelleri/" class="hover:text-[#006039] transition">Salon & TV Üniteleri (68)</a></li>
          <li><a href="/genc-odasi-modelleri/" class="hover:text-[#006039] transition">Genç Odası Modelleri (92)</a></li>
          <li><a href="/cocuk-odasi-modelleri/" class="hover:text-[#006039] transition">Çocuk Odası Modelleri (45)</a></li>
          <li><a href="/camasir-odasi-modelleri/" class="hover:text-[#006039] transition">Çamaşır Odası & Kiler (9)</a></li>
          <li><a href="/tasarimlar/" class="hover:text-[#006039] font-bold transition text-[#C5A880]">Tüm Modeller Arşivi →</a></li>
        </ul>
      </div>

      <!-- Kolon 4: Hızlı Keşif Formu / Çağrısı -->
      <div class="space-y-3 bg-white p-5 border border-[#E5DFD5] rounded-xs shadow-2xs">
        <h4 class="text-xs font-bold uppercase tracking-widest text-[#1A1918]">Mimari Keşif Randevusu</h4>
        <p class="text-[11px] text-[#6E675F] font-light leading-relaxed">
          Adatepe atölyemizden uzman mimarımız yerinde lazer rölöve alır ve mekanınıza özel fotogerçekçi 3D mimari çizim hazırlar.
        </p>
        <div class="pt-2">
          <a href="https://wa.me/905324261788" target="_blank" rel="noopener noreferrer" class="block w-full text-center py-3 px-4 bg-[#006039] hover:bg-[#00482B] text-white font-bold uppercase tracking-wider text-[11px] rounded-xs border border-[#C5A880]/30 shadow-xs transition">
            Ücretsiz 3D Keşif Al
          </a>
        </div>
      </div>

    </div>

    <!-- Bölgesel Hizmet Merkezleri -->
    <div class="py-4 border-t border-[#E5DFD5] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-[#6E675F]">
      <span class="font-bold uppercase tracking-wider text-[#1A1918]">Bölgesel Hizmet Merkezleri:</span>
      <div class="flex flex-wrap items-center gap-4 text-[11.5px]">
        <a href="/hizmet-bolgeleri/buca/" class="hover:text-[#006039] transition">Buca Mutfak & Tadilat</a>
        <span class="text-[#D2D2D7]">•</span>
        <a href="/hizmet-bolgeleri/narlidere/" class="hover:text-[#006039] transition">Narlıdere & Sahilevleri</a>
        <span class="text-[#D2D2D7]">•</span>
        <a href="/hizmet-bolgeleri/guzelbahce/" class="hover:text-[#006039] transition">Güzelbahçe Villa</a>
        <span class="text-[#D2D2D7]">•</span>
        <a href="/hizmet-bolgeleri/urla/" class="hover:text-[#006039] transition">Urla & Kekliktepe</a>
        <span class="text-[#D2D2D7]">•</span>
        <a href="/hizmet-bolgeleri/cesme/" class="hover:text-[#006039] transition">Çeşme & Alaçatı</a>
      </div>
    </div>

    <!-- Telif ve Alt Linkler -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-[#6E675F] whitespace-nowrap pt-8 border-t border-[#E5DFD5]">
      <div>
        &copy; {currentYear} Yeşilay Mutfak & İç Mekân Tasarımı. Tüm hakları saklıdır.
      </div>
      <div class="flex flex-wrap items-center gap-5">
        <a href="/" class="hover:text-[#006039] transition">Ana Sayfa</a>
        <a href="/hakkimizda/" class="hover:text-[#006039] transition">Hakkımızda</a>
        <a href="/tasarimlar/" class="hover:text-[#006039] transition">Koleksiyon</a>
        <a href="/yapilan-isler/" class="hover:text-[#006039] transition">Yapılan İşler</a>
        <a href="/projelendirme/" class="text-[#D4AF37] font-semibold hover:underline transition">Projelendirme</a>
        <a href="/iletisim/" class="hover:text-[#006039] transition">İletişim & Atölye</a>
        <a href="/kvkk-aydinlatma-metni/" class="hover:text-[#006039] transition">KVKK</a>
      </div>
    </div>

  </div>
</footer>
