---
const currentYear = new Date().getFullYear();
---

<!-- ===================================================================== -->
<!-- LOCUS BİREBİR MİMARİ FOOTER                                           -->
<!-- Renk: #111111 & #575757 | Border: #ede9e6 | Font: Roboto & Inter      -->
<!-- ===================================================================== -->
<footer class="bg-white border-t border-[#ede9e6] pt-16 pb-12 text-[#575757] font-roboto">
  <div class="max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16">
    
    <!-- 4 SÜTUNLU MİMARİ DÜZEN -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-16 pb-16 border-b border-[#ede9e6]">
      
      <!-- KOLON 1: MAĞAZA & İLETİŞİM -->
      <div class="space-y-4">
        <h2 class="text-[13px] font-medium uppercase tracking-[0.08em] text-[#111111]">
          Mağaza
        </h2>
        <p class="text-[13.5px] leading-relaxed text-[#575757]">
          Mimar Sinan Mah. Dr. Mustafa Enver Bey Cad. No:41/A Alsancak Konak - İzmir
        </p>
        <p class="text-[12.5px] text-[#777777]">
          İmalat & Rölöve Atölyesi: Adatepe Mah. Buca - İzmir
        </p>
        <div class="pt-2">
          <a 
            href="https://maps.google.com/?q=Alsancak+Konak+Izmir" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-[12px] uppercase tracking-[0.06em] text-[#111111] hover:text-[#777777] underline underline-offset-4 transition-colors"
          >
            Haritada Görüntüle ↗
          </a>
        </div>
      </div>

      <!-- KOLON 2: İLETİŞİM & ÇALIŞMA SAATLERİ -->
      <div class="space-y-6">
        <div class="space-y-2">
          <h2 class="text-[13px] font-medium uppercase tracking-[0.08em] text-[#111111]">
            İletişim
          </h2>
          <p class="text-[13.5px] text-[#575757]">
            <a href="tel:+902324411060" class="hover:text-[#111111] transition-colors">0 (232) 441 10 60</a>
          </p>
          <p class="text-[13.5px] text-[#575757]">
            <a href="tel:+905324261788" class="hover:text-[#111111] transition-colors">0 (532) 426 17 88</a>
          </p>
          <p class="text-[13px] text-[#575757]">
            <a href="mailto:info@yesilaymutfak.com" class="hover:text-[#111111] transition-colors">info@yesilaymutfak.com</a>
          </p>
        </div>

        <div class="space-y-2 pt-2 border-t border-[#f3efe8]">
          <h2 class="text-[13px] font-medium uppercase tracking-[0.08em] text-[#111111]">
            Çalışma Saatlerimiz
          </h2>
          <p class="text-[13px] text-[#575757]">
            Pzt-Cuma: 09:00 - 19:30
          </p>
          <p class="text-[13px] text-[#575757]">
            Cumartesi: 10:00 - 18:00
          </p>
        </div>
      </div>

      <!-- KOLON 3: MENÜ NAVİGASYON -->
      <div class="space-y-4">
        <h2 class="text-[13px] font-medium uppercase tracking-[0.08em] text-[#111111]">
          Koleksiyon & Menü
        </h2>
        <ul class="space-y-2 text-[13px]">
          <li>
            <a href="/tasarimlar/" class="hover:text-[#111111] transition-colors">Mutfak</a>
          </li>
          <li>
            <a href="/salon-modelleri/" class="hover:text-[#111111] transition-colors">Mobilya</a>
          </li>
          <li>
            <a href="/hazir-mutfak/" class="hover:text-[#111111] transition-colors">Tamamlayıcı Ürünler</a>
          </li>
          <li>
            <a href="/izmir-komple-mutfak-tadilati/" class="hover:text-[#111111] transition-colors">Cihaz</a>
          </li>
          <li>
            <a href="/tasarimlar/" class="hover:text-[#111111] transition-colors">Kataloglar</a>
          </li>
          <li>
            <a href="/hakkimizda/" class="hover:text-[#111111] transition-colors">Kurumsal</a>
          </li>
          <li>
            <a href="/iletisim/" class="hover:text-[#111111] transition-colors">İletişim</a>
          </li>
          <li>
            <a href="/hakkimizda/" class="text-[11.5px] text-[#888888] hover:text-[#111111] transition-colors">KVKK Aydınlatma Metni</a>
          </li>
        </ul>
      </div>

      <!-- KOLON 4: INSTAGRAM & SOSYAL MEDYA -->
      <div class="space-y-4">
        <h2 class="text-[13px] font-medium uppercase tracking-[0.08em] text-[#111111]">
          Instagram
        </h2>
        <div class="space-y-2 text-[13px]">
          <p>
            <a 
              href="https://www.instagram.com/yesilaymutfak" 
              target="_blank" 
              rel="noopener noreferrer"
              class="hover:text-[#111111] transition-colors flex items-center gap-1.5"
            >
              <span>@yesilaymutfak</span>
              <span class="text-[11px] text-[#888888]">↗</span>
            </a>
          </p>
          <p>
            <a 
              href="https://www.instagram.com/yesilaymutfak" 
              target="_blank" 
              rel="noopener noreferrer"
              class="hover:text-[#111111] transition-colors flex items-center gap-1.5"
            >
              <span>@yesilaymimarlik</span>
              <span class="text-[11px] text-[#888888]">↗</span>
            </a>
          </p>
        </div>

        <div class="pt-4">
          <div class="p-4 bg-[#fbf9f6] border border-[#ede9e6] space-y-2">
            <span class="text-[10px] uppercase tracking-[0.12em] text-[#888888] block font-medium">
              MİMARİ DANIŞMANLIK
            </span>
            <p class="text-[11.5px] text-[#575757] leading-relaxed">
              Mekanınıza özel 3D lazer rölöve ve fotogerçekçi mutfak projelendirmesi için showroomumuza bekleriz.
            </p>
          </div>
        </div>
      </div>

    </div>

    <!-- EN ALT: TELİF VE HAKLAR -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[12px] text-[#888888]">
      <div>
        © {currentYear} Yeşilay Mutfak Mimarlık San. ve Tic. Ltd. Şti. Tüm hakları saklıdır.
      </div>
      <div class="flex items-center gap-6">
        <a href="/sitemap.xml" target="_blank" class="hover:text-[#111111] transition-colors">Site Haritası</a>
        <span>•</span>
        <a href="/hakkimizda/" class="hover:text-[#111111] transition-colors">Gizlilik & KVKK</a>
        <span>•</span>
        <a href="/iletisim/" class="hover:text-[#111111] transition-colors">İletişim</a>
      </div>
    </div>

  </div>
</footer>
