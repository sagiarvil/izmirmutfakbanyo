---
import { siteConfig } from "../data/siteConfig";
import { SEO_REGISTRY, DOMAIN } from "../seo/registry";
import { buildCompleteJsonLdGraph } from "../seo/schema-builder";
import type { CatalogItemInput, FaqInput } from "../seo/registry.types";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  breadcrumbs?: Array<{ name: string; url: string }>;
  faqList?: Array<{ question: string; answer: string }>;
  catalogItems?: CatalogItemInput[];
  serviceName?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  canonical,
  image,
  type,
  noindex = false,
  breadcrumbs = [],
  faqList = [],
  catalogItems = [],
  serviceName,
  publishedTime = "2024-01-15T09:00:00+03:00",
  modifiedTime = "2026-11-14T12:00:00+03:00"
} = Astro.props;

const siteUrl = siteConfig.siteUrl.replace(/\/$/, "");
const rawPathname = Astro.url.pathname;
const isHtmlFile = rawPathname.endsWith(".html");
const currentPath = rawPathname.replace(/\/$/, "");
const normalizedRoute = isHtmlFile
  ? rawPathname
  : currentPath === ""
    ? "/"
    : `${currentPath}/`;

const registeredPage = SEO_REGISTRY[normalizedRoute];

const resolvedTitle = registeredPage
  ? registeredPage.title
  : title.includes("|")
    ? title
    : `${title} | Yeşilay Mutfak`;

const resolvedDescription = registeredPage ? registeredPage.metaDescription : description;
const resolvedImageRel = image || registeredPage?.image || "/media/real/yesilay-showroom-gece-cephe.webp";
const imageUrl = resolvedImageRel.startsWith("http")
  ? resolvedImageRel
  : `${siteUrl}${resolvedImageRel.startsWith("/") ? resolvedImageRel : "/" + resolvedImageRel}`;

const canonicalUrl = canonical || `${siteUrl}${normalizedRoute}`;
const ogType = type || (registeredPage?.role === "article" ? "article" : "website");
const robotsContent = noindex
  ? "noindex,follow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

let jsonLd = "";
if (!noindex) {
  const effectiveRecord = registeredPage || {
    route: normalizedRoute,
    role: "service" as const,
    title: resolvedTitle,
    metaDescription: resolvedDescription,
    image: resolvedImageRel,
    serviceType: serviceName || resolvedTitle.split("|")[0].trim(),
    publishedAt: publishedTime,
    modifiedAt: modifiedTime,
    breadcrumbs: breadcrumbs.length > 0
      ? breadcrumbs.map(b => ({ name: b.name, item: b.url }))
      : [
          { name: "Ana Sayfa", item: "/" },
          { name: resolvedTitle.split("|")[0].trim(), item: normalizedRoute }
        ],
    catalogItems
  };

  jsonLd = buildCompleteJsonLdGraph(effectiveRecord, DOMAIN, {
    faqList: faqList as FaqInput[],
    catalogItemsOverride: catalogItems.length > 0 ? catalogItems : undefined
  });
}
---

<title>{resolvedTitle}</title>
<meta name="description" content={resolvedDescription} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={robotsContent} />

{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={resolvedTitle} />
<meta property="og:description" content={resolvedDescription} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content="tr_TR" />
<meta property="og:site_name" content="Yeşilay Mutfak" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={resolvedTitle} />
<meta name="twitter:description" content={resolvedDescription} />
<meta name="twitter:image" content={imageUrl} />

<!-- Yerel Konum Sinyalleri -->
<meta name="geo.region" content="TR-35" />
<meta name="geo.placename" content="Buca, İzmir" />
<meta name="geo.position" content={`${siteConfig.geo.latitude};${siteConfig.geo.longitude}`} />
<meta name="ICBM" content={`${siteConfig.geo.latitude}, ${siteConfig.geo.longitude}`} />

<!-- AI Arama Dizini -->
<link rel="alternate" type="text/markdown" href="/llms.txt" title="Yeşilay Mutfak LLMs Dizini" />
